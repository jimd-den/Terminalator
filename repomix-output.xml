<file path="src/domain/commands/core/UniqCommand.ts">
  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { CommandBase } from '../CommandBase';
  3: import { CommandCapability } from '../IStructuredCommand';
  4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  5: import { TerminalState } from '../../entities/TerminalState';
  6: import { CommandResponse } from '../../entities/Command';
  7: import { FileSystemService } from '../../services/FileSystemService';
  8: interface UniqOptions {
  9:     count: boolean;
 10:     repeated: boolean;
 11:     unique: boolean;
 12:     skipFields: number;
 13:     skipChars: number;
 14:     ignoreCase: boolean;
 15:     inputFile?: string;
 16:     outputFile?: string;
 17: }
 18: export class UniqCommand extends CommandBase {
 19:     public readonly capabilities = [CommandCapability.FILTER];
 20:     public readonly utility = 'uniq';
 21:     constructor(private fs: FileSystemService) {
 22:         super();
 23:     }
 24:     protected override parseArgs(args: string[]) {
 25:         super.parseArgs(args, ['f', 's']);
 26:     }
 27:     protected async executeInternal(
 28:         rawArgs: string[],
 29:         flags: Set<string>,
 30:         operands: string[],
 31:         context: ProcessContext,
 32:         state: TerminalState
 33:     ): Promise<CommandResponse> {
 34:         const input = getStdinAsString(context);
 35:         const options: UniqOptions = {
 36:             count: flags.has('c'),
 37:             repeated: flags.has('d'),
 38:             unique: flags.has('u'),
 39:             ignoreCase: flags.has('i'),
 40:             skipFields: this.options.get('f') ? parseInt(this.options.get('f')!) : 0,
 41:             skipChars: this.options.get('s') ? parseInt(this.options.get('s')!) : 0
 42:         };
 43:         if (operands.length > 0) options.inputFile = operands[0];
 44:         if (operands.length > 1) options.outputFile = operands[1];
 45:         let content = '';
 46:         if (options.inputFile && options.inputFile !== '-') {
 47:             try {
 48:                 const resolvedPath = this.resolvePath(options.inputFile, state);
 49:                 content = this.fs.readFile(resolvedPath);
 50:             } catch (e) {
 51:                 return {
 52:                     output: `uniq: ${options.inputFile}: No such file or directory`,
 53:                     newState: state,
 54:                     exitCode: 1
 55:                 };
 56:             }
 57:         } else if (input !== undefined) {
 58:             content = input;
 59:         } else {
 60:             return { output: '', newState: state, exitCode: 0 };
 61:         }
 62:         const lines = content.split('\n');
 63:         if (content.endsWith('\n') && lines[lines.length - 1] === '') {
 64:             lines.pop();
 65:         }
 66:         const results: string[] = [];
 67:         let previousLine: string | null = null;
 68:         let count = 0;
 69:         const getCompareKey = (line: string): string => {
 70:             let key = line;
 71:             if (options.skipFields > 0) {
 72:                 let remaining = line;
 73:                 for (let f = 0; f < options.skipFields; f++) {
 74:                     remaining = remaining.trimStart();
 75:                     const spaceIdx = remaining.search(/\s/);
 76:                     if (spaceIdx === -1) {
 77:                         remaining = "";
 78:                         break;
 79:                     }
 80:                     remaining = remaining.substring(spaceIdx);
 81:                 }
 82:                 key = remaining.trimStart();
 83:             }
 84:             if (options.skipChars > 0) {
 85:                 if (key.length > options.skipChars) {
 86:                     key = key.substring(options.skipChars);
 87:                 } else {
 88:                     key = "";
 89:                 }
 90:             }
 91:             if (options.ignoreCase) {
 92:                 key = key.toLowerCase();
 93:             }
 94:             return key;
 95:         };
 96:         const flush = () => {
 97:             if (previousLine !== null) {
 98:                 const isRepeated = count > 1;
 99:                 let shouldPrint = true;
100:                 if (options.repeated || options.unique) {
101:                     shouldPrint = false;
102:                     if (options.repeated && isRepeated) shouldPrint = true;
103:                     if (options.unique && !isRepeated) shouldPrint = true;
104:                 }
105:                 if (shouldPrint) {
106:                     let lineOut = previousLine;
107:                     if (options.count) {
108:                         lineOut = `${count.toString().padStart(4)} ${lineOut}`;
109:                     }
110:                     results.push(lineOut);
111:                 }
112:             }
113:         };
114:         for (const line of lines) {
115:             const key = getCompareKey(line);
116:             if (previousLine === null) {
117:                 previousLine = line;
118:                 count = 1;
119:                 continue;
120:             }
121:             const prevKey = getCompareKey(previousLine);
122:             if (key !== prevKey) {
123:                 flush();
124:                 previousLine = line;
125:                 count = 1;
126:             } else {
127:                 count++;
128:             }
129:         }
130:         flush();
131:         const finalOutput = results.join('\n');
132:         if (options.outputFile) {
133:             try {
134:                 const resolvedOut = this.resolvePath(options.outputFile, state);
135:                 this.fs.writeFile(resolvedOut, finalOutput);
136:                 return { output: '', newState: state, exitCode: 0 };
137:             } catch (e) {
138:                 return { output: `uniq: ${options.outputFile}: Cannot write`, newState: state, exitCode: 1 };
139:             }
140:         }
141:         return {
142:             output: finalOutput,
143:             newState: state,
