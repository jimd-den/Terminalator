  4: import { CommandResponse } from '../../domain/entities/Command';
  5: import { TerminalOutputLine, OutputControllerActions } from './OutputController';
  6: import { ShellPresenter } from '../presenters/ShellPresenter';
  7: import { IGameManager } from '../../domain/interfaces/IGameManager';
  8: import { GameEventObserver } from '../../domain/services/GameEventObserver';
  9: import { SimulationMediator } from '../../core/presentation/SimulationMediator';
 10: export interface ShellControllerDeps {
 11:     commandExecutor: ExecuteCommand;
 12:     gameManager: IGameManager;
 13:     gameEventObserver: GameEventObserver;
 14:     outputController: OutputControllerActions;
 15:     setState: (update: (prev: TerminalState) => TerminalState) => void;
 16:     stateRef: MutableRefObject<TerminalState>;
 17:     inputController: { clearInput: () => void };
 18:     navigation: any;
 19:     setIsTransitioning: (val: boolean) => void;
 20:     setActiveApp: (app: any) => void;
 21:     setMissions: (missions: any[]) => void;
 22:     simulationMediator: SimulationMediator;
 23: }
 24: export class ShellController {
 25:     private deps: ShellControllerDeps;
 26:     constructor(deps: ShellControllerDeps) {
 27:         this.deps = deps;
 28:     }
 29:     async execute(cmdToRun: string): Promise<void> {
 30:         if (!cmdToRun) return;
 31:         const {
 32:             outputController,
 33:             inputController,
 34:             commandExecutor,
 35:             stateRef,
 36:             setState,
 37:             gameManager,
 38:             gameEventObserver,
 39:             navigation,
 40:             setIsTransitioning,
 41:             setActiveApp,
 42:             setMissions
 43:         } = this.deps;
 44:         const cmdIndex = outputController.getLineCount();
 45:         outputController.appendLine(
 46:             ShellPresenter.presentInputEcho(cmdToRun, true)
 47:         );
 48:         inputController.clearInput();
 49:         const { simulationMediator } = this.deps;
 50:         const response: CommandResponse = await simulationMediator.executeWithTheatre(cmdToRun, stateRef.current);
 51:         const { output: cmdOutput, newState, navigationAction, uiAction, exitCode, controlFlow } = response;
 52:         if (newState) {
 53:             const updated = { ...stateRef.current, ...newState };
 54:             stateRef.current = updated;
 55:             setState(() => updated);
 56:         }
 57:         if (controlFlow === 'EXIT') {
 58:             gameManager.tutorEngine.stop();
 59:             outputController.clear();
 60:             return;
 61:         }
 62:         if (uiAction === 'CLEAR') {
 63:             outputController.clear();
 64:             return;
 65:         }
 66:         if (navigationAction?.type === 'NAVIGATE') {
 67:             await this.handleNavigation(navigationAction, setIsTransitioning, setActiveApp, navigation);
 68:             return;
 69:         }
 70:         outputController.updateInputStatus(cmdIndex, exitCode, false);
 71:         if (cmdOutput !== undefined && cmdOutput !== null) {
 72:             outputController.appendLine(
 73:                 ShellPresenter.presentOutput(cmdOutput, response.metadata)
 74:             );
 75:         }
 76:         const prevFsContext = stateRef.current.fsContext;
 77:         gameManager.onCommandExecuted(stateRef.current, response, prevFsContext);
 78:         const eventMsg = await gameEventObserver.checkProceduralEvents(outputController.getLineCount());
 79:         if (eventMsg) {
 80:             outputController.appendLine(
 81:                 ShellPresenter.presentSystemMessage(eventMsg)
 82:             );
 83:         }
 84:         setMissions([...gameManager.getActiveMissions()]);
 85:     }
 86:     private async handleNavigation(
 87:         action: any,
 88:         setIsTransitioning: (v: boolean) => void,
 89:         setActiveApp: (app: any) => void,
 90:         navigation: any
 91:     ) {
 92:         if (action.target === 'Editor') {
 93:             setIsTransitioning(true);
 94:             setTimeout(() => {
 95:                 setActiveApp({ type: 'VIM', filename: action.params.filename });
 96:                 setTimeout(() => setIsTransitioning(false), 300);
 97:             }, 100);
 98:             return;
 99:         }
100:         navigation.navigate(action.target, action.params);
101:     }
102: }
</file>

