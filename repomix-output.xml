 67:             }
 68:         }, 1000);
 69:         return () => clearInterval(interval);
 70:     }, [contextualHint, missionVM.missions, shellVM.fsContext, gameManager, hintService]);
 71:     const handleKeyPressWrapped = useCallback((key: string) => {
 72:         resetInactivityTimer();
 73:         shellVM.handleKeyPress(key);
 74:     }, [shellVM.handleKeyPress, resetInactivityTimer]);
 75:     const handleAction = useCallback((action: string) => {
 76:         if (action === 'HELP') {
