 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { CommandBase } from '../CommandBase';
 3: import { CommandCapability } from '../IStructuredCommand';
 4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystemService } from '../../services/FileSystemService';
 8: export class FoldCommand extends CommandBase {
 9:     public readonly capabilities = [CommandCapability.TRANSFORM];
10:     public readonly utility = 'fold';
11:     constructor(private fs: FileSystemService) {
12:         super();
13:     }
14:     protected override parseArgs(args: string[]) {
15:         super.parseArgs(args, ['w']);
16:     }
17:     protected async executeInternal(
18:         rawArgs: string[],
19:         flags: Set<string>,
20:         operands: string[],
21:         context: ProcessContext,
22:         state: TerminalState
23:     ): Promise<CommandResponse> {
24:         const input = getStdinAsString(context);
25:         let width = parseInt(this.options.get('w') || '80', 10) || 80;
26:         let files = operands;
27:         let content = '';
28:         if (files.length > 0) {
29:             for (const file of files) {
30:                 try {
31:                     const path = this.resolvePath(file, state);
32:                     content += this.fs.readFile(path);
33:                 } catch (e) {
34:                     return { output: `fold: ${file}: No such file`, newState: state, exitCode: 1 };
35:                 }
36:             }
37:         } else if (input) {
38:             content = input;
39:         } else {
40:             return { output: '', newState: state, exitCode: 0 };
41:         }
42:         const lines = content.split('\n');
43:         const outputLines: string[] = [];
44:         for (const line of lines) {
45:             if (line.length <= width) {
46:                 outputLines.push(line);
47:             } else {
48:                 let pos = 0;
49:                 while (pos < line.length) {
50:                     outputLines.push(line.slice(pos, pos + width));
51:                     pos += width;
52:                 }
53:             }
54:         }
55:         return {
56:             output: outputLines.join('\n'),
57:             newState: state,
58:             exitCode: 0
59:         };
60:     }
61:     private resolvePath(path: string, state: TerminalState): string {
62:         if (path.startsWith('/')) return path;
63:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
64:     }
65: }
</file>

<file path="src/domain/commands/core/FuserCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand, CommandResponse } from '../ICommand';
