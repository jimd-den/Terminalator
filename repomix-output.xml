<file path="src/domain/commands/core/FgCommand.ts">
 1: import { ICommand, CommandResponse } from '../ICommand';
 2: import { ProcessContext } from '../../entities/ProcessContext';
 3: import { TerminalState } from '../../entities/TerminalState';
 4: import { formatJobForFg } from '../../entities/Job';
 5: export class FgCommand implements ICommand {
 6:     async execute(
 7:         args: string[],
 8:         context: ProcessContext,
 9:         state: TerminalState
10:     ): Promise<CommandResponse> {
11:         const jobControl = context.jobControl;
12:         if (!jobControl) {
13:             return {
14:                 output: 'fg: no job control in this shell',
15:                 newState: state,
16:                 exitCode: 1
17:             };
18:         }
19:         const jobSpecs = args.filter(arg => !arg.startsWith('-'));
20:         if (args.includes('--help')) {
21:             return {
22:                 output: this.getHelp(),
23:                 newState: state,
24:                 exitCode: 0
25:             };
26:         }
27:         if (jobSpecs.length > 1) {
28:             return {
29:                 output: 'fg: too many arguments',
30:                 newState: state,
31:                 exitCode: 1
32:             };
33:         }
34:         const spec = jobSpecs.length > 0 ? jobSpecs[0] : undefined;
35:         const result = jobControl.resumeForeground(spec);
36:         if (!result.success) {
37:             return {
38:                 output: result.errorMessage ?? 'fg: no current job',
39:                 newState: state,
40:                 exitCode: 1
41:             };
42:         }
43:         if (result.job) {
44:             return {
45:                 output: formatJobForFg(result.job),
46:                 newState: state,
47:                 exitCode: result.job.exitCode ?? 0
48:             };
49:         }
50:         return {
51:             output: '',
52:             newState: state,
53:             exitCode: 0
54:         };
55:     }
56:     private getHelp(): string {
57:         return `fg - run jobs in the foreground
58: Usage: fg [job_id]
59: Move a background job to the foreground.
60: If no job_id is given, the current job is used.
61: Job ID formats:
62:   %n      - Job number n
63:   %% or %+ - Current job
64:   %-      - Previous job
65:   %str    - Job starting with str`;
66:     }
67: }
</file>

<file path="src/domain/commands/core/FileCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem, S_IFDIR, S_IFLNK, S_IFREG, S_IFIFO, S_IFMT } from '../../entities/FileSystem';
 8: export class FileCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
11:         const input = getStdinAsString(context);
12:         if (args.length === 0) {
13:             return { output: 'usage: file file...', newState: state, exitCode: 1 };
14:         }
15:         const results: string[] = [];
16:         let finalExitCode = 0;
17:         for (const arg of args) {
18:             if (arg.startsWith('-')) continue;
19:             const dentry = this.fs.resolve(arg, state.currentDirectory);
20:             if (!dentry) {
21:                 results.push(`${arg}: cannot open '${arg}' (No such file or directory)`);
22:                 finalExitCode = 1;
23:                 continue;
24:             }
25:             const inode = this.fs.getInode(dentry.inodeId);
26:             if (!inode) {
27:                 results.push(`${arg}: error reading inode`);
28:                 finalExitCode = 1;
29:                 continue;
30:             }
31:             let type = 'data';
32:             const modeType = inode.mode & S_IFMT;
33:             if (modeType === S_IFDIR) {
34:                 type = 'directory';
35:             } else if (modeType === S_IFLNK) {
36:                 type = 'symbolic link';
37:             } else if (modeType === S_IFIFO) {
38:                 type = 'fifo (named pipe)';
39:             } else if (modeType === S_IFREG) {
40:                 if (inode.size === 0) {
41:                     type = 'empty';
42:                 } else {
43:                     const content = inode.content as string;
44:                     if (content.indexOf('\0') !== -1) {
45:                         type = 'data';
46:                     } else {
47:                         type = 'ASCII text';
48:                     }
49:                 }
50:             } else {
51:                 type = 'special file';
52:             }
53:             results.push(`${arg}: ${type}`);
54:         }
55:         return { output: results.join('\n'), newState: state, exitCode: finalExitCode };
56:     }
57: }
</file>

