25:         for (const arg of args) {
26:             if (arg.includes('=')) {
27:                 const parts = arg.split('=');
28:                 const name = parts[0];
29:                 const val = parts.slice(1).join('=');
30:                 newState.aliases[name] = val;
31:             } else {
32:                 if (newState.aliases[arg]) {
33:                     output += `${arg}=${newState.aliases[arg]}\n`;
