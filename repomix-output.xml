36:             const id = i === 1 ? targetIncidentId : `INC-${500 + i}`;
37:             const code = '10-31';
38:             const zone = i === 1 ? targetZone : 'ZONE_X';
39:             const priority = Math.floor(Math.random() * 5) + 1;
40:             content += `${id},${code},${zone},${priority}\n`;
41:         }
