 8: export class GetconfCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         let showAll = false;
13:         let spec = '';
14:         const operands: string[] = [];
15:         for (let i = 0; i < args.length; i++) {
16:             const arg = args[i];
17:             if (arg === '-a') {
18:                 showAll = true;
19:             } else if (arg === '-v') {
20:                 if (i + 1 < args.length) {
21:                     spec = args[++i];
22:                 } else {
23:                     return { output: 'getconf: option requires an argument -- v', newState: state, exitCode: 1 };
24:                 }
25:             } else if (arg.startsWith('-')) {
26:                 return { output: `getconf: invalid option -- ${arg.replace(/^-+/, '')}`, newState: state, exitCode: 1 };
27:             } else {
28:                 operands.push(arg);
29:             }
30:         }
31:         const sysconf: Record<string, string> = {
32:             'PATH_MAX': '4096',
33:             'NAME_MAX': '255',
34:             'ARG_MAX': '131072',
35:             'LINE_MAX': '2048',
36:             'CHILD_MAX': '25',
37:             'OPEN_MAX': '1024',
38:             'NGROUPS_MAX': '65536',
39:             'STREAM_MAX': '16',
40:             'TZNAME_MAX': '6',
41:             'PAGESIZE': '4096',
42:             'PAGE_SIZE': '4096',
43:             '_POSIX_VERSION': '200809L',
44:             '_POSIX2_VERSION': '200809L'
45:         };
46:         const confstr: Record<string, string> = {
47:             'PATH': '/bin:/usr/bin',
48:             'CS_PATH': '/bin:/usr/bin',
49:             'SHELL': '/bin/sh'
50:         };
51:         const allVars = { ...sysconf, ...confstr };
52:         if (showAll) {
53:             let output = '';
54:             for (const [k, v] of Object.entries(allVars)) {
55:                 output += `${k}: ${v}\n`;
56:             }
57:             return { output: output.trim(), newState: state, exitCode: 0 };
58:         }
59:         if (operands.length === 0) {
60:             return { output: 'getconf: missing operand', newState: state, exitCode: 1 };
61:         }
62:         const varName = operands[0];
63:         const path = operands[1];
64:         if (path) {
65:             if (varName === 'PATH_MAX' || varName === 'NAME_MAX' || varName.includes('_PATH') || varName.includes('_NAME')) {
66:                 const node = this.fs.resolve(path);
67:                 if (!node) {
68:                     return { output: `getconf: ${path}: No such file or directory`, newState: state, exitCode: 1 };
69:                 }
70:             } else {
71:                 const node = this.fs.resolve(path);
72:                 if (!node) {
73:                     return { output: `getconf: ${path}: No such file or directory`, newState: state, exitCode: 1 };
74:                 }
75:             }
76:         }
77:         if (allVars[varName]) {
78:             return { output: allVars[varName], newState: state, exitCode: 0 };
79:         }
80:         return { output: 'undefined', newState: state, exitCode: 1 };
81:     }
82: }
