<file path="src/domain/services/filesystem/PathResolver.ts">
  1: import { IFileSystemNode } from '../../entities/filesystem/IFileSystemNode';
  2: import { DirectoryNode } from '../../entities/filesystem/DirectoryNode';
  3: import { S_IFLNK, Inode } from '../../entities/filesystem/FileSystemTypes';
  4: import { InodeTable } from '../../entities/filesystem/InodeTable';
  5: type Dentry = IFileSystemNode;
  6: export class PathResolver {
  7:     constructor(private inodeTable: InodeTable) { }
  8:     resolve(root: Dentry, path: string, cwd: string = '/', followSymlinks: boolean = true, actingUser?: { uid: number, gid: number, groups: number[] }): Dentry | null {
  9:         if (!path) return null;
 10:         let startNode: Dentry;
 11:         if (path.startsWith('/')) {
 12:             startNode = root;
 13:         } else {
 14:             const resolvedCwd = this.resolve(root, cwd, '/', true, actingUser);
 15:             if (!resolvedCwd) return null;
 16:             startNode = resolvedCwd;
 17:         }
 18:         const parts = path.split('/').filter(p => p.length > 0 && p !== '.');
 19:         let current = startNode;
 20:         let symlinkCount = 0;
 21:         const MAX_SYMLINKS = 40;
 22:         for (let i = 0; i < parts.length; i++) {
 23:             const part = parts[i];
 24:             if (part === '..') {
 25:                 if (current.parent) {
 26:                     current = current.parent;
 27:                 }
 28:             } else {
 29:                 if (!current.isDirectory()) {
 30:                     return null;
 31:                 }
 32:                 const dirNode = current as DirectoryNode;
 33:                 if (actingUser) {
 34:                     const inode = this.inodeTable.get(current.inodeId);
 35:                     if (inode) {
 36:                         if (!this.hasSearchPermission(inode, actingUser)) {
 37:                             throw new Error('Permission denied');
 38:                         }
 39:                     }
 40:                 }
 41:                 const next = dirNode.getChild(part);
 42:                 if (!next) {
 43:                     return null;
 44:                 }
 45:                 const inode = this.inodeTable.get(next.inodeId);
 46:                 if (!inode) return null;
 47:                 const isLast = (i === parts.length - 1);
 48:                 const shouldFollow = !isLast || followSymlinks;
 49:                 if (shouldFollow && (inode.mode & S_IFLNK) && inode.target) {
 50:                     if (symlinkCount++ > MAX_SYMLINKS) throw new Error('Too many levels of symbolic links');
 51:                     const target = inode.target;
 52:                     let targetNode: Dentry | null;
 53:                     if (target.startsWith('/')) {
 54:                         targetNode = this.resolve(root, target, '/', true, actingUser);
 55:                     } else {
 56:                         const currentAbs = this.getAbsolutePath(current);
 57:                         targetNode = this.resolve(root, target, currentAbs, true, actingUser);
 58:                     }
 59:                     if (!targetNode) return null;
 60:                     current = targetNode;
 61:                 } else {
 62:                     current = next;
 63:                 }
 64:             }
 65:         }
 66:         return current;
 67:     }
 68:     getAbsolutePath(dentry: Dentry): string {
 69:         const parts: string[] = [];
 70:         let current: Dentry | null = dentry;
 71:         while (current && current.parent) {
 72:             parts.unshift(current.name);
 73:             current = current.parent;
 74:         }
 75:         return parts.length === 0 ? '/' : '/' + parts.join('/');
 76:     }
 77:     private hasSearchPermission(inode: Inode, user: { uid: number, gid: number, groups: number[] }): boolean {
 78:         if (user.uid === 0) return true;
 79:         if (user.uid === inode.uid) return (inode.mode & 0o100) !== 0;
 80:         if (user.gid === inode.gid || user.groups.includes(inode.gid)) return (inode.mode & 0o010) !== 0;
 81:         return (inode.mode & 0o001) !== 0;
 82:     }
 83:     public static resolveString(path: string, cwd: string, home: string = '/home/operator'): string {
 84:         let absolutePath = path;
 85:         if (path === '~') {
 86:             return home;
 87:         }
 88:         if (path.startsWith('~/')) {
 89:             absolutePath = home + path.substring(1);
 90:         }
 91:         if (!absolutePath.startsWith('/')) {
 92:             absolutePath = cwd === '/' ? `/${absolutePath}` : `${cwd}/${absolutePath}`;
 93:         }
 94:         return this.normalize(absolutePath);
 95:     }
 96:     public static normalize(path: string): string {
 97:         const parts = path.split('/').filter(p => p.length > 0 && p !== '.');
 98:         const stack: string[] = [];
 99:         for (const part of parts) {
100:             if (part === '..') {
101:                 if (stack.length > 0) stack.pop();
102:                 continue;
103:             }
104:             stack.push(part);
105:         }
106:         return '/' + stack.join('/');
107:     }
108: }
</file>

<file path="src/domain/services/filesystem/PermissionService.ts">
 1: import { Inode, S_IRUSR, S_IWUSR, S_IXUSR, S_IRGRP, S_IWGRP, S_IXGRP, S_IROTH, S_IWOTH, S_IXOTH } from '../../entities/filesystem/FileSystemTypes';
 2: import { InodeTable } from '../../entities/filesystem/InodeTable';
 3: export class PermissionService {
 4:     constructor(private inodeTable: InodeTable) { }
 5:     public hasAccess(inodeId: number, actingUser: { uid: number, gid: number, groups: number[] }, requiredBit: number): boolean {
 6:         const inode = this.inodeTable.get(inodeId);
 7:         if (!inode) return false;
 8:         if (actingUser.uid === 0) {
 9:             if (this.isExecuteCheck(requiredBit)) {
10:                 return (inode.mode & 0o111) !== 0;
11:             }
12:             return true;
13:         }
14:         if (actingUser.uid === inode.uid) {
15:             return this.checkBits(inode.mode, requiredBit, 'USER');
16:         }
17:         if (actingUser.gid === inode.gid || actingUser.groups.includes(inode.gid)) {
18:             return this.checkBits(inode.mode, requiredBit, 'GROUP');
19:         }
20:         return this.checkBits(inode.mode, requiredBit, 'OTHER');
21:     }
22:     private isExecuteCheck(bit: number): boolean {
23:         return bit === S_IXUSR || bit === S_IXGRP || bit === S_IXOTH;
24:     }
25:     private checkBits(mode: number, requiredBit: number, scope: 'USER' | 'GROUP' | 'OTHER'): boolean {
26:         if (requiredBit === S_IRUSR || requiredBit === S_IRGRP || requiredBit === S_IROTH) {
27:             if (scope === 'USER') return (mode & S_IRUSR) !== 0;
28:             if (scope === 'GROUP') return (mode & S_IRGRP) !== 0;
29:             if (scope === 'OTHER') return (mode & S_IROTH) !== 0;
30:         }
31:         if (requiredBit === S_IWUSR || requiredBit === S_IWGRP || requiredBit === S_IWOTH) {
32:             if (scope === 'USER') return (mode & S_IWUSR) !== 0;
33:             if (scope === 'GROUP') return (mode & S_IWGRP) !== 0;
34:             if (scope === 'OTHER') return (mode & S_IWOTH) !== 0;
35:         }
36:         if (requiredBit === S_IXUSR || requiredBit === S_IXGRP || requiredBit === S_IXOTH) {
37:             if (scope === 'USER') return (mode & S_IXUSR) !== 0;
38:             if (scope === 'GROUP') return (mode & S_IXGRP) !== 0;
39:             if (scope === 'OTHER') return (mode & S_IXOTH) !== 0;
40:         }
41:         return false;
42:     }
43: }
</file>

