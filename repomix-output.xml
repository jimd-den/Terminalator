 2: import { SimulationBus, GameEventType } from '../SimulationBus';
 3: export class TutorProxy {
 4:     public static wrapCpuState(cpu: CpuState, bus: SimulationBus): CpuState {
 5:         return new Proxy(cpu, {
 6:             get(target: any, prop: string | symbol, receiver: any) {
 7:                 const value = Reflect.get(target, prop, receiver);
 8:                 if (prop === 'setRegister' && typeof value === 'function') {
 9:                     return (...args: any[]) => {
10:                         const [index, newVal] = args;
11:                         const oldValue = target.getRegister(index);
12:                         const result = value.apply(target, args);
13:                         bus.emit(GameEventType.REGISTER_MODIFIED, {
14:                             register: CpuState.getRegisterName(index),
15:                             index,
16:                             oldValue,
17:                             newValue: newVal,
18:                             source: 'PROXY'
19:                         });
20:                         return result;
21:                     };
22:                 }
23:                 return value;
24:             }
25:         });
26:     }
