378:                                 <Animated.Text style={[dynamicStyles.multiplierText, { color: colors.primary }, multiplierStyle]}>
379:                                     {Math.min(8, 1 + Math.floor(streak / 5))}X
380:                                 </Animated.Text>
381:                             )}
382:                         </View>
383:                         {}
384:                         <View style={dynamicStyles.glyphContainer}>
385:                             <Animated.Text style={[dynamicStyles.glyph, { color: colors.primary }, glyphStyle]}>
386:                                 {displayChar || ''}
387:                             </Animated.Text>
388:                         </View>
389:                         {/* Feedback Layer */}
390:                         {feedback !== 'NONE' && (
391:                             <Animated.View style={[dynamicStyles.feedbackContainer, feedbackStyle]}>
392:                                 <Text
393:                                     adjustsFontSizeToFit
394:                                     numberOfLines={1}
395:                                     style={[dynamicStyles.feedbackText, { color: feedback === 'PERFECT' ? colors.secondary : colors.error }]}
396:                                 >
397:                                     {feedback === 'PERFECT' ? 'PERFECT' : 'MISS'}
398:                                 </Text>
399:                             </Animated.View>
400:                         )}
401:                     </View>
402:                 )}
403:             </Animated.View>
404:         </View>
405:     );
406: };
