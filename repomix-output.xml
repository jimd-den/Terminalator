 3: import { NPC, NPCGenerator } from '../domain/entities/NPC';
 4: import { MissionService } from '../domain/services/MissionService';
 5: import { EconomyService } from '../domain/services/EconomyService';
 6: export class LessonCoordinator {
 7:     constructor(
 8:         private tutorEngine: TutorEngine,
 9:         private mailSystem: MailSystem,
10:         private missionService: MissionService,
11:         private economyService: EconomyService
12:     ) {
13:         this.tutorEngine.subscribe(this.handleTutorEvent);
14:     }
15:     private handleTutorEvent = (event: TutorEvent) => {
16:         const tutorNpc: NPC = {
17:             id: 'tutor_bot',
18:             name: 'TutorBot',
19:             career: 'Training AI',
20:             origin: 'Mainframe',
21:             goal: 'Educate',
22:             status: 'active',
23:             traits: ['Precise', 'Strict'],
24:             loadout: []
25:         };
26:         switch (event.type) {
27:             case 'START':
28:                 this.economyService.startSession();
29:                 break;
30:             case 'SPEED_WARNING':
31:                 if (event.payload === 'TOO FAST') {
32:                 }
33:                 break;
34:             case 'COMPLETE':
35:                 const payload = event.payload;
36:                 const lesson = payload?.lesson;
37:                 if (!lesson) return;
38:                 this.mailSystem.sendMail(
39:                     tutorNpc,
40:                     'LESSON COMPLETE',
41:                     `MODULE ${lesson.id} VERIFIED. PROCEEDING.`
42:                 );
43:                 if (lesson.id && lesson.id.startsWith('MISSION_')) {
44:                     const missionId = lesson.id.replace('MISSION_', '');
45:                     const mission = this.missionService.getMissionById(missionId);
46:                     if (mission) {
47:                         // Progression messages were historically added here,
48:                         // but now we rely on MissionService.updateMissions doing the heavy lifting.
49:                         // However, a completion message in chatHistory is still useful for UI feedback.
50:                         mission.chatHistory.push({
51:                             sender: 'SYSTEM',
52:                             message: `PROTOCOL ${lesson.id} SECURED.`,
53:                             timestamp: Date.now()
54:                         });
55:                     }
56:                 }
57:                 break;
58:             case 'MISTAKE':
59:                 break;
60:         }
61:     };
62: }
</file>

