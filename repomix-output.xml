<file path="src/domain/services/knowledge/ConstraintSolver.ts">
 1: import { UnixKnowledgeBase } from './UnixKnowledgeBase';
 2: import { CommandCapability } from '../../entities/knowledge/UnixCommandDefinition';
 3: export interface SolvedStep {
 4:     tool: string;
 5:     flags: string[];
 6:     reasoning: string;
 7: }
 8: export class ConstraintSolver {
 9:     constructor(private kb: UnixKnowledgeBase) {}
10:     public solveChain(capabilities: CommandCapability[], constraints: string[]): SolvedStep[] {
11:         const steps: SolvedStep[] = [];
12:         for (const cap of capabilities) {
13:             const tools = this.kb.findTools(cap);
14:             if (tools.length === 0) continue;
15:             let bestTool = tools[0];
16:             let bestMatchCount = -1;
17:             let bestFlags: string[] = [];
18:             for (const tool of tools) {
19:                 const applicableFlags = tool.flags.filter(f => constraints.includes(f.effect));
20:                 if (applicableFlags.length > bestMatchCount) {
21:                     bestMatchCount = applicableFlags.length;
22:                     bestTool = tool;
23:                     bestFlags = applicableFlags.map(f => f.name);
24:                 }
25:             }
26:             steps.push({
27:                 tool: bestTool.name,
28:                 flags: bestFlags,
29:                 reasoning: `Selected ${bestTool.name} to satisfy ${cap} with constraints: [${constraints.join(', ')}]`
30:             });
31:         }
32:         return steps;
33:     }
34: }
</file>

