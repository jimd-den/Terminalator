 93:         if (onKeyPressRef.current) onKeyPressRef.current('ENTER');
 94:         lastValue.current = ' ';
 95:         setInputValue(' ');
 96:     };
 97:     const handleKeyPressEvent = (e: any) => {
 98:         if (isLocked) return;
 99:         const key = e.nativeEvent.key;
100:         if (key === 'Enter') {
101:             fireEnter();
102:             return;
103:         }
104:         if (key.length > 1 && key !== 'Backspace') {
105:             if (onKeyPressRef.current) onKeyPressRef.current(key.toUpperCase());
106:         }
107:     };
108:     const setOnInput = useCallback((handler: (text: string) => void) => {
109:         onInputRef.current = handler;
110:     }, []);
111:     const handleSubmitEditing = () => {
112:         fireEnter();
113:     };
114:     const setOnKeyPress = useCallback((handler: (key: string) => void) => {
115:         onKeyPressRef.current = handler;
116:     }, []);
117:     return (
118:         <InputContext.Provider value={{ inputValue, refocus, setOnInput, setOnKeyPress, isLocked, setInputLocked }}>
119:             {}
120:             <TextInput
121:                 ref={inputRef}
122:                 style={{ position: 'absolute', width: 1, height: 1, opacity: 0, zIndex: -1 }}
123:                 value={inputValue}
124:                 onChangeText={handleTextChange}
125:                 onKeyPress={handleKeyPressEvent}
126:                 onSubmitEditing={handleSubmitEditing}
127:                 onBlur={handleBlur}
128:                 autoCapitalize="none"
129:                 autoCorrect={false}
130:                 autoFocus={true}
131:                 blurOnSubmit={false}
132:                 multiline={false}
133:                 caretHidden={true}
134:                 returnKeyType="done"
135:                 selection={{ start: inputValue.length, end: inputValue.length }}
136:             />
137:             {children}
138:         </InputContext.Provider>
139:     );
140: };
