15:             } else {
16:                 const latency = Math.floor(Math.random() * 200) + 10;
17:                 content += `[${timestamp}] 200 OK - /api/v1/status - latency=${latency}ms - user_agent="Mozilla/5.0"\n`;
18:             }
19:         }
20:         this.fsService.writeFile(path, content);
21:     }
22:     public populateUnitDatabase(path: string, count: number): void {
23:         let content = "UNIT_ID,NAME,ZONE,STATUS,LAST_SYNC\n";
24:         const zones = ['ZONE_A', 'ZONE_B', 'ZONE_C', 'ZONE_D'];
25:         for (let i = 0; i < count; i++) {
26:             const id = `UNIT-${100 + i}`;
27:             const zone = zones[Math.floor(Math.random() * zones.length)];
28:             const status = Math.random() > 0.3 ? 'BUSY' : 'IDLE';
