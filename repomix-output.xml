 1: import { IMasteryRepository, MasteryData } from '../../interfaces/IMasteryRepository';
 2: export type MasteryLevel = 'NOVICE' | 'COMPETENT' | 'MASTER';
 3: export class MasteryTracker {
 4:     private successCounts: Map<string, number> = new Map();
 5:     private failureCounts: Map<string, number> = new Map();
 6:     private repository?: IMasteryRepository;
 7:     private initialized: Promise<void>;
 8:     constructor(repository?: IMasteryRepository) {
 9:         this.repository = repository;
10:         this.initialized = this.load();
11:     }
12:     private async load() {
13:         if (this.repository) {
14:             const data = await this.repository.getMasteryData();
15:             this.successCounts = new Map(Object.entries(data.successCounts));
16:             this.failureCounts = new Map(Object.entries(data.failureCounts));
17:         }
18:     }
19:     private async save() {
20:         if (this.repository) {
21:             const data: MasteryData = {
22:                 successCounts: Object.fromEntries(this.successCounts),
23:                 failureCounts: Object.fromEntries(this.failureCounts)
24:             };
25:             await this.repository.saveMasteryData(data);
26:         }
27:     }
28:     async recordSuccess(command: string): Promise<void> {
29:         await this.initialized;
30:         const current = this.successCounts.get(command) || 0;
31:         this.successCounts.set(command, current + 1);
32:         await this.save();
33:     }
34:     async recordFailure(command: string): Promise<void> {
35:         await this.initialized;
36:         const current = this.failureCounts.get(command) || 0;
37:         this.failureCounts.set(command, current + 1);
38:         await this.save();
39:     }
40:     getLevel(command: string): MasteryLevel {
41:         const count = this.successCounts.get(command) || 0;
42:         if (count >= 15) return 'MASTER';
43:         if (count >= 5) return 'COMPETENT';
44:         return 'NOVICE';
45:     }
46:     getFailCount(command: string): number {
47:         return this.failureCounts.get(command) || 0;
48:     }
49: }
</file>

