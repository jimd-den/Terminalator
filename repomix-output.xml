  1: import { FileSystem } from './FileSystem';
  2: import { SimulationBus, GameEventType } from '../services/SimulationBus';
  3: export enum InputResult {
  4:     ACCEPTED = 'ACCEPTED',
  5:     REJECTED = 'REJECTED',
  6:     IGNORED = 'IGNORED'
  7: }
  8: export enum TutorEmotion {
  9:     NORMAL = 'NORMAL',
 10:     RESTLESS = 'RESTLESS',
 11:     MAD = 'MAD',
 12:     CRASH_OUT = 'CRASH_OUT'
 13: }
 14: export type TutorEventType = 'START' | 'STOP' | 'PROGRESS' | 'MISTAKE' | 'COMPLETE' | 'SPEED_WARNING' | 'EMOTION_CHANGE' | 'CORRECTION' | 'RHYTHM_START' | 'RHYTHM_STOP';
 15: export interface TutorEvent {
 16:     type: TutorEventType;
 17:     payload?: any;
 18: }
 19: export interface Lesson {
 20:     id: string;
 21:     text: string;
 22:     type: 'SHELL' | 'VIM_INSERT' | 'VIM_COMMAND';
 23:     instructions: string;
 24:     isMission?: boolean;
 25:     setup?: (fs: FileSystem) => void;
 26: }
 27: export interface RhythmStats {
 28:     totalHits: number;
 29:     perfectHits: number;
 30:     mistakes: number;
 31:     maxStreak: number;
 32:     accuracy: number;
 33:     totalZincMined: number;
 34: }
 35: export class TutorEngine {
 36:     private active: boolean = false;
 37:     private currentLesson: Lesson | null = null;
 38:     private progressIndex: number = 0;
 39:     private bpm: number = 120;
 40:     private nextBeatTime: number = 0;
 41:     private stats: RhythmStats = {
 42:         totalHits: 0,
 43:         perfectHits: 0,
 44:         mistakes: 0,
 45:         maxStreak: 0,
 46:         accuracy: 100,
 47:         totalZincMined: 0
 48:     };
 49:     private patience: number = 100;
 50:     private currentEmotion: TutorEmotion = TutorEmotion.NORMAL;
 51:     private consecutiveMistakes: number = 0;
 52:     private currentStreak: number = 0;
 53:     private startTime: number = 0;
 54:     private keystrokes: number[] = [];
 55:     private listeners: ((event: TutorEvent) => void)[] = [];
 56:     constructor(private bus?: SimulationBus) { }
 57:     public startLesson(lesson: Lesson): boolean {
 58:         if (!lesson) return false;
 59:         this.currentLesson = lesson;
 60:         this.progressIndex = 0;
 61:         this.active = true;
 62:         this.startTime = Date.now();
 63:         this.keystrokes = [];
 64:         this.patience = 100;
 65:         this.consecutiveMistakes = 0;
 66:         this.currentStreak = 0;
 67:         this.stats = {
 68:             totalHits: 0,
 69:             perfectHits: 0,
 70:             mistakes: 0,
 71:             maxStreak: 0,
 72:             accuracy: 100,
 73:             totalZincMined: 0
 74:         };
 75:         this.bpm = 120;
 76:         this.nextBeatTime = this.startTime + (60000 / this.bpm);
 77:         this.updateEmotion();
 78:         this.emit({ type: 'START', payload: { ...this.currentLesson, bpm: this.bpm } });
 79:         this.emit({ type: 'PROGRESS', payload: { index: 0, stats: this.stats } });
 80:         this.emit({ type: 'RHYTHM_START', payload: { bpm: this.bpm } });
 81:         return true;
 82:     }
 83:     public stop(): void {
 84:         this.active = false;
 85:         this.currentLesson = null;
 86:         this.patience = 100;
 87:         this.consecutiveMistakes = 0;
 88:         this.updateEmotion();
 89:         this.emit({ type: 'STOP' });
 90:         this.emit({ type: 'RHYTHM_STOP' });
 91:     }
 92:     public isActive(): boolean {
 93:         return this.active;
 94:     }
 95:     public getCurrentLesson(): Lesson | null {
 96:         return this.currentLesson;
 97:     }
 98:     public getGhostText(): string {
 99:         if (!this.currentLesson) return '';
100:         return this.currentLesson.text.substring(this.progressIndex);
101:     }
102:     public getCompletedText(): string {
103:         if (!this.currentLesson) return '';
104:         return this.currentLesson.text.substring(0, this.progressIndex);
105:     }
106:     public getEmotion(): TutorEmotion {
107:         return this.currentEmotion;
108:     }
109:     public getStats(): RhythmStats {
110:         return { ...this.stats };
111:     }
112:     /**
113:      * Core Rhythm Mechanic:
114:      * Handles a keystroke. If match, advance. If mismatch, rewind (penalty).
115:      */
116:     public handleInput(char: string): InputResult {
117:         if (!this.active || !this.currentLesson) return InputResult.IGNORED;
118:         const now = Date.now();
119:         const targetChar = this.currentLesson.text[this.progressIndex];
120:         // Rhythm Sync Check
121:         const beatInterval = 60000 / this.bpm;
122:         const timeSinceBeat = (now - this.startTime) % beatInterval;
123:         const isOnBeat = timeSinceBeat < 80 || timeSinceBeat > (beatInterval - 80);
124:         // 1. Check Exact Match
125:         if (char === targetChar) {
126:             this.progressIndex++;
127:             this.consecutiveMistakes = 0;
128:             this.currentStreak++;
129:             this.stats.totalHits++;
130:             if (isOnBeat) this.stats.perfectHits++;
131:             if (this.currentStreak > this.stats.maxStreak) this.stats.maxStreak = this.currentStreak;
132:             this.recoverPatience(2);
133:             this.updateAccuracy();
134:             this.emit({
135:                 type: 'PROGRESS',
136:                 payload: {
137:                     index: this.progressIndex,
138:                     isOnBeat,
139:                     char,
140:                     streak: this.currentStreak,
141:                     stats: this.stats
142:                 }
143:             });
144:             if (this.progressIndex >= this.currentLesson.text.length) {
145:                 this.completeLesson();
146:             }
147:             return InputResult.ACCEPTED;
148:         } else {
149:             this.consecutiveMistakes++;
150:             this.currentStreak = 0;
151:             this.stats.mistakes++;
152:             this.updateAccuracy();
153:             this.updateEmotion();
154:             if (this.consecutiveMistakes >= 3) {
155:                 this.damagePatience(30);
156:                 const penalty = 5;
157:                 const oldIndex = this.progressIndex;
158:                 this.progressIndex = Math.max(0, this.progressIndex - penalty);
159:                 this.emit({ type: 'MISTAKE', payload: { dropped: oldIndex - this.progressIndex, stats: this.stats } });
160:                 this.consecutiveMistakes = 0;
161:                 this.updateEmotion();
162:             } else {
163:                 this.damagePatience(10);
164:                 this.emit({ type: 'CORRECTION', payload: { expected: targetChar, actual: char, stats: this.stats } });
165:             }
166:             return InputResult.REJECTED;
167:         }
168:     }
169:     private updateAccuracy() {
170:         const total = this.stats.totalHits + this.stats.mistakes;
171:         this.stats.accuracy = total > 0 ? (this.stats.totalHits / total) * 100 : 100;
172:     }
173:     private damagePatience(amount: number) {
174:         this.patience = Math.max(0, this.patience - amount);
175:         this.updateEmotion();
176:     }
177:     private recoverPatience(amount: number) {
178:         this.patience = Math.min(100, this.patience + amount);
179:         this.updateEmotion();
180:     }
181:     private updateEmotion() {
182:         let newEmotion = TutorEmotion.NORMAL;
183:         if (this.consecutiveMistakes >= 3) newEmotion = TutorEmotion.CRASH_OUT;
184:         else if (this.consecutiveMistakes === 2) newEmotion = TutorEmotion.MAD;
185:         else {
186:             if (this.patience < 20) newEmotion = TutorEmotion.CRASH_OUT;
187:             else if (this.patience < 50) newEmotion = TutorEmotion.MAD;
188:             else if (this.patience < 80) newEmotion = TutorEmotion.RESTLESS;
189:         }
190:         if (newEmotion !== this.currentEmotion) {
191:             this.currentEmotion = newEmotion;
192:             this.emit({ type: 'EMOTION_CHANGE', payload: newEmotion });
193:         }
194:     }
195:     public setSessionZinc(amount: number) {
196:         this.stats.totalZincMined = amount;
197:     }
198:     private completeLesson() {
199:         this.active = false;
200:         this.patience = 100;
201:         this.consecutiveMistakes = 0;
202:         this.updateEmotion();
203:         const lesson = this.currentLesson;
204:         this.currentLesson = null;
205:         this.emit({ type: 'COMPLETE', payload: { lesson, stats: this.stats } });
206:     }
207:     public subscribe(listener: (event: TutorEvent) => void): () => void {
208:         this.listeners.push(listener);
209:         return () => {
210:             this.listeners = this.listeners.filter(l => l !== listener);
211:         };
212:     }
213:     public emit(event: TutorEvent) {
214:         this.listeners.forEach(l => l(event));
215:         if (this.bus) {
216:             this.bus.emit(GameEventType.TUTOR_EVENT, event);
217:         }
218:     }
219: }
</file>

