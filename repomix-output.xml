 1: import { ASTNode, NodeType, IfNode, ForNode, WhileNode, SubshellNode, BlockNode, FunctionDefNode, CommandNode, RedirectNode } from '../../interfaces/ShellAST';
 2: import { TokenType } from '../ShellLexer';
 3: import { IStatementParser } from './IStatementParser';
 4: import { IShellParserFacade } from './IShellParserFacade';
 5: export class SimpleCommandParser implements IStatementParser {
 6:     canHandle(facade: IShellParserFacade): boolean {
 7:         const token = facade.peek();
 8:         return token.type === TokenType.WORD || facade.isRedirect(token);
 9:     }
10:     parse(facade: IShellParserFacade): ASTNode {
11:         const token = facade.peek();
12:         if (token.value === '}') return null as any;
13:         const args: string[] = [];
14:         const redirects: RedirectNode[] = [];
15:         while (facade.peek().type === TokenType.WORD || facade.isRedirect(facade.peek())) {
16:             const t = facade.peek();
17:             if (args.length > 0 && t.type === TokenType.WORD && facade.isReservedWord(t.value)) {
18:                 break;
19:             }
20:             if (facade.isRedirect(t)) {
21:                 redirects.push(facade.parseRedirect());
22:             } else {
23:                 args.push(facade.advance().value);
24:             }
25:         }
26:         if (args.length === 0 && redirects.length === 0) return null as any;
27:         const cmdName = args.length > 0 ? args.shift()! : '';
28:         return {
29:             type: NodeType.COMMAND,
30:             command: cmdName,
31:             args: args,
32:             redirects: redirects
33:         } as CommandNode;
34:     }
35: }
</file>

