 8:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 9:         const input = getStdinAsString(context);
10:         if (args.length < 1) {
11:             return { output: 'gencat: missing output file', newState: state, exitCode: 1 };
12:         }
13:         const catFile = args[0];
14:         const inputFiles = args.slice(1);
15:         let catalogContent = '';
16:         if (inputFiles.length === 0) {
17:             // Read from stdin
18:             if (input) catalogContent = input;
19:         } else {
20:             for (const file of inputFiles) {
21:                 if (file === '-') {
22:                     if (input) catalogContent += input + '\n';
23:                     continue;
24:                 }
25:                 const content = this.fs.readFile(file, state.currentDirectory);
26:                 catalogContent += content + '\n';
27:             }
28:         }
29:         const lines = catalogContent.split('\n');
30:         for (const line of lines) {
31:             const trimmed = line.trim();
32:             if (trimmed.length === 0) continue;
33:             if (trimmed.startsWith('$')) continue;
34:             if (/^\d/.test(trimmed)) continue;
35:             return { output: 'gencat: invalid format', newState: state, exitCode: 1 };
36:         }
37:         this.fs.writeFile(catFile, catalogContent, 'w', 1000, 1000, state.currentDirectory);
38:         return { output: '', newState: state, exitCode: 0 };
39:     }
40: }
