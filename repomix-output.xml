<file path="src/domain/commands/core/CommCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { TerminalState } from '../../entities/TerminalState';
 5: import { CommandResponse } from '../../entities/Command';
 6: import { FileSystemService } from '../../services/FileSystemService';
 7: export class CommCommand implements ICommand {
 8:     constructor(private fs: FileSystemService) { }
 9:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
10:         const input = getStdinAsString(context);
11:         let suppress1 = false;
12:         let suppress2 = false;
13:         let suppress3 = false;
14:         let ignoreCase = false;
15:         const files: string[] = [];
16:         for (const arg of args) {
17:             if (arg.startsWith('-')) {
18:                 if (arg.includes('1')) suppress1 = true;
19:                 if (arg.includes('2')) suppress2 = true;
20:                 if (arg.includes('3')) suppress3 = true;
21:                 if (arg.includes('i')) ignoreCase = true;
22:             } else {
23:                 files.push(arg);
24:             }
25:         }
26:         if (files.length !== 2) {
27:             return { output: 'comm: missing operand', newState: state, exitCode: 1 };
28:         }
29:         try {
30:             const content1 = this.readFile(files[0], state, input);
31:             const content2 = this.readFile(files[1], state, input);
32:             const lines1 = content1.split('\n');
33:             const lines2 = content2.split('\n');
34:             if (lines1.length > 0 && lines1[lines1.length - 1] === '') lines1.pop();
35:             if (lines2.length > 0 && lines2[lines2.length - 1] === '') lines2.pop();
36:             let i = 0;
37:             let j = 0;
38:             const output: string[] = [];
39:             let exitCode = 0;
40:             const cmp = (a: string, b: string) => {
41:                 if (ignoreCase) return a.toLowerCase().localeCompare(b.toLowerCase());
42:                 return a.localeCompare(b);
43:             };
44:             // POSIX says results undefined if unsorted, but typically doesn't error out hard unless requested.
45:             while (i < lines1.length || j < lines2.length) {
46:                 const l1 = i < lines1.length ? lines1[i] : null;
47:                 const l2 = j < lines2.length ? lines2[j] : null;
48:                 let comp = 0;
49:                 if (l1 === null) comp = 1;
50:                 else if (l2 === null) comp = -1;
51:                 else comp = cmp(l1, l2);
52:                 if (comp < 0) {
53:                     if (!suppress1) output.push(l1!);
54:                     i++;
55:                 } else if (comp > 0) {
56:                     if (!suppress2) {
57:                         let prefix = '';
58:                         if (!suppress1) prefix = '\t';
59:                         output.push(prefix + l2!);
60:                     }
61:                     j++;
62:                 } else {
63:                     if (!suppress3) {
64:                         let prefix = '';
65:                         if (!suppress1) prefix += '\t';
66:                         if (!suppress2) prefix += '\t';
67:                         output.push(prefix + l1!);
68:                     }
69:                     i++;
70:                     j++;
71:                 }
72:             }
73:             return {
74:                 output: output.join('\n'),
75:                 newState: state,
76:                 exitCode: exitCode
77:             };
78:         } catch (e: any) {
79:             if (e.message.includes('No such file')) {
80:                 return { output: `comm: ${files.join(' ')}: No such file or directory`, newState: state, exitCode: 1 };
81:             }
82:             return {
83:                 output: `comm: error: ${e.message}`,
84:                 newState: state,
85:                 exitCode: 1
86:             };
87:         }
88:     }
89:     private readFile(pathStr: string, state: TerminalState, input?: string): string {
90:         if (pathStr === '-') return input || '';
91:         const path = this.resolvePath(pathStr, state);
92:         return this.fs.readFile(path);
93:     }
94:     private resolvePath(path: string, state: TerminalState): string {
95:         if (path.startsWith('/')) return path;
96:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
97:     }
98: }
</file>

