 1: import { Mission } from '../entities/Mission';
 2: import { IWorldManager } from '../interfaces/IWorldManager';
 3: import { FileSystemService } from './FileSystemService';
 4: export class MissionPopulator {
 5:     constructor(private worldManager: IWorldManager) {}
 6:     public populateMissionObjectives(mission: Mission): void {
 7:         const host = mission.targetSystem;
 8:         const fsService = (this.worldManager as any).getHostFileSystem(host) as FileSystemService;
 9:         if (!fsService) {
10:             console.warn(`[MissionPopulator] Warning: Target host ${host} not found for mission ${mission.id}`);
11:             return;
12:         }
13:         const targetPath = `/var/log/${mission.objectiveTarget}`;
14:         fsService.mkdirp('/var/log');
15:         const searchTerm = mission.metadata?.searchTerm;
16:         if (mission.description.includes('unsorted')) {
17:             const content = this.generateUnsortedData(mission.problemSize || 100, searchTerm);
18:             fsService.writeFile(targetPath, content);
19:         }
20:         else if (mission.description.includes('sorted')) {
21:             const content = this.generateSortedData(mission.problemSize || 1000, searchTerm);
22:             fsService.writeFile(targetPath, content);
23:         }
24:         else {
25:             const content = searchTerm ? `MISSION_CRITICAL_DATA: ${searchTerm}\n` : 'DATA_PAYLOAD_ENCRYPTED_...';
26:             fsService.writeFile(targetPath, content);
27:         }
28:     }
29:     private generateUnsortedData(size: number, searchTerm?: string): string {
30:         const lines = [];
31:         for (let i = 0; i < size; i++) {
32:             lines.push(`ID-${Math.floor(Math.random() * 99999)}: DATA-${i}`);
33:         }
34:         if (searchTerm) {
35:             const pos = Math.floor(Math.random() * lines.length);
36:             lines[pos] = `ID-${searchTerm}: TARGET_RECORD_DATA`;
37:         }
38:         return lines.join('\n');
39:     }
40:     private generateSortedData(size: number, searchTerm?: string): string {
41:         const lines = [];
42:         for (let i = 0; i < size; i++) {
43:             const id = String(i).padStart(5, '0');
44:             lines.push(`ID-${id}: RECORD-${i}`);
45:         }
46:         if (searchTerm) {
47:             const pos = Math.floor(size / 2);
48:             lines[pos] = `ID-${searchTerm}: TARGET_RECORD_DATA`;
49:         }
50:         return lines.join('\n');
51:     }
52: }
