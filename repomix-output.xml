 30:         simulationMediator
 31:     );
 32:     const archiveService = useMemo(() => new ArchiveService(), []);
 33:     const hintService = useMemo(() => new HintService(), []);
 34:     const [buffers, setBuffers] = useState<CapturedBuffer[]>([]);
 35:     const saveToArchive = useCallback((index: number) => {
 36:         archiveService.recordFromOutput(
 37:             index,
 38:             shellVM.outputLines,
 39:             shellVM.fsContext || 'LOCAL'
 40:         );
 41:         setBuffers(archiveService.getAll());
 42:     }, [shellVM.outputLines, archiveService, shellVM.fsContext]);
 43:     const toggleBufferView = useCallback(() => {
 44:         setActiveView(prev => prev === 'BUFFERS' ? 'SHELL' : 'BUFFERS');
 45:     }, []);
 46:     const toggleCommsView = useCallback(() => {
 47:         setActiveView(prev => prev === 'COMMS' ? 'SHELL' : 'COMMS');
 48:         if (activeView !== 'COMMS' && !missionVM.ircMissionId) {
 49:             const active = missionVM.missions.find(m => m.status === 'active');
 50:             missionVM.setIrcMissionId(active ? active.id : (missionVM.missions[0]?.id || null));
 51:         }
 52:     }, [activeView, missionVM.ircMissionId, missionVM.missions, missionVM.setIrcMissionId]);
 53:     const resetInactivityTimer = useCallback(() => {
 54:         lastActivityRef.current = Date.now();
 55:         if (contextualHint) setContextualHint(null);
 56:     }, [contextualHint]);
 57:     useEffect(() => {
 58:         const interval = setInterval(() => {
 59:             const idleTime = Date.now() - lastActivityRef.current;
 60:             if (idleTime > 15000 && !contextualHint) {
 61:                 const hint = hintService.getHint(
 62:                     missionVM.missions,
 63:                     gameManager.tutorEngine.isActive(),
 64:                     !!shellVM.fsContext
 65:                 );
