140:             uid: inode.uid,
141:             gid: inode.gid,
142:             mtime: inode.mtime,
143:             atime: inode.atime,
144:             ctime: inode.ctime,
145:             isDirectory: (inode.mode & S_IFDIR) === S_IFDIR,
146:             isFile: (inode.mode & S_IFREG) === S_IFREG,
