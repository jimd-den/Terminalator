<file path="src/interface-adapters/controllers/OutputController.ts">
  1: import { useState, useCallback } from 'react';
  2: export interface TerminalOutputLine {
  3:     text: string;
  4:     type: 'input' | 'output' | 'system';
  5:     exitCode?: number;
  6:     pending?: boolean;
  7:     isMinimized?: boolean;
  8:     isDeleted?: boolean;
  9:     timestamp?: number;
 10:     metadata?: {
 11:         renderType?: 'ls-pretty' | 'system-alert' | 'fish-style';
 12:         data?: any;
 13:     };
 14: }
 15: export interface OutputControllerState {
 16:     outputLines: TerminalOutputLine[];
 17:     renderedLineCount: number;
 18: }
 19: export interface OutputControllerActions {
 20:     appendInput: (command: string, exitCode?: number, pending?: boolean) => void;
 21:     updateInputStatus: (index: number, exitCode: number, pending: boolean) => void;
 22:     appendOutput: (text: string, metadata?: any) => void;
 23:     appendSystemMessage: (text: string) => void;
 24:     appendLine: (line: TerminalOutputLine) => void;
 25:     toggleMinimize: (index: number) => void;
 26:     deleteGroup: (index: number) => void;
 27:     clear: () => void;
 28:     getLineCount: () => number;
 29:     markLineComplete: () => void;
 30: }
 31: const INITIAL_OUTPUT: TerminalOutputLine[] = [
 32:     { text: 'MAINFRAME v1.0 CONNECTION ESTABLISHED', type: 'system', timestamp: Date.now() },
 33:     { text: 'AWAITING COMMAND INPUT...', type: 'system', timestamp: Date.now() },
 34: ];
 35: export const useOutputController = (): OutputControllerState & OutputControllerActions => {
 36:     const [outputLines, setOutputLines] = useState<TerminalOutputLine[]>(INITIAL_OUTPUT);
 37:     const [renderedLineCount, setRenderedLineCount] = useState(INITIAL_OUTPUT.length);
 38:     const appendInput = useCallback((command: string, exitCode?: number, pending?: boolean) => {
 39:         setOutputLines(prev => [
 40:             ...prev,
 41:             {
 42:                 text: `> ${command}`,
 43:                 type: 'input',
 44:                 exitCode,
 45:                 pending,
 46:                 timestamp: Date.now()
 47:             }
 48:         ]);
 49:     }, []);
 50:     const updateInputStatus = useCallback((index: number, exitCode: number, pending: boolean) => {
 51:         setOutputLines(prev => {
 52:             const next = [...prev];
 53:             if (next[index] && next[index].type === 'input') {
 54:                 next[index] = { ...next[index], exitCode, pending };
 55:             }
 56:             return next;
 57:         });
 58:     }, []);
 59:     const appendOutput = useCallback((text: string, metadata?: any) => {
 60:         setOutputLines(prev => [
 61:             ...prev,
 62:             {
 63:                 text: text || '', // Allow empty for blank lines
 64:                 type: 'output',
 65:                 metadata,
 66:                 timestamp: Date.now()
 67:             }
 68:         ]);
 69:     }, []);
 70:     const appendSystemMessage = useCallback((text: string) => {
 71:         setOutputLines(prev => [
 72:             ...prev,
 73:             {
 74:                 text,
 75:                 type: 'system',
 76:                 timestamp: Date.now()
 77:             }
 78:         ]);
 79:     }, []);
 80:     const appendLine = useCallback((line: TerminalOutputLine) => {
 81:         setOutputLines(prev => [...prev, { ...line, timestamp: line.timestamp || Date.now() }]);
 82:         if (line.type === 'input') {
 83:             setRenderedLineCount(prev => prev + 1);
 84:         }
 85:     }, []);
 86:     const clear = useCallback(() => {
 87:         setOutputLines([]);
 88:         setRenderedLineCount(0);
 89:     }, []);
 90:     const getLineCount = useCallback(() => {
 91:         return outputLines.length;
 92:     }, [outputLines.length]);
 93:     const toggleMinimize = useCallback((index: number) => {
 94:         setOutputLines(prev => {
 95:             const next = [...prev];
 96:             if (next[index] && next[index].type === 'input') {
 97:                 next[index] = { ...next[index], isMinimized: !next[index].isMinimized };
 98:             }
 99:             return next;
100:         });
101:     }, []);
102:     const deleteGroup = useCallback((index: number) => {
103:         setOutputLines(prev => {
104:             const next = [...prev];
105:             if (next[index] && next[index].type === 'input') {
106:                 next[index] = { ...next[index], isDeleted: true };
107:                 for (let i = index + 1; i < next.length; i++) {
108:                     if (next[i].type === 'input') break;
109:                     next[i] = { ...next[i], isDeleted: true };
110:                 }
111:             }
112:             return next;
113:         });
114:     }, []);
115:     const markLineComplete = useCallback(() => {
116:         setRenderedLineCount(prev => prev + 1);
117:     }, []);
118:     return {
119:         outputLines,
120:         renderedLineCount,
121:         appendInput,
122:         updateInputStatus,
123:         appendOutput,
124:         appendSystemMessage,
125:         appendLine,
126:         toggleMinimize,
127:         deleteGroup,
128:         clear,
129:         getLineCount,
130:         markLineComplete
131:     };
132: };
</file>

<file path="src/interface-adapters/controllers/VimInputController.ts">
 1: import { useState, useCallback } from 'react';
 2: import { VimSimulator } from '../VimSimulator';
 3: import { VimState, VimMode } from '../../domain/entities/VimEngine';
 4: import { TutorEngine } from '../../domain/entities/TutorEngine';
 5: import { TutorShadow } from '../../domain/services/tutor/TutorShadow';
 6: export interface VimInputControllerState {
 7:     state: VimState & { lines: string[] };
 8:     commandInput: string;
 9: }
10: export interface VimInputControllerActions {
11:     handleVirtualKey: (key: string) => void;
12:     handleCommandSubmit: () => boolean;
13:     resetCommandInput: () => void;
14: }
15: export const useVimInputController = (
16:     simulator: VimSimulator,
17:     onExit: () => void,
18:     tutorEngine: TutorEngine,
19:     tutorShadow: TutorShadow
20: ): VimInputControllerState & VimInputControllerActions => {
21:     const [state, setState] = useState(simulator.getSnapshot());
22:     const [commandInput, setCommandInput] = useState('');
23:     /**
24:      * Handles command-line mode submission (:w, :q, etc.)
25:      * Returns true if vim should exit.
26:      */
27:     const handleCommandSubmit = useCallback((): boolean => {
28:         const { exit, message } = simulator.executeCommand(commandInput);
29:         if (exit) {
30:             onExit();
31:             return true;
32:         } else {
33:             const nextState = simulator.getSnapshot();
34:             nextState.statusMessage = message;
35:             setState(nextState);
36:             setCommandInput('');
37:             return false;
38:         }
39:     }, [commandInput, onExit, simulator]);
40:     /**
41:      * Resets command input buffer.
42:      */
43:     const resetCommandInput = useCallback(() => {
44:         setCommandInput('');
45:     }, []);
46:     /**
47:      * Main key handler - routes keys based on mode.
48:      */
49:     const handleVirtualKey = useCallback((key: string) => {
50:         // -- TUTOR SHADOW INTERCEPTION (GATING) --
51:         const allowed = tutorShadow.intercept(key, 'VIM');
52:         if (!allowed) return;
53:         if (key === 'BACKSPACE') {
54:             if (state.mode === 'COMMAND') {
55:                 if (commandInput.length > 0) {
56:                     setCommandInput(prev => prev.slice(0, -1));
57:                 } else {
58:                     simulator.handleInput('ESC');
59:                     setState(simulator.getSnapshot());
60:                 }
61:                 return;
62:             }
63:             setState(simulator.handleInput('BACKSPACE'));
64:             return;
65:         }
66:         if (state.mode === 'COMMAND') {
67:             if (key === 'ESC') {
68:                 simulator.handleInput('ESC');
69:                 setState(simulator.getSnapshot());
70:                 setCommandInput('');
71:                 return;
72:             }
73:             if (key === 'ENTER') {
74:                 handleCommandSubmit();
75:                 return;
76:             }
77:             if (key.length === 1) {
78:                 setCommandInput(prev => prev + key);
79:             }
80:             return;
81:         }
82:         if (state.mode === 'NORMAL' && key === ':') {
83:             setCommandInput(':');
84:         }
85:         setState(simulator.handleInput(key));
86:     }, [state.mode, commandInput, simulator, handleCommandSubmit, tutorEngine]);
87:     return {
88:         state,
89:         commandInput,
90:         handleVirtualKey,
91:         handleCommandSubmit,
92:         resetCommandInput
93:     };
94: };
</file>

<file path="src/interface-adapters/controllers/VimTutorController.ts">
 1: import { useState, useEffect } from 'react';
 2: import { TutorEngine } from '../../domain/entities/TutorEngine';
 3: export interface VimTutorState {
 4:     active: boolean;
 5:     text: string;
 6:     completed: string;
 7: }
 8: export const useVimTutorController = (tutorEngine: TutorEngine): VimTutorState => {
 9:     const [tutorState, setTutorState] = useState<VimTutorState>({
10:         active: false,
11:         text: '',
12:         completed: ''
13:     });
14:     useEffect(() => {
15:         // If tutor is not active, clear state
16:         if (!tutorEngine.isActive()) {
17:             setTutorState({ active: false, text: '', completed: '' });
18:             return;
19:         }
20:         const updateTutor = () => {
21:             setTutorState({
22:                 active: tutorEngine.isActive(),
23:                 text: tutorEngine.getGhostText(),
24:                 completed: tutorEngine.getCompletedText()
25:             });
26:         };
27:         updateTutor();
28:         const unsubscribe = tutorEngine.subscribe(() => {
29:             updateTutor();
30:         });
31:         return unsubscribe;
32:     }, [tutorEngine]);
33:     return tutorState;
34: };
</file>

