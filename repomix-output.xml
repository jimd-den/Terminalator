<file path="src/domain/commands/core/TsortCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class TsortCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         const file = args.find(a => !a.startsWith('-'));
13:         let content = '';
14:         if (file) {
15:             try {
16:                 content = this.fs.readFile(this.resolvePath(file, state));
17:             } catch (e) {
18:                 return { output: `tsort: ${file}: No such file`, newState: state, exitCode: 1 };
19:             }
20:         } else if (input) {
21:             content = input;
22:         } else {
23:             return { output: '', newState: state, exitCode: 0 };
24:         }
25:         const items = content.trim().split(/\s+/).filter(x => x);
26:         if (items.length % 2 !== 0) {
27:             return { output: 'tsort: odd input', newState: state, exitCode: 1 };
28:         }
29:         const adj = new Map<string, string[]>();
30:         const inDegree = new Map<string, number>();
31:         const nodes = new Set<string>();
32:         for (let i = 0; i < items.length; i += 2) {
33:             const u = items[i];
34:             const v = items[i + 1];
35:             nodes.add(u);
36:             nodes.add(v);
37:             if (!adj.has(u)) adj.set(u, []);
38:             adj.get(u)!.push(v);
39:             if (!inDegree.has(v)) inDegree.set(v, 0);
40:             if (!inDegree.has(u)) inDegree.set(u, 0);
41:             inDegree.set(v, (inDegree.get(v) || 0) + 1);
42:         }
43:         const queue: string[] = [];
44:         const result: string[] = [];
45:         for (const node of nodes) {
46:             if ((inDegree.get(node) || 0) === 0) {
47:                 queue.push(node);
48:             }
49:         }
50:         queue.sort();
51:         while (queue.length > 0) {
52:             const u = queue.shift()!;
53:             result.push(u);
54:             const neighbors = adj.get(u) || [];
55:             for (const v of neighbors) {
56:                 inDegree.set(v, (inDegree.get(v) || 0) - 1);
57:                 if (inDegree.get(v) === 0) {
58:                     queue.push(v);
59:                 }
60:             }
61:             queue.sort();
62:         }
63:         if (result.length !== nodes.size) {
64:             for (const node of nodes) {
65:                 if (!result.includes(node)) {
66:                     result.push(node);
67:                 }
68:             }
69:         }
70:         return {
71:             output: result.join('\n'),
72:             newState: state,
73:             exitCode: 0
74:         };
75:     }
76:     private resolvePath(path: string, state: TerminalState): string {
77:         if (path.startsWith('/')) return path;
78:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
79:     }
80: }
</file>

