122:         let negated = false;
123:         if (src.startsWith('!')) { negated = true; src = src.slice(1).trim(); }
124:         const funcChar = src[0];
125:         if (!funcChar) return { addresses, function: '#', arguments: {}, negated: false };
126:         const argsStr = src.slice(1).trim();
