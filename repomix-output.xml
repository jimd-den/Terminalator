<file path="src/domain/commands/core/TimeoutCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class TimeoutCommand implements ICommand {
 9:     constructor(
10:         private fs: FileSystemService,
11:         private commandProvider: (name: string) => ICommand | undefined
12:     ) { }
13:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
14:         const input = getStdinAsString(context);
15:         if (args.length < 2) {
16:             return { output: 'timeout: missing operand', newState: state, exitCode: 125 };
17:         }
18:         const durationStr = args[0];
19:         const cmdName = args[1];
20:         const cmdArgs = args.slice(2);
21:         let duration = parseFloat(durationStr);
22:         const lastChar = durationStr.slice(-1);
23:         if (['s', 'm', 'h', 'd'].includes(lastChar)) {
24:             duration = parseFloat(durationStr.slice(0, -1));
25:             if (lastChar === 'm') duration *= 60;
26:             if (lastChar === 'h') duration *= 3600;
27:             if (lastChar === 'd') duration *= 86400;
28:         }
29:         if (isNaN(duration)) {
30:             return { output: `timeout: invalid time interval '${durationStr}'`, newState: state, exitCode: 125 };
31:         }
32:         const timeoutMs = duration * 1000;
33:         const command = this.commandProvider(cmdName);
34:         if (!command) {
35:             return { output: `timeout: failed to run command '${cmdName}': No such file or directory`, newState: state, exitCode: 127 };
36:         }
37:         const timeoutPromise = new Promise<CommandResponse>((resolve) => {
38:             setTimeout(() => {
39:                 resolve({
40:                     output: '',
41:                     newState: state,
42:                     exitCode: 124
43:                 });
44:             }, timeoutMs);
45:         });
46:         const executionPromise = command.execute(cmdArgs, context, state);
47:         return Promise.race([executionPromise, timeoutPromise]);
48:     }
49: }
</file>

