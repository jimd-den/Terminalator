 1: import { ASTNode, NodeType, IfNode, ForNode, WhileNode, SubshellNode, BlockNode, FunctionDefNode, CommandNode, RedirectNode } from '../../interfaces/ShellAST';
 2: import { TokenType } from '../ShellLexer';
 3: import { IStatementParser } from './IStatementParser';
 4: import { IShellParserFacade } from './IShellParserFacade';
 5: export class ForParser implements IStatementParser {
 6:     canHandle(facade: IShellParserFacade): boolean {
 7:         const token = facade.peek();
 8:         return token.type === TokenType.WORD && token.value === 'for';
 9:     }
10:     parse(facade: IShellParserFacade): ASTNode {
11:         facade.advance();
12:         const nameToken = facade.advance();
13:         if (nameToken.type !== TokenType.WORD) {
14:             throw new Error(`Syntax Error: Expected variable name after 'for' at position ${nameToken.position}`);
15:         }
16:         let items: string[] = [];
17:         if (facade.peek().value === 'in') {
18:             facade.advance();
19:             while (facade.peek().type === TokenType.WORD && !facade.isReservedWord(facade.peek().value)) {
20:                 items.push(facade.advance().value);
21:             }
22:             if (facade.peek().type === TokenType.SEMI || facade.peek().type === TokenType.NEWLINE) {
23:                 facade.advance();
24:             }
25:         }
26:         while (facade.peek().type === TokenType.NEWLINE || facade.peek().type === TokenType.SEMI) {
27:             facade.advance();
28:         }
29:         if (facade.peek().value !== 'do') {
30:             throw new Error(`Syntax Error: Expected 'do' at position ${facade.peek().position}`);
31:         }
32:         facade.advance();
33:         const body = facade.parseList();
34:         while (facade.peek().type === TokenType.NEWLINE || facade.peek().type === TokenType.SEMI) {
35:             facade.advance();
36:         }
37:         if (facade.peek().value !== 'done') {
38:             throw new Error(`Syntax Error: Expected 'done' at position ${facade.peek().position}`);
39:         }
40:         facade.advance();
41:         return {
42:             type: NodeType.FOR,
43:             variable: nameToken.value,
44:             items: items,
45:             body: body!
46:         } as ForNode;
47:     }
48: }
