  1: import { IAwkVisitor } from './IAwkVisitor';
  2: import { AwkRuntimeEnvironment } from './AwkRuntimeEnvironment';
  3: import {
  4:     ASTNode, ProgramNode, BlockNode, PatternActionNode,
  5:     PrintStatementNode, ExprStatementNode, IfStatementNode,
  6:     BinaryExpressionNode, UnaryExpressionNode, LiteralNode, VariableNode,
  7:     FieldAccessNode, AssignExpressionNode
  8: } from './AwkParser';
  9: export class AwkExecutionVisitor implements IAwkVisitor {
 10:     private env: AwkRuntimeEnvironment;
 11:     private outputBuffer: string[] = [];
 12:     constructor(env: AwkRuntimeEnvironment) {
 13:         this.env = env;
 14:     }
 15:     public getOutput(): string {
 16:         return this.outputBuffer.join('\n');
 17:     }
 18:     public clearOutput() {
 19:         this.outputBuffer = [];
 20:     }
 21:     public visit(node: ASTNode): any {
 22:         switch (node.type) {
 23:             case 'Program': return this.visitProgram(node as ProgramNode);
 24:             case 'Block': return this.visitBlock(node as BlockNode);
 25:             case 'PatternAction': return this.visitPatternAction(node as PatternActionNode);
 26:             case 'Print': return this.visitPrint(node as PrintStatementNode);
 27:             case 'ExprStmt': return this.visitExprStmt(node as ExprStatementNode);
 28:             case 'If': return this.visitIf(node as IfStatementNode);
 29:             case 'Binary': return this.visitBinary(node as BinaryExpressionNode);
 30:             case 'Unary': return this.visitUnary(node as UnaryExpressionNode);
 31:             case 'Literal': return this.visitLiteral(node as LiteralNode);
 32:             case 'Variable': return this.visitVariable(node as VariableNode);
 33:             case 'FieldAccess': return this.visitFieldAccess(node as FieldAccessNode);
 34:             case 'Assign': return this.visitAssign(node as AssignExpressionNode);
 35:             default:
 36:                 throw new Error(`Unknown node type: ${node.type}`);
 37:         }
 38:     }
 39:     visitProgram(node: ProgramNode): void {
 40:         throw new Error("Program node handled by Interpreter main loop generally, but if visited:");
 41:     }
 42:     visitBlock(node: BlockNode): void {
 43:         for (const stmt of node.statements) {
 44:             this.visit(stmt);
 45:         }
 46:     }
 47:     visitPatternAction(node: PatternActionNode): void {
 48:         if (!node.pattern || this.toBoolean(this.visit(node.pattern))) {
 49:             this.visit(node.action);
 50:         }
 51:     }
 52:     visitPrint(node: PrintStatementNode): void {
 53:         let line = '';
 54:         if (node.args.length === 0) {
 55:             line = this.env.getField(0);
 56:         } else {
 57:             line = node.args.map(arg => String(this.visit(arg))).join(this.env.OFS);
 58:         }
 59:         this.outputBuffer.push(line);
 60:     }
 61:     visitExprStmt(node: ExprStatementNode): void {
 62:         this.visit(node.expr);
 63:     }
 64:     visitIf(node: IfStatementNode): void {
 65:         if (this.toBoolean(this.visit(node.condition))) {
 66:             this.visit(node.thenBranch);
 67:         } else if (node.elseBranch) {
 68:             this.visit(node.elseBranch);
 69:         }
 70:     }
 71:     // --- Expressions ---
 72:     visitBinary(node: BinaryExpressionNode): any {
 73:         const left = this.visit(node.left);
 74:         const right = this.visit(node.right);
 75:         const op = node.op;
 76:         switch (op) {
 77:             case '+': return Number(left) + Number(right);
 78:             case '-': return Number(left) - Number(right);
 79:             case '*': return Number(left) * Number(right);
 80:             case '/': return Number(left) / Number(right);
 81:             case '%': return Number(left) % Number(right);
 82:             case '==': return left == right ? 1 : 0;
 83:             case '!=': return left != right ? 1 : 0;
 84:             case '<': return Number(left) < Number(right) ? 1 : 0;
 85:             case '>': return Number(left) > Number(right) ? 1 : 0;
 86:             case '<=': return Number(left) <= Number(right) ? 1 : 0;
 87:             case '>=': return Number(left) >= Number(right) ? 1 : 0;
 88:             case '&&': return (this.toBoolean(left) && this.toBoolean(right)) ? 1 : 0;
 89:             case '||': return (this.toBoolean(left) || this.toBoolean(right)) ? 1 : 0;
 90:             case 'concat': return String(left) + String(right);
 91:             case '~': {
 92:                 const pattern = right instanceof RegExp ? right : new RegExp(String(right));
 93:                 return pattern.test(String(left)) ? 1 : 0;
 94:             }
 95:             case '!~': {
 96:                 const pattern = right instanceof RegExp ? right : new RegExp(String(right));
 97:                 return !pattern.test(String(left)) ? 1 : 0;
 98:             }
 99:             default: return 0;
100:         }
101:     }
102:     visitUnary(node: UnaryExpressionNode): any {
103:         const val = this.visit(node.operand);
104:         switch (node.op) {
105:             case '-': return -Number(val);
106:             case '+': return Number(val);
107:             case '!': return this.toBoolean(val) ? 0 : 1;
108:             default: return 0;
109:         }
110:     }
111:     visitLiteral(node: LiteralNode): any {
112:         if (node.valueType === 'regex') {
113:             return new RegExp(String(node.value));
114:         }
115:         return node.value;
116:     }
117:     visitVariable(node: VariableNode): any {
118:         return this.env.getVar(node.name);
119:     }
120:     visitFieldAccess(node: FieldAccessNode): any {
121:         const index = Number(this.visit(node.index));
122:         return this.env.getField(index);
123:     }
124:     visitAssign(node: AssignExpressionNode): any {
125:         const val = this.visit(node.right);
126:         if (node.left.type === 'Variable') {
127:             const vNode = node.left as VariableNode;
128:             this.env.setVar(vNode.name, val);
129:         } else if (node.left.type === 'FieldAccess') {
130:             const fNode = node.left as FieldAccessNode;
131:             const index = Number(this.visit(fNode.index));
132:             this.env.setField(index, val);
133:         }
134:         return val;
135:     }
136:     private toBoolean(val: any): boolean {
137:         if (val instanceof RegExp) {
138:             return val.test(this.env.getField(0));
139:         }
140:         if (typeof val === 'number') return val !== 0;
141:         if (typeof val === 'string') return val.length > 0;
142:         return !!val;
143:     }
144: }
