<file path="src/domain/usecases/vim/VimInputHandler.ts">
 1: import { IVimState } from '../../entities/vim/IVimState';
 2: import { IVimBuffer } from '../../entities/vim/IVimBuffer';
 3: import { VimStateEntity } from '../../entities/vim/VimStateEntity';
 4: import { IVimMode } from './IVimMode';
 5: import { NormalMode } from './modes/NormalMode';
 6: import { InsertMode } from './modes/InsertMode';
 7: import { CommandMode } from './modes/CommandMode';
 8: import { VimCommandManager } from './VimCommandManager';
 9: export class VimInputHandler {
10:     private modes: Map<string, IVimMode> = new Map();
11:     constructor() {
12:         this.modes.set('NORMAL', new NormalMode());
13:         this.modes.set('INSERT', new InsertMode());
14:         this.modes.set('COMMAND', new CommandMode());
15:     }
16:     public handleKey(key: string, state: IVimState, buffer: IVimBuffer, commands: VimCommandManager): IVimState {
17:         const nextState = (state as VimStateEntity).clone
18:             ? (state as VimStateEntity).clone()
19:             : new VimStateEntity(state.mode, { ...state.cursor }, state.pendingAction, state.statusMessage, [...state.lintErrors], state.isLocked || false);
20:         if (nextState.isLocked) return nextState;
21:         if (['SHIFT', 'CONTROL', 'ALT', 'META'].includes(key.toUpperCase())) return nextState;
22:         if (key === 'ESC') {
23:             nextState.mode = 'NORMAL';
24:             nextState.pendingAction = null;
25:             nextState.statusMessage = '';
26:             this.clampCursor(nextState, buffer);
27:             return nextState;
28:         }
29:         // 4. Delegate to Strategy (State Pattern)
30:         const modeStrategy = this.modes.get(nextState.mode);
31:         if (modeStrategy) {
32:             const result = modeStrategy.handleKey(key, nextState, buffer, commands);
33:             // Handle Mode Transition
34:             if (result && result !== nextState.mode) {
35:                 nextState.mode = result as any;
36:                 this.updateStatusForMode(nextState);
37:             }
38:         }
39:         // 5. Post-process (Invariant enforcement)
40:         this.clampCursor(nextState, buffer);
41:         return nextState;
42:     }
43:     private updateStatusForMode(state: IVimState): void {
44:         switch (state.mode) {
45:             case 'NORMAL':
46:                 state.statusMessage = '';
47:                 break;
48:             case 'INSERT':
49:                 state.statusMessage = '-- INSERT --';
50:                 break;
51:             case 'COMMAND':
52:                 state.statusMessage = ':';
53:                 break;
54:         }
55:     }
56:     private clampCursor(state: IVimState, buffer: IVimBuffer): void {
57:         const lineCount = buffer.length;
58:         if (state.cursor.line < 0) state.cursor.line = 0;
59:         if (state.cursor.line >= lineCount) state.cursor.line = lineCount - 1;
60:         const line = buffer.getLine(state.cursor.line);
61:         const lineLen = line.length;
62:         const maxCol = state.mode === 'INSERT' ? lineLen : Math.max(0, lineLen - 1);
63:         if (state.cursor.col < 0) state.cursor.col = 0;
64:         if (state.cursor.col > maxCol) state.cursor.col = maxCol;
65:     }
66: }
</file>

