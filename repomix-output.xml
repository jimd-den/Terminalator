<file path="src/domain/commands/core/YaccCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand, CommandResponse } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: export class YaccCommand implements ICommand {
 7:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 8:         const input = getStdinAsString(context);
 9:         let file = '';
10:         let prefix = 'y';
11:         let header = false;
12:         let graph = false;
13:         for (let i = 0; i < args.length; i++) {
14:             if (args[i] === '-d') header = true;
15:             else if (args[i] === '-g') graph = true;
16:             else if (args[i] === '-b') {
17:                 if (i + 1 < args.length) prefix = args[++i];
18:             } else if (!args[i].startsWith('-')) {
19:                 file = args[i];
20:             }
21:         }
22:         if (!file) {
23:             return { output: 'yacc: no input file', newState: state, exitCode: 1 };
24:         }
25:         const fs = context.fileSystemService;
26:         const node = fs.resolve(file, state.currentDirectory);
27:         if (!node || fs.isDirectory(node)) {
28:             return { output: `yacc: ${file}: No such file or directory`, newState: state, exitCode: 1 };
29:         }
30:         const cCode = `
31: #include <stdio.h>
32: int yyparse(void) { return 0; }
33:         `;
34:         const hCode = `#ifndef _Y_TAB_H\n#define _Y_TAB_H\n#endif`;
35:         fs.writeFile(state.currentDirectory + '/' + prefix + '.tab.c', cCode, 'w', undefined, undefined, state.currentDirectory);
36:         if (header) {
37:             fs.writeFile(state.currentDirectory + '/' + prefix + '.tab.h', hCode, 'w', undefined, undefined, state.currentDirectory);
38:         }
39:         if (graph) {
40:             fs.writeFile(state.currentDirectory + '/' + prefix + '.dot', 'digraph {}', 'w', undefined, undefined, state.currentDirectory);
41:         }
42:         return { output: '', newState: state, exitCode: 0 };
43:     }
44: }
</file>

<file path="src/domain/commands/core/ZcatCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { TerminalState } from '../../entities/TerminalState';
 5: import { CommandResponse } from '../../entities/Command';
 6: import { FileSystemService } from '../../services/FileSystemService';
 7: export class ZcatCommand implements ICommand {
 8:     constructor(private fs: FileSystemService) { }
 9:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
10:         const input = getStdinAsString(context);
11:         const files = args.filter(a => !a.startsWith('-'));
12:         if (files.length === 0) {
13:             return { output: 'zcat: missing operand', newState: state, exitCode: 1 };
14:         }
15:         let output = '';
16:         for (const file of files) {
17:             try {
18:                 const content = this.fs.readFile(file, state.currentDirectory);
19:                 // readFile now returns string automatically (decodes if binary)
20:                 if (content.startsWith('RLE:')) {
21:                     output += this.rleDecode(content.substring(4));
22:                 } else {
23:                     // zcat: usually complains if not compressed, or cat it?
24:                     // "Write the uncompressed form ... to standard output"
25:                     // If not compressed, maybe write as is?
26:                     // gzip zcat warns "not in gzip format" and writes original.
27:                     output += content;
28:                 }
29:             } catch (e) {
30:                 return { output: `zcat: ${file}: No such file or directory`, newState: state, exitCode: 1 };
31:             }
32:         }
33:         return {
34:             output: output,
35:             newState: state,
36:             exitCode: 0
37:         };
38:     }
39:     private rleDecode(input: string): string {
40:         let decoded = '';
41:         let i = 0;
42:         while (i < input.length) {
43:             let j = i;
44:             while (j < input.length && /\d/.test(input[j])) {
45:                 j++;
46:             }
47:             if (j > i) {
48:                 const count = parseInt(input.slice(i, j), 10);
49:                 const char = input[j];
50:                 if (char) {
51:                     decoded += char.repeat(count);
52:                     i = j + 1;
53:                 } else {
54:                     break;
55:                 }
56:             } else {
57:                 break;
58:             }
59:         }
60:         return decoded;
61:     }
62: }
