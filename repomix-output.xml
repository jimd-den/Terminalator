381:                                     return (
382:                                         <GhostWriter
383:                                             key={i}
384:                                             text={label}
385:                                             speed={10}
386:                                             style={item.type === 'dir' ? styles.dirText : styles.fileText}
387:                                             isActive={isTyping}
388:                                             onComplete={i === items.length - 1 ? onLineComplete : undefined}
389:                                         />
390:                                     );
391:                                 })}
392:                                 {items.length === 0 && (
393:                                     <TextRenderer content="[ NO_DATA_DETECTED ]" type="dim" />
394:                                 )}
