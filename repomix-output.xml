 6:         return this.parseSymbolic(modeStr, initialMode);
 7:     }
 8:     private static parseSymbolic(modeStr: string, initialMode: number): number {
 9:         let currentMode = initialMode;
10:         const clauses = modeStr.split(',');
11:         for (const clause of clauses) {
12:             const match = clause.match(/^([ugoa]*)([-+=])([rwxXstugo]*)$/);
13:             if (!match) {
14:                 throw new Error(`Invalid symbolic mode clause: ${clause}`);
15:             }
16:             const whoStr = match[1] || 'a';
17:             const op = match[2];
18:             const permStr = match[3];
19:             const whoBits = this.getWhoBits(whoStr);
20:             const permBits = this.getPermBits(permStr, currentMode, whoBits);
21:             switch (op) {
22:                 case '+':
23:                     currentMode |= (permBits & whoBits);
24:                     break;
25:                 case '-':
26:                     currentMode &= ~(permBits & whoBits);
27:                     break;
28:                 case '=':
29:                     currentMode &= ~whoBits;
30:                     currentMode |= (permBits & whoBits);
31:                     break;
32:             }
33:         }
34:         return currentMode & 0o7777;
35:     }
36:     private static getWhoBits(whoStr: string): number {
37:         if (whoStr === 'a') return 0o777;
38:         let bits = 0;
39:         if (whoStr.includes('u')) bits |= 0o700;
40:         if (whoStr.includes('g')) bits |= 0o070;
41:         if (whoStr.includes('o')) bits |= 0o007;
42:         return bits;
43:     }
44:     private static getPermBits(permStr: string, currentMode: number, whoBits: number): number {
45:         let bits = 0;
46:         if (permStr === 'u') {
47:             const u = (currentMode & 0o700) >> 6;
48:             return (u << 6) | (u << 3) | u;
49:         }
50:         if (permStr === 'g') {
51:             const g = (currentMode & 0o070) >> 3;
52:             return (g << 6) | (g << 3) | g;
53:         }
54:         if (permStr === 'o') {
55:             const o = (currentMode & 0o007);
56:             return (o << 6) | (o << 3) | o;
57:         }
58:         if (permStr.includes('r')) bits |= 0o444;
59:         if (permStr.includes('w')) bits |= 0o222;
60:         if (permStr.includes('x')) bits |= 0o111;
61:         if (permStr.includes('X')) {
62:             bits |= 0o111;
63:         }
64:         if (permStr.includes('s')) {
65:             if (whoBits & 0o700) bits |= 0o4000;
66:             if (whoBits & 0o070) bits |= 0o2000;
67:         }
68:         if (permStr.includes('t')) bits |= 0o1000;
69:         return bits;
70:     }
71: }
