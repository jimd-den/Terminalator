 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class TimeCommand implements ICommand {
 9:     constructor(
10:         private fs: FileSystemService,
11:         private commandProvider: (name: string) => ICommand | undefined
12:     ) { }
13:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
14:         const input = getStdinAsString(context);
15:         const cmdArgs = args.filter(a => a !== '-p');
16:         if (cmdArgs.length === 0) {
17:             return { output: 'time: missing operand', newState: state, exitCode: 1 };
18:         }
19:         const cmdName = cmdArgs[0];
20:         const utilityArgs = cmdArgs.slice(1);
21:         const command = this.commandProvider(cmdName);
22:         if (!command) {
23:             return { output: `time: command not found: ${cmdName}`, newState: state, exitCode: 127 };
24:         }
25:         const start = Date.now();
26:         let response: CommandResponse;
27:         try {
28:             response = await command.execute(utilityArgs, context, state);
29:         } catch (e: any) {
30:             return { output: `time: error executing ${cmdName}: ${e.message}`, newState: state, exitCode: 1 };
31:         }
32:         const end = Date.now();
33:         const duration = (end - start) / 1000;
34:         const timing = `\nreal ${duration.toFixed(2)}\nuser 0.00\nsys 0.00`;
35:         return {
36:             output: response.output + timing,
37:             newState: response.newState,
38:             exitCode: response.exitCode
39:         };
40:     }
41: }
