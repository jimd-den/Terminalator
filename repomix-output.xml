  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { CommandBase } from '../CommandBase';
  3: import { CommandCapability } from '../IStructuredCommand';
  4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  5: import { TerminalState } from '../../entities/TerminalState';
  6: import { CommandResponse } from '../../entities/Command';
  7: import { FileSystemService } from '../../services/FileSystemService';
  8: interface TrOptions {
  9:     delete: boolean;
 10:     squeeze: boolean;
 11:     complement: boolean;
 12:     set1: string;
 13:     set2: string;
 14: }
 15: export class TrCommand extends CommandBase {
 16:     public readonly capabilities = [CommandCapability.TRANSFORM];
 17:     public readonly utility = 'tr';
 18:     constructor(private fs: FileSystemService) {
 19:         super();
 20:     }
 21:     protected async executeInternal(
 22:         rawArgs: string[],
 23:         flags: Set<string>,
 24:         operands: string[],
 25:         context: ProcessContext,
 26:         state: TerminalState
 27:     ): Promise<CommandResponse> {
 28:         const input = getStdinAsString(context);
 29:         const options: TrOptions = {
 30:             delete: flags.has('d'),
 31:             squeeze: flags.has('s'),
 32:             complement: flags.has('c') || flags.has('C'),
 33:             set1: '',
 34:             set2: ''
 35:         };
 36:         if (operands.length === 0) {
 37:             return { output: 'tr: missing operand', newState: state, exitCode: 1 };
 38:         }
 39:         options.set1 = this.expandSet(operands[0]);
 40:         if (operands.length > 1) {
 41:             options.set2 = this.expandSet(operands[1]);
 42:         }
 43:         if (input === undefined) {
 44:             return { output: '', newState: state, exitCode: 0 };
 45:         }
 46:         let output = input;
 47:         if (options.delete) {
 48:             if (options.squeeze && operands.length > 1) {
 49:                 output = this.deleteChars(output, options.set1, options.complement);
 50:                 output = this.squeezeChars(output, options.set2);
 51:             } else {
 52:                 output = this.deleteChars(output, options.set1, options.complement);
 53:             }
 54:         } else if (options.squeeze && operands.length === 1) {
 55:             output = this.squeezeChars(output, options.set1);
 56:         } else {
 57:             if (operands.length < 2) {
 58:                 return { output: 'tr: missing operand', newState: state, exitCode: 1 };
 59:             }
 60:             output = this.translate(output, options.set1, options.set2, options.complement);
 61:             if (options.squeeze) {
 62:                 output = this.squeezeChars(output, options.set2);
 63:             }
 64:         }
 65:         return {
 66:             output: output,
 67:             newState: state,
 68:             exitCode: 0
 69:         };
 70:     }
 71:     private expandSet(setStr: string): string {
 72:         let expanded = '';
 73:         let i = 0;
 74:         if (setStr === 'a-z') return 'abcdefghijklmnopqrstuvwxyz';
 75:         if (setStr === 'A-Z') return 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
 76:         if (setStr === '0-9') return '0123456789';
 77:         while (i < setStr.length) {
 78:             if (i + 2 < setStr.length && setStr[i + 1] === '-') {
 79:                 const start = setStr.charCodeAt(i);
 80:                 const end = setStr.charCodeAt(i + 2);
 81:                 if (start < end) {
 82:                     for (let c = start; c <= end; c++) {
 83:                         expanded += String.fromCharCode(c);
 84:                     }
 85:                     i += 3;
 86:                     continue;
 87:                 }
 88:             }
 89:             if (setStr[i] === '\\') {
 90:                 if (i + 1 < setStr.length) {
 91:                     const next = setStr[i + 1];
 92:                     if (next === 'n') expanded += '\n';
 93:                     else if (next === 't') expanded += '\t';
 94:                     else if (next === '\\') expanded += '\\';
 95:                     else expanded += next;
 96:                     i += 2;
 97:                     continue;
 98:                 }
 99:             }
100:             expanded += setStr[i];
101:             i++;
102:         }
103:         return expanded;
104:     }
105:     private deleteChars(str: string, set: string, complement: boolean): string {
106:         const setSet = new Set(set.split(''));
107:         let res = '';
108:         for (const char of str) {
109:             const has = setSet.has(char);
110:             if (complement ? has : !has) {
111:                 res += char;
112:             }
113:         }
114:         return res;
115:     }
116:     private squeezeChars(str: string, set: string): string {
117:         const setSet = new Set(set.split(''));
118:         let res = '';
119:         let lastChar = '';
120:         for (const char of str) {
121:             if (setSet.has(char) && char === lastChar) {
122:                 continue;
123:             }
124:             res += char;
125:             lastChar = char;
126:         }
127:         return res;
128:     }
129:     private translate(str: string, set1: string, set2: string, complement: boolean): string {
130:         const map = new Map<string, string>();
131:         if (!complement) {
132:             for (let i = 0; i < set1.length; i++) {
133:                 const char1 = set1[i];
134:                 let char2 = '';
135:                 if (i < set2.length) {
136:                     char2 = set2[i];
137:                 } else {
138:                     char2 = set2[set2.length - 1];
139:                 }
140:                 map.set(char1, char2);
141:             }
142:         }
143:         let res = '';
144:         const set1Set = new Set(set1.split(''));
145:         const lastSet2 = set2.length > 0 ? set2[set2.length - 1] : '';
146:         for (const char of str) {
147:             if (complement) {
148:                 if (!set1Set.has(char)) {
149:                     res += lastSet2;
150:                 } else {
151:                     res += char;
152:                 }
153:             } else {
154:                 res += map.get(char) ?? char;
155:             }
156:         }
157:         return res;
158:     }
159: }
</file>

