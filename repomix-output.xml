<file path="src/domain/usecases/vim/MotionStrategy.ts">
 1: import { IVimBuffer } from '../../entities/vim/IVimBuffer';
 2: export class MotionStrategy {
 3:     public static findNextWordStart(buffer: IVimBuffer, lineIdx: number, colIdx: number): { line: number, col: number } {
 4:         const line = buffer.getLine(lineIdx);
 5:         let current = colIdx;
 6:         while (current < line.length && !this.isWhitespace(line[current])) {
 7:             current++;
 8:         }
 9:         while (current < line.length && this.isWhitespace(line[current])) {
10:             current++;
11:         }
12:         if (current >= line.length && line.length > 0) {
13:             current = line.length - 1;
14:         }
15:         return { line: lineIdx, col: current };
16:     }
17:     public static findEndOfLine(buffer: IVimBuffer, lineIdx: number): { line: number, col: number } {
18:         const line = buffer.getLine(lineIdx);
19:         const col = Math.max(0, line.length - 1);
20:         return { line: lineIdx, col };
21:     }
22:     private static isWhitespace(char: string): boolean {
23:         return /\s/.test(char);
24:     }
25: }
</file>

<file path="src/domain/usecases/vim/ProcessVimCommand.ts">
 1: import { IVimBuffer } from '../../entities/vim/IVimBuffer';
 2: import { SaveBuffer } from './SaveBuffer';
 3: export interface CommandResult {
 4:     exit: boolean;
 5:     message: string;
 6: }
 7: export class ProcessVimCommand {
 8:     constructor(private saveBuffer: SaveBuffer) {}
 9:     public execute(cmd: string, buffer: IVimBuffer, filename: string): CommandResult {
10:         const command = cmd.trim();
11:         if (command === ':w') {
12:             const message = this.saveBuffer.execute(buffer, filename);
13:             return { exit: false, message };
14:         } else if (command === ':q' || command === ':quit' || command === ':exit') {
15:             return { exit: true, message: 'UPLINK TERMINATED.' };
16:         } else if (command === ':wq') {
17:             this.saveBuffer.execute(buffer, filename);
18:             return { exit: true, message: 'UPLINK TERMINATED.' };
19:         } else if (command === ':q!') {
20:             return { exit: true, message: 'UPLINK TERMINATED.' };
21:         }
22:         return { exit: false, message: `E492: Not an editor command: ${command}` };
23:     }
24: }
