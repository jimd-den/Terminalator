<file path="src/domain/commands/core/XargsCommand.ts">
  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { ICommand } from '../ICommand';
  3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  4: import { FileSystemService } from '../../../domain/services/FileSystemService';
  5: import { TerminalState } from '../../entities/TerminalState';
  6: import { NullStream, StringStream } from '../../entities/Stream';
  7: import { CommandResponse } from '../../entities/Command';
  8: interface XargsOptions {
  9:     eofStr?: string;
 10:     replStr?: string;
 11:     linesPerInvoke?: number;
 12:     maxArgs?: number;
 13:     maxSize: number;
 14:     prompt: boolean;
 15:     noRunIfEmpty: boolean;
 16:     trace: boolean;
 17:     exitIfTooLong: boolean;
 18:     nullDelim: boolean;
 19: }
 20: const LINE_MAX = 2048;
 21: export class XargsCommand implements ICommand {
 22:     private getCommand: (name: string) => ICommand | undefined;
 23:     constructor(private fs: FileSystemService, commandLookup: (name: string) => ICommand | undefined) {
 24:         this.getCommand = commandLookup;
 25:     }
 26:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 27:         const input = getStdinAsString(context);
 28:         const { opts, utility, utilityArgs } = this.parseOptions(args);
 29:         const inputStr = input ?? '';
 30:         // Parse input into tokens based on delimiter mode
 31:         let tokens: string[];
 32:         if (opts.nullDelim) {
 33:             tokens = this.parseInputNull(inputStr, opts.eofStr);
 34:         } else {
 35:             tokens = this.parseInputStandard(inputStr, opts.eofStr);
 36:         }
 37:         // -r: If no arguments from input and -r specified, don't run
 38:         if (tokens.length === 0 && opts.noRunIfEmpty) {
 39:             return { output: '', newState: state, exitCode: 0 };
 40:         }
 41:         // Default: if no input and no -r, run utility once with no extra args
 42:         if (tokens.length === 0) {
 43:             return this.executeBatch(utility, utilityArgs, [], opts, context, state);
 44:         }
 45:         // Batch arguments based on options
 46:         const batches = this.batchArgs(tokens, utilityArgs, opts);
 47:         // Execute batches
 48:         let output = '';
 49:         let traceOutput = '';
 50:         let lastExitCode = 0;
 51:         let highestErrorCode = 0;
 52:         for (const batch of batches) {
 53:             const result = await this.executeBatch(utility, utilityArgs, batch, opts, context, state);
 54:             if (result.exitCode === 255) {
 55:                 // Exit 255 signals xargs to stop
 56:                 return {
 57:                     output: traceOutput + output + result.output,
 58:                     newState: state,
 59:                     exitCode: 1
 60:                 };
 61:             }
 62:             // Track highest error code (126/127 are special)
 63:             if (result.exitCode === 126 || result.exitCode === 127) {
 64:                 highestErrorCode = result.exitCode;
 65:             } else if (result.exitCode !== 0 && highestErrorCode < 126) {
 66:                 highestErrorCode = result.exitCode;
 67:             }
 68:             output += result.output;
 69:             if (result.traceOutput) {
 70:                 traceOutput += result.traceOutput;
 71:             }
 72:             lastExitCode = result.exitCode;
 73:         }
 74:         // Return: 127 if cmd not found, 126 if couldn't invoke, else 0 or 1-125
 75:         const finalExitCode = highestErrorCode >= 126 ? highestErrorCode : (highestErrorCode > 0 ? 1 : 0);
 76:         return {
 77:             output: traceOutput + output,
 78:             newState: state,
 79:             exitCode: finalExitCode
 80:         };
 81:     }
 82:     private parseOptions(args: string[]): { opts: XargsOptions, utility: string, utilityArgs: string[] } {
 83:         const opts: XargsOptions = {
 84:             maxSize: LINE_MAX,
 85:             prompt: false,
 86:             noRunIfEmpty: false,
 87:             trace: false,
 88:             exitIfTooLong: false,
 89:             nullDelim: false
 90:         };
 91:         let i = 0;
 92:         while (i < args.length) {
 93:             const arg = args[i];
 94:             if (arg === '-E' && i + 1 < args.length) {
 95:                 opts.eofStr = args[++i];
 96:             } else if (arg === '-I' && i + 1 < args.length) {
 97:                 opts.replStr = args[++i];
 98:                 opts.exitIfTooLong = true;
 99:             } else if (arg === '-L' && i + 1 < args.length) {
100:                 opts.linesPerInvoke = parseInt(args[++i], 10);
101:             } else if (arg === '-n' && i + 1 < args.length) {
102:                 opts.maxArgs = parseInt(args[++i], 10);
103:             } else if (arg === '-s' && i + 1 < args.length) {
104:                 opts.maxSize = parseInt(args[++i], 10);
105:             } else if (arg === '-p') {
106:                 opts.prompt = true;
107:                 opts.trace = true;
108:             } else if (arg === '-r') {
109:                 opts.noRunIfEmpty = true;
110:             } else if (arg === '-t') {
111:                 opts.trace = true;
112:             } else if (arg === '-x') {
113:                 opts.exitIfTooLong = true;
114:             } else if (arg === '-0') {
115:                 opts.nullDelim = true;
116:             } else if (arg === '--') {
117:                 i++;
118:                 break;
119:             } else if (arg.startsWith('-')) {
120:                 for (let j = 1; j < arg.length; j++) {
121:                     const c = arg[j];
122:                     if (c === 'p') { opts.prompt = true; opts.trace = true; }
123:                     else if (c === 'r') { opts.noRunIfEmpty = true; }
124:                     else if (c === 't') { opts.trace = true; }
125:                     else if (c === 'x') { opts.exitIfTooLong = true; }
126:                     else if (c === '0') { opts.nullDelim = true; }
127:                 }
128:             } else {
129:                 break;
130:             }
131:             i++;
132:         }
133:         const utility = args[i] || 'echo';
134:         const utilityArgs = args.slice(i + 1);
135:         return { opts, utility, utilityArgs };
136:     }
137:     private parseInputStandard(input: string, eofStr?: string): string[] {
138:         const tokens: string[] = [];
139:         let current = '';
140:         let inDouble = false;
141:         let inSingle = false;
142:         let escaped = false;
143:         for (let i = 0; i < input.length; i++) {
144:             const c = input[i];
145:             if (escaped) {
146:                 current += c;
147:                 escaped = false;
148:                 continue;
149:             }
150:             if (c === '\\' && !inSingle) {
151:                 escaped = true;
152:                 continue;
153:             }
154:             if (c === '"' && !inSingle) {
155:                 inDouble = !inDouble;
156:                 continue;
157:             }
158:             if (c === "'" && !inDouble) {
159:                 inSingle = !inSingle;
160:                 continue;
161:             }
162:             if (!inDouble && !inSingle && (c === ' ' || c === '\t' || c === '\n')) {
163:                 if (current.length > 0) {
164:                     if (eofStr !== undefined && current === eofStr) {
165:                         return tokens;
166:                     }
167:                     tokens.push(current);
168:                     current = '';
169:                 }
170:                 continue;
171:             }
172:             current += c;
173:         }
174:         // Add final token if any
175:         if (current.length > 0) {
176:             if (eofStr !== undefined && current === eofStr) {
177:                 return tokens;
178:             }
179:             tokens.push(current);
180:         }
181:         return tokens;
182:     }
183:     /**
184:      * Parse input using null-byte delimiter (-0 mode).
185:      * No quote processing; each argument separated by \0.
186:      */
187:     private parseInputNull(input: string, eofStr?: string): string[] {
188:         const tokens: string[] = [];
189:         const parts = input.split('\0');
190:         for (const part of parts) {
191:             if (part.length > 0) {
192:                 if (eofStr !== undefined && part === eofStr) {
193:                     return tokens;
194:                 }
195:                 tokens.push(part);
196:             }
197:         }
198:         return tokens;
199:     }
200:     private batchArgs(tokens: string[], baseArgs: string[], opts: XargsOptions): string[][] {
201:         if (opts.replStr) {
202:             return tokens.map(t => [t]);
203:         }
204:         if (opts.linesPerInvoke) {
205:             const batches: string[][] = [];
206:             for (let i = 0; i < tokens.length; i += opts.linesPerInvoke) {
207:                 batches.push(tokens.slice(i, i + opts.linesPerInvoke));
208:             }
209:             return batches;
210:         }
211:         if (opts.maxArgs) {
212:             const batches: string[][] = [];
213:             for (let i = 0; i < tokens.length; i += opts.maxArgs) {
214:                 batches.push(tokens.slice(i, i + opts.maxArgs));
215:             }
216:             return batches;
217:         }
218:         const batches: string[][] = [];
219:         let currentBatch: string[] = [];
220:         let currentSize = baseArgs.reduce((a, b) => a + b.length + 1, 0);
221:         for (const token of tokens) {
222:             const tokenSize = token.length + 1;
223:             if (currentSize + tokenSize > opts.maxSize && currentBatch.length > 0) {
224:                 batches.push(currentBatch);
225:                 currentBatch = [];
226:                 currentSize = baseArgs.reduce((a, b) => a + b.length + 1, 0);
227:             }
228:             currentBatch.push(token);
229:             currentSize += tokenSize;
230:         }
231:         if (currentBatch.length > 0) {
232:             batches.push(currentBatch);
233:         }
234:         return batches.length > 0 ? batches : [[]];
235:     }
236:     private async executeBatch(
237:         utility: string,
238:         baseArgs: string[],
239:         batchArgs: string[],
240:         opts: XargsOptions,
241:         context: ProcessContext,
242:         state: TerminalState
243:     ): Promise<CommandResponse & { traceOutput?: string }> {
244:         let finalArgs: string[];
245:         if (opts.replStr) {
246:             const replacement = batchArgs[0] || '';
247:             finalArgs = baseArgs.map(arg => arg.split(opts.replStr!).join(replacement));
248:         } else {
249:             // Normal mode: append batch args to base args
250:             finalArgs = [...baseArgs, ...batchArgs];
251:         }
252:         // Find command
253:         const command = this.getCommand(utility);
254:         if (!command) {
255:             return {
256:                 output: `xargs: ${utility}: No such file or directory\n`,
257:                 newState: state,
258:                 exitCode: 127
259:             };
260:         }
261:         // Trace output
262:         let traceOutput = '';
263:         if (opts.trace) {
264:             const cmdLine = [utility, ...finalArgs].join(' ');
265:             traceOutput = cmdLine + '\n';
266:         }
267:         try {
268:             const innerContext: ProcessContext = {
269:                 ...context,
270:                 stdin: new NullStream(),
271:                 stdout: new StringStream(),
272:                 stderr: new StringStream(),
273:                 stdinLegacy: undefined
274:             };
275:             const result = await command.execute(finalArgs, innerContext, state);
276:             return {
277:                 ...result,
278:                 traceOutput
279:             };
280:         } catch (e: any) {
281:             return {
282:                 output: `xargs: ${utility}: ${e.message}\n`,
283:                 newState: state,
284:                 exitCode: 126,
285:                 traceOutput
286:             };
287:         }
288:     }
289: }
</file>

