  6: import { SchemeParser } from '../../../domain/usecases/SchemeParser';
  7: import { SchemeEvaluator } from '../../../domain/usecases/SchemeEvaluator';
  8: import { Environment } from '../../../domain/entities/Environment';
  9: import { ProcedureRegistry } from '../../../domain/entities/ProcedureRegistry';
 10: import { schemeToString, makeProcedure } from '../../../domain/entities/SchemeValue';
 11: import { registerStandardLibrary, getPrelude } from '../../scheme/StandardLibrary';
 12: export class SchemeCommand implements ICommand {
 13:     readonly name = 'scheme';
 14:     readonly description = 'Scheme Lisp interpreter (R7RS-ready)';
 15:     private parser = new SchemeParser();
 16:     private evaluator = new SchemeEvaluator();
 17:     private globalEnv: Environment | null = null;
 18:     constructor(private fs: FileSystemService) {
 19:         registerStandardLibrary();
 20:     }
 21:     private getEnv(): Environment {
 22:         if (!this.globalEnv) {
 23:             this.globalEnv = new Environment();
 24:             ProcedureRegistry.getInstance().populate(this.globalEnv);
 25:             const prelude = getPrelude();
 26:             const exprs = this.parser.parse(prelude);
 27:             for (const expr of exprs) {
 28:                 this.evaluator.evaluate(expr, this.globalEnv);
 29:             }
 30:             const loadProc = makeProcedure({
 31:                 name: 'load',
 32:                 isBuiltin: true,
 33:                 call: (args) => {
 34:                     if (args.length !== 1 || args[0].type !== 'string') {
 35:                         throw new Error("load: expects a single string argument (filename)");
 36:                     }
 37:                     const filename = args[0].value as string;
 38:                     if (!this.fs) throw new Error("load: Filesystem not available");
 39:                     try {
 40:                         const content = this.fs.readFile(filename, '/');
 41:                         const expressions = this.parser.parse(content);
 42:                         let lastResult: any = { type: 'boolean', value: false };
 43:                         for (const expr of expressions) {
 44:                             lastResult = this.evaluator.evaluate(expr, this.globalEnv!);
 45:                         }
 46:                         return lastResult;
 47:                     } catch (e: any) {
 48:                         throw new Error(`load: failed to load '${filename}': ${e.message}`);
 49:                     }
 50:                 }
 51:             });
 52:             this.globalEnv.define('load', loadProc);
 53:         }
 54:         return this.globalEnv;
 55:     }
 56:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 57:         const input = context.stdin;
 58:         const env = this.getEnv();
 59:         const fs = this.fs;
 60:         let exprCode = '';
 61:         let filename = '';
 62:         if (args[0] === '-e' && args.length > 1) {
 63:             exprCode = args.slice(1).join(' ');
 64:         } else if (args.length > 0 && args[0].startsWith('(')) {
 65:             exprCode = args.join(' ');
 66:         } else if (args.length === 1) {
 67:             filename = args[0];
 68:         } else {
 69:             return {
 70:                 output: 'MAINFRAME SCHEME v1.0\nUsage: scheme <file.scm> or scheme -e "(expr)"',
 71:                 newState: state,
 72:                 exitCode: 0
 73:             };
 74:         }
 75:         if (filename) {
 76:             try {
 77:                 const content = fs.readFile(filename, state.currentDirectory);
 78:                 const expressions = this.parser.parse(content);
 79:                 let lastResult = '';
 80:                 const startTime = Date.now();
 81:                 let totalInstructions = 0;
 82:                 for (const expr of expressions) {
 83:                     const result = this.evaluator.evaluate(expr, env);
 84:                     lastResult = schemeToString(result);
 85:                     totalInstructions += this.evaluator.lastInstructionCount;
 86:                 }
 87:                 const endTime = Date.now();
 88:                 return {
 89:                     output: lastResult,
 90:                     newState: state,
 91:                     exitCode: 0,
 92:                     executionStats: {
 93:                         timeMs: endTime - startTime,
 94:                         iterations: totalInstructions,
 95:                         memoryUsed: 0 // Not tracked yet
 96:                     }
 97:                 };
 98:             } catch (err: any) {
 99:                 return { output: `scheme error: ${err.message}`, newState: state, exitCode: 1 };
100:             }
101:         }
102:         if (exprCode) {
103:             try {
104:                 const expressions = this.parser.parse(exprCode);
105:                 if (expressions.length === 0) return { output: '', newState: state, exitCode: 0 };
106:                 const startTime = Date.now();
107:                 const result = this.evaluator.evaluate(expressions[0], env);
108:                 const endTime = Date.now();
109:                 return {
110:                     output: schemeToString(result),
111:                     newState: state,
112:                     exitCode: 0,
113:                     executionStats: {
114:                         timeMs: endTime - startTime,
115:                         iterations: this.evaluator.lastInstructionCount,
116:                         memoryUsed: 0
117:                     }
118:                 };
119:             } catch (err: any) {
120:                 return { output: `scheme error: ${err.message}`, newState: state, exitCode: 1 };
121:             }
122:         }
123:         return { output: '', newState: state, exitCode: 0 };
124:     }
125: }
</file>

