  1: import { Job, createJob, JobState } from '../entities/Job';
  2: import { SIGNALS, parseSignal, getSignalName, DEFAULT_SIGNAL } from '../entities/Signal';
  3: export interface JobOperationResult {
  4:     readonly success: boolean;
  5:     readonly job?: Job;
  6:     readonly errorMessage?: string;
  7: }
  8: export class JobControlService {
  9:     private jobs: Job[] = [];
 10:     private nextPid: number = 1000;
 11:     private nextJobId: number = 1;
 12:     createJob(command: string): Job {
 13:         const pid = this.allocatePid();
 14:         const jobId = this.nextJobId++;
 15:         const job = createJob(jobId, pid, command);
 16:         this.updateCurrentJob(job);
 17:         this.jobs.push(job);
 18:         this.log('createJob', { jobId, pid, command });
 19:         return job;
 20:     }
 21:     private allocatePid(): number {
 22:         return this.nextPid++;
 23:     }
 24:     resolveJobSpec(spec: string): Job | undefined {
 25:         if (!spec || spec.length === 0) {
 26:             return this.getCurrentJob();
 27:         }
 28:         if (spec.startsWith('%')) {
 29:             const rest = spec.slice(1);
 30:             if (rest === '%' || rest === '+' || rest === '') {
 31:                 return this.getCurrentJob();
 32:             }
 33:             // %- = previous job
 34:             if (rest === '-') {
 35:                 return this.getPreviousJob();
 36:             }
 37:             // %?string = job containing string
 38:             if (rest.startsWith('?')) {
 39:                 const searchStr = rest.slice(1);
 40:                 return this.jobs.find(j => j.command.includes(searchStr));
 41:             }
 42:             // %n = job number n
 43:             const jobNum = parseInt(rest, 10);
 44:             if (!isNaN(jobNum)) {
 45:                 return this.getJobById(jobNum);
 46:             }
 47:             // %string = job starting with string
 48:             return this.jobs.find(j => j.command.startsWith(rest));
 49:         }
 50:         // Try as PID
 51:         const pid = parseInt(spec, 10);
 52:         if (!isNaN(pid)) {
 53:             return this.getJobByPid(pid);
 54:         }
 55:         return undefined;
 56:     }
 57:     /**
 58:      * Get a job by its job ID number.
 59:      *
 60:      * Pure lookup - O(n) where n = number of jobs.
 61:      *
 62:      * @param jobId - The job ID (1, 2, 3, ...)
 63:      * @returns The Job or undefined
 64:      */
 65:     getJobById(jobId: number): Job | undefined {
 66:         return this.jobs.find(j => j.jobId === jobId);
 67:     }
 68:     /**
 69:      * Get a job by its PID.
 70:      *
 71:      * Pure lookup - O(n) where n = number of jobs.
 72:      *
 73:      * @param pid - The process ID
 74:      * @returns The Job or undefined
 75:      */
 76:     getJobByPid(pid: number): Job | undefined {
 77:         return this.jobs.find(j => j.pid === pid || j.pgid === pid);
 78:     }
 79:     /**
 80:      * Get the current job (+).
 81:      *
 82:      * POSIX: "If there is any suspended job, then the current job shall
 83:      * be a suspended job."
 84:      *
 85:      * @returns The current job or undefined if no jobs
 86:      */
 87:     getCurrentJob(): Job | undefined {
 88:         return this.jobs.find(j => j.isCurrent);
 89:     }
 90:     /**
 91:      * Get the previous job (-).
 92:      *
 93:      * POSIX: "If there are at least two suspended jobs, then the previous
 94:      * job also shall be a suspended job."
 95:      *
 96:      * @returns The previous job or undefined
 97:      */
 98:     getPreviousJob(): Job | undefined {
 99:         return this.jobs.find(j => j.isPrevious);
100:     }
101:     /**
102:      * Get all jobs.
103:      *
104:      * @returns Copy of the jobs array
105:      */
106:     getAllJobs(): readonly Job[] {
107:         return [...this.jobs];
108:     }
109:     /**
110:      * Get all active jobs (not Done/Terminated).
111:      *
112:      * @returns Jobs in Running or Stopped state
113:      */
114:     getActiveJobs(): Job[] {
115:         return this.jobs.filter(j => j.state === 'Running' || j.state === 'Stopped');
116:     }
117:     sendSignal(spec: string, signal: number = DEFAULT_SIGNAL): JobOperationResult {
118:         let job = this.resolveJobSpec(spec);
119:         if (!job && !spec.startsWith('%')) {
120:             const pid = parseInt(spec, 10);
121:             if (!isNaN(pid)) {
122:                 job = this.getJobByPid(pid);
123:                 if (pid === 0) {
124:                     this.log('sendSignal', { spec, signal, target: 'current-group' });
125:                     return { success: true };
126:                 }
127:             }
128:         }
129:         if (!job) {
130:             const pid = parseInt(spec, 10);
131:             if (!isNaN(pid) && pid > 0) {
132:                 this.log('sendSignal', { spec, signal, target: 'unknown-pid' });
133:                 return { success: true };
134:             }
135:             return {
136:                 success: false,
137:                 errorMessage: `kill: ${spec}: no such job`
138:             };
139:         }
140:         this.applySignalToJob(job, signal);
141:         this.log('sendSignal', { jobId: job.jobId, signal, state: job.state });
142:         return { success: true, job };
143:     }
144:     private applySignalToJob(job: Job, signal: number): void {
145:         switch (signal) {
146:             case SIGNALS.CONT:
147:                 if (job.state === 'Stopped') {
148:                     job.state = 'Running';
149:                     job.signal = undefined;
150:                 }
151:                 break;
152:             case SIGNALS.STOP:
153:             case SIGNALS.TSTP:
154:             case SIGNALS.TTIN:
155:             case SIGNALS.TTOU:
156:                 if (job.state === 'Running') {
157:                     job.state = 'Stopped';
158:                     job.signal = signal;
159:                     this.updateCurrentJob(job);
160:                 }
161:                 break;
162:             case SIGNALS.KILL:
163:             case SIGNALS.TERM:
164:             case SIGNALS.HUP:
165:             case SIGNALS.INT:
166:             case SIGNALS.QUIT:
167:             case SIGNALS.ABRT:
168:                 job.state = 'Terminated';
169:                 job.exitCode = 128 + signal;
170:                 job.signal = signal;
171:                 break;
172:             case 0:
173:                 break;
174:             default:
175:                 job.state = 'Terminated';
176:                 job.exitCode = 128 + signal;
177:                 job.signal = signal;
178:                 break;
179:         }
180:     }
181:     resumeBackground(spec?: string): JobOperationResult {
182:         const job = spec ? this.resolveJobSpec(spec) : this.getCurrentJob();
183:         if (!job) {
184:             return {
185:                 success: false,
186:                 errorMessage: spec ? `bg: ${spec}: no such job` : 'bg: no current job'
187:             };
188:         }
189:         if (job.state === 'Running') {
190:             this.log('resumeBackground', { jobId: job.jobId, alreadyRunning: true });
191:             return { success: true, job };
192:         }
193:         if (job.state === 'Stopped') {
194:             job.state = 'Running';
195:             job.signal = undefined;
196:             this.log('resumeBackground', { jobId: job.jobId });
197:             return { success: true, job };
198:         }
199:         return {
200:             success: false,
201:             errorMessage: `bg: job has already terminated`
202:         };
203:     }
204:     resumeForeground(spec?: string): JobOperationResult {
205:         const job = spec ? this.resolveJobSpec(spec) : this.getCurrentJob();
206:         if (!job) {
207:             return {
208:                 success: false,
209:                 errorMessage: spec ? `fg: ${spec}: no such job` : 'fg: no current job'
210:             };
211:         }
212:         if (job.state === 'Stopped') {
213:             job.state = 'Running';
214:             job.signal = undefined;
215:         }
216:         if (job.state === 'Running') {
217:             job.state = 'Done';
218:             job.exitCode = 0;
219:             this.removeFromJobTable(job);
220:         }
221:         this.log('resumeForeground', { jobId: job.jobId });
222:         return { success: true, job };
223:     }
224:     markDone(jobId: number, exitCode: number): void {
225:         const job = this.getJobById(jobId);
226:         if (job) {
227:             job.state = 'Done';
228:             job.exitCode = exitCode;
229:             this.log('markDone', { jobId, exitCode });
230:         }
231:     }
232:     waitFor(spec: string): number {
233:         if (!spec || spec === '') {
234:             // Wait for all jobs - in simulation, mark all as done
235:             const activeJobs = this.getActiveJobs();
236:             for (const job of activeJobs) {
237:                 if (job.state === 'Stopped') {
238:                     job.state = 'Done';
239:                     job.exitCode = 0;
240:                 }
241:             }
242:             this.jobs = this.jobs.filter(j => j.state !== 'Done' && j.state !== 'Terminated');
243:             this.log('waitFor', { spec: 'all', jobsRemaining: this.jobs.length });
244:             return 0;
245:         }
246:         const job = this.resolveJobSpec(spec);
247:         if (!job) {
248:             this.log('waitFor', { spec, notFound: true });
249:             return 127;
250:         }
251:         let exitCode = 0;
252:         if (job.state === 'Done' || job.state === 'Terminated') {
253:             exitCode = job.exitCode ?? 0;
254:         } else {
255:             job.state = 'Done';
256:             job.exitCode = 0;
257:             exitCode = 0;
258:         }
259:         this.removeFromJobTable(job);
260:         this.log('waitFor', { spec, exitCode });
261:         return exitCode;
262:     }
263:     private updateCurrentJob(newCurrent: Job): void {
264:         const oldCurrent = this.getCurrentJob();
265:         for (const job of this.jobs) {
266:             if (job.isCurrent) {
267:                 job.isCurrent = false;
268:                 if (oldCurrent && oldCurrent.jobId !== newCurrent.jobId) {
269:                     for (const j of this.jobs) {
270:                         j.isPrevious = false;
271:                     }
272:                     oldCurrent.isPrevious = true;
273:                 }
274:             }
275:         }
276:         newCurrent.isCurrent = true;
277:     }
278:     private removeFromJobTable(job: Job): void {
279:         const index = this.jobs.findIndex(j => j.jobId === job.jobId);
280:         if (index !== -1) {
281:             this.jobs.splice(index, 1);
282:             if (job.isCurrent && this.jobs.length > 0) {
283:                 const newCurrent = this.jobs[this.jobs.length - 1];
284:                 newCurrent.isCurrent = true;
285:             }
286:         }
287:     }
288:     reapCompletedJobs(): Job[] {
289:         const completed = this.jobs.filter(
290:             j => j.state === 'Done' || j.state === 'Terminated'
291:         );
292:         this.jobs = this.jobs.filter(
293:             j => j.state !== 'Done' && j.state !== 'Terminated'
294:         );
295:         return completed;
296:     }
297:     private log(operation: string, details: Record<string, unknown>): void {
298:         const timestamp = new Date().toISOString();
299:     }
300: }
</file>

