 1: import { ConstraintMissionFactory, ProblemDefinition } from '../mission/ConstraintMissionFactory';
 2: import { MasteryTracker } from '../../services/tutor/MasteryTracker';
 3: import { CommandCapability } from '../../entities/knowledge/UnixCommandDefinition';
 4: import { Mission } from '../../entities/Mission';
 5: import { SystemPreparationSpec } from '../../entities/world/SystemPreparationSpec';
 6: export class TutorLedProgression {
 7:     constructor(
 8:         private factory: ConstraintMissionFactory,
 9:         private masteryTracker: MasteryTracker
10:     ) {}
11:     public async generateNextMission(targetSystem: string): Promise<Mission> {
12:         const focusTools = ['grep', 'sed', 'awk', 'ls', 'cd', 'mkdir'];
13:         let mostFailed = '';
14:         let maxFails = 0;
15:         for (const tool of focusTools) {
16:             const fails = this.masteryTracker.getFailCount(tool);
17:             if (fails > maxFails) {
18:                 maxFails = fails;
19:                 mostFailed = tool;
20:             }
21:         }
22:         // 2. If a problematic tool is found (> 2 fails), force a mission for it
23:         if (mostFailed && maxFails > 2) {
24:             return this.generateForcedMission(mostFailed, targetSystem);
25:         }
26:         // 3. Otherwise, proceed with default factory logic (random grammar selection)
27:         return this.generateRandomMission(targetSystem);
28:     }
29:     private generateForcedMission(utility: string, targetSystem: string): Mission {
30:         // Map problematic utility to semantic capabilities
31:         const capMap: Record<string, CommandCapability[]> = {
32:             'grep': [CommandCapability.SEARCH],
33:             'sed': [CommandCapability.TRANSFORM],
34:             'awk': [CommandCapability.FILTER, CommandCapability.TRANSFORM],
35:             'ls': [CommandCapability.LIST],
36:             'mkdir': [CommandCapability.MODIFY]
37:         };
38:         const capabilities = capMap[utility] || [CommandCapability.READ];
39:         const constraints = Math.random() > 0.5 ? ['RECURSIVE'] : [];
40:         const problem: ProblemDefinition = {
41:             objective: `Solve system anomaly using ${utility.toUpperCase()}`,
42:             capabilities,
43:             constraints,
44:             targetSystem
45:         };
46:         return this.factory.createMission(problem);
47:     }
48:     private generateRandomMission(targetSystem: string): Mission {
49:         const capabilitiesPool = [
50:             [CommandCapability.SEARCH],
51:             [CommandCapability.LIST],
52:             [CommandCapability.MODIFY],
53:             [CommandCapability.TRANSFORM],
54:             [CommandCapability.READ]
55:         ];
56:         const constraintsPool = ['RECURSIVE', 'DETAILS', 'SHOW_HIDDEN', 'FORCE'];
57:         const problem: ProblemDefinition = {
58:             objective: "Perform randomized tactical data maneuver",
59:             capabilities: capabilitiesPool[Math.floor(Math.random() * capabilitiesPool.length)],
60:             constraints: [constraintsPool[Math.floor(Math.random() * constraintsPool.length)]],
61:             targetSystem
62:         };
63:         return this.factory.createMission(problem);
64:     }
65: }
