251:     /**
252:      * Generator for Phosphorus Aesthetics.
253:      * Pure function to create themed styles with glow effects.
254:      */
255:     const createPhosphorStyles = (colors: any, settings: any) => StyleSheet.create({
256:         scrollContent: {
257:             paddingBottom: THEME.spacing.xl,
258:         },
259:         outputText: {
