<file path="src/domain/entities/SchemeValue.ts">
 1: export type SchemeType =
 2:     | 'number'
 3:     | 'symbol'
 4:     | 'boolean'
 5:     | 'string'
 6:     | 'char'
 7:     | 'pair'
 8:     | 'null'
 9:     | 'vector'
10:     | 'bytevector'
11:     | 'procedure'
12:     | 'keyword'
13:     | 'eof';
14: export interface SchemeValue {
15:     readonly type: SchemeType;
16:     readonly value: any;
17: }
18: export const makeNumber = (n: number): SchemeValue => ({ type: 'number', value: n });
19: export const makeSymbol = (name: string): SchemeValue => ({ type: 'symbol', value: name.toLowerCase() });
20: export const makeBoolean = (b: boolean): SchemeValue => ({ type: 'boolean', value: b });
21: export const makeString = (s: string): SchemeValue => ({ type: 'string', value: s });
22: export const makePair = (car: SchemeValue, cdr: SchemeValue): SchemeValue => ({
23:     type: 'pair',
24:     value: { car, cdr }
25: });
26: export const makeChar = (c: string): SchemeValue => ({ type: 'char', value: c });
27: export const makeVector = (elements: SchemeValue[]): SchemeValue => ({ type: 'vector', value: elements });
28: export const makeBytevector = (bytes: Uint8Array): SchemeValue => ({ type: 'bytevector', value: bytes });
29: export const NIL: SchemeValue = { type: 'null', value: null };
30: export const EOF: SchemeValue = { type: 'eof', value: null };
31: export interface Procedure {
32:     readonly name?: string;
33:     readonly isBuiltin: boolean;
34:     readonly params?: string[];
35:     readonly body?: SchemeValue;
36:     readonly env?: any;
37:     readonly call?: (args: SchemeValue[]) => SchemeValue;
38: }
39: export const makeProcedure = (proc: Procedure): SchemeValue => ({
40:     type: 'procedure',
41:     value: proc
42: });
43: export const isList = (v: SchemeValue): boolean => {
44:     if (v.type === 'null') return true;
45:     if (v.type !== 'pair') return false;
46:     return isList(v.value.cdr);
47: };
48: export const arrayToList = (arr: SchemeValue[]): SchemeValue => {
49:     return arr.reduceRight((acc, val) => makePair(val, acc), NIL);
50: };
51: export const listToArray = (list: SchemeValue): SchemeValue[] => {
52:     const arr: SchemeValue[] = [];
53:     let curr = list;
54:     while (curr.type === 'pair') {
55:         arr.push(curr.value.car);
56:         curr = curr.value.cdr;
57:     }
58:     return arr;
59: };
60: export const schemeToString = (v: SchemeValue): string => {
61:     switch (v.type) {
62:         case 'number': return String(v.value);
63:         case 'symbol': return v.value;
64:         case 'boolean': return v.value ? '#t' : '#f';
65:         case 'string': return `"${v.value}"`;
66:         case 'null': return '()';
67:         case 'pair': {
68:             const items = listToArray(v);
69:             const isProper = isList(v);
70:             if (isProper) {
71:                 return `(${items.map(schemeToString).join(' ')})`;
72:             } else {
73:                 return `(${schemeToString(v.value.car)} . ${schemeToString(v.value.cdr)})`;
74:             }
75:         }
76:         case 'char': {
77:             if (v.value === ' ') return '#\\space';
78:             if (v.value === '\n') return '#\\newline';
79:             return `#\\${v.value}`;
80:         }
81:         case 'vector': return `#(${v.value.map(schemeToString).join(' ')})`;
82:         case 'bytevector': return `#u8(${Array.from(v.value as Uint8Array).join(' ')})`;
83:         case 'eof': return '#<eof>';
84:         case 'procedure': return `#<procedure${v.value.name ? `:${v.value.name}` : ''}>`;
85:         default: return '#<unknown>';
86:     }
87: };
</file>

<file path="src/domain/entities/Signal.ts">
 1: export const SIGNALS: Record<string, number> = {
 2:     HUP: 1,
 3:     INT: 2,
 4:     QUIT: 3,
 5:     ILL: 4,
 6:     TRAP: 5,
 7:     ABRT: 6,
 8:     BUS: 7,
 9:     FPE: 8,
10:     KILL: 9,
11:     USR1: 10,
12:     SEGV: 11,
13:     USR2: 12,
14:     PIPE: 13,
15:     ALRM: 14,
16:     TERM: 15,
17:     STOP: 19,
18:     TSTP: 20,
19:     CONT: 18,
20:     CHLD: 17,
21:     TTIN: 21,
22:     TTOU: 22,
23:     URG: 23,
24:     XCPU: 24,
25:     XFSZ: 25,
26:     VTALRM: 26,
27:     PROF: 27,
28:     WINCH: 28,
29:     IO: 29,
30:     PWR: 30,
31:     SYS: 31,
32: } as const;
33: export function getSignalName(signalNumber: number): string | undefined {
34:     for (const [name, num] of Object.entries(SIGNALS)) {
35:         if (num === signalNumber) {
36:             return name;
37:         }
38:     }
39:     return undefined;
40: }
41: export function parseSignal(spec: string): number | undefined {
42:     const numericValue = parseInt(spec, 10);
43:     if (!isNaN(numericValue) && numericValue >= 0) {
44:         if (numericValue === 0) return 0;
45:         if (getSignalName(numericValue) !== undefined) return numericValue;
46:         if (numericValue <= 64) return numericValue;
47:         return undefined;
48:     }
49:     const upperName = spec.toUpperCase();
50:     const normalizedName = upperName.startsWith('SIG')
51:         ? upperName.slice(3)
52:         : upperName;
53:     return SIGNALS[normalizedName];
54: }
55: export function listSignals(): string[] {
56:     return Object.entries(SIGNALS)
57:         .sort(([, a], [, b]) => a - b)
58:         .map(([name]) => name);
59: }
60: export const DEFAULT_SIGNAL = SIGNALS.TERM;
61: export const UNCATCHABLE_SIGNALS = [SIGNALS.KILL, SIGNALS.STOP] as const;
</file>

<file path="src/domain/entities/Stream.ts">
  1: export interface IStream {
  2:     read(): string | null;
  3:     readLine(): string | null;
  4:     write(data: string): void;
  5:     close(): void;
  6:     isClosed(): boolean;
  7:     hasData(): boolean;
  8: }
  9: export class StringStream implements IStream {
 10:     private buffer: string = '';
 11:     private closed: boolean = false;
 12:     private readPosition: number = 0;
 13:     constructor(initialData: string = '') {
 14:         this.buffer = initialData;
 15:     }
 16:     read(): string | null {
 17:         if (this.readPosition >= this.buffer.length) {
 18:             return this.closed ? null : '';
 19:         }
 20:         const data = this.buffer.substring(this.readPosition);
 21:         this.readPosition = this.buffer.length;
 22:         return data;
 23:     }
 24:     readLine(): string | null {
 25:         if (this.readPosition >= this.buffer.length) {
 26:             return this.closed ? null : '';
 27:         }
 28:         const newlineIndex = this.buffer.indexOf('\n', this.readPosition);
 29:         if (newlineIndex === -1) {
 30:             if (this.closed) {
 31:                 const line = this.buffer.substring(this.readPosition);
 32:                 this.readPosition = this.buffer.length;
 33:                 return line.length > 0 ? line : null;
 34:             }
 35:             return null;
 36:         }
 37:         const line = this.buffer.substring(this.readPosition, newlineIndex + 1);
 38:         this.readPosition = newlineIndex + 1;
 39:         return line;
 40:     }
 41:     write(data: string): void {
 42:         if (this.closed) {
 43:             throw new Error('Cannot write to closed stream');
 44:         }
 45:         this.buffer += data;
 46:     }
 47:     close(): void {
 48:         this.closed = true;
 49:     }
 50:     isClosed(): boolean {
 51:         return this.closed;
 52:     }
 53:     hasData(): boolean {
 54:         return this.readPosition < this.buffer.length;
 55:     }
 56:     getContents(): string {
 57:         return this.buffer;
 58:     }
 59:     getUnread(): string {
 60:         return this.buffer.substring(this.readPosition);
 61:     }
 62: }
 63: export class PipeStream implements IStream {
 64:     private buffer: string[] = [];
 65:     private closed: boolean = false;
 66:     private partial: string = ''; // Incomplete line buffer
 67:     read(): string | null {
 68:         if (this.buffer.length === 0 && this.partial.length === 0) {
 69:             return this.closed ? null : '';
 70:         }
 71:         let result = this.buffer.join('');
 72:         this.buffer = [];
 73:         if (this.closed && this.partial.length > 0) {
 74:             result += this.partial;
 75:             this.partial = '';
 76:         }
 77:         return result;
 78:     }
 79:     readLine(): string | null {
 80:         // Check if we have a complete line in buffer
 81:         for (let i = 0; i < this.buffer.length; i++) {
 82:             const chunk = this.buffer[i];
 83:             const newlineIndex = chunk.indexOf('\n');
 84:             if (newlineIndex !== -1) {
 85:                 const line = this.buffer.slice(0, i).join('') + chunk.substring(0, newlineIndex + 1);
 86:                 // Keep remainder in buffer
 87:                 const remainder = chunk.substring(newlineIndex + 1);
 88:                 this.buffer = remainder.length > 0 ? [remainder, ...this.buffer.slice(i + 1)] : this.buffer.slice(i + 1);
 89:                 return line;
 90:             }
 91:         }
 92:         // No complete line in buffer
 93:         if (this.closed) {
 94:             // Return remaining as final line
 95:             if (this.buffer.length > 0 || this.partial.length > 0) {
 96:                 const line = this.buffer.join('') + this.partial;
 97:                 this.buffer = [];
 98:                 this.partial = '';
 99:                 return line.length > 0 ? line : null;
100:             }
101:             return null;
102:         }
103:         return null; // No complete line yet
104:     }
105:     write(data: string): void {
106:         if (this.closed) {
107:             throw new Error('Cannot write to closed pipe');
108:         }
109:         this.buffer.push(data);
110:     }
111:     close(): void {
112:         this.closed = true;
113:     }
114:     isClosed(): boolean {
115:         return this.closed;
116:     }
117:     hasData(): boolean {
118:         return this.buffer.length > 0 || this.partial.length > 0;
119:     }
120: }
121: export class NullStream implements IStream {
122:     read(): string | null { return null; }
123:     readLine(): string | null { return null; }
124:     write(_data: string): void {  }
125:     close(): void { }
126:     isClosed(): boolean { return true; }
127:     hasData(): boolean { return false; }
128: }
129: export function createStdinStream(input?: string): IStream {
130:     const stream = new StringStream(input || '');
131:     if (input !== undefined) {
132:         stream.close();
133:     }
134:     return stream;
135: }
136: export function createOutputStream(): StringStream {
137:     return new StringStream();
138: }
</file>

