  7: export class EdCommand implements ICommand {
  8:     private buffer: string[] = [];
  9:     private currentLine = 0;
 10:     private filename = '';
 11:     private mode: 'command' | 'input' = 'command';
 12:     private inputBuffer: string[] = [];
 13:     constructor(private fs: FileSystemService) { }
 14:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
 15:         const input = getStdinAsString(context);
 16:         this.buffer = [];
 17:         this.currentLine = 0;
 18:         this.filename = '';
 19:         this.mode = 'command';
 20:         this.inputBuffer = [];
 21:         if (args.length > 0) {
 22:             this.filename = args[0];
 23:             const resolvedPath = this.resolvePath(this.filename, state);
 24:             try {
 25:                 try {
 26:                     const content = this.fs.readFile(resolvedPath);
 27:                     if (content) {
 28:                         this.buffer = content.split('\n');
 29:                         this.currentLine = this.buffer.length;
 30:                     }
 31:                 } catch (e) {
 32:                 }
 33:             } catch (e) {
 34:             }
 35:         }
 36:         if (!input) {
 37:             return {
 38:                 output: 'ed: interactive mode not supported (provide script via stdin)',
 39:                 newState: state,
 40:                 exitCode: 1
 41:             };
 42:         }
 43:         const scriptLines = input.split('\n');
 44:         const outputLines: string[] = [];
 45:         for (const line of scriptLines) {
 46:             if ((this.mode as string) === 'input') {
 47:                 if (line === '.') {
 48:                     this.mode = 'command';
 49:                     this.buffer.splice(this.currentLine, 0, ...this.inputBuffer);
 50:                     this.currentLine += this.inputBuffer.length;
 51:                     this.inputBuffer = [];
 52:                 } else {
 53:                     this.inputBuffer.push(line);
 54:                 }
 55:             } else {
 56:                 const trimmed = line.trim();
 57:                 if (!trimmed) continue;
 58:                 this.processCommand(trimmed, outputLines, state);
 59:             }
 60:         }
 61:         return {
 62:             output: outputLines.join('\n'),
 63:             newState: state,
 64:             exitCode: 0
 65:         };
 66:     }
 67:     private resolvePath(path: string, state: TerminalState): string {
 68:         if (path.startsWith('/')) return path;
 69:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
 70:     }
 71:     private processCommand(cmdStr: string, output: string[], state: TerminalState): void {
 72:         const match = cmdStr.match(/^([0-9.,$]*)(.*)$/);
 73:         if (!match) return;
 74:         const addrStr = match[1];
 75:         const command = match[2];
 76:         if (!command) return;
 77:         const cmdChar = command[0];
 78:         const param = command.slice(1).trim();
 79:         let startLine = this.currentLine;
 80:         let endLine = this.currentLine;
 81:         if (addrStr) {
 82:             const range = this.parseAddress(addrStr);
 83:             startLine = range.start;
 84:             endLine = range.end;
 85:         }
 86:         switch (cmdChar) {
 87:             case 'p':
 88:                 for (let i = startLine; i <= endLine; i++) {
 89:                     if (i > 0 && i <= this.buffer.length) {
 90:                         output.push(this.buffer[i - 1]);
 91:                     }
 92:                 }
 93:                 this.currentLine = endLine;
 94:                 break;
 95:             case 'd':
 96:                 const count = endLine - startLine + 1;
 97:                 if (startLine > 0 && startLine <= this.buffer.length) {
 98:                     this.buffer.splice(startLine - 1, count);
 99:                     this.currentLine = Math.min(startLine, this.buffer.length);
100:                 }
101:                 break;
102:             case 'a':
103:                 this.mode = 'input';
104:                 this.currentLine = endLine;
105:                 break;
106:             case 'w':
107:                 let target = this.filename;
108:                 if (param) target = param;
109:                 if (!target) {
110:                     output.push('?');
111:                     break;
112:                 }
113:                 const path = this.resolvePath(target, state);
114:                 const content = this.buffer.join('\n');
115:                 try {
116:                     this.fs.writeFile(path, content, 'w');
117:                     output.push(content.length.toString());
118:                 } catch (e) {
119:                     output.push('?');
120:                 }
121:                 break;
122:             case 'q':
123:                 break;
124:             default:
125:                 output.push('?');
126:                 break;
127:         }
128:     }
129:     private parseAddress(addr: string): { start: number, end: number } {
130:         const parts = addr.split(',');
131:         const parseSingle = (s: string): number => {
132:             if (s === '.') return this.currentLine;
133:             if (s === '$') return this.buffer.length;
134:             const n = parseInt(s, 10);
135:             return isNaN(n) ? this.currentLine : n;
136:         };
137:         if (parts.length === 1) {
138:             const val = parseSingle(parts[0]);
139:             return { start: val, end: val };
140:         } else {
141:             return { start: parseSingle(parts[0]), end: parseSingle(parts[1]) };
142:         }
143:     }
144: }
