<file path="src/domain/commands/core/TeeCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { TerminalState } from '../../entities/TerminalState';
 5: import { CommandResponse } from '../../entities/Command';
 6: import { FileSystemService } from '../../services/FileSystemService';
 7: export class TeeCommand implements ICommand {
 8:     constructor(private fs: FileSystemService) { }
 9:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
10:         const input = getStdinAsString(context);
11:         const files: string[] = [];
12:         let append = false;
13:         for (const arg of args) {
14:             if (arg === '-a') {
15:                 append = true;
16:             } else if (!arg.startsWith('-')) {
17:                 files.push(arg);
18:             }
19:         }
20:         const content = input || '';
21:         let exitCode = 0;
22:         // Write to files
23:         for (const file of files) {
24:             try {
25:                 const path = this.resolvePath(file, state);
26:                 // Check parent dir
27:                 const parentPath = path.substring(0, path.lastIndexOf('/')) || '/';
28:                 const parent = this.fs.resolve(parentPath);
29:                 if (!parent || !this.fs.isDirectory(parent)) {
30:                     throw new Error('No such directory');
31:                 }
32:                 if (append) {
33:                     let existing = '';
34:                     try {
35:                         existing = this.fs.readFile(path);
36:                     } catch (e) {
37:                         // ignore if missing
38:                     }
39:                     this.fs.writeFile(path, existing + content, 'w');
40:                 } else {
41:                     this.fs.writeFile(path, content, 'w');
42:                 }
43:             } catch (e) {
44:                 exitCode = 1;
45:             }
46:         }
47:         return {
48:             output: content,
49:             newState: state,
50:             exitCode: exitCode
51:         };
52:     }
53:     private resolvePath(path: string, state: TerminalState): string {
54:         if (path.startsWith('/')) return path;
55:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
56:     }
57: }
</file>

