 95:     const widthAnim = useRef(new Animated.Value(350)).current;
 96:     const performClearAnimation = async () => {
 97:         const currentHistory = [...history];
 98:         for (let i = currentHistory.length - 1; i >= 0; i--) {
 99:             await new Promise(resolve => setTimeout(resolve, 50));
100:             setHistory(prev => prev.slice(0, i));
101:         }
102:         setHistory([]);
103:     };
104:     useEffect(() => {
105:         const unsub = bus.subscribe(GameEventType.TUTOR_EVENT, (event) => {
106:             const { type, payload } = event.payload;
107:             if (type === 'PRESENTATION_START') {
108:                 setActiveCard({
