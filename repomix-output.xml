295:             fontSize: THEME.typography.fontSize.md,
296:         },
297:         cardContainer: {
298:             borderWidth: 1,
299:             borderColor: colors.primary,
300:             marginBottom: THEME.spacing.md,
301:             marginTop: THEME.spacing.xs,
302:         },
303:         cardHeader: {
304:             backgroundColor: colors.primary,
305:             paddingHorizontal: THEME.spacing.sm,
306:             paddingVertical: 2,
307:         },
308:         cardHeaderText: {
309:             color: colors.background,
310:             fontFamily: settings.fontFamily,
311:             fontSize: 10,
312:             fontWeight: 'bold',
313:             letterSpacing: 1,
