 12: export type ActiveView = 'SHELL' | 'COMMS' | 'BUFFERS';
 13: export const useHeadlessTerminal = (
 14:     fs: FileSystem,
 15:     commandCoordinator: CommandCoordinator,
 16:     gameManager: GameManager,
 17:     tutorShadow: TutorShadow,
 18:     simulationMediator: SimulationMediator
 19: ) => {
 20:     const [activeView, setActiveView] = useState<ActiveView>('SHELL');
 21:     const [contextualHint, setContextualHint] = useState<string | null>(null);
 22:     const lastActivityRef = useRef<number>(Date.now());
 23:     const missionVM = useMissionViewModel(gameManager);
 24:     const shellVM = useShellViewModel(
 25:         fs,
 26:         commandCoordinator as any,
 27:         gameManager,
