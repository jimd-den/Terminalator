 1: export class CpuState {
 2:     private registers: Int32Array = new Int32Array(32);
 3:     public pc: number = 0;
 4:     private memory: Uint8Array = new Uint8Array(64 * 1024);
 5:     public isHalted: boolean = false;
 6:     public exitCode: number = 0;
 7:     constructor() {
 8:         this.reset();
 9:     }
10:     loadMemory(data: Uint8Array): void {
11:         this.memory.set(data);
12:     }
13:     reset(): void {
14:         this.registers.fill(0);
15:         this.pc = 0;
16:         this.isHalted = false;
17:         this.exitCode = 0;
18:     }
19:     getRegister(index: number): number {
20:         if (index === 0) return 0;
21:         return this.registers[index & 0x1F];
22:     }
23:     setRegister(index: number, value: number): void {
24:         if (index === 0) return;
25:         this.registers[index & 0x1F] = value;
26:     }
27:     readByte(address: number): number {
28:         return this.memory[address % this.memory.length];
29:     }
30:     writeByte(address: number, value: number): void {
31:         this.memory[address % this.memory.length] = value & 0xFF;
32:     }
33:     readWord(address: number): number {
34:         const addr = address % this.memory.length;
35:         return (this.memory[addr] |
36:             (this.memory[addr + 1] << 8) |
37:             (this.memory[addr + 2] << 16) |
38:             (this.memory[addr + 3] << 24));
39:     }
40:     writeWord(address: number, value: number): void {
41:         const addr = address % this.memory.length;
42:         this.memory[addr] = value & 0xFF;
43:         this.memory[addr + 1] = (value >> 8) & 0xFF;
44:         this.memory[addr + 2] = (value >> 16) & 0xFF;
45:         this.memory[addr + 3] = (value >> 24) & 0xFF;
46:     }
47:     static getRegisterName(index: number): string {
48:         const names = [
49:             'zero', 'ra', 'sp', 'gp', 'tp', 't0', 't1', 't2',
50:             's0', 's1', 'a0', 'a1', 'a2', 'a3', 'a4', 'a5',
51:             'a6', 'a7', 's2', 's3', 's4', 's5', 's6', 's7',
52:             's8', 's9', 's10', 's11', 't3', 't4', 't5', 't6'
53:         ];
54:         return names[index] || `x${index}`;
55:     }
56: }
</file>

