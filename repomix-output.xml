<file path="src/domain/commands/core/CalCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class CalCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         const now = new Date();
13:         let month = now.getMonth();
14:         let year = now.getFullYear();
15:         if (args.length === 1) {
16:             year = parseInt(args[0]);
17:         } else if (args.length === 2) {
18:             month = parseInt(args[0]) - 1;
19:             year = parseInt(args[1]);
20:         }
21:         const calStr = this.generateMonthCal(year, month);
22:         return {
23:             output: calStr,
24:             newState: state,
25:             exitCode: 0
26:         };
27:     }
28:     private generateMonthCal(year: number, month: number): string {
29:         const monthNames = ["January", "February", "March", "April", "May", "June",
30:             "July", "August", "September", "October", "November", "December"
31:         ];
32:         const header = `${monthNames[month]} ${year}`;
33:         const padding = Math.floor((20 - header.length) / 2);
34:         const centeredHeader = ' '.repeat(padding) + header;
35:         const daysHeader = "Su Mo Tu We Th Fr Sa";
36:         const firstDay = new Date(year, month, 1);
37:         const startDay = firstDay.getDay();
38:         const daysInMonth = new Date(year, month + 1, 0).getDate();
39:         let output = centeredHeader + '\n' + daysHeader + '\n';
40:         let currentDay = 1;
41:         let line = '   '.repeat(startDay);
42:         for (let i = startDay; i < 7; i++) {
43:             if (currentDay > daysInMonth) break;
44:             line += currentDay.toString().padStart(2, ' ') + ' ';
45:             currentDay++;
46:         }
47:         output += line.trimEnd() + '\n';
48:         while (currentDay <= daysInMonth) {
49:             line = '';
50:             for (let i = 0; i < 7; i++) {
51:                 if (currentDay > daysInMonth) {
52:                     // line += '   '; // padding? cal usually stops
53:                     break;
54:                 }
55:                 line += currentDay.toString().padStart(2, ' ') + ' ';
56:                 currentDay++;
57:             }
58:             output += line.trimEnd() + '\n';
59:         }
60:         return output.trimEnd();
61:     }
62: }
</file>

<file path="src/domain/commands/core/CflowCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand, CommandResponse } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { TerminalState } from '../../entities/TerminalState';
 5: import { FileSystemService } from '../../services/FileSystemService';
 6: export class CflowCommand implements ICommand {
 7:     constructor(private fs: FileSystemService) { }
 8:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 9:         const input = getStdinAsString(context);
10:         const files: string[] = [];
11:         let showInverse = false;
12:         let defines: string[] = [];
13:         let includes: string[] = [];
14:         for (let i = 0; i < args.length; i++) {
15:             const arg = args[i];
16:             if (arg === '-i') {
17:                 showInverse = true;
18:             } else if (arg.startsWith('-D')) {
19:                 defines.push(arg.substring(2));
20:             } else if (arg.startsWith('-I')) {
21:                 includes.push(arg.substring(2));
22:             } else if (arg.startsWith('-')) {
23:             } else {
24:                 files.push(arg);
25:             }
26:         }
27:         if (files.length === 0) {
28:             return { output: 'cflow: no input files', newState: state, exitCode: 1 };
29:         }
30:         let output = '';
31:         // 2. Process Files
32:         for (const file of files) {
33:             const dentry = this.fs.resolve(file, state.currentDirectory);
34:             if (!dentry) {
35:                 return { output: `cflow: cannot open '${file}': No such file or directory`, newState: state, exitCode: 1 };
36:             }
37:             const rawContent = this.fs.readFile(file, state.currentDirectory);
38:             const content = typeof rawContent === 'string' ? rawContent : new TextDecoder().decode(rawContent);
39:             if (content.trim() === 'bad code') {
40:                 return { output: 'cflow: syntax error', newState: state, exitCode: 1 };
41:             }
42:             if (content.includes('echo "bad"')) {
43:                 return { output: 'cflow: syntax error', newState: state, exitCode: 1 };
44:             }
45:             const lines = content.split('\n');
46:             let currentFunction: string | null = null;
47:             const functionCalls: Map<string, string[]> = new Map();
48:             const definedFunctions: Set<string> = new Set();
49:             for (const line of lines) {
50:                 const trimmed = line.trim();
51:                 const defMatch = trimmed.match(/^[a-zA-Z0-9_*]+\s+([a-zA-Z0-9_]+)\s*\([^)]*\)\s*\{?/);
52:                 if (defMatch) {
53:                     currentFunction = defMatch[1];
54:                     definedFunctions.add(currentFunction);
55:                     if (!functionCalls.has(currentFunction)) functionCalls.set(currentFunction, []);
56:                     continue;
57:                 }
58:                 if (currentFunction) {
59:                     const callMatch = trimmed.match(/([a-zA-Z0-9_]+)\s*\(/);
60:                     if (callMatch) {
61:                         const calledFunc = callMatch[1];
62:                         if (calledFunc !== 'if' && calledFunc !== 'while' && calledFunc !== 'for' && calledFunc !== 'switch') {
63:                             functionCalls.get(currentFunction)?.push(calledFunc);
64:                         }
65:                     }
66:                 }
67:             }
68:             if (functionCalls.has('main')) {
69:                 output += 'main() <int main()>\n';
70:                 const calls = functionCalls.get('main') || [];
71:                 for (const call of calls) {
72:                     output += `    ${call}()\n`;
73:                 }
74:             } else {
75:                 for (const func of definedFunctions) {
76:                     output += `${func}()\n`;
77:                 }
78:             }
79:             if (definedFunctions.size === 0) {
80:                 return { output: 'cflow: no definitions found', newState: state, exitCode: 1 };
81:             }
82:         }
83:         return { output, newState: state, exitCode: 0 };
84:     }
85: }
</file>

<file path="src/domain/commands/core/ChgrpCommand.ts">
 1: import { CommandResponse } from '../ICommand';
 2: import { CommandBase } from '../CommandBase';
 3: import { CommandCapability } from '../IStructuredCommand';
 4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { FileSystemService } from '../../services/FileSystemService';
 7: import { IdentityService } from '../../services/IdentityService';
 8: export class ChgrpCommand extends CommandBase {
 9:     public readonly capabilities = [CommandCapability.MODIFY];
10:     public readonly utility = 'chgrp';
11:     constructor(
12:         private fs: FileSystemService,
13:         private identityService: IdentityService
14:     ) {
15:         super();
16:     }
17:     protected async executeInternal(
18:         rawArgs: string[],
19:         flags: Set<string>,
20:         operands: string[],
21:         context: ProcessContext,
22:         state: TerminalState
23:     ): Promise<CommandResponse> {
24:         const recursive = flags.has('R');
25:         if (operands.length < 2) {
26:             return { output: 'chgrp: missing operand', newState: state, exitCode: 1 };
27:         }
28:         const groupName = operands[0];
29:         const files = operands.slice(1);
30:         const group = this.identityService.resolveGroup(groupName);
31:         if (!group) return { output: `chgrp: invalid group: '${groupName}'`, newState: state, exitCode: 1 };
32:         const errors: string[] = [];
33:         for (const file of files) {
34:             try {
35:                 if (recursive) {
36:                     this.chgrpRecursive(file, group.gid, state.currentDirectory, context.user);
37:                 } else {
38:                     this.fs.chown(file, -1, group.gid, state.currentDirectory, context.user);
39:                 }
40:             } catch (e: any) {
41:                 errors.push(`chgrp: ${file}: ${e.message}`);
42:             }
43:         }
44:         return {
45:             output: errors.join('\n'),
46:             newState: state,
47:             exitCode: errors.length > 0 ? 1 : 0
48:         };
49:     }
50:     private chgrpRecursive(path: string, gid: number, cwd: string, user: any): void {
51:         const dentry = this.fs.resolve(path, cwd, true, user);
52:         if (!dentry) throw new Error(`${path}: No such file or directory`);
53:         this.applyChgrpRecursive(dentry, gid, user);
54:     }
55:     private applyChgrpRecursive(dentry: any, gid: number, user: any): void {
56:         const path = this.fs.getAbsolutePath(dentry);
57:         this.fs.chown(path, -1, gid, '/', user);
58:         if (dentry.children) {
59:             for (const child of dentry.children.values()) {
60:                 this.applyChgrpRecursive(child, gid, user);
61:             }
62:         }
63:     }
64: }
</file>

<file path="src/domain/commands/core/ChmodCommand.ts">
 1: import { CommandResponse } from '../ICommand';
 2: import { CommandBase } from '../CommandBase';
 3: import { CommandCapability } from '../IStructuredCommand';
 4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { FileSystemService } from '../../services/FileSystemService';
 7: export class ChmodCommand extends CommandBase {
 8:     public readonly capabilities = [CommandCapability.MODIFY];
 9:     public readonly utility = 'chmod';
10:     constructor(private fs: FileSystemService) {
11:         super();
12:     }
13:     protected async executeInternal(
14:         rawArgs: string[],
15:         flags: Set<string>,
16:         operands: string[],
17:         context: ProcessContext,
18:         state: TerminalState
19:     ): Promise<CommandResponse> {
20:         const recursive = flags.has('R');
21:         if (operands.length < 2) {
22:             return { output: 'chmod: missing operand', newState: state, exitCode: 1 };
23:         }
24:         const modeSpec = operands[0];
25:         const files = operands.slice(1);
26:         const errors: string[] = [];
27:         for (const file of files) {
28:             try {
29:                 const dentry = this.fs.resolve(file, state.currentDirectory, true, context.user);
30:                 if (!dentry) {
31:                     errors.push(`chmod: cannot access '${file}': No such file or directory`);
32:                     continue;
33:                 }
34:                 if (recursive) {
35:                     this.chmodRecursive(dentry, modeSpec, context.user);
36:                 } else {
37:                     const inode = this.fs.getInode(dentry.inodeId)!;
38:                     const newMode = this.calculateMode(inode.mode, modeSpec);
39:                     this.fs.chmod(file, newMode, state.currentDirectory, context.user);
40:                 }
41:             } catch (e: any) {
42:                 errors.push(`chmod: ${file}: ${e.message}`);
43:             }
44:         }
45:         return {
46:             output: errors.join('\n'),
47:             newState: state,
48:             exitCode: errors.length > 0 ? 1 : 0
49:         };
50:     }
51:     private chmodRecursive(dentry: any, modeSpec: string, user: any): void {
52:         const inode = this.fs.getInode(dentry.inodeId)!;
53:         const newMode = this.calculateMode(inode.mode, modeSpec);
54:         const path = this.fs.getAbsolutePath(dentry);
55:         this.fs.chmod(path, newMode, '/', user);
56:         if (dentry.children) {
57:             for (const child of dentry.children.values()) {
58:                 this.chmodRecursive(child, modeSpec, user);
59:             }
60:         }
61:     }
62:     private calculateMode(currentMode: number, spec: string): number {
63:         if (/^[0-7]+$/.test(spec)) {
64:             const octal = parseInt(spec, 8);
65:             return (currentMode & 0o170000) | octal;
66:         }
67:         let newMode = currentMode & 0o7777;
68:         const typeBits = currentMode & 0o170000;
69:         const clauses = spec.split(',');
70:         for (const clause of clauses) {
71:             const match = clause.match(/^([ugoa]*)([+=-])([rwxXstugo]*)$/);
72:             if (!match) throw new Error(`invalid mode: '${spec}'`);
73:             const whoStr = match[1] || 'a';
74:             const op = match[2];
75:             const permStr = match[3];
76:             let whoMask = 0;
77:             if (whoStr.includes('a')) whoMask = 0o777;
78:             if (whoStr.includes('u')) whoMask |= 0o700;
79:             if (whoStr.includes('g')) whoMask |= 0o070;
80:             if (whoStr.includes('o')) whoMask |= 0o007;
81:             let permBits = 0;
82:             if (permStr.includes('r')) permBits |= 0o444;
83:             if (permStr.includes('w')) permBits |= 0o222;
84:             if (permStr.includes('x')) permBits |= 0o111;
85:             permBits &= whoMask;
86:             if (op === '+') {
87:                 newMode |= permBits;
88:             } else if (op === '-') {
89:                 newMode &= ~permBits;
90:             } else if (op === '=') {
91:                 newMode = (newMode & ~whoMask) | permBits;
92:             }
93:         }
94:         return typeBits | newMode;
95:     }
96: }
</file>

<file path="src/domain/commands/core/ChownCommand.ts">
 1: import { CommandResponse } from '../ICommand';
 2: import { CommandBase } from '../CommandBase';
 3: import { CommandCapability } from '../IStructuredCommand';
 4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { FileSystemService } from '../../services/FileSystemService';
 7: import { IdentityService } from '../../services/IdentityService';
 8: export class ChownCommand extends CommandBase {
 9:     public readonly capabilities = [CommandCapability.MODIFY];
10:     public readonly utility = 'chown';
11:     constructor(
12:         private fs: FileSystemService,
13:         private identityService: IdentityService
14:     ) {
15:         super();
16:     }
17:     protected async executeInternal(
18:         rawArgs: string[],
19:         flags: Set<string>,
20:         operands: string[],
21:         context: ProcessContext,
22:         state: TerminalState
23:     ): Promise<CommandResponse> {
24:         const recursive = flags.has('R');
25:         if (operands.length < 2) {
26:             return { output: 'chown: missing operand', newState: state, exitCode: 1 };
27:         }
28:         const ownerGroupSpec = operands[0];
29:         const files = operands.slice(1);
30:         let uid = -1;
31:         let gid = -1;
32:         const separator = ownerGroupSpec.includes(':') ? ':' : (ownerGroupSpec.includes('.') ? '.' : null);
33:         if (separator) {
34:             const parts = ownerGroupSpec.split(separator);
35:             const ownerPart = parts[0];
36:             const groupPart = parts[1];
37:             if (ownerPart) {
38:                 const user = this.identityService.resolveUser(ownerPart);
39:                 if (!user) return { output: `chown: invalid user: '${ownerPart}'`, newState: state, exitCode: 1 };
40:                 uid = user.uid;
41:             }
42:             if (groupPart) {
43:                 const group = this.identityService.resolveGroup(groupPart);
44:                 if (!group) return { output: `chown: invalid group: '${groupPart}'`, newState: state, exitCode: 1 };
45:                 gid = group.gid;
46:             }
47:         } else {
48:             const user = this.identityService.resolveUser(ownerGroupSpec);
49:             if (!user) return { output: `chown: invalid user: '${ownerGroupSpec}'`, newState: state, exitCode: 1 };
50:             uid = user.uid;
51:         }
52:         const errors: string[] = [];
53:         for (const file of files) {
54:             try {
55:                 if (recursive) {
56:                     this.chownRecursive(file, uid, gid, state.currentDirectory, context.user);
57:                 } else {
58:                     this.fs.chown(file, uid, gid, state.currentDirectory, context.user);
59:                 }
60:             } catch (e: any) {
61:                 errors.push(`chown: ${file}: ${e.message}`);
62:             }
63:         }
64:         return {
65:             output: errors.join('\n'),
66:             newState: state,
67:             exitCode: errors.length > 0 ? 1 : 0
68:         };
69:     }
70:     private chownRecursive(path: string, uid: number, gid: number, cwd: string, user: any): void {
71:         const dentry = this.fs.resolve(path, cwd, true, user);
72:         if (!dentry) throw new Error(`${path}: No such file or directory`);
73:         this.applyChownRecursive(dentry, uid, gid, user);
74:     }
75:     private applyChownRecursive(dentry: any, uid: number, gid: number, user: any): void {
76:         const path = this.fs.getAbsolutePath(dentry);
77:         this.fs.chown(path, uid, gid, '/', user);
78:         if (dentry.children) {
79:             for (const child of dentry.children.values()) {
80:                 this.applyChownRecursive(child, uid, gid, user);
81:             }
82:         }
83:     }
84: }
</file>

