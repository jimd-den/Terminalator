164:     private static parseArgs(func: string, argsStr: string, ere: boolean): any {
165:         switch (func) {
166:             case 's': {
167:                 const delim = argsStr[0];
168:                 if (!delim) throw new Error("Missing delimiter");
169:                 const parts: string[] = [];
170:                 let current = '';
171:                 let dCount = 0;
172:                 for (let i = 1; i < argsStr.length; i++) {
173:                     if (argsStr[i] === delim && argsStr[i - 1] !== '\\') {
174:                         parts.push(current); current = ''; dCount++;
175:                         if (dCount === 2) { parts.push(argsStr.slice(i + 1)); break; }
176:                     } else current += argsStr[i];
177:                 }
178:                 if (dCount < 2) throw new Error("Unfinished s command");
179:                 const pattern = parts[0] || '';
180:                 const replacement = parts[1] || '';
181:                 const flagsStr = parts[2] || '';
182:                 let finalPattern = pattern;
183:                 let finalReplacement = replacement;
184:                 if (!ere) {
185:                     finalPattern = pattern.replace(/\\\(/g, '(').replace(/\\\)/g, ')').replace(/\\\+/g, '+');
186:                     finalReplacement = replacement.replace(/\\(\d)/g, '$$$1');
187:                 }
188:                 finalReplacement = finalReplacement.replace(/(?<!\\)&/g, '$$&').replace(/\\&/g, '&');
189:                 const flags = {
190:                     global: flagsStr.includes('g'),
191:                     print: flagsStr.includes('p'),
192:                     ignoreCase: flagsStr.includes('i'),
193:                     nth: parseInt(flagsStr.match(/\d+/)?.[0] || '0')
194:                 };
195:                 return {
196:                     pattern: new RegExp(finalPattern, (flags.global ? 'g' : '') + (flags.ignoreCase ? 'i' : '')),
197:                     replacement: finalReplacement,
198:                     flags
199:                 };
200:             }
201:             case 'a': case 'i': case 'c': return argsStr.replace(/^\\?\n?/, '').replace(/\\n/g, '\n').replace(/\\$/, '');
202:             case 'y': {
203:                 const delim = argsStr[0];
204:                 const parts = argsStr.slice(1).split(delim);
205:                 return { srcMap: parts[0], destMap: parts[1] };
206:             }
207:             case 'b': case 't': case ':': return argsStr.split(/[; \n]/)[0];
208:             default: return argsStr;
209:         }
210:     }
211:     private static resolveJumpsAndLabels(instructions: SedInstruction[]): SedInstruction[] {
212:         const labels: Map<string, number> = new Map();
213:         for (let i = 0; i < instructions.length; i++) {
214:             if (instructions[i].function === ':') labels.set(instructions[i].label!, i);
215:         }
216:         const stack: number[] = [];
217:         for (let i = 0; i < instructions.length; i++) {
218:             const inst = instructions[i];
219:             if (inst.function === 'b' || inst.function === 't') {
220:                 if (inst.arguments) inst.jumpTarget = labels.get(inst.arguments);
221:                 else inst.jumpTarget = instructions.length;
222:             } else if (inst.function === '{') stack.push(i);
223:             else if (inst.function === '}') {
224:                 const start = stack.pop();
225:                 if (start !== undefined) instructions[start].jumpTarget = i + 1;
226:             }
227:         }
228:         return instructions;
229:     }
230: }
231: export class SedVM {
232:     static execute(instructions: SedInstruction[], state: SedState): SedState {
233:         let currentState: SedState = { ...state, deleted: false, printed: [], nextCycle: false, insertBuffer: [], appendBuffer: [] };
234:         if (currentState.rangeActive.length < instructions.length) {
235:             currentState.rangeActive = new Array(instructions.length).fill(false);
236:             currentState.rangeEnding = new Array(instructions.length).fill(false);
237:         }
238:         for (let i = 0; i < instructions.length; i++) {
239:             if (currentState.quit || currentState.nextCycle) break;
240:             const inst = instructions[i];
241:             if (inst.function === '}' || inst.function === ':') continue;
242:             const matches = this.checkAddress(inst.addresses, currentState, i);
243:             const shouldExecute = inst.negated ? !matches : matches;
244:             if (shouldExecute) {
245:                 if (inst.function === '{') continue;
246:                 currentState = this.applyFunction(inst, currentState, i);
247:                 if (inst.function === 'b') {
248:                     i = (inst.jumpTarget !== undefined ? inst.jumpTarget - 1 : instructions.length);
249:                 } else if (inst.function === 't') {
250:                     if (currentState.substSuccess) {
251:                         currentState.substSuccess = false;
252:                         i = (inst.jumpTarget !== undefined ? inst.jumpTarget - 1 : instructions.length);
253:                     }
254:                 }
255:             } else if (inst.function === '{') {
256:                 i = (inst.jumpTarget !== undefined ? inst.jumpTarget - 1 : instructions.length);
257:             }
258:         }
259:         return currentState;
260:     }
261:     private static checkAddress(addresses: SedAddress[], state: SedState, instIdx: number): boolean {
262:         if (addresses.length === 0) return true;
263:         if (addresses.length === 1) return this.matchSingle(addresses[0], state);
264:         if (state.rangeActive[instIdx]) {
265:             if (this.matchSingle(addresses[1], state)) {
266:                 state.rangeActive[instIdx] = false;
267:                 state.rangeEnding[instIdx] = true;
268:             }
269:             return true;
270:         } else if (this.matchSingle(addresses[0], state)) {
271:             state.rangeActive[instIdx] = true;
272:             if (addresses[1].type === 'line' && (addresses[1].value as number) <= state.lineNumber) {
273:                 state.rangeActive[instIdx] = false;
274:                 state.rangeEnding[instIdx] = true;
275:                 return true;
276:             }
277:             if (this.matchSingle(addresses[1], state)) {
278:                 state.rangeActive[instIdx] = false;
279:                 state.rangeEnding[instIdx] = true;
280:             }
281:             return true;
282:         }
283:         return false;
284:     }
285:     private static matchSingle(addr: SedAddress, state: SedState): boolean {
286:         if (addr.type === 'line') return state.lineNumber === addr.value;
287:         if (addr.type === 'regex') return (addr.value as RegExp).test(state.patternSpace);
288:         if (addr.type === 'last') return state.isLastLine;
289:         return false;
290:     }
291:     private static applyFunction(inst: SedInstruction, state: SedState, instIdx: number): SedState {
292:         const newState = { ...state };
293:         switch (inst.function) {
294:             case 's': {
295:                 const { pattern, replacement, flags } = inst.arguments;
296:                 const old = newState.patternSpace;
297:                 if (flags.nth > 0) {
298:                     let count = 0;
299:                     newState.patternSpace = old.replace(new RegExp(pattern.source, pattern.flags + 'g'), (match) => {
300:                         count++; return count === flags.nth ? match.replace(pattern, replacement) : match;
301:                     });
302:                 } else newState.patternSpace = old.replace(pattern, replacement);
303:                 if (newState.patternSpace !== old) {
304:                     newState.substSuccess = true;
305:                     if (flags.print) newState.printed.push(newState.patternSpace);
306:                 }
307:                 break;
308:             }
309:             case 'd': newState.deleted = true; newState.nextCycle = true; break;
310:             case 'D': {
311:                 const firstNL = newState.patternSpace.indexOf('\n');
312:                 if (firstNL !== -1) {
313:                     newState.patternSpace = newState.patternSpace.slice(firstNL + 1);
314:                     newState.nextCycle = true;
315:                 } else {
316:                     newState.deleted = true;
317:                     newState.nextCycle = true;
318:                 }
319:                 break;
320:             }
321:             case 'p': newState.printed.push(newState.patternSpace); break;
322:             case 'P': newState.printed.push(newState.patternSpace.split('\n')[0]); break;
323:             case 'q': newState.quit = true; break;
324:             case 'h': newState.holdSpace = newState.patternSpace; break;
325:             case 'H': newState.holdSpace += (newState.holdSpace ? '\n' : '') + newState.patternSpace; break;
326:             case 'g': newState.patternSpace = newState.holdSpace; break;
327:             case 'G': newState.patternSpace += '\n' + newState.holdSpace; break;
328:             case 'x': { const tmp = newState.patternSpace; newState.patternSpace = newState.holdSpace; newState.holdSpace = tmp; break; }
329:             case 'y': {
330:                 const { srcMap, destMap } = inst.arguments;
331:                 let res = '';
332:                 for (const char of newState.patternSpace) {
333:                     const idx = srcMap.indexOf(char);
334:                     res += idx !== -1 ? destMap[idx] : char;
335:                 }
336:                 newState.patternSpace = res; break;
337:             }
338:             case '=': newState.printed.push(newState.lineNumber.toString()); break;
339:             case 'a': newState.appendBuffer.push(inst.arguments); break;
340:             case 'i': newState.insertBuffer.push(inst.arguments); break;
341:             case 'c':
342:                 if (inst.addresses.length < 2 || newState.rangeEnding[instIdx]) {
343:                     newState.insertBuffer.push(inst.arguments);
344:                 }
345:                 newState.deleted = true;
346:                 newState.nextCycle = true;
347:                 break;
348:             case 'n': {
349:                 if (!newState.suppressAutoPrint) newState.printed.push(newState.patternSpace);
350:                 for (const al of newState.appendBuffer) newState.printed.push(al);
351:                 newState.appendBuffer = [];
352:                 newState.currentIndex++;
353:                 if (newState.currentIndex < newState.lines.length) {
354:                     newState.patternSpace = newState.lines[newState.currentIndex];
355:                     newState.lineNumber = newState.currentIndex + 1;
356:                     newState.isLastLine = (newState.currentIndex === newState.lines.length - 1);
357:                     newState.substSuccess = false;
358:                 } else newState.quit = true;
359:                 break;
360:             }
361:             case 'N': {
362:                 newState.currentIndex++;
363:                 if (newState.currentIndex < newState.lines.length) {
364:                     newState.patternSpace += '\n' + newState.lines[newState.currentIndex];
365:                     newState.lineNumber = newState.currentIndex + 1;
366:                     newState.isLastLine = (newState.currentIndex === newState.lines.length - 1);
367:                 } else newState.quit = true;
368:                 break;
369:             }
370:         }
371:         return newState;
372:     }
373: }
</file>

