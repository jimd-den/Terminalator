<file path="src/domain/commands/core/AsaCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class AsaCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         const files = args.filter(a => !a.startsWith('-'));
13:         let content = '';
14:         if (files.length > 0) {
15:             for (const file of files) {
16:                 try {
17:                     content += this.fs.readFile(this.resolvePath(file, state));
18:                 } catch (e) {
19:                     return { output: `asa: ${file}: No such file`, newState: state, exitCode: 1 };
20:                 }
21:             }
22:         } else if (input) {
23:             content = input;
24:         } else {
25:             return { output: '', newState: state, exitCode: 0 };
26:         }
27:         const lines = content.split('\n');
28:         let output = '';
29:         for (const line of lines) {
30:             if (line.length === 0) {
31:                 output += '\n';
32:                 continue;
33:             }
34:             const control = line[0];
35:             const data = line.slice(1);
36:             switch (control) {
37:                 case '0':
38:                     output += '\n\n' + data;
39:                     break;
40:                 case '1':
41:                     output += '\f' + data;
42:                     break;
43:                 case '+':
44:                     output += '\r' + data;
45:                     break;
46:                 case ' ':
47:                 default:
48:                     output += '\n' + (control === ' ' ? data : line);
49:                     break;
50:             }
51:         }
52:         return {
53:             output: output.trimStart(),
54:             newState: state,
55:             exitCode: 0
56:         };
57:     }
58:     private resolvePath(path: string, state: TerminalState): string {
59:         if (path.startsWith('/')) return path;
60:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
61:     }
62: }
</file>

