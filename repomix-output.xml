10:         const input = getStdinAsString(context);
11:         const files = args.filter(a => !a.startsWith('-'));
12:         if (files.length < 2) {
13:             return { output: 'cmp: missing operand', newState: state, exitCode: 2 };
14:         }
15:         const file1 = files[0];
16:         const file2 = files[1];
17:         try {
18:             const path1 = this.resolvePath(file1, state);
19:             const path2 = this.resolvePath(file2, state);
20:             const content1 = this.fs.readFile(path1);
21:             const content2 = this.fs.readFile(path2);
22:             const len = Math.min(content1.length, content2.length);
23:             for (let i = 0; i < len; i++) {
24:                 if (content1[i] !== content2[i]) {
25:                     let line = 1;
26:                     for (let j = 0; j < i; j++) {
27:                         if (content1[j] === '\n') line++;
28:                     }
29:                     return {
30:                         output: `${file1} ${file2} differ: byte ${i + 1}, line ${line}`,
31:                         newState: state,
32:                         exitCode: 1
33:                     };
34:                 }
35:             }
36:             if (content1.length !== content2.length) {
37:                 return {
38:                     output: `cmp: EOF on ${content1.length < content2.length ? file1 : file2}`,
39:                     newState: state,
40:                     exitCode: 1
41:                 };
42:             }
43:             return {
44:                 output: '',
45:                 newState: state,
46:                 exitCode: 0
47:             };
48:         } catch (e) {
49:             return {
50:                 output: `cmp: No such file or directory`,
51:                 newState: state,
52:                 exitCode: 2
53:             };
54:         }
55:     }
56:     private resolvePath(path: string, state: TerminalState): string {
57:         if (path.startsWith('/')) return path;
58:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
59:     }
60: }
