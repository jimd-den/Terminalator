30:     Directory = S_IFDIR,
31:     File = S_IFREG,
32:     Symlink = S_IFLNK,
33:     CharDevice = S_IFCHR,
34:     BlockDevice = S_IFBLK,
35:     FIFO = S_IFIFO,
36:     Socket = S_IFSOCK
37: }
38: export { InodeTable, Inode };
39: export type Dentry = IFileSystemNode;
40: export class FileSystem {
41:     public inodeTable: InodeTable;
42:     public usedBytes: number = 0;
43:     public root: DirectoryNode;
44:     constructor() {
45:         this.inodeTable = new InodeTable();
46:         const rootInode = this.inodeTable.allocate(S_IFDIR | 0o755, 0, 0);
47:         rootInode.size = 4096;
48:         rootInode.links = 2;
49:         this.usedBytes += 4096;
50:         this.root = new DirectoryNode('/', rootInode.id);
51:         this.mkdir('/home');
52:         this.mkdir('/home/operator');
53:         this.mkdir('/bin');
54:         this.mkdir('/usr/bin');
55:         this.mkdir('/tmp');
56:         this.mkdir('/var/mail');
57:     }
58:     private mkdir(path: string) {
59:         const parts = path.split('/').filter(p => p.length > 0);
60:         let current: DirectoryNode = this.root;
61:         for (const part of parts) {
62:             let child = current.getChild(part);
63:             if (!child) {
64:                 const inode = this.inodeTable.allocate(S_IFDIR | 0o755, 0, 0);
65:                 inode.size = 4096;
66:                 inode.links = 2;
67:                 child = new DirectoryNode(part, inode.id, current);
68:                 current.addChild(child);
69:                 const parentInode = this.inodeTable.get(current.inodeId);
70:                 if (parentInode) parentInode.links++;
71:             }
72:             if (child.isDirectory()) {
73:                 current = child as DirectoryNode;
74:             } else {
75:                 throw new Error(`Bootstrap error: ${part} is not a directory`);
76:             }
77:         }
78:     }
79:     public attachDentryHelpers(dentry: Dentry) {
80:     }
81: }
