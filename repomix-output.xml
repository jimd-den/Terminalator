 8: export class MkfifoCommand extends CommandBase {
 9:     public readonly capabilities = [CommandCapability.MODIFY];
10:     public readonly utility = 'mkfifo';
11:     constructor(private fs: FileSystemService) {
12:         super();
13:     }
14:     protected override parseArgs(args: string[]) {
15:         super.parseArgs(args, ['m']);
16:     }
17:     protected async executeInternal(
18:         rawArgs: string[],
19:         flags: Set<string>,
20:         operands: string[],
21:         context: ProcessContext,
22:         state: TerminalState
23:     ): Promise<CommandResponse> {
24:         let mode = 0o644;
25:         const modeStr = this.options.get('m');
26:         if (modeStr) {
27:             try {
28:                 mode = parseInt(modeStr, 8);
29:                 if (isNaN(mode)) throw new Error('Invalid octal');
30:             } catch (e) {
31:                 return { output: `mkfifo: invalid mode: '${modeStr}'`, newState: state, exitCode: 1 };
32:             }
33:         }
34:         if (operands.length === 0) {
35:             return { output: 'mkfifo: missing operand', newState: state, exitCode: 1 };
36:         }
37:         let output = '';
38:         let finalExitCode = 0;
39:         for (const target of operands) {
40:             try {
41:                 this.fs.mkfifo(target, mode, 1000, 1000, state.currentDirectory);
42:             } catch (error: any) {
43:                 output += `mkfifo: cannot create fifo '${target}': ${error.message}\n`;
44:                 finalExitCode = 1;
45:             }
46:         }
47:         return { output: output.trim(), newState: state, exitCode: finalExitCode };
48:     }
49: }
