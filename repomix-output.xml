 21: export class ExecuteCommand implements IShellExecutor {
 22:     private registry: CommandRegistry;
 23:     private parser: ShellParser;
 24:     protected service: FileSystemService;
 25:     private expansionService: ShellExpansionService;
 26:     protected fs: FileSystem;
 27:     private jobControl: JobControlService;
 28:     private identityService: IdentityService;
 29:     private interpreter: ShellInterpreter;
 30:     private redirectionService: RedirectionService;
 31:     protected networkMap: NetworkMap;
 32:     private worldManager?: IWorldManager;
 33:     private riscv: RISCVInterpreter;
 34:     constructor(
 35:         fsOrService: FileSystem | FileSystemService,
 36:         protected telemetry?: TelemetryPort,
 37:         registry?: CommandRegistry,
 38:         protected binaryRunner?: IBinaryRunner,
 39:         networkMap?: NetworkMap,
 40:         worldManager?: IWorldManager
 41:     ) {
 42:         if (fsOrService instanceof FileSystemService) {
 43:             this.service = fsOrService;
 44:             this.fs = (fsOrService as any).fs as FileSystem;
 45:         } else {
 46:             this.fs = fsOrService;
