<file path="src/domain/services/RhythmConductor.ts">
 1: import { SimulationBus, GameEventType } from './SimulationBus';
 2: export class RhythmConductor {
 3:     private bpm: number = 120;
 4:     private timer: NodeJS.Timeout | null = null;
 5:     private startTime: number = 0;
 6:     private tickCount: number = 0;
 7:     private isActive: boolean = false;
 8:     constructor(private bus: SimulationBus) {}
 9:     public start(bpm: number = 120): void {
10:         if (this.isActive) return;
11:         this.bpm = bpm;
12:         this.isActive = true;
13:         this.startTime = Date.now();
14:         this.tickCount = 0;
15:         this.scheduleNextTick();
16:     }
17:     public stop(): void {
18:         this.isActive = false;
19:         if (this.timer) {
20:             clearTimeout(this.timer);
21:             this.timer = null;
22:         }
23:     }
24:     private scheduleNextTick(): void {
25:         if (!this.isActive) return;
26:         const intervalMs = 60000 / this.bpm;
27:         this.tickCount++;
28:         const nextTickTime = this.startTime + (this.tickCount * intervalMs);
29:         const delay = Math.max(0, nextTickTime - Date.now());
30:         this.timer = setTimeout(() => {
31:             this.emitTick();
32:             this.scheduleNextTick();
33:         }, delay);
34:     }
35:     private emitTick(): void {
36:         this.bus.emit(GameEventType.TUTOR_EVENT, {
37:             type: 'RHYTHM_TICK',
38:             payload: {
39:                 bpm: this.bpm,
40:                 tick: this.tickCount,
41:                 timestamp: Date.now()
42:             }
43:         });
44:     }
45:     public getBPM(): number {
46:         return this.bpm;
47:     }
48:     public isHeartbeatActive(): boolean {
49:         return this.isActive;
50:     }
51: }
</file>

<file path="src/domain/utils/ZincFormatter.ts">
 1: export class ZincFormatter {
 2:     static format(value: number): { value: string, unit: string } {
 3:         if (value === 0) return { value: '0.00', unit: 'µƵ' };
 4:         const absVal = Math.abs(value);
 5:         if (absVal < 1e-6) {
 6:             return { value: (value * 1e9).toFixed(2), unit: 'nƵ' };
 7:         }
 8:         if (absVal < 1e-3) {
 9:             return { value: (value * 1e6).toFixed(2), unit: 'µƵ' };
10:         }
11:         if (absVal < 1) {
12:             return { value: (value * 1e3).toFixed(2), unit: 'mƵ' };
13:         }
14:         if (absVal < 1e3) {
15:             return { value: value.toFixed(2), unit: 'Ƶ' };
16:         }
17:         if (absVal < 1e6) {
18:             return { value: (value / 1e3).toFixed(2), unit: 'kƵ' };
19:         }
20:         return { value: (value / 1e6).toFixed(2), unit: 'MƵ' };
21:     }
22:     static formatFull(value: number): string {
23:         const { value: val, unit } = this.format(value);
24:         return `${val} ${unit}`;
25:     }
26: }
</file>

