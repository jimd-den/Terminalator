 5: import { TerminalState } from '../../entities/TerminalState';
 6: export class LexCommand implements ICommand {
 7:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 8:         const input = getStdinAsString(context);
 9:         let file = '';
10:         let output = 'lex.yy.c';
11:         for (let i = 0; i < args.length; i++) {
12:             if (args[i] === '-t') {
13:                 output = ''; // stdout
14:             } else if (args[i] === '-v') {
15:             } else if (!args[i].startsWith('-')) {
16:                 file = args[i];
17:             }
18:         }
19:         if (!file) {
20:             return { output: 'lex: no input file', newState: state, exitCode: 1 };
21:         }
22:         const fs = context.fileSystemService;
23:         const node = fs.resolve(file, state.currentDirectory);
24:         if (!node || fs.isDirectory(node)) {
25:             return { output: `lex: ${file}: No such file or directory`, newState: state, exitCode: 1 };
26:         }
27:         const cCode = `
28: #include <stdio.h>
29: #include <stdlib.h>
30: int yylex(void) {
31:     return 0;
32: }
33: int main(int argc, char **argv) {
34:     yylex();
35:     return 0;
36: }
37: `;
38:         if (output) {
39:             fs.writeFile(state.currentDirectory + '/' + output, cCode, 'w', undefined, undefined, state.currentDirectory);
40:             return { output: '', newState: state, exitCode: 0 };
41:         } else {
42:             return { output: cCode, newState: state, exitCode: 0 };
43:         }
44:     }
45: }
