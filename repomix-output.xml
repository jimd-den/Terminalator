137:         const addresses: SedAddress[] = [];
138:         while (current.length > 0) {
139:             const addr = this.consumeAddress(current);
140:             if (!addr) break;
141:             addresses.push(addr.address);
142:             current = addr.remaining.trim();
143:             if (current.startsWith(',')) current = current.slice(1).trim();
144:             else break;
145:         }
146:         return { addresses, remaining: current };
147:     }
148:     private static consumeAddress(src: string): { address: SedAddress, remaining: string } | null {
149:         if (src.startsWith('$')) return { address: { type: 'last', value: null }, remaining: src.slice(1) };
150:         const lineMatch = src.match(/^(\d+)/);
151:         if (lineMatch) return { address: { type: 'line', value: parseInt(lineMatch[1]) }, remaining: src.slice(lineMatch[0].length) };
152:         if (src.startsWith('/')) {
