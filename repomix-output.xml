  1: import { SchemeValue, listToArray } from '../entities/SchemeValue';
  2: import { Instruction } from './SchemeVM';
  3: export class SchemeCompiler {
  4:     compile(expr: SchemeValue, isTail: boolean = false): Instruction[] {
  5:         if (['number', 'string', 'boolean', 'char', 'null', 'vector', 'bytevector'].includes(expr.type)) {
  6:             return [{ op: 'CONST', value: expr } as Instruction, ...(isTail ? [{ op: 'RETURN' } as Instruction] : [])];
  7:         }
  8:         if (expr.type === 'symbol') {
  9:             if (expr.value === '#<void>') {
 10:                 return [{ op: 'CONST', value: { type: 'symbol', value: '#<void>' } } as Instruction, ...(isTail ? [{ op: 'RETURN' } as Instruction] : [])];
 11:             }
 12:             return [{ op: 'LOOKUP', name: expr.value } as Instruction, ...(isTail ? [{ op: 'RETURN' } as Instruction] : [])];
 13:         }
 14:         if (expr.type === 'pair') {
 15:             const arr = listToArray(expr);
 16:             const first = arr[0];
 17:             if (first.type === 'symbol') {
 18:                 const op = first.value;
 19:                 if (op === 'quote') return this.compileQuote(arr, isTail);
 20:                 if (op === 'define') return this.compileDefine(arr, isTail);
 21:                 if (op === 'set!') return this.compileSet(arr, isTail);
 22:                 if (op === 'if') return this.compileIf(arr, isTail);
 23:                 if (op === 'lambda') return this.compileLambda(arr, isTail);
 24:                 if (op === 'begin') return this.compileBegin(arr, isTail);
 25:                 if (op === 'call/cc' || op === 'call-with-current-continuation') return this.compileCallCC(arr, isTail);
 26:             }
 27:             return this.compileApplication(arr, isTail);
 28:         }
 29:         throw new Error(`Cannot compile expression of type: ${expr.type}`);
 30:     }
 31:     private compileQuote(arr: SchemeValue[], isTail: boolean): Instruction[] {
 32:         return [{ op: 'CONST', value: arr[1] } as Instruction, ...(isTail ? [{ op: 'RETURN' } as Instruction] : [])];
 33:     }
 34:     private compileDefine(arr: SchemeValue[], isTail: boolean): Instruction[] {
 35:         const head = arr[1];
 36:         if (head.type === 'pair') {
 37:             const name = (head.value.car as any).value;
 38:             const args = head.value.cdr;
 39:             const params = listToArray(args).map(p => (p as any).value);
 40:             const bodyExprs = arr.slice(2);
 41:             const bodyCode: Instruction[] = [];
 42:             for (let i = 0; i < bodyExprs.length; i++) {
 43:                 bodyCode.push(...this.compile(bodyExprs[i], i === bodyExprs.length - 1));
 44:             }
 45:             const closure: Instruction = { op: 'CLOSURE', params, body: bodyCode };
 46:             return [closure, { op: 'DEFINE', name } as Instruction, ...(isTail ? [{ op: 'RETURN' } as Instruction] : [])];
 47:         }
 48:         const name = (arr[1] as any).value;
 49:         const valInstructions = this.compile(arr[2], false);
 50:         return [...valInstructions, { op: 'DEFINE', name } as Instruction, ...(isTail ? [{ op: 'RETURN' } as Instruction] : [])];
 51:     }
 52:     private compileSet(arr: SchemeValue[], isTail: boolean): Instruction[] {
 53:         const name = (arr[1] as any).value;
 54:         const valInstructions = this.compile(arr[2], false);
 55:         return [...valInstructions, { op: 'SET', name } as Instruction, ...(isTail ? [{ op: 'RETURN' } as Instruction] : [])];
 56:     }
 57:     private compileIf(arr: SchemeValue[], isTail: boolean): Instruction[] {
 58:         const test = this.compile(arr[1], false);
 59:         const thenBranch = this.compile(arr[2], isTail);
 60:         const elseBranch = arr[3] ? this.compile(arr[3], isTail) : [{ op: 'CONST', value: { type: 'symbol', value: 'unspecified' } } as Instruction];
 61:         if (isTail) {
 62:             return [
 63:                 ...test,
 64:                 { op: 'JUMP_IF_FALSE', offset: thenBranch.length + 1 } as Instruction,
 65:                 ...thenBranch,
 66:                 ...elseBranch
 67:             ];
 68:         } else {
 69:             return [
 70:                 ...test,
 71:                 { op: 'JUMP_IF_FALSE', offset: thenBranch.length + 2 } as Instruction,
 72:                 ...thenBranch,
 73:                 { op: 'JUMP', offset: elseBranch.length + 1 } as Instruction,
 74:                 ...elseBranch
 75:             ];
 76:         }
 77:     }
 78:     private compileLambda(arr: SchemeValue[], isTail: boolean): Instruction[] {
 79:         const params = listToArray(arr[1]).map(p => (p as any).value);
 80:         const bodyExprs = arr.slice(2);
 81:         const bodyCode: Instruction[] = [];
 82:         for (let i = 0; i < bodyExprs.length; i++) {
 83:             bodyCode.push(...this.compile(bodyExprs[i], i === bodyExprs.length - 1));
 84:         }
 85:         const closure: Instruction = { op: 'CLOSURE', params, body: bodyCode };
 86:         return [closure, ...(isTail ? [{ op: 'RETURN' } as Instruction] : [])];
 87:     }
 88:     private compileBegin(arr: SchemeValue[], isTail: boolean): Instruction[] {
 89:         const instrs: Instruction[] = [];
 90:         const exprs = arr.slice(1);
 91:         for (let i = 0; i < exprs.length; i++) {
 92:             instrs.push(...this.compile(exprs[i], isTail && (i === exprs.length - 1)));
 93:         }
 94:         return instrs;
 95:     }
 96:     private compileCallCC(arr: SchemeValue[], isTail: boolean): Instruction[] {
 97:         const receiver = this.compile(arr[1], false);
 98:         return [
 99:             ...receiver,
100:             { op: 'CALL_CC' } as Instruction,
101:             { op: 'APPLY', argCount: 1 } as Instruction,
102:             ...(isTail ? [{ op: 'RETURN' } as Instruction] : [])
103:         ];
104:     }
105:     private compileApplication(arr: SchemeValue[], isTail: boolean): Instruction[] {
106:         const instrs: Instruction[] = [];
107:         for (let i = 1; i < arr.length; i++) {
108:             instrs.push(...this.compile(arr[i], false));
109:         }
110:         instrs.push(...this.compile(arr[0], false));
111:         instrs.push({ op: 'APPLY', argCount: arr.length - 1 } as Instruction);
112:         if (isTail) {
113:             instrs.push({ op: 'RETURN' } as Instruction);
114:         }
115:         return instrs;
116:     }
117: }
