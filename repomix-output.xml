 3: import { SimulationBus, GameEventType } from '../SimulationBus';
 4: import { PresentationDirector } from '../PresentationDirector';
 5: import { RhythmConductor } from '../RhythmConductor';
 6: export class TutorShadow {
 7:     private currentBeatTime: number = 0;
 8:     private isSummaryActive: boolean = false;
 9:     private isCountdownActive: boolean = false;
10:     constructor(
11:         private engine: TutorEngine,
12:         private economy: EconomyService,
13:         private bus: SimulationBus,
14:         private director: PresentationDirector,
15:         private conductor: RhythmConductor
16:     ) {
17:         this.bus.subscribe(GameEventType.TUTOR_EVENT, (event) => {
18:             const data = event.payload;
19:             if (data && data.type === 'RHYTHM_TICK') {
20:                 this.currentBeatTime = data.payload.timestamp;
21:             } else if (data && data.type === 'RHYTHM_START') {
22:                 this.conductor.start(data.payload.bpm);
23:             } else if (data && data.type === 'RHYTHM_STOP') {
24:                 this.conductor.stop();
25:             } else if (data && data.type === 'COMPLETE') {
26:                 this.isSummaryActive = true;
27:                 this.conductor.stop();
28:             } else if (data && data.type === 'SUMMARY_DISMISSED') {
29:                 this.isSummaryActive = false;
30:             } else if (data && data.type === 'COUNTDOWN_START') {
31:                 this.isCountdownActive = true;
32:             } else if (data && data.type === 'COUNTDOWN_COMPLETE') {
33:                 this.isCountdownActive = false;
34:             }
35:         });
36:     }
37:     public intercept(key: string, mode: 'SHELL' | 'VIM' = 'SHELL'): boolean {
38:         if (this.isSummaryActive || this.isCountdownActive) {
39:             if (this.isSummaryActive && key === 'ENTER') {
40:                 this.bus.emit(GameEventType.TUTOR_EVENT, { type: 'SUMMARY_ENTER_PRESSED' });
41:             }
42:             console.log(`[TutorShadow] Blocking input due to ${this.isSummaryActive ? 'SUMMARY' : 'COUNTDOWN'}_MODE`);
43:             return false;
44:         }
45:         console.log(`[TutorShadow] Intercepting key: "${key}" (mode: ${mode}). Current Beat: ${this.currentBeatTime}`);
46:         if (!this.engine.isActive()) {
47:             console.log("[TutorShadow] Engine NOT active. Pass through.");
48:             if (key.length === 1) {
49:                 this.economy.recordHit();
50:                 this.bus.emit(GameEventType.KEYSTROKE_ACCEPTED, { key });
51:             }
52:             return true;
53:         }
54:         const lesson = this.engine.getCurrentLesson();
55:         if (!lesson) {
56:             console.log("[TutorShadow] Engine active but no lesson? Pass through.");
57:             return true;
58:         }
59:         console.log(`[TutorShadow] Lesson active: ${lesson.id}. Target: ${lesson.text[this.engine.getCompletedText().length]}`);
60:         if (key === 'ENTER' || key === 'BACKSPACE' || key === 'TAB') {
61:             if (lesson.type === 'SHELL' && key === 'BACKSPACE') {
62:                 this.recordFailure();
63:                 return false;
64:             }
65:             return true;
66:         }
67:         if (key.length !== 1) return true;
68:         const result = this.engine.handleInput(key);
69:         console.log(`[TutorShadow] Engine Result for ${key}: ${result}`);
70:         if (result === InputResult.ACCEPTED) {
71:             this.economy.recordHit(this.currentBeatTime);
72:             this.engine.setSessionZinc(this.economy.getSession().sessionZincMined);
73:             this.bus.emit(GameEventType.KEYSTROKE_ACCEPTED, { key });
74:             return true;
75:         } else if (result === InputResult.REJECTED) {
76:             this.economy.recordMistake();
77:             return false;
78:         }
79:         return true;
80:     }
81:     private recordFailure() {
82:         this.economy.recordMistake();
83:         this.bus.emit(GameEventType.TUTOR_EVENT, {
84:             type: 'MISTAKE',
85:             payload: { type: 'SHADOW_BLOCK', message: 'HERESY DETECTED', dropped: 0 }
86:         });
87:     }
88: }
</file>

