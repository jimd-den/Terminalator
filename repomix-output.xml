<file path="src/frameworks-drivers/ui/components/PopChar.tsx">
  1: import React, { useEffect, useRef } from 'react';
  2: import { Animated, Text, TextStyle, StyleSheet } from 'react-native';
  3: export type PopVariant = 'pop' | 'crawl' | 'star';
  4: interface PopCharProps {
  5:     children: string;
  6:     style?: TextStyle;
  7:     delay?: number;
  8:     variant?: PopVariant;
  9:     isCrashing?: boolean;
 10: }
 11: export const PopChar: React.FC<PopCharProps> = ({ children, style, delay = 0, variant = 'pop', isCrashing = false }) => {
 12:     const scaleAnim = useRef(new Animated.Value(1)).current;
 13:     const opacityAnim = useRef(new Animated.Value(0)).current;
 14:     const translateAnim = useRef(new Animated.Value(variant === 'crawl' ? 10 : 0)).current;
 15:     const rotateAnim = useRef(new Animated.Value(0)).current;
 16:     const crashTranslateAnim = useRef(new Animated.Value(0)).current;
 17:     const crashRotateAnim = useRef(new Animated.Value(0)).current;
 18:     useEffect(() => {
 19:         if (isCrashing) {
 20:             Animated.parallel([
 21:                 Animated.timing(crashTranslateAnim, {
 22:                     toValue: 100,
 23:                     duration: 400,
 24:                     useNativeDriver: true,
 25:                 }),
 26:                 Animated.timing(crashRotateAnim, {
 27:                     toValue: 1,
 28:                     duration: 400,
 29:                     useNativeDriver: true,
 30:                 }),
 31:                 Animated.timing(opacityAnim, {
 32:                     toValue: 0,
 33:                     duration: 300,
 34:                     delay: 100,
 35:                     useNativeDriver: true,
 36:                 })
 37:             ]).start();
 38:             return;
 39:         }
 40:         const animations = [];
 41:         if (variant === 'pop') {
 42:             scaleAnim.setValue(1);
 43:             animations.push(
 44:                 Animated.timing(opacityAnim, {
 45:                     toValue: 1,
 46:                     duration: 50,
 47:                     useNativeDriver: true,
 48:                     delay
 49:                 })
 50:             );
 51:         } else if (variant === 'crawl') {
 52:             animations.push(
 53:                 Animated.parallel([
 54:                     Animated.timing(opacityAnim, {
 55:                         toValue: 1,
 56:                         duration: 150,
 57:                         useNativeDriver: true,
 58:                         delay
 59:                     }),
 60:                     Animated.timing(translateAnim, {
 61:                         toValue: 0,
 62:                         duration: 150,
 63:                         useNativeDriver: true,
 64:                         delay
 65:                     })
 66:                 ])
 67:             );
 68:         } else if (variant === 'star') {
 69:             scaleAnim.setValue(1);
 70:             animations.push(
 71:                 Animated.timing(opacityAnim, {
 72:                     toValue: 1,
 73:                     duration: 50,
 74:                     useNativeDriver: true,
 75:                     delay
 76:                 })
 77:             );
 78:         }
 79:         Animated.parallel(animations).start();
 80:     }, [variant, delay, scaleAnim, opacityAnim, translateAnim, rotateAnim, isCrashing, crashTranslateAnim, crashRotateAnim]);
 81:     const rotateStr = rotateAnim.interpolate({
 82:         inputRange: [0, 1],
 83:         outputRange: ['0deg', '360deg']
 84:     });
 85:     const crashRotateStr = crashRotateAnim.interpolate({
 86:         inputRange: [0, 1],
 87:         outputRange: ['0deg', '90deg']
 88:     });
 89:     const transform = [];
 90:     if (isCrashing) {
 91:         transform.push({ translateY: crashTranslateAnim });
 92:         transform.push({ rotate: crashRotateStr });
 93:     } else {
 94:         if (variant === 'pop' || variant === 'star') transform.push({ scale: scaleAnim });
 95:         if (variant === 'crawl') transform.push({ translateY: translateAnim });
 96:         if (variant === 'star') transform.push({ rotate: rotateStr });
 97:     }
 98:     return (
 99:         <Animated.Text
100:             style={[
101:                 style,
102:                 {
103:                     opacity: opacityAnim,
104:                     transform
105:                 }
106:             ]}
107:         >
108:             {children}
109:         </Animated.Text>
110:     );
111: };
</file>

