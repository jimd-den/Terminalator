<file path="src/domain/services/TutorService.ts">
 1: import { TerminalState } from '../entities/TerminalState';
 2: import { Mission, MissionStep } from '../entities/Mission';
 3: import { CommandResponse } from '../entities/Command';
 4: import { IMissionStrategy } from './mission-strategies/IMissionStrategy';
 5: import { MissionRepository } from './MissionRepository';
 6: import { LessonRegistry } from './LessonRegistry';
 7: import { TutorAction, TutorProgressionResult } from '../interfaces/ITutorService';
 8: import { StrategyRegistry } from './mission-strategies/StrategyRegistry';
 9: export { TutorAction, TutorProgressionResult };
10: export class TutorService {
11:     constructor(
12:         private missionRepository: MissionRepository,
13:         private lessonRegistry: LessonRegistry,
14:         private strategyRegistry: StrategyRegistry
15:     ) { }
16:     private getStrategy(type: string): IMissionStrategy {
17:         return this.strategyRegistry.get(type);
18:     }
19:     public analyzeGameState(mission: Mission, state: TerminalState, lastResponse: CommandResponse): TutorAction | null {
20:         if (!mission || mission.status !== 'active') return null;
21:         if (mission.type === 'generative') return null;
22:         const strategy = this.getStrategy(mission.type);
23:         const result = strategy.evaluate(mission, state, lastResponse, this.missionRepository, this.lessonRegistry);
24:         return result.hint;
25:     }
26:     public checkMissionProgression(
27:         state: TerminalState,
28:         activeMissions: Mission[],
29:         lastResponse?: CommandResponse
30:     ): { result: TutorProgressionResult | null, missionId: string } | null {
31:         for (const mission of activeMissions) {
32:             if (mission.status !== 'active') continue;
33:             const strategy = this.getStrategy(mission.type);
34:             const response = lastResponse || { output: '', exitCode: 0, newState: state } as any;
35:             const evaluation = strategy.evaluate(mission, state, response, this.missionRepository, this.lessonRegistry);
36:             if (evaluation.progression) {
37:                 return { result: evaluation.progression, missionId: mission.id };
38:             }
39:         }
40:         return null;
41:     }
42: }
