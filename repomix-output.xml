 1: import { ICommand, CommandResponse } from '../ICommand';
 2: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 3: import { TerminalState } from '../../entities/TerminalState';
 4: import { IdentityService } from '../../services/IdentityService';
 5: export class IdCommand implements ICommand {
 6:     constructor(private identityService: IdentityService) { }
 7:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 8:         const flags = args.filter(a => a.startsWith('-'));
 9:         const operands = args.filter(a => !a.startsWith('-'));
10:         const showUidOnly = flags.includes('-u');
11:         const showGidOnly = flags.includes('-g');
12:         const showGroupsOnly = flags.includes('-G');
13:         const showNames = flags.includes('-n');
14:         let targetUser = context.user;
15:         let username = 'operator';
16:         if (operands.length > 0) {
17:             const user = this.identityService.resolveUser(operands[0]);
18:             if (!user) {
19:                 return { output: `id: '${operands[0]}': no such user`, newState: state, exitCode: 1 };
20:             }
21:             targetUser = { uid: user.uid, gid: user.gid, groups: user.groups };
22:             username = user.username;
23:         } else {
24:             const user = this.identityService.getUserByUid(context.user.uid);
25:             if (user) username = user.username;
26:         }
27:         let output = '';
28:         if (showUidOnly) {
29:             output = showNames ? username : targetUser.uid.toString();
30:         } else if (showGidOnly) {
31:             const group = this.identityService.getGroupByGid(targetUser.gid);
32:             output = (showNames && group) ? group.groupname : targetUser.gid.toString();
33:         } else if (showGroupsOnly) {
34:             const groupParts: string[] = [];
35:             for (const gid of targetUser.groups) {
36:                 const g = this.identityService.getGroupByGid(gid);
37:                 groupParts.push((showNames && g) ? g.groupname : gid.toString());
38:             }
39:             output = groupParts.join(' ');
40:         } else {
41:             // Default POSIX format:
42:             // uid=1000(operator) gid=1000(operator) groups=1000(operator),1001(staff)...
43:             const group = this.identityService.getGroupByGid(targetUser.gid);
44:             const groupname = group ? group.groupname : targetUser.gid.toString();
45:             output = `uid=${targetUser.uid}(${username}) gid=${targetUser.gid}(${groupname}) groups=`;
46:             const groupList: string[] = [];
47:             for (const gid of targetUser.groups) {
48:                 const g = this.identityService.getGroupByGid(gid);
49:                 const gn = g ? g.groupname : gid.toString();
50:                 groupList.push(`${gid}(${gn})`);
51:             }
52:             output += groupList.join(',');
53:         }
54:         return {
55:             output: output,
56:             newState: state,
57:             exitCode: 0
58:         };
59:     }
60: }
</file>

