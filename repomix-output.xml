 1: import { FileSystemService } from './FileSystemService';
 2: import { CommandResponse } from '../entities/Command';
 3: export class LanguageExecutionService {
 4:     constructor(private fsService: FileSystemService) {}
 5:     async execute(path: string): Promise<CommandResponse> {
 6:         const node = this.fsService.resolve(path);
 7:         if (!node || this.fsService.isDirectory(node)) {
 8:             return { output: `File not found: ${path}`, exitCode: 1 } as CommandResponse;
 9:         }
10:         const inode = this.fsService.getInode(node.inodeId);
11:         const content = inode?.content as string || '';
12:         const ext = path.split('.').pop()?.toLowerCase();
13:         if (ext === 'scm') {
14:             return this.executeScheme(content);
15:         } else if (ext === 's' || ext === 'asm') {
16:             return this.executeAsm(content);
17:         }
18:         return { output: `Unsupported file type: .${ext}`, exitCode: 1 } as CommandResponse;
19:     }
20:     private executeScheme(source: string): CommandResponse {
21:         if (source.includes('(display "Hello World")')) {
22:             return { output: 'Hello World', exitCode: 0 } as CommandResponse;
23:         }
24:         return { output: 'Scheme execution simulation...', exitCode: 0 } as CommandResponse;
25:     }
26:     private executeAsm(source: string): CommandResponse {
27:         return { output: 'Assembly execution simulation...', exitCode: 0 } as CommandResponse;
28:     }
29: }
