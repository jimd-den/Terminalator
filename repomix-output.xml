<file path="src/domain/commands/core/TrapCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand, CommandResponse } from '../ICommand';
 3: import { FileSystemService } from '../../../domain/services/FileSystemService';
 4: import { TerminalState } from '../../entities/TerminalState';
 5: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 6: export class TrapCommand implements ICommand {
 7:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 8:         if (args.length === 0) {
 9:             let output = '';
10:             // POSIX format: trap -- 'action' signal
11:             if (state.traps) {
12:                 state.traps.forEach((action, sig) => {
13:                     output += `trap -- '${action.replace(/'/g, "'\\''")}' ${sig}\n`;
14:                 });
15:             }
16:             return { output: output.trimEnd(), newState: state, exitCode: 0 };
17:         }
18:         let action = args[0];
19:         let signals = args.slice(1);
20:         if (action === '-l') {
21:             return { output: 'EXIT HUP INT QUIT ILL TRAP ABRT BUS FPE KILL USR1 SEGV USR2 PIPE ALRM TERM CHLD CONT STOP TSTP TTIN TTOU URG XCPU XFSZ VTALRM PROF WINCH POLL POWER SYS', newState: state, exitCode: 0 };
22:         }
23:         if (action === '-p') {
24:             let output = '';
25:             if (state.traps) {
26:                 state.traps.forEach((cmd, sig) => {
27:                     output += `trap -- '${cmd.replace(/'/g, "'\\''")}' ${sig}\n`;
28:                 });
29:             }
30:             return { output: output.trimEnd(), newState: state, exitCode: 0 };
31:         }
32:         const isSignal = (s: string) => /^[0-9]+$/.test(s) || ['EXIT', 'ERR', 'DEBUG', 'RETURN'].includes(s.toUpperCase()) || /^[A-Z]+$/.test(s.toUpperCase());
33:         if (isSignal(action) && action !== 'EXIT' && action !== 'ERR' && action !== 'DEBUG' && action !== 'RETURN') {
34:         }
35:         let reset = false;
36:         let startIndex = 1;
37:         if (isSignal(action) && signals.length === 0) {
38:             reset = true;
39:             signals = [action];
40:             startIndex = 1;
41:         } else if (isSignal(action)) {
42:             reset = true;
43:             signals = args;
44:             startIndex = args.length;
45:         } else if (action === '-') {
46:             reset = true;
47:         }
48:         if (reset) {
49:             signals.forEach(sig => {
50:                 let s = sig.toUpperCase();
51:                 if (s === '0') s = 'EXIT';
52:                 state.traps.delete(s);
53:             });
54:             return { output: '', newState: state, exitCode: 0 };
55:         }
56:         // Set action
57:         for (const sig of signals) {
58:             let s = sig.toUpperCase();
59:             if (s === '0') s = 'EXIT';
60:             state.traps.set(s, action);
61:         }
62:         return {
63:             output: '',
64:             newState: state,
65:             exitCode: 0
66:         };
67:     }
68: }
