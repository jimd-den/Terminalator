11: export class WorldManager implements IWorldStateProvider, IWorldManager {
12:     private locations = new Map<string, Location>();
13:     private devices = new Map<string, Device>();
14:     private hostFileSystems = new Map<string, FileSystemService>();
15:     private dispatcher: WorldEffectDispatcher;
16:     private observer: FileSystemObserver;
17:     private projector: StateProjector;
18:     private generator: WorldGenerator;
19:     constructor() {
20:         this.generator = new WorldGenerator();
21:         this.dispatcher = new WorldEffectDispatcher(this.devices, this.locations);
22:         this.observer = new FileSystemObserver(this.dispatcher);
23:         this.projector = new StateProjector(Array.from(this.devices.values()));
24:         this.generateAndRegisterWorld('prime-station', 'RESEARCH');
25:     }
26:     public registerHost(hostname: string, service: FileSystemService): void {
27:         this.hostFileSystems.set(hostname, service);
28:         this.observer.observe(hostname, service);
29:         this.projector.project(hostname, service);
30:     }
31:     public getHostFileSystem(hostname: string): FileSystemService | null {
32:         if (!this.hostFileSystems.has(hostname)) {
33:             const fs = new FileSystem();
34:             const service = new FileSystemService(fs);
35:             service.mkdirp('/bin');
36:             service.mkdirp('/home/admin');
37:             service.mkdirp('/var/log');
38:             service.mkdirp('/dev');
39:             service.writeFile('/var/log/syslog', 'System initialized (Lazy Provision)...\n');
40:             this.registerHost(hostname, service);
41:         }
42:         return this.hostFileSystems.get(hostname) || null;
43:     }
44:     public getAllHosts(): string[] {
45:         return Array.from(this.hostFileSystems.keys());
46:     }
47:     public tick(activeHosts: Map<string, FileSystemService>): void {
48:         activeHosts.forEach((service, hostname) => {
49:             this.projector.project(hostname, service);
50:         });
51:     }
52:     private generateAndRegisterWorld(seed: string, theme: any) {
53:         const world = this.generator.generateStation(seed, theme);
54:         world.locations.forEach(l => this.locations.set(l.id, l));
55:         world.devices.forEach(d => this.devices.set(d.id, d));
56:         const hosts = new Set(world.devices.map(d => d.hostId));
57:         hosts.forEach(hostname => {
58:             if (hostname === 'terminalator') return;
59:             const fs = new FileSystem();
60:             const service = new FileSystemService(fs);
61:             service.mkdirp('/bin');
62:             service.mkdirp('/home/admin');
63:             service.mkdirp('/var/log');
64:             service.mkdirp('/dev');
65:             service.writeFile('/var/log/syslog', 'System initialized...\n');
66:             this.registerHost(hostname, service);
67:         });
68:         this.projector = new StateProjector(Array.from(this.devices.values()));
69:         hosts.forEach(h => {
70:             const fs = this.hostFileSystems.get(h);
71:             if (fs) this.projector.project(h, fs);
72:         });
73:     }
74:     public getAllLocations(): Location[] { return Array.from(this.locations.values()); }
75:     public getAllDevices(): Device[] { return Array.from(this.devices.values()); }
76:     public getDeviceById(id: string): Device | undefined { return this.devices.get(id); }
77:     public getLocationById(id: string): Location | undefined { return this.locations.get(id); }
78: }
