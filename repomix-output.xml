  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { ICommand, CommandResponse } from '../ICommand';
  3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  4: import { TerminalState } from '../../entities/TerminalState';
  5: import { FileSystemService } from '../../services/FileSystemService';
  6: interface ArHeader {
  7:     name: string;
  8:     date: number;
  9:     uid: number;
 10:     gid: number;
 11:     mode: number;
 12:     size: number;
 13: }
 14: interface ArEntry {
 15:     header: ArHeader;
 16:     content: string;
 17: }
 18: export class ArCommand implements ICommand {
 19:     constructor(private fs: FileSystemService) { }
 20:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 21:         const input = getStdinAsString(context);
 22:         let mode = '';
 23:         let archiveName = '';
 24:         const files: string[] = [];
 25:         let verbose = false;
 26:         for (const arg of args) {
 27:             if (arg.startsWith('-')) {
 28:                 if (arg.includes('v')) verbose = true;
 29:                 const clean = arg.replace(/^-/, '');
 30:                 if (/^[dmpqrtx]/.test(clean)) mode = clean;
 31:             } else if (!mode && /^[dmpqrtx]/.test(arg)) {
 32:                 mode = arg;
 33:                 if (arg.includes('v')) verbose = true;
 34:             } else if (!archiveName) {
 35:                 archiveName = arg;
 36:             } else {
 37:                 files.push(arg);
 38:             }
 39:         }
 40:         if (!mode || !archiveName) {
 41:             return {
 42:                 output: 'ar: usage: ar -[dmpqrtx] [member...] archive files...',
 43:                 newState: state,
 44:                 exitCode: 1
 45:             };
 46:         }
 47:         const archivePath = archiveName.startsWith('/') ? archiveName : state.currentDirectory + '/' + archiveName;
 48:         let entries: ArEntry[] = [];
 49:         let created = false;
 50:         const node = this.fs.resolve(archivePath);
 51:         if (node && !this.fs.isDirectory(node)) {
 52:             try {
 53:                 const content = this.fs.readFile(archivePath);
 54:                 entries = this.parseArchive(content);
 55:             } catch (e) {
 56:                 return {
 57:                     output: `ar: ${archiveName}: File format not recognized`,
 58:                     newState: state,
 59:                     exitCode: 1
 60:                 };
 61:             }
 62:         } else if (mode.includes('r') || mode.includes('q') || mode.includes('c')) {
 63:             created = true;
 64:         } else {
 65:             return {
 66:                 output: `ar: ${archiveName}: No such file or directory`,
 67:                 newState: state,
 68:                 exitCode: 1
 69:             };
 70:         }
 71:         let outputLines: string[] = [];
 72:         if (mode.includes('t')) {
 73:             const targets = files.length > 0 ? entries.filter(e => files.includes(e.header.name)) : entries;
 74:             for (const entry of targets) {
 75:                 if (verbose) outputLines.push(this.formatVerbose(entry));
 76:                 else outputLines.push(entry.header.name);
 77:             }
 78:         } else if (mode.includes('d')) {
 79:             for (const f of files) {
 80:                 const idx = entries.findIndex(e => e.header.name === f);
 81:                 if (idx !== -1) {
 82:                     entries.splice(idx, 1);
 83:                     if (verbose) outputLines.push(`d - ${f}`);
 84:                 }
 85:             }
 86:             this.writeArchive(archivePath, entries, state.currentDirectory);
 87:         } else if (mode.includes('x')) {
 88:             const targets = files.length > 0 ? entries.filter(e => files.includes(e.header.name)) : entries;
 89:             for (const entry of targets) {
 90:                 const outPath = entry.header.name;
 91:                 this.fs.writeFile(outPath, entry.content, 'w', 1000, 1000, state.currentDirectory);
 92:                 if (verbose) outputLines.push(`x - ${entry.header.name}`);
 93:             }
 94:         } else if (mode.includes('r') || mode.includes('q')) {
 95:             for (const f of files) {
 96:                 const srcPath = f.startsWith('/') ? f : state.currentDirectory + '/' + f;
 97:                 const srcNode = this.fs.resolve(srcPath);
 98:                 if (!srcNode || this.fs.isDirectory(srcNode)) {
 99:                     outputLines.push(`ar: ${f}: No such file or directory`);
100:                     continue;
101:                 }
102:                 const content = this.fs.readFile(srcPath);
103:                 const inode = this.fs.getInode(srcNode.inodeId);
104:                 const newEntry: ArEntry = {
105:                     header: {
106:                         name: f.split('/').pop() || f,
107:                         date: inode ? inode.mtime : Date.now(),
108:                         uid: inode ? inode.uid : 0,
109:                         gid: inode ? inode.gid : 0,
110:                         mode: inode ? inode.mode : 0o644,
111:                         size: content.length
112:                     },
113:                     content: content
114:                 };
115:                 const idx = entries.findIndex(e => e.header.name === newEntry.header.name);
116:                 if (idx !== -1 && mode.includes('r')) {
117:                     entries[idx] = newEntry;
118:                     if (verbose) outputLines.push(`r - ${newEntry.header.name}`);
119:                 } else {
120:                     entries.push(newEntry);
121:                     if (verbose) outputLines.push(`a - ${newEntry.header.name}`);
122:                 }
123:             }
124:             this.writeArchive(archivePath, entries, state.currentDirectory);
125:         } else if (mode.includes('p')) {
126:             const targets = files.length > 0 ? entries.filter(e => files.includes(e.header.name)) : entries;
127:             for (const entry of targets) {
128:                 if (verbose) outputLines.push(`\n<${entry.header.name}>\n`);
129:                 outputLines.push(entry.content);
130:             }
131:         }
132:         return {
133:             output: outputLines.join('\n'),
134:             newState: state,
135:             exitCode: 0
136:         };
137:     }
138:     private parseArchive(content: string): ArEntry[] {
139:         if (!content.startsWith('!<arch>\n')) return [];
140:         try {
141:             const json = content.substring(8);
142:             return JSON.parse(json);
143:         } catch (e) {
144:             return [];
145:         }
146:     }
147:     private writeArchive(path: string, entries: ArEntry[], cwd: string) {
148:         const json = JSON.stringify(entries);
149:         this.fs.writeFile(path, '!<arch>\n' + json, 'w', 1000, 1000, cwd);
150:     }
151:     private formatVerbose(entry: ArEntry): string {
152:         return `rw-r--r-- ${entry.header.uid}/${entry.header.gid} ${entry.header.size} ${entry.header.name}`;
153:     }
154: }
