  2:     WORD = 'WORD',
  3:     PIPE = 'PIPE',
  4:     SEMI = 'SEMI',
  5:     AND_IF = 'AND_IF',
  6:     OR_IF = 'OR_IF',
  7:     LPAREN = 'LPAREN',
  8:     RPAREN = 'RPAREN',
  9:     NEWLINE = 'NEWLINE',
 10:     EOF = 'EOF'
 11: }
 12: export interface Token {
 13:     type: TokenType;
 14:     value: string;
 15:     position: number;
 16: }
 17: export class ShellLexer {
 18:     private input: string = '';
 19:     private pos: number = 0;
 20:     private len: number = 0;
 21:     tokenize(input: string): Token[] {
 22:         this.input = input;
 23:         this.pos = 0;
 24:         this.len = input.length;
 25:         const tokens: Token[] = [];
 26:         while (this.pos < this.len) {
 27:             this.skipWhitespace();
 28:             if (this.pos >= this.len) break;
 29:             const char = this.peek();
 30:             // Comments
 31:             if (char === '#') {
 32:                 this.skipComment();
 33:                 continue;
 34:             }
 35:             // Operators
 36:             if (this.isOperatorStart(char)) {
 37:                 const opToken = this.readOperator();
 38:                 if (opToken) {
 39:                     tokens.push(opToken);
 40:                     continue;
 41:                 }
 42:             }
 43:             // Newline
 44:             if (char === '\n') {
 45:                 tokens.push({ type: TokenType.NEWLINE, value: '\n', position: this.pos++ });
 46:                 continue;
 47:             }
 48:             const word = this.readWord();
 49:             if (word) {
 50:                 tokens.push(word);
 51:             } else {
 52:                 this.pos++;
 53:             }
 54:         }
 55:         tokens.push({ type: TokenType.EOF, value: '', position: this.pos });
 56:         return tokens;
 57:     }
 58:     private peek(offset: number = 0): string {
 59:         return this.input[this.pos + offset] || '';
 60:     }
 61:     private skipWhitespace() {
 62:         while (this.pos < this.len) {
 63:             const char = this.input[this.pos];
 64:             if (char === ' ' || char === '\t') {
 65:                 this.pos++;
 66:             } else {
 67:                 break;
 68:             }
 69:         }
 70:     }
 71:     private skipComment() {
 72:         while (this.pos < this.len) {
 73:             if (this.input[this.pos] === '\n') break;
 74:             this.pos++;
 75:         }
 76:     }
 77:     private isOperatorStart(char: string): boolean {
 78:         return /[|;&()]/.test(char);
 79:     }
 80:     private readOperator(): Token | null {
 81:         const c1 = this.peek(0);
 82:         const c2 = this.peek(1);
 83:         const start = this.pos;
 84:         if ((c1 === '&' && c2 === '&') || (c1 === '|' && c2 === '|')) {
 85:             this.pos += 2;
 86:             return {
 87:                 type: c1 === '&' ? TokenType.AND_IF : TokenType.OR_IF,
 88:                 value: c1 + c2,
 89:                 position: start
 90:             };
 91:         }
 92:         if (c1 === '|') {
 93:             this.pos++;
 94:             return { type: TokenType.PIPE, value: '|', position: start };
 95:         }
 96:         if (c1 === ';') {
 97:             this.pos++;
 98:             return { type: TokenType.SEMI, value: ';', position: start };
 99:         }
100:         if (c1 === '(') {
101:             this.pos++;
102:             return { type: TokenType.LPAREN, value: '(', position: start };
103:         }
104:         if (c1 === ')') {
105:             this.pos++;
106:             return { type: TokenType.RPAREN, value: ')', position: start };
107:         }
108:         return null;
109:     }
110:     private readWord(): Token | null {
111:         let value = '';
112:         const start = this.pos;
113:         let inSingleQuote = false;
114:         let inDoubleQuote = false;
115:         let escaped = false;
116:         let parenDepth = 0;
117:         while (this.pos < this.len) {
118:             const char = this.input[this.pos];
119:             if (escaped) {
120:                 value += char;
121:                 escaped = false;
122:                 this.pos++;
123:                 continue;
124:             }
125:             if (char === '\\') {
126:                 // Backslash logic
127:                 if (inSingleQuote) {
128:                     value += char; // Literal backslash in single quotes
129:                 } else {
130:                     escaped = true; // Next literal
131:                 }
132:                 this.pos++;
133:                 continue;
134:             }
135:             if (char === "'" && !inDoubleQuote && parenDepth === 0) {
136:                 inSingleQuote = !inSingleQuote;
137:                 // Include quote
138:                 value += char;
139:                 this.pos++;
140:                 continue;
141:             }
142:             if (char === '"' && !inSingleQuote && parenDepth === 0) {
143:                 inDoubleQuote = !inDoubleQuote;
144:                 // Include quote
145:                 value += char;
146:                 this.pos++;
147:                 continue;
148:             }
149:             // Word Delimiters (if not quoted and not in expansion)
150:             if (!inSingleQuote && !inDoubleQuote) {
151:                 // Check for expansion start $(
152:                 if (char === '$' && this.peek(1) === '(') {
153:                     parenDepth++;
154:                     value += '$(';
155:                     this.pos += 2;
156:                     continue;
157:                 }
158:                 if (parenDepth > 0) {
159:                     if (char === '(') parenDepth++;
160:                     else if (char === ')') parenDepth--;
161:                     value += char;
162:                     this.pos++;
163:                     continue;
164:                 }
165:                 if (char === ' ' || char === '\t' || char === '\n') break;
166:                 if (this.isOperatorStart(char)) break;
167:             }
168:             value += char;
169:             this.pos++;
170:         }
171:         if (value.length === 0 && this.pos === start) return null;
172:         if (inSingleQuote || inDoubleQuote) {
173:             throw new Error("Syntax Error: Unclosed quote");
174:         }
175:         return {
176:             type: TokenType.WORD,
177:             value: value,
178:             position: start
179:         };
180:     }
181: }
