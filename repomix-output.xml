<file path="src/frameworks-drivers/ui/GhostWriter.tsx">
 1: import React, { useState, useEffect, useRef } from 'react';
 2: import { TextStyle } from 'react-native';
 3: import { THEME } from './Theme';
 4: interface GhostWriterProps {
 5:     text: string;
 6:     speed?: number;
 7:     style?: TextStyle;
 8:     isActive?: boolean;
 9:     onComplete?: () => void;
10: }
11: import { useTheme, useThemeComponents } from './context/ThemeContext';
12: export const GhostWriter: React.FC<GhostWriterProps> = ({
13:     text,
14:     speed = 30,
15:     style,
16:     isActive = true,
17:     onComplete
18: }) => {
19:     const { theme, settings } = useTheme();
20:     const components = useThemeComponents();
21:     const { TextRenderer } = components;
22:     const colors = theme.colors;
23:     const [displayedText, setDisplayedText] = useState('');
24:     const [isComplete, setIsComplete] = useState(false);
25:     const hasStartedRef = useRef(false);
26:     useEffect(() => {
27:         if (!isActive) return;
28:         // If we were already complete (e.g. re-render), don't restart
29:         if (isComplete) return;
30:         let currentIdx = displayedText.length;
31:         let timeoutId: NodeJS.Timeout;
32:         let isMounted = true;
33:         if (!hasStartedRef.current) {
34:             setDisplayedText('');
35:             hasStartedRef.current = true;
36:             currentIdx = 0;
37:         }
38:         const typeNextChar = () => {
39:             if (!isMounted) return;
40:             if (currentIdx < text.length) {
41:                 setDisplayedText(text.slice(0, currentIdx + 1));
42:                 currentIdx++;
43:                 timeoutId = setTimeout(typeNextChar, speed);
44:             } else {
45:                 setIsComplete(true);
46:                 onComplete?.();
47:             }
48:         };
49:         timeoutId = setTimeout(typeNextChar, 10);
50:         return () => {
51:             isMounted = false;
52:             clearTimeout(timeoutId);
53:         };
54:     }, [text, speed, isActive, isComplete, onComplete, displayedText.length]);
55:     if (!isActive && !hasStartedRef.current) return null;
56:     return (
57:         <TextRenderer
58:             style={style}
59:             content={displayedText}
60:         />
61:     );
62: };
</file>

