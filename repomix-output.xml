173:     link(oldPath: string, newPath: string, cwd: string = '/'): Dentry {
174:         // Hard link logic
175:         const oldDentry = this.resolve(oldPath, cwd);
176:         if (!oldDentry) throw new Error(`link: cannot access '${oldPath}': No such file or directory`);
177:         const inode = this.getInode(oldDentry.inodeId);
178:         if (!inode) throw new Error('Corrupt filesystem');
179:         if (inode.mode & S_IFDIR) throw new Error(`link: '${oldPath}': Hard link to directory not allowed`);
180:         const absPath = this.resolveAbsolutePath(newPath, cwd);
181:         const parentPath = absPath.substring(0, absPath.lastIndexOf('/')) || '/';
182:         const name = absPath.substring(absPath.lastIndexOf('/') + 1);
183:         const parent = this.resolve(parentPath, cwd, true);
184:         if (!parent || !parent.isDirectory()) throw new Error(`link: cannot create link '${newPath}': Parent not found`);
185:         const parentDir = parent as DirectoryNode;
186:         if (parentDir.getChild(name)) throw new Error(`link: failed to create link '${newPath}': File exists`);
187:         const dentry = new FileNode(name, inode.id, parentDir);
188:         parentDir.addChild(dentry);
189:         inode.links++;
190:         inode.ctime = Date.now();
191:         return dentry;
192:     }
193:     rename(oldPath: string, newPath: string, cwd: string = '/'): void {
194:         const oldDentry = this.resolve(oldPath, cwd, false);
195:         if (!oldDentry) throw new Error(`rename: cannot access '${oldPath}': No such file or directory`);
196:         if (!oldDentry.parent) throw new Error(`rename: cannot move root`);
197:         const existing = this.resolve(newPath, cwd, false);
198:         if (existing) {
199:             this.deleteNode(newPath, cwd);
200:         }
201:         const absPath = this.resolveAbsolutePath(newPath, cwd);
202:         const parentPath = absPath.substring(0, absPath.lastIndexOf('/')) || '/';
203:         const newName = absPath.substring(absPath.lastIndexOf('/') + 1);
204:         const newParent = this.resolve(parentPath, cwd, true);
205:         if (!newParent || !newParent.isDirectory()) throw new Error(`rename: cannot move to '${newPath}': Parent not found`);
206:         const targetParentDir = newParent as DirectoryNode;
207:         const oldParent = oldDentry.parent as DirectoryNode;
208:         oldParent.removeChild(oldDentry.name);
209:         oldDentry.parent = targetParentDir;
210:         oldDentry.name = newName;
211:         targetParentDir.addChild(oldDentry);
212:         const inode = this.getInode(oldDentry.inodeId);
213:         if (inode) inode.ctime = Date.now();
214:     }
