 1: import { SyntaxChecker, SyntaxError } from '../ports/SyntaxChecker';
 2: import { SchemeParser } from './SchemeParser';
 3: export class SchemeChecker implements SyntaxChecker {
 4:     readonly language = 'scheme';
 5:     private parser = new SchemeParser();
 6:     check(source: string): SyntaxError[] {
 7:         const errors: SyntaxError[] = [];
 8:         const parenStats = this.checkParens(source);
 9:         if (parenStats.error) {
10:             errors.push(parenStats.error);
11:             return errors;
12:         }
13:         try {
14:             this.parser.parse(source);
15:         } catch (err: any) {
16:             const message = err.message;
17:             const match = message.match(/line (\d+), column (\d+)/);
18:             if (match) {
19:                 errors.push({
20:                     line: parseInt(match[1]),
21:                     column: parseInt(match[2]),
22:                     message: message,
23:                     severity: 'error'
24:                 });
25:             } else {
26:                 const lines = source.split('\n');
27:                 errors.push({
28:                     line: lines.length,
29:                     column: lines[lines.length - 1].length + 1,
30:                     message: message,
31:                     severity: 'error'
32:                 });
33:             }
34:         }
35:         return errors;
36:     }
37:     private checkParens(source: string): { error: SyntaxError | null } {
38:         const stack: { char: string, line: number, col: number }[] = [];
39:         let line = 1;
40:         let col = 1;
41:         for (let i = 0; i < source.length; i++) {
42:             const char = source[i];
43:             if (char === '\n') {
44:                 line++;
45:                 col = 1;
46:                 continue;
47:             }
48:             if (char === '(') {
49:                 stack.push({ char: '(', line, col });
50:             } else if (char === ')') {
51:                 if (stack.length === 0) {
52:                     return {
53:                         error: {
54:                             line,
55:                             column: col,
56:                             message: 'Unexpected closing parenthesis ")"',
57:                             severity: 'error'
58:                         }
59:                     };
60:                 }
61:                 stack.pop();
62:             }
63:             col++;
64:         }
65:         if (stack.length > 0) {
66:             const last = stack.pop()!;
67:             return {
68:                 error: {
69:                     line: last.line,
70:                     column: last.col,
71:                     message: 'Unclosed parenthesis "("',
72:                     severity: 'error'
73:                 }
74:             };
75:         }
76:         return { error: null };
77:     }
78: }
</file>

