<file path="src/domain/services/SimulationBus.ts">
 1: import { TelemetryPort } from '../ports/TelemetryPort';
 2: export enum GameEventType {
 3:     COMMAND_EXECUTED = 'COMMAND_EXECUTED',
 4:     REGISTER_MODIFIED = 'REGISTER_MODIFIED',
 5:     FILE_ACCESS = 'FILE_ACCESS',
 6:     MISSION_PROGRESS = 'MISSION_PROGRESS',
 7:     TUTOR_EVENT = 'TUTOR_EVENT',
 8:     ECONOMY_UPDATE = 'ECONOMY_UPDATE',
 9:     KEYSTROKE_ACCEPTED = 'KEYSTROKE_ACCEPTED',
10:     ERROR_OCCURRED = 'ERROR_OCCURRED'
11: }
12: export interface CommandExecutedPayload {
13:     command: string;
14:     args: string[];
15:     exitCode: number;
16:     output: string;
17:     cwd: string;
18: }
19: export interface RegisterModifiedPayload {
20:     register: string;
21:     oldValue: number;
22:     newValue: number;
23:     instruction?: string;
24: }
25: export interface FileAccessPayload {
26:     path: string;
27:     operation: 'READ' | 'WRITE' | 'DELETE' | 'EXECUTE';
28:     success: boolean;
29: }
30: export interface GameEvent {
31:     type: GameEventType;
32:     timestamp: string;
33:     payload: CommandExecutedPayload | RegisterModifiedPayload | FileAccessPayload | any;
34: }
35: export type GameEventCallback = (event: GameEvent) => void;
36: export class SimulationBus {
37:     private listeners: Map<GameEventType | '*', GameEventCallback[]> = new Map();
38:     constructor(private telemetry: TelemetryPort) {}
39:     public subscribe(type: GameEventType | '*', callback: GameEventCallback): () => void {
40:         console.log(`[SimulationBus] SUBSCRIBE: ${type}`);
41:         this.telemetry.trace('SimulationBus.subscribe', () => {
42:             if (!this.listeners.has(type)) {
43:                 this.listeners.set(type, []);
44:             }
45:             this.listeners.get(type)!.push(callback);
46:         }, type);
47:         return () => {
48:             console.log(`[SimulationBus] UNSUBSCRIBE: ${type}`);
49:             const list = this.listeners.get(type);
50:             if (list) {
51:                 this.listeners.set(type, list.filter(l => l !== callback));
52:             }
53:         };
54:     }
55:     public once(type: GameEventType, callback: GameEventCallback): void {
56:         const unsubscribe = this.subscribe(type, (event) => {
57:             unsubscribe();
58:             callback(event);
59:         });
60:     }
61:     public waitFor(type: GameEventType, timeoutMs: number = 5000): Promise<GameEvent> {
62:         return new Promise((resolve, reject) => {
63:             const timer = setTimeout(() => {
64:                 reject(new Error(`Timeout waiting for event: ${type}`));
65:             }, timeoutMs);
66:             this.once(type, (event) => {
67:                 clearTimeout(timer);
68:                 resolve(event);
69:             });
70:         });
71:     }
72:     public emit(type: GameEventType, payload: any): void {
73:         console.log(`[SimulationBus] EMIT: ${type}`, payload);
74:         this.telemetry.trace('SimulationBus.emit', () => {
75:             const event: GameEvent = {
76:                 type,
77:                 timestamp: new Date().toISOString(),
78:                 payload
79:             };
80:             const specificListeners = this.listeners.get(type) || [];
81:             const wildcardListeners = this.listeners.get('*') || [];
82:             const allListeners = [...specificListeners, ...wildcardListeners];
83:             this.telemetry.debug(`Emitting ${type} to ${allListeners.length} listeners`, { payload });
84:             allListeners.forEach(callback => {
85:                 try {
86:                     callback(event);
87:                 } catch (error) {
88:                     console.error(`[SimulationBus] Listener Error for ${type}:`, error);
89:                     this.telemetry.error(`Error in SimulationBus listener for ${type}`, { error, event });
90:                 }
91:             });
92:         }, type, payload);
93:     }
94: }
</file>

