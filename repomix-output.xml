<file path="src/frameworks-drivers/ui/hooks/useTutorAnimation.ts">
 1: import { useRef, useEffect } from 'react';
 2: import { Animated, Platform } from 'react-native';
 3: import { TutorMessage } from '../../../domain/entities/tutor/TutorMessage';
 4: export const useTutorAnimation = (message: TutorMessage | null) => {
 5:     const shakeAnim = useRef(new Animated.Value(0)).current;
 6:     const pulseAnim = useRef(new Animated.Value(1)).current;
 7:     const useNativeDriver = Platform.OS !== 'web';
 8:     useEffect(() => {
 9:         if (!message) return;
10:         if (message.type === 'critical') {
11:             Animated.sequence([
12:                 Animated.timing(shakeAnim, { toValue: 10, duration: 50, useNativeDriver }),
13:                 Animated.timing(shakeAnim, { toValue: -10, duration: 50, useNativeDriver }),
14:                 Animated.timing(shakeAnim, { toValue: 10, duration: 50, useNativeDriver }),
15:                 Animated.timing(shakeAnim, { toValue: 0, duration: 50, useNativeDriver })
16:             ]).start();
17:         } else if (message.type === 'warn') {
18:             Animated.sequence([
19:                 Animated.timing(pulseAnim, { toValue: 0.5, duration: 200, useNativeDriver }),
20:                 Animated.timing(pulseAnim, { toValue: 1, duration: 200, useNativeDriver })
21:             ]).start();
22:         } else {
23:             shakeAnim.setValue(0);
24:             pulseAnim.setValue(1);
25:         }
26:     }, [message]);
27:     return {
28:         transform: [{ translateX: shakeAnim }],
29:         opacity: pulseAnim
30:     };
31: };
</file>

