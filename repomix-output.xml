 2: import { ICommand, CommandResponse } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: export class CompressCommand implements ICommand {
 7:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 8:         const input = getStdinAsString(context);
 9:         const fs = context.fileSystemService;
10:         const file = args[0];
11:         if (!file) {
12:             return { output: 'compress: missing file', newState: state, exitCode: 1 };
13:         }
14:         const node = fs.resolve(file, state.currentDirectory);
15:         if (!node || fs.isDirectory(node)) {
16:             return { output: `compress: ${file}: No such file or directory`, newState: state, exitCode: 1 };
17:         }
18:         const path = fs.getAbsolutePath(node);
19:         const content = fs.readFile(path);
20:         const compressed = `\x1f\x9d` + content;
21:         fs.writeFile(path + '.Z', compressed, 'w', undefined, undefined, state.currentDirectory);
22:         fs.deleteNode(path, state.currentDirectory);
23:         return { output: '', newState: state, exitCode: 0 };
24:     }
25: }
