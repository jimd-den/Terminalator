 22:     fs: FileSystem,
 23:     commandExecutor: ExecuteCommand,
 24:     gameManager: IGameManager,
 25:     tutorShadow: TutorShadow,
 26:     setMissions: (missions: any[]) => void,
 27:     simulationMediator: SimulationMediator
