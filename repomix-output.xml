<file path="src/domain/commands/core/awk/AwkInterpreter.ts">
 1: import { ProgramNode } from './AwkParser';
 2: import { AwkRuntimeEnvironment } from './AwkRuntimeEnvironment';
 3: import { AwkExecutionVisitor } from './AwkExecutionVisitor';
 4: export class AwkInterpreter {
 5:     public execute(ast: ProgramNode, input: string): string {
 6:         const env = new AwkRuntimeEnvironment();
 7:         const visitor = new AwkExecutionVisitor(env);
 8:         for (const block of ast.beginBlocks) {
 9:             visitor.visit(block);
10:         }
11:         if (input.length > 0) {
12:             const lines = input.split('\n');
13:             for (const line of lines) {
14:                 env.updateFields(line);
15:                 for (const pa of ast.patternActions) {
16:                     visitor.visit(pa);
17:                 }
18:             }
19:         } else if (ast.patternActions.length > 0) {
20:         }
21:         for (const block of ast.endBlocks) {
22:             visitor.visit(block);
23:         }
24:         return visitor.getOutput();
25:     }
26: }
