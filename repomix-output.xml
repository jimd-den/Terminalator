  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { CommandBase } from '../CommandBase';
  3: import { CommandCapability } from '../IStructuredCommand';
  4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  5: import { TerminalState } from '../../entities/TerminalState';
  6: import { CommandResponse, CommandMetadata } from '../../entities/Command';
  7: import { TheatricalVerb } from '../../services/PresentationDirector';
  8: import { FileSystemService } from '../../services/FileSystemService';
  9: import { DirectoryNode } from '../../entities/filesystem/DirectoryNode';
 10: export class CpCommand extends CommandBase {
 11:     public readonly capabilities = [CommandCapability.MODIFY];
 12:     public readonly utility = 'cp';
 13:     constructor(private fsService: FileSystemService) { super(); }
 14:     public getMetadata(): CommandMetadata {
 15:         return {
 16:             verb: TheatricalVerb.SYNTHESIZE,
 17:             style: 'NORMAL'
 18:         };
 19:     }
 20:     executeInternal(args: string[], flags: Set<string>, operands: string[], context: ProcessContext, state: TerminalState): CommandResponse {
 21:         const fsService = context.fileSystemService || this.fsService;
 22:         const recursive = flags.has('r') || flags.has('R');
 23:         if (operands.length < 2) {
 24:             return {
 25:                 output: 'cp: missing file operand',
 26:                 newState: state,
 27:                 exitCode: 1
 28:             };
 29:         }
 30:         const sources = operands.slice(0, operands.length - 1);
 31:         const destination = operands[operands.length - 1];
 32:         const destPath = fsService.resolveAbsolutePath(destination, state.currentDirectory);
 33:         const destNode = fsService.resolve(destPath);
 34:         const destIsDir = destNode ? fsService.isDirectory(destNode) : destination.endsWith('/');
 35:         if (sources.length > 1 && destNode && !destIsDir) {
 36:             return {
 37:                 output: `cp: target '${destination}' is not a directory`,
 38:                 newState: state,
 39:                 exitCode: 1
 40:             };
 41:         }
 42:         for (const source of sources) {
 43:             const srcPath = fsService.resolveAbsolutePath(source, state.currentDirectory);
 44:             const srcNode = fsService.resolve(srcPath);
 45:             if (!srcNode) {
 46:                 return {
 47:                     output: `cp: cannot stat '${source}': No such file or directory`,
 48:                     newState: state,
 49:                     exitCode: 1
 50:                 };
 51:             }
 52:             const srcIsDir = fsService.isDirectory(srcNode);
 53:             if (srcIsDir) {
 54:                 if (!recursive) {
 55:                     return {
 56:                         output: `cp: -r not specified; omitting directory '${source}'`,
 57:                         newState: state,
 58:                         exitCode: 1
 59:                     };
 60:                 }
 61:                 try {
 62:                     let finalDest = destPath;
 63:                     if (destIsDir) {
 64:                         finalDest = destPath === '/' ? `/${srcNode.name}` : `${destPath}/${srcNode.name}`;
 65:                     }
 66:                     this.copyRecursive(srcPath, finalDest, fsService);
 67:                 } catch (e: any) {
 68:                     return {
 69:                         output: `cp: error copying '${source}': ${e.message}`,
 70:                         newState: state,
 71:                         exitCode: 1
 72:                     };
 73:                 }
 74:             } else {
 75:                 try {
 76:                     let finalDest = destPath;
 77:                     if (destIsDir) {
 78:                         finalDest = destPath === '/' ? `/${srcNode.name}` : `${destPath}/${srcNode.name}`;
 79:                     }
 80:                     const content = fsService.readFile(srcPath);
 81:                     fsService.writeFile(finalDest, content, 'w');
 82:                 } catch (e: any) {
 83:                     return {
 84:                         output: `cp: cannot create regular file '${destination}': ${e.message}`,
 85:                         newState: state,
 86:                         exitCode: 1
 87:                     };
 88:                 }
 89:             }
 90:         }
 91:         return {
 92:             output: '',
 93:             newState: state,
 94:             exitCode: 0
 95:         };
 96:     }
 97:     private copyRecursive(srcPath: string, destPath: string, fsService: FileSystemService) {
 98:         if (!fsService.resolve(destPath)) {
 99:             fsService.mkdir(destPath, 0o755);
100:         }
101:         const srcNode = fsService.resolve(srcPath);
102:         if (!srcNode || !fsService.isDirectory(srcNode)) return;
103:         const children = Array.from((srcNode as DirectoryNode).children.values());
104:         for (const child of children) {
105:             const childSrcPath = srcPath === '/' ? `/${child.name}` : `${srcPath}/${child.name}`;
106:             const childDestPath = destPath === '/' ? `/${child.name}` : `${destPath}/${child.name}`;
107:             if (fsService.isDirectory(child)) {
108:                 this.copyRecursive(childSrcPath, childDestPath, fsService);
109:             } else {
110:                 const content = fsService.readFile(childSrcPath);
111:                 fsService.writeFile(childDestPath, content, 'w');
112:             }
113:         }
114:     }
115: }
