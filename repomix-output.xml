<file path="src/domain/commands/CommandBase.ts">
 1: import { CommandResponse } from './ICommand';
 2: import { IStructuredCommand, CommandCapability } from './IStructuredCommand';
 3: import { ProcessContext } from '../entities/ProcessContext';
 4: import { TerminalState } from '../entities/TerminalState';
 5: export abstract class CommandBase implements IStructuredCommand {
 6:     public abstract readonly capabilities: CommandCapability[];
 7:     public abstract readonly utility: string;
 8:     protected flags: Set<string> = new Set();
 9:     protected options: Map<string, string> = new Map();
10:     protected operands: string[] = [];
11:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
12:         this.parseArgs(args);
13:         return this.executeInternal(args, this.flags, this.operands, context, state);
14:     }
15:     protected abstract executeInternal(
16:         rawArgs: string[],
17:         flags: Set<string>,
18:         operands: string[],
19:         context: ProcessContext,
20:         state: TerminalState
21:     ): Promise<CommandResponse> | CommandResponse;
22:     public buildArgs(requirements: Record<string, any>): string[] {
23:         const args: string[] = [];
24:         if (requirements.flags) args.push(...requirements.flags);
25:         if (requirements.path) args.push(requirements.path);
26:         return args;
27:     }
28:     protected parseArgs(args: string[], optionDefinitions: string[] = []) {
29:         this.flags = new Set();
30:         this.options = new Map();
31:         this.operands = [];
32:         for (let i = 0; i < args.length; i++) {
33:             const arg = args[i];
34:             if (arg === '--') {
35:                 this.operands.push(...args.slice(i + 1));
36:                 break;
37:             }
38:             if (arg.startsWith('-') && arg !== '-') {
39:                 const flagStr = arg.substring(1);
40:                 let handled = false;
41:                 for (const def of optionDefinitions) {
42:                     if (flagStr === def) {
43:                         if (i + 1 < args.length) {
44:                             this.options.set(def, args[++i]);
45:                             handled = true;
46:                             break;
47:                         }
48:                     } else if (flagStr.startsWith(def)) {
49:                         this.options.set(def, flagStr.substring(def.length));
50:                         handled = true;
51:                         break;
52:                     }
53:                 }
54:                 if (!handled) {
55:                     for (const char of flagStr) {
56:                         this.flags.add(char);
57:                     }
58:                 }
59:             } else {
60:                 this.operands.push(arg);
61:             }
62:         }
63:     }
64:     protected hasFlag(char: string): boolean {
65:         return this.flags.has(char);
66:     }
67: }
</file>

