 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { CommandBase } from '../CommandBase';
 3: import { CommandCapability } from '../IStructuredCommand';
 4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystemService } from '../../services/FileSystemService';
 8: import { AwkLexer } from './awk/AwkLexer';
 9: import { AwkParser } from './awk/AwkParser';
10: import { AwkInterpreter } from './awk/AwkInterpreter';
11: export class AwkCommand extends CommandBase {
12:     public readonly capabilities = [CommandCapability.TRANSFORM, CommandCapability.FILTER];
13:     public readonly utility = 'awk';
14:     constructor(private fs: FileSystemService) {
15:         super();
16:     }
17:     public override buildArgs(requirements: Record<string, any>): string[] {
18:         const args: string[] = [];
19:         if (requirements.fieldSeparator) args.push('-F', requirements.fieldSeparator);
20:         if (requirements.program) args.push(requirements.program);
21:         if (requirements.path) args.push(requirements.path);
22:         return args;
23:     }
24:     protected override parseArgs(args: string[]) {
25:         super.parseArgs(args, ['F', 'v']);
26:     }
27:     protected async executeInternal(
28:         rawArgs: string[],
29:         flags: Set<string>,
30:         operands: string[],
31:         context: ProcessContext,
32:         state: TerminalState
33:     ): Promise<CommandResponse> {
34:         const input = getStdinAsString(context);
35:         let program = '';
36:         const files: string[] = [];
37:         let fieldSeparator = this.options.get('F') || ' ';
38:         let opIndex = 0;
39:         if (operands.length > 0) {
40:             program = operands[opIndex++];
41:         }
42:         while (opIndex < operands.length) {
43:             files.push(operands[opIndex++]);
44:         }
45:         if (!program) {
46:             return { output: 'awk: missing program', newState: state, exitCode: 1 };
47:         }
48:         if ((program.startsWith("'") && program.endsWith("'")) || (program.startsWith('"') && program.endsWith('"'))) {
49:             program = program.slice(1, -1);
50:         }
51:         try {
52:             if (fieldSeparator !== ' ') {
53:                 program = `BEGIN { FS="${fieldSeparator}" } ` + program;
54:             }
55:             const lexer = new AwkLexer(program);
56:             const tokens = lexer.tokenize();
57:             const parser = new AwkParser(tokens);
58:             const ast = parser.parse();
59:             let content = '';
60:             if (files.length > 0) {
61:                 for (const file of files) {
62:                     try {
63:                         const path = file.startsWith('/') ? file : (state.currentDirectory === '/' ? `/${file}` : `${state.currentDirectory}/${file}`);
64:                         content += this.fs.readFile(path) + '\n';
65:                     } catch (e: any) {
66:                         return { output: `awk: ${file}: ${e.message}`, newState: state, exitCode: 1 };
67:                     }
68:                 }
69:                 if (content.endsWith('\n')) content = content.slice(0, -1);
70:             } else if (input !== undefined) {
71:                 content = input;
72:             }
73:             const interpreter = new AwkInterpreter();
74:             const output = interpreter.execute(ast, content);
75:             return { output: output.trimEnd(), newState: state, exitCode: 0 };
76:         } catch (e: any) {
77:             return { output: `awk: ${e.message}`, newState: state, exitCode: 1 };
78:         }
79:     }
80: }
</file>

