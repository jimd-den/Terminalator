 2:     QUARTER = 1,
 3:     EIGHTH = 2,
 4:     SIXTEENTH = 4
 5: }
 6: export class MiningSession {
 7:     public hashRate: number = 0.0;
 8:     public totalZincMined: number = 0;
 9:     public sessionZincMined: number = 0;
10:     public streak: number = 0;
11:     public lastBeatTime: number = 0;
12:     private readonly BASE_REWARD = 0.00000000001;
13:     private readonly MAX_HASHRATE = 100.0;
14:     private readonly STREAK_BOOST = 0.1;
15:     private readonly PASSIVE_DECAY = 0.02;
16:     private readonly MISTAKE_PENALTY = 0.5;
17:     private readonly BPM = 120;
18:     private readonly BEAT_MS = (60 / 120) * 1000;
19:     public processHit(timestamp: number, _unused?: number): number {
20:         const beatOffset = timestamp % this.BEAT_MS;
21:         const isOnBeat = beatOffset < 80 || beatOffset > (this.BEAT_MS - 80);
22:         if (isOnBeat) {
23:             this.streak++;
24:             this.hashRate = Math.min(this.MAX_HASHRATE, this.hashRate + this.STREAK_BOOST);
25:             const reward = this.BASE_REWARD * this.hashRate;
26:             this.totalZincMined += reward;
27:             this.sessionZincMined += reward;
28:             return reward;
29:         } else {
30:             this.penalize();
31:             return 0;
32:         }
33:     }
34:     public decay(): number {
35:         if (this.hashRate > 0) {
36:             this.hashRate = Math.max(0, this.hashRate - this.PASSIVE_DECAY);
37:         }
38:         const passiveReward = (this.BASE_REWARD * this.hashRate) / 10;
39:         this.totalZincMined += passiveReward;
40:         this.sessionZincMined += passiveReward;
41:         return passiveReward;
42:     }
43:     private checkSubdivisions(offset: number): boolean {
44:         const tolerance = 80;
45:         if (offset < tolerance) return true;
46:         const eighth = this.BEAT_MS / 2;
47:         if (Math.abs(offset - eighth) < tolerance) return true;
48:         const sixteenth = this.BEAT_MS / 4;
49:         if (Math.abs(offset - sixteenth) < tolerance) return true;
50:         if (Math.abs(offset - (sixteenth * 3)) < tolerance) return true;
51:         return false;
52:     }
53:     public penalize() {
54:         this.streak = 0;
55:         this.hashRate = Math.max(0, this.hashRate - this.MISTAKE_PENALTY);
56:     }
57:     public startSession() {
58:         this.sessionZincMined = 0;
59:     }
60:     public reset() {
61:         this.streak = 0;
62:         this.hashRate = 0.0;
63:         this.totalZincMined = 0;
64:         this.sessionZincMined = 0;
65:     }
66: }
