25:                 Object.entries(file.params).forEach(([key, val]) => {
26:                     finalContent = finalContent.replace(new RegExp(`{${key}}`, 'g'), String(val));
27:                 });
28:             }
29:             try {
30:                 service.writeFile(
31:                     file.path,
32:                     finalContent,
33:                     'w',
34:                     file.owner ? 1002 : undefined,
35:                     file.owner ? 1002 : undefined
36:                 );
37:                 if (file.mode !== undefined) {
38:                     service.chmod(file.path, file.mode);
39:                 }
40:             } catch (e) {
41:             }
42:         });
43:         spec.logs.forEach(log => {
44:             try {
45:                 const parts = log.path.split('/');
46:                 parts.pop();
47:                 service.mkdirp(parts.join('/'));
48:                 if (log.type === 'INCIDENT') {
49:                     populator.populateIncidentLogs(log.path, log.lineCount, log.keyPhrase, 'ZONE_B');
50:                 } else if (log.type === 'UNIT') {
51:                     populator.populateUnitDatabase(log.path, log.lineCount);
52:                 } else {
