 1: import { RhythmStats } from '../../domain/entities/TutorEngine';
 2: import { ZincFormatter } from '../../domain/utils/ZincFormatter';
 3: export type RhythmGrade = 'SS' | 'S' | 'A' | 'B' | 'C' | 'D' | 'F';
 4: export interface RhythmSummary {
 5:     grade: RhythmGrade;
 6:     perfectPercentage: string;
 7:     accuracyPercentage: string;
 8:     maxStreak: number;
 9:     totalMined: string;
10: }
11: export class RhythmGamePresenter {
12:     static calculateGrade(stats: RhythmStats): RhythmGrade {
13:         const { accuracy, perfectHits, totalHits } = stats;
14:         if (totalHits === 0) return 'F';
15:         const perfectRatio = (perfectHits / totalHits) * 100;
16:         if (accuracy >= 98 && perfectRatio >= 90) return 'SS';
17:         if (accuracy >= 95 && perfectRatio >= 80) return 'S';
18:         if (accuracy >= 90) return 'A';
19:         if (accuracy >= 80) return 'B';
20:         if (accuracy >= 70) return 'C';
21:         if (accuracy >= 60) return 'D';
22:         return 'F';
23:     }
24:     static getSummary(stats: RhythmStats): RhythmSummary {
25:         return {
26:             grade: this.calculateGrade(stats),
27:             perfectPercentage: ((stats.perfectHits / (stats.totalHits || 1)) * 100).toFixed(1) + '%',
28:             accuracyPercentage: stats.accuracy.toFixed(1) + '%',
29:             maxStreak: stats.maxStreak,
30:             totalMined: ZincFormatter.formatFull(stats.totalZincMined)
31:         };
32:     }
33:     static getFeedbackType(isOnBeat: boolean, isMistake: boolean): 'PERFECT' | 'GREAT' | 'MISS' | 'NONE' {
34:         if (isMistake) return 'MISS';
35:         if (isOnBeat) return 'PERFECT';
36:         return 'GREAT';
37:     }
38: }
