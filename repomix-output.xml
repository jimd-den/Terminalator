111:             () => `I see you working on that command.`,
112:             () => `Buffer stream active. Maintaining uplink.`,
113:             () => `Data throughput increasing. Keep going.`
114:         ];
115:         return structures[Math.floor(Math.random() * structures.length)]();
116:     }
117:     private selectWord(pos: PartOfSpeech, tone: TutorToneProfile, desiredTags: string[]): string {
118:         const candidates = this.lexicon.entries.filter(e => {
119:             if (e.pos !== pos) return false;
120:             if (e.tones && !e.tones.includes(tone)) return false;
121:             return true;
122:         });
123:         if (candidates.length === 0) return '[WORD_MISSING]';
124:         const better = candidates.filter(e => e.tags.some(t => desiredTags.includes(t)));
125:         const pool = better.length > 0 ? better : candidates;
126:         const selected = pool[Math.floor(Math.random() * pool.length)];
127:         return selected.word;
128:     }
