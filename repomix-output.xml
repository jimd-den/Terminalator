<file path="src/domain/usecases/SchemeParser.ts">
  1: import {
  2:     SchemeValue,
  3:     makeNumber,
  4:     makeSymbol,
  5:     makeBoolean,
  6:     makeString,
  7:     makeChar,
  8:     makePair,
  9:     makeVector,
 10:     makeBytevector,
 11:     NIL,
 12:     EOF
 13: } from '../entities/SchemeValue';
 14: export class SchemeParser {
 15:     private input: string = '';
 16:     private pos: number = 0;
 17:     private labels: Map<number, SchemeValue> = new Map();
 18:     /**
 19:      * Parses a string into a list of Scheme expressions.
 20:      */
 21:     parse(source: string): SchemeValue[] {
 22:         this.input = source;
 23:         this.pos = 0;
 24:         this.labels.clear();
 25:         const expressions: SchemeValue[] = [];
 26:         while (true) {
 27:             this.skipWhitespaceAndComments();
 28:             if (this.isEOF()) break;
 29:             expressions.push(this.readDatum());
 30:         }
 31:         return expressions;
 32:     }
 33:     /**
 34:      * Internal: Read a single datum from the current position.
 35:      */
 36:     private readDatum(): SchemeValue {
 37:         this.skipWhitespaceAndComments();
 38:         if (this.isEOF()) throw new Error('Unexpected end of input');
 39:         const char = this.peek();
 40:         if (char === '(') {
 41:             return this.readList();
 42:         }
 43:         if (char === "'") {
 44:             this.advance();
 45:             return makePair(makeSymbol('quote'), makePair(this.readDatum(), NIL));
 46:         }
 47:         if (char === '`') {
 48:             this.advance();
 49:             return makePair(makeSymbol('quasiquote'), makePair(this.readDatum(), NIL));
 50:         }
 51:         if (char === ',') {
 52:             this.advance();
 53:             if (this.peek() === '@') {
 54:                 this.advance();
 55:                 return makePair(makeSymbol('unquote-splicing'), makePair(this.readDatum(), NIL));
 56:             }
 57:             return makePair(makeSymbol('unquote'), makePair(this.readDatum(), NIL));
 58:         }
 59:         if (char === '#') {
 60:             return this.readHashDatum();
 61:         }
 62:         if (char === '"') {
 63:             return this.readString();
 64:         }
 65:         return this.readAtomic();
 66:     }
 67:     private readList(): SchemeValue {
 68:         this.advance();
 69:         let head: SchemeValue = NIL;
 70:         let last: any = null;
 71:         while (true) {
 72:             this.skipWhitespaceAndComments();
 73:             if (this.isEOF()) throw new Error('Expected )');
 74:             if (this.peek() === ')') {
 75:                 this.advance();
 76:                 break;
 77:             }
 78:             if (this.peek() === '.') {
 79:                 const next = this.input[this.pos + 1];
 80:                 if (this.isDelimiter(next)) {
 81:                     this.advance();
 82:                     if (!last) throw new Error('Unexpected .');
 83:                     last.value.cdr = this.readDatum();
 84:                     this.skipWhitespaceAndComments();
 85:                     if (this.peek() !== ')') throw new Error('Expected ) after dotted pair');
 86:                     this.advance();
 87:                     break;
 88:                 }
 89:             }
 90:             const datum = this.readDatum();
 91:             const pair = makePair(datum, NIL);
 92:             if (!last) {
 93:                 head = pair;
 94:             } else {
 95:                 last.value.cdr = pair;
 96:             }
 97:             last = pair;
 98:         }
 99:         return head;
100:     }
101:     private readHashDatum(): SchemeValue {
102:         this.advance();
103:         const char = this.peek();
104:         if (char === 't' || char === 'f') {
105:             const word = this.readWord();
106:             if (word === 't' || word === 'true') return makeBoolean(true);
107:             if (word === 'f' || word === 'false') return makeBoolean(false);
108:             throw new Error(`Invalid boolean: #${word}`);
109:         }
110:         if (char === '\\') {
111:             this.advance();
112:             const word = this.readWord();
113:             if (word === 'space') return makeChar(' ');
114:             if (word === 'newline') return makeChar('\n');
115:             if (word === 'tab') return makeChar('\t');
116:             if (word.length === 1) return makeChar(word);
117:             return makeChar(word);
118:         }
119:         if (char === '(') {
120:             const list = this.readList();
121:             return makeVector(this.listToArr(list));
122:         }
123:         if (char === 'u') {
124:             this.advance();
125:             if (this.peek() === '8') {
126:                 this.advance();
127:                 if (this.peek() !== '(') throw new Error('Expected ( after #u8');
128:                 const list = this.readList();
129:                 const arr = this.listToArr(list);
130:                 return makeBytevector(new Uint8Array(arr.map(v => v.value)));
131:             }
132:         }
133:         if (/[0-9]/.test(char)) {
134:             let nStr = '';
135:             while (/[0-9]/.test(this.peek())) nStr += this.advance();
136:             const n = parseInt(nStr, 10);
137:             if (this.peek() === '=') {
138:                 this.advance();
139:                 const placeholder: any = { type: 'placeholder', id: n };
140:                 this.labels.set(n, placeholder);
141:                 const actual = this.readDatum();
142:                 this.patch(actual, placeholder, actual);
143:                 this.labels.set(n, actual);
144:                 return actual;
145:             } else if (this.peek() === '#') {
146:                 this.advance();
147:                 const label = this.labels.get(n);
148:                 if (label === undefined) throw new Error(`Undefined label: #${n}#`);
149:                 return label;
150:             }
151:         }
152:         throw new Error(`Unknown hash syntax: #${char}`);
153:     }
154:     private readString(): SchemeValue {
155:         this.advance();
156:         let str = '';
157:         while (!this.isEOF() && this.peek() !== '"') {
158:             const char = this.advance();
159:             if (char === '\\') {
160:                 const next = this.advance();
161:                 if (next === 'n') str += '\n';
162:                 else if (next === 't') str += '\t';
163:                 else if (next === '"') str += '"';
164:                 else if (next === '\\') str += '\\';
165:                 else str += next;
166:             } else {
167:                 str += char;
168:             }
169:         }
170:         if (this.advance() !== '"') throw new Error('Unterminated string');
171:         return makeString(str);
172:     }
173:     private readAtomic(): SchemeValue {
174:         const word = this.readWord();
175:         if (word === '') throw new Error('Unexpected empty atom');
176:         const num = Number(word);
177:         if (!isNaN(num) && word !== '+' && word !== '-') {
178:             return makeNumber(num);
179:         }
180:         return makeSymbol(word);
181:     }
182:     private readWord(): string {
183:         let word = '';
184:         while (!this.isEOF() && !this.isDelimiter(this.peek())) {
185:             const char = this.advance();
186:             if (char === '|') {
187:                 // Pipe-quoted symbol |symbol name|
188:                 while (!this.isEOF() && this.peek() !== '|') {
189:                     word += this.advance();
190:                 }
191:                 this.advance(); // '|'
192:             } else {
193:                 word += char;
194:             }
195:         }
196:         return word;
197:     }
198:     private skipWhitespaceAndComments(): void {
199:         while (true) {
200:             while (/\s/.test(this.peek())) this.advance();
201:             if (this.peek() === ';') {
202:                 while (!this.isEOF() && this.peek() !== '\n') this.advance();
203:                 continue;
204:             }
205:             if (this.peek() === '#' && this.input[this.pos + 1] === '|') {
206:                 this.pos += 2;
207:                 let depth = 1;
208:                 while (depth > 0 && !this.isEOF()) {
209:                     if (this.peek() === '#' && this.input[this.pos + 1] === '|') {
210:                         depth++; this.pos += 2;
211:                     } else if (this.peek() === '|' && this.input[this.pos + 1] === '#') {
212:                         depth--; this.pos += 2;
213:                     } else {
214:                         this.advance();
215:                     }
216:                 }
217:                 continue;
218:             }
219:             if (this.peek() === '#' && this.input[this.pos + 1] === ';') {
220:                 this.pos += 2;
221:                 this.readDatum();
222:                 continue;
223:             }
224:             break;
225:         }
226:     }
227:     private listToArr(list: SchemeValue): SchemeValue[] {
228:         const arr: SchemeValue[] = [];
229:         let curr = list;
230:         while (curr.type === 'pair') {
231:             arr.push(curr.value.car);
232:             curr = curr.value.cdr;
233:         }
234:         return arr;
235:     }
236:     private patch(obj: SchemeValue, placeholder: any, replacement: SchemeValue, seen: Set<any> = new Set()): void {
237:         if (!obj || typeof obj !== 'object' || seen.has(obj)) return;
238:         seen.add(obj);
239:         if (obj.type === 'pair') {
240:             if (obj.value.car === placeholder) (obj.value as any).car = replacement;
241:             else this.patch(obj.value.car, placeholder, replacement, seen);
242:             if (obj.value.cdr === placeholder) (obj.value as any).cdr = replacement;
243:             else this.patch(obj.value.cdr, placeholder, replacement, seen);
244:         } else if (obj.type === 'vector') {
245:             const elements = obj.value as SchemeValue[];
246:             for (let i = 0; i < elements.length; i++) {
247:                 if (elements[i] === placeholder) elements[i] = replacement;
248:                 else this.patch(elements[i], placeholder, replacement, seen);
249:             }
250:         }
251:     }
252:     private peek(): string { return this.input[this.pos] || ''; }
253:     private advance(): string { return this.input[this.pos++] || ''; }
254:     private isEOF(): boolean { return this.pos >= this.input.length; }
255:     private isDelimiter(char: string): boolean {
256:         return !char || /\s/.test(char) || '()";'.includes(char);
257:     }
258: }
