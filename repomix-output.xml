<file path="src/domain/services/mission-strategies/GenericMissionStrategy.ts">
  1: import { IMissionStrategy } from './IMissionStrategy';
  2: import { Mission, MissionStep } from '../../entities/Mission';
  3: import { TerminalState } from '../../entities/TerminalState';
  4: import { CommandResponse } from '../../entities/Command';
  5: import { TutorAction, TutorProgressionResult } from '../../interfaces/ITutorService';
  6: import { MissionRepository } from '../MissionRepository';
  7: import { LessonRegistry } from '../LessonRegistry';
  8: import { StepRule, CommandMatcher } from '../../entities/mission/MissionGrammar';
  9: import { GameEvent, GameEventType } from '../../services/SimulationBus';
 10: import { SystemPreparationSpec } from '../../entities/world/SystemPreparationSpec';
 11: export class GenericMissionStrategy implements IMissionStrategy {
 12:     public getPreparationSpec(mission: Mission): SystemPreparationSpec | null {
 13:         return mission.metadata?.prepSpec || null;
 14:     }
 15:     public evaluate(
 16:         mission: Mission,
 17:         state: TerminalState,
 18:         lastResponse: CommandResponse,
 19:         missionRepository: MissionRepository,
 20:         lessonRegistry: LessonRegistry
 21:     ): { hint: TutorAction | null; progression: TutorProgressionResult | null } {
 22:         if (!mission.grammar) {
 23:             return { hint: null, progression: null };
 24:         }
 25:         const currentStepId = mission.currentStepId || mission.grammar.initialStepId;
 26:         const currentStep = mission.grammar.steps.find(s => s.id === currentStepId);
 27:         if (!currentStep) {
 28:             return { hint: null, progression: null };
 29:         }
 30:         const isStepSatisfied = this.matchEvent(currentStep.commandMatcher, lastResponse, state);
 31:         if (isStepSatisfied) {
 32:             if (currentStep.cwdPattern) {
 33:                 const currentCwd = state.currentDirectory;
 34:                 if (!this.smartMatch(currentStep.cwdPattern, currentCwd)) {
 35:                     return {
 36:                         hint: {
 37:                             missionId: mission.id,
 38:                             type: 'HINT',
 39:                             message: `Incorrect location. Navigation required to: ${currentStep.cwdPattern}`,
 40:                             confidence: 1.0,
 41:                             severity: 'WARN'
 42:                         },
 43:                         progression: null
 44:                     };
 45:                 }
 46:             }
 47:             return this.handleTransition(mission, currentStep);
 48:         }
 49:         const hint: TutorAction = {
 50:             missionId: mission.id,
 51:             type: 'HINT',
 52:             message: currentStep.description,
 53:             confidence: 1.0,
 54:             severity: 'INFO'
 55:         };
 56:         return { hint, progression: null };
 57:     }
 58:     private matchEvent(matcher: CommandMatcher, response: CommandResponse, state: TerminalState): boolean {
 59:         if (matcher.type === GameEventType.COMMAND_EXECUTED) {
 60:             const actualCommand = response.command || '';
 61:             // Match Command Name
 62:             if (matcher.target && !this.smartMatch(matcher.target, actualCommand)) {
 63:                 return false;
 64:             }
 65:             // Match Output
 66:             if (matcher.expectedValue && !this.smartMatch(String(matcher.expectedValue), response.output)) {
 67:                 return false;
 68:             }
 69:             // Match Rule
 70:             if (matcher.ruleKey) {
 71:                 return this.evaluateRule(matcher.ruleKey, response, state);
 72:             }
 73:             return true;
 74:         }
 75:         return false;
 76:     }
 77:     /**
 78:      * Performs a smart match supporting literal strings or simple regex patterns.
 79:      */
 80:     private smartMatch(pattern: string, actual: string): boolean {
 81:         if (pattern.startsWith('/') && pattern.endsWith('/')) {
 82:             try {
 83:                 const regex = new RegExp(pattern.slice(1, -1), 'i');
 84:                 return regex.test(actual);
 85:             } catch (e) {
 86:                 return actual.includes(pattern);
 87:             }
 88:         }
 89:         return actual.includes(pattern);
 90:     }
 91:     private evaluateRule(ruleKey: string, response: CommandResponse, state: TerminalState): boolean {
 92:         switch (ruleKey) {
 93:             case 'SUCCESS_EXIT':
 94:                 return response.exitCode === 0;
 95:             case 'HAS_OUTPUT':
 96:                 return response.output.trim().length > 0;
 97:             case 'FAILURE_EXIT':
 98:                 return response.exitCode !== 0;
 99:             case 'DIR_MATCH':
100:                 return state.currentDirectory === response.metadata?.data?.targetDir;
101:             default:
102:                 return false;
103:         }
104:     }
105:     private handleTransition(mission: Mission, currentStep: StepRule): { hint: TutorAction | null; progression: TutorProgressionResult | null } {
106:         const transition = currentStep.onComplete;
107:         let nextLessonText: string | undefined;
108:         if (transition?.nextStepId && mission.grammar) {
109:             const nextStep = mission.grammar.steps.find(s => s.id === transition.nextStepId);
110:             nextLessonText = nextStep?.lessonText;
111:         }
112:         const progression: TutorProgressionResult = {
113:             type: transition?.nextStepId ? 'START_LESSON' : 'MISSION_COMPLETE',
114:             message: transition?.tutorIntent || 'Objective reached.',
115:             nextStep: transition?.nextStepId ? undefined : MissionStep.COMPLETED,
116:             nextStepId: transition?.nextStepId,
117:             lessonId: transition?.startLessonId,
118:             text: nextLessonText,
119:             objectiveTarget: mission.objectiveTarget,
120:             isMission: true
121:         };
122:         if (transition?.nextStepId) {
123:             mission.currentStepId = transition.nextStepId;
124:         } else {
125:             mission.status = 'completed';
126:         }
127:         const congratsHint: TutorAction = {
128:             missionId: mission.id,
129:             type: 'CONGRATS',
130:             message: transition?.tutorIntent || 'Well done.',
131:             confidence: 1.0,
132:             severity: 'SUCCESS'
133:         };
134:         return { hint: congratsHint, progression };
135:     }
136: }
</file>

