<file path="src/domain/commands/core/UudecodeCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class UudecodeCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         const file = args.length > 0 ? args[0] : null;
13:         let content = '';
14:         if (file) {
15:             try {
16:                 const raw = this.fs.readFile(this.resolvePath(file, state));
17:                 content = typeof raw === 'string' ? raw : new TextDecoder().decode(raw);
18:             } catch (e) {
19:                 return { output: `uudecode: ${file}: No such file`, newState: state, exitCode: 1 };
20:             }
21:         } else if (input) {
22:             content = input;
23:         } else {
24:             return { output: '', newState: state, exitCode: 0 };
25:         }
26:         const lines = content.split('\n');
27:         let mode = '';
28:         let decodePath = '';
29:         let started = false;
30:         let output = '';
31:         for (const line of lines) {
32:             if (!started) {
33:                 if (line.startsWith('begin ')) {
34:                     const parts = line.split(' ');
35:                     mode = parts[1];
36:                     decodePath = parts[2];
37:                     started = true;
38:                 }
39:                 continue;
40:             }
41:             if (line === 'end') break;
42:             if (line.length === 0) continue;
43:             const lenChar = line.charCodeAt(0);
44:             const len = (lenChar - 32) & 0x3F;
45:             if (len === 0) continue;
46:             for (let i = 1; i < line.length && output.length < output.length + len; i += 4) {
47:                 const c1 = (line.charCodeAt(i) - 32) & 0x3F;
48:                 const c2 = (line.charCodeAt(i + 1) - 32) & 0x3F;
49:                 const c3 = (line.charCodeAt(i + 2) - 32) & 0x3F;
50:                 const c4 = (line.charCodeAt(i + 3) - 32) & 0x3F;
51:                 const val = (c1 << 18) | (c2 << 12) | (c3 << 6) | c4;
52:                 const b1 = (val >> 16) & 0xFF;
53:                 const b2 = (val >> 8) & 0xFF;
54:                 const b3 = val & 0xFF;
55:                 output += String.fromCharCode(b1);
56:                 if (output.length < output.length + len) output += String.fromCharCode(b2);
57:                 if (output.length < output.length + len) output += String.fromCharCode(b3);
58:             }
59:         }
60:         if (decodePath && output) {
61:             try {
62:                 this.fs.writeFile(this.resolvePath(decodePath, state), output, 'w');
63:             } catch (e) {
64:                 return { output: `uudecode: cannot write ${decodePath}`, newState: state, exitCode: 1 };
65:             }
66:         }
67:         return {
68:             output: '', // silent on success
69:             newState: state,
70:             exitCode: 0
71:         };
72:     }
73:     private resolvePath(path: string, state: TerminalState): string {
74:         if (path.startsWith('/')) return path;
75:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
76:     }
77: }
</file>

<file path="src/domain/commands/core/UuencodeCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class UuencodeCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         let infile = '';
13:         let decodePath = '';
14:         if (args.length === 1) {
15:             decodePath = args[0];
16:         } else if (args.length === 2) {
17:             infile = args[0];
18:             decodePath = args[1];
19:         } else {
20:             return { output: 'uuencode: missing operand', newState: state, exitCode: 1 };
21:         }
22:         let content = '';
23:         if (infile) {
24:             try {
25:                 const raw = this.fs.readFile(this.resolvePath(infile, state));
26:                 content = typeof raw === 'string' ? raw : new TextDecoder().decode(raw);
27:             } catch (e) {
28:                 return { output: `uuencode: ${infile}: No such file`, newState: state, exitCode: 1 };
29:             }
30:         } else if (input) {
31:             content = input;
32:         } else {
33:             return { output: '', newState: state, exitCode: 0 };
34:         }
35:         const mode = '644';
36:         let output = `begin ${mode} ${decodePath}\n`;
37:         for (let i = 0; i < content.length; i += 45) {
38:             const chunk = content.slice(i, i + 45);
39:             const lenChar = String.fromCharCode(32 + chunk.length);
40:             output += lenChar;
41:             for (let j = 0; j < chunk.length; j += 3) {
42:                 const b1 = chunk.charCodeAt(j);
43:                 const b2 = j + 1 < chunk.length ? chunk.charCodeAt(j + 1) : 0;
44:                 const b3 = j + 2 < chunk.length ? chunk.charCodeAt(j + 2) : 0;
45:                 const val = (b1 << 16) | (b2 << 8) | b3;
46:                 const c1 = (val >> 18) & 0x3F;
47:                 const c2 = (val >> 12) & 0x3F;
48:                 const c3 = (val >> 6) & 0x3F;
49:                 const c4 = val & 0x3F;
50:                 output += String.fromCharCode(32 + (c1 || 0));
51:                 output += String.fromCharCode(32 + (c2 || 0));
52:                 output += String.fromCharCode(32 + (c3 || 0));
53:                 output += String.fromCharCode(32 + (c4 || 0));
54:             }
55:             output += '\n';
56:         }
57:         output += '`\nend';
58:         return {
59:             output: output,
60:             newState: state,
61:             exitCode: 0
62:         };
63:     }
64:     private resolvePath(path: string, state: TerminalState): string {
65:         if (path.startsWith('/')) return path;
66:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
67:     }
68: }
