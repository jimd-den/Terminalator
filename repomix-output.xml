<file path="src/domain/services/tutor/CombinatorialDialogueAssembler.ts">
 1: import { VariableTemplateEngine } from './VariableTemplateEngine';
 2: export class CombinatorialDialogueAssembler {
 3:     constructor(private fragmentPools: Record<string, string[]>) {}
 4:     public assemble(template: string, variables: Record<string, string> = {}): string {
 5:         let result = template;
 6:         let iteration = 0;
 7:         const MAX_ITERATIONS = 5;
 8:         while (result.includes('{') && iteration < MAX_ITERATIONS) {
 9:             const context: Record<string, string> = { ...variables };
10:             const tags = result.match(/\{(\w+)\}/g) || [];
11:             for (const tag of tags) {
12:                 const key = tag.slice(1, -1);
13:                 if (this.fragmentPools[key] && !context[key]) {
14:                     const pool = this.fragmentPools[key];
15:                     context[key] = pool[Math.floor(Math.random() * pool.length)];
16:                 }
17:             }
18:             const next = VariableTemplateEngine.render(result, context);
19:             if (next === result) break;
20:             result = next;
21:             iteration++;
22:         }
23:         return result;
24:     }
25: }
</file>

<file path="src/domain/services/tutor/CombinatorialUtteranceEngine.ts">
 1: import { TutorIntent } from '../../entities/tutor/TutorIntent';
 2: import { TutorToneProfile } from '../../entities/tutor/TutorToneProfile';
 3: import { TutorTemplate, UtteranceContext } from '../../entities/tutor/TutorTemplate';
 4: import { TutorAction } from '../../interfaces/ITutorService';
 5: export class CombinatorialUtteranceEngine {
 6:     private static vocab: Record<string, string[]> = {
 7:         'greeting': ['Hello', 'Greetings', 'Salutations', 'Attention', 'System ready'],
 8:         'affirmative': ['Correct', 'Affirmative', 'Indeed', 'Precisely', 'Confirmed'],
 9:         'negative': ['Incorrect', 'Negative', 'False', 'Error', 'Denied'],
10:         'connector': ['and', 'additionally', 'furthermore', 'plus', 'also'],
11:         'emphasis': ['critical', 'vital', 'essential', 'important', 'mandatory']
12:     };
13:     public static generate(
14:         intent: TutorIntent,
15:         tone: TutorToneProfile,
16:         context: UtteranceContext,
17:         templates: TutorTemplate[],
18:         missionId: string,
19:         rng: () => number = Math.random
20:     ): TutorAction {
21:         const eligible = templates.filter(t => t.intent === intent && t.tone === tone);
22:         if (eligible.length === 0) {
23:             return {
24:                 missionId,
25:                 message: `[SYSTEM: NO STRUCTURE FOR ${intent}:${tone}]`,
26:                 type: 'HINT',
27:                 confidence: 0.1,
28:                 severity: 'INFO'
29:             };
30:         }
31:         const selected = eligible[Math.floor(rng() * eligible.length)];
32:         const message = this.expand(selected.text, context, rng);
33:         return {
34:             missionId,
35:             message,
36:             type: this.mapIntentToType(intent),
37:             confidence: 1.0,
38:             severity: this.mapIntentToSeverity(intent)
39:         };
40:     }
41:     private static expand(template: string, context: UtteranceContext, rng: () => number): string {
42:         let result = template.replace(/{vocab:(\w+)}/g, (match, key) => {
43:             const pool = this.vocab[key];
44:             if (!pool) return match;
45:             return pool[Math.floor(rng() * pool.length)];
46:         });
47:         result = result.replace(/{(\w+)}/g, (match, key) => {
48:             return String(context[key] ?? match);
49:         });
50:         return result;
51:     }
52:     private static mapIntentToType(intent: TutorIntent): 'HINT' | 'WARNING' | 'CONGRATS' {
53:         switch (intent) {
54:             case TutorIntent.REPRIMAND_MISTAKE: return 'WARNING';
55:             case TutorIntent.CELEBRATE_SUCCESS: return 'CONGRATS';
56:             default: return 'HINT';
57:         }
58:     }
59:     private static mapIntentToSeverity(intent: TutorIntent): 'INFO' | 'WARN' | 'ERROR' | 'SUCCESS' {
60:         switch (intent) {
61:             case TutorIntent.REPRIMAND_MISTAKE: return 'WARN';
62:             case TutorIntent.CELEBRATE_SUCCESS: return 'SUCCESS';
63:             case TutorIntent.TOOL_INSTRUCTION: return 'INFO';
64:             default: return 'INFO';
65:         }
66:     }
67: }
</file>

