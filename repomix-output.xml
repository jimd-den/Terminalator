 1: import React, { useEffect, useRef } from 'react';
 2: import { View, StyleSheet, Animated } from 'react-native';
 3: import { useTheme } from '../context/ThemeContext';
 4: export const TypingIndicator = () => {
 5:     const { theme } = useTheme();
 6:     const dotColor = theme.colors.primary;
 7:     const dot1 = useRef(new Animated.Value(0)).current;
 8:     const dot2 = useRef(new Animated.Value(0)).current;
 9:     const dot3 = useRef(new Animated.Value(0)).current;
10:     const animate = (val: Animated.Value, delay: number) => {
11:         return Animated.loop(
12:             Animated.sequence([
13:                 Animated.delay(delay),
14:                 Animated.timing(val, { toValue: 1, duration: 300, useNativeDriver: true }),
15:                 Animated.timing(val, { toValue: 0, duration: 300, useNativeDriver: true }),
16:             ])
17:         );
18:     };
19:     useEffect(() => {
20:         const a1 = animate(dot1, 0);
21:         const a2 = animate(dot2, 200);
22:         const a3 = animate(dot3, 400);
23:         a1.start(); a2.start(); a3.start();
24:         return () => { a1.stop(); a2.stop(); a3.stop(); };
25:     }, []);
26:     const dotStyle = (val: Animated.Value) => ({
27:         opacity: val,
28:         backgroundColor: dotColor,
29:         width: 4,
30:         height: 4,
31:         borderRadius: 2,
32:         marginHorizontal: 2,
33:     });
34:     return (
35:         <View style={styles.container}>
36:             <Animated.View style={dotStyle(dot1)} />
37:             <Animated.View style={dotStyle(dot2)} />
38:             <Animated.View style={dotStyle(dot3)} />
39:         </View>
40:     );
41: };
