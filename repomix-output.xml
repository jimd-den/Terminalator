<file path="src/domain/commands/core/DiffCommand.ts">
  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { ICommand } from '../ICommand';
  3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  4: import { TerminalState } from '../../entities/TerminalState';
  5: import { CommandResponse } from '../../entities/Command';
  6: import { FileSystemService } from '../../services/FileSystemService';
  7: export class DiffCommand implements ICommand {
  8:     constructor(private fs: FileSystemService) { }
  9:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 10:         let brief = false;
 11:         let unified = false;
 12:         let ignoreWhitespace = false;
 13:         let recursive = false;
 14:         const files: string[] = [];
 15:         for (const arg of args) {
 16:             if (arg === '-q') brief = true;
 17:             else if (arg === '-u') unified = true;
 18:             else if (arg === '-w') ignoreWhitespace = true;
 19:             else if (arg === '-r') recursive = true;
 20:             else if (!arg.startsWith('-')) files.push(arg);
 21:         }
 22:         if (files.length !== 2) {
 23:             return {
 24:                 output: 'diff: missing operand',
 25:                 newState: state,
 26:                 exitCode: 2
 27:             };
 28:         }
 29:         const path1 = this.resolvePath(files[0], state);
 30:         const path2 = this.resolvePath(files[1], state);
 31:         try {
 32:             const node1 = this.fs.resolve(path1);
 33:             const node2 = this.fs.resolve(path2);
 34:             if (!node1 || !node2) {
 35:                 return { output: 'diff: No such file or directory', newState: state, exitCode: 2 };
 36:             }
 37:             const isDir1 = this.fs.isDirectory(node1);
 38:             const isDir2 = this.fs.isDirectory(node2);
 39:             if (isDir1 && isDir2) {
 40:                 if (!recursive) {
 41:                     return { output: `diff: ${files[0]}: is a directory`, newState: state, exitCode: 2 };
 42:                 }
 43:                 return await this.diffRecursive(node1, node2, files[0], files[1], brief, unified, ignoreWhitespace, state);
 44:             } else if (isDir1 || isDir2) {
 45:                 return { output: `diff: ${files[0]} and ${files[1]}: Not simple files`, newState: state, exitCode: 2 };
 46:             }
 47:             return this.diffFiles(path1, path2, files[0], files[1], brief, unified, ignoreWhitespace, state);
 48:         } catch (e: any) {
 49:             return {
 50:                 output: `diff: ${e.message}`,
 51:                 newState: state,
 52:                 exitCode: 2
 53:             };
 54:         }
 55:     }
 56:     private resolvePath(path: string, state: TerminalState): string {
 57:         if (path.startsWith('/')) return path;
 58:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
 59:     }
 60:     private diffFiles(
 61:         absPath1: string, absPath2: string,
 62:         label1: string, label2: string,
 63:         brief: boolean, unified: boolean, ignoreWhitespace: boolean,
 64:         state: TerminalState
 65:     ): CommandResponse {
 66:         const content1 = this.fs.readFile(absPath1);
 67:         const content2 = this.fs.readFile(absPath2);
 68:         const lines1 = content1.split('\n');
 69:         const lines2 = content2.split('\n');
 70:         if (content1.endsWith('\n')) lines1.pop();
 71:         if (content2.endsWith('\n')) lines2.pop();
 72:         const cmp1 = ignoreWhitespace ? lines1.map(l => l.replace(/\s+/g, '').trim()) : lines1;
 73:         const cmp2 = ignoreWhitespace ? lines2.map(l => l.replace(/\s+/g, '').trim()) : lines2;
 74:         const matrix = this.lcsMatrix(cmp1, cmp2);
 75:         // If brief, checking only if different
 76:         // We can check matrix[m][n] == m == n only if same length?
 77:         // Or simply trace diffs.
 78:         const diffs = this.printDiff(matrix, lines1, lines2, cmp1, cmp2, lines1.length, lines2.length, unified);
 79:         if (diffs.length > 0) {
 80:             if (brief) {
 81:                 return {
 82:                     output: `Files ${label1} and ${label2} differ`,
 83:                     newState: state,
 84:                     exitCode: 1
 85:                 };
 86:             }
 87:             let output = diffs.join('\n');
 88:             if (unified) {
 89:                 output = `--- ${label1}\n+++ ${label2}\n${output}`;
 90:             }
 91:             return {
 92:                 output: output,
 93:                 newState: state,
 94:                 exitCode: 1
 95:             };
 96:         }
 97:         return {
 98:             output: '',
 99:             newState: state,
100:             exitCode: 0
101:         };
102:     }
103:     private async diffRecursive(
104:         dir1: any, dir2: any,
105:         label1: string, label2: string,
106:         brief: boolean, unified: boolean, ignoreWhitespace: boolean,
107:         state: TerminalState
108:     ): Promise<CommandResponse> {
109:         // List files in both
110:         const files1 = new Set(dir1.children.keys());
111:         const files2 = new Set(dir2.children.keys());
112:         const allFiles = new Set([...files1, ...files2]);
113:         const sortedFiles = Array.from(allFiles).sort();
114:         let output = '';
115:         let exitCode = 0;
116:         for (const f of sortedFiles) {
117:             const in1 = files1.has(f);
118:             const in2 = files2.has(f);
119:             if (in1 && in2) {
120:                 const child1 = dir1.children.get(f);
121:                 const child2 = dir2.children.get(f);
122:                 // Recurse or Diff File
123:                 // Simplification based on typical recursion:
124:                 let res: CommandResponse;
125:                 if (this.fs.isDirectory(child1) && this.fs.isDirectory(child2)) {
126:                     res = await this.diffRecursive(child1, child2, `${label1}/${f}`, `${label2}/${f}`, brief, unified, ignoreWhitespace, state);
127:                 } else if (!this.fs.isDirectory(child1) && !this.fs.isDirectory(child2)) {
128:                     // Diff Files
129:                     res = this.diffFiles(
130:                         this.fs.getAbsolutePath(child1),
131:                         this.fs.getAbsolutePath(child2),
132:                         `${label1}/${f}`, `${label2}/${f}`,
133:                         brief, unified, ignoreWhitespace, state
134:                     );
135:                 } else {
136:                     // Mixed type
137:                     output += `File ${label1}/${f} is a ${this.fs.isDirectory(child1) ? 'directory' : 'regular file'} while file ${label2}/${f} is a ${this.fs.isDirectory(child2) ? 'directory' : 'regular file'}\n`;
138:                     exitCode = 1;
139:                     continue;
140:                 }
141:                 if (res.exitCode !== 0) exitCode = 1;
142:                 if (res.output) {
143:                     output += (output ? '\n' : '') + res.output;
144:                 }
145:             } else if (in1) {
146:                 output += `Only in ${label1}: ${f}\n`;
147:                 exitCode = 1;
148:             } else {
149:                 output += `Only in ${label2}: ${f}\n`;
150:                 exitCode = 1;
151:             }
152:         }
153:         return {
154:             output: output,
155:             newState: state,
156:             exitCode: exitCode
157:         };
158:     }
159:     private lcsMatrix(a: string[], b: string[]): number[][] {
160:         const m = a.length;
161:         const n = b.length;
162:         const C: number[][] = Array(m + 1).fill(0).map(() => Array(n + 1).fill(0));
163:         for (let i = 1; i <= m; i++) {
164:             for (let j = 1; j <= n; j++) {
165:                 if (a[i - 1] === b[j - 1]) {
166:                     C[i][j] = C[i - 1][j - 1] + 1;
167:                 } else {
168:                     C[i][j] = Math.max(C[i][j - 1], C[i - 1][j]);
169:                 }
170:             }
171:         }
172:         return C;
173:     }
174:     private printDiff(
175:         C: number[][],
176:         rawA: string[], rawB: string[],
177:         cmpA: string[], cmpB: string[],
178:         i: number, j: number,
179:         unified: boolean
180:     ): string[] {
181:         const res: string[] = [];
182:         if (i > 0 && j > 0 && cmpA[i - 1] === cmpB[j - 1]) {
183:             return this.printDiff(C, rawA, rawB, cmpA, cmpB, i - 1, j - 1, unified);
184:         } else if (j > 0 && (i === 0 || C[i][j - 1] >= C[i - 1][j])) {
185:             const prev = this.printDiff(C, rawA, rawB, cmpA, cmpB, i, j - 1, unified);
186:             res.push(...prev);
187:             if (unified) res.push(`+${rawB[j - 1]}`);
188:             else res.push(`> ${rawB[j - 1]}`);
189:         } else if (i > 0 && (j === 0 || C[i][j - 1] < C[i - 1][j])) {
190:             const prev = this.printDiff(C, rawA, rawB, cmpA, cmpB, i - 1, j, unified);
191:             res.push(...prev);
192:             if (unified) res.push(`-${rawA[i - 1]}`);
193:             else res.push(`< ${rawA[i - 1]}`);
194:         }
195:         return res;
196:     }
197: }
</file>

