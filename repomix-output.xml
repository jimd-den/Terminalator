 52:         if (this.worldManager) {
 53:             this.worldManager.registerHost('terminalator', this.service);
 54:         }
 55:         this.parser = new ShellParser();
 56:         this.expansionService = new ShellExpansionService(this.service);
 57:         this.jobControl = new JobControlService();
 58:         this.identityService = new IdentityService();
 59:         this.redirectionService = new RedirectionService(this.service);
 60:         if (registry) {
 61:             this.registry = registry;
 62:         } else {
 63:             this.registry = new CommandRegistry();
 64:         }
 65:         this.interpreter = new ShellInterpreter(
 66:             this.service,
 67:             this.fs,
 68:             this.registry,
 69:             this.expansionService,
 70:             this.jobControl,
 71:             this.redirectionService,
 72:             this.binaryRunner,
 73:             () => this,
 74:             this.networkMap
 75:         );
 76:     }
 77:     getRegistry(): CommandRegistry {
 78:         return this.registry;
 79:     }
 80:     private createInterpreter(fsService: FileSystemService): ShellInterpreter {
 81:         return new ShellInterpreter(
 82:             fsService,
 83:             fsService.fileSystem,
 84:             this.registry,
 85:             new ShellExpansionService(fsService),
 86:             this.jobControl,
 87:             new RedirectionService(fsService),
 88:             this.binaryRunner,
 89:             () => this,
 90:             this.networkMap
 91:         );
 92:     }
 93:     protected resolveInterpreter(state: TerminalState): ShellInterpreter {
 94:         if (!state.fsContext || state.fsContext === 'localhost' || state.fsContext === 'terminalator') {
 95:             return this.interpreter;
 96:         }
 97:         if (state.fsContext && this.worldManager) {
 98:             const remoteService = this.worldManager.getHostFileSystem(state.fsContext);
 99:             if (remoteService) {
100:                 if (this.telemetry) {
101:                     this.telemetry.info(`[ExecuteCommand] Switching to remote interpreter for host: ${state.fsContext}`);
102:                 }
103:                 return this.createInterpreter(remoteService);
104:             }
105:         }
106:         if (this.networkMap) {
107:             const remoteFs = this.networkMap.getSystem(state.fsContext);
108:             if (remoteFs) {
109:                 if (this.telemetry) {
110:                     this.telemetry.info(`[ExecuteCommand] Switching to remote interpreter for host: ${state.fsContext}`);
111:                 }
112:                 const remoteService = new FileSystemService(remoteFs);
113:                 return this.createInterpreter(remoteService);
114:             }
115:         }
116:         return this.interpreter;
117:     }
118:     async execute(input: string, state: TerminalState): Promise<CommandResponse> {
119:         const executeLogic = async (): Promise<CommandResponse> => {
120:             if (!input.trim()) return { output: '', exitCode: 0, newState: state, command: input };
121:             // 1. Artifact Detection (Phase 1: Glass Box)
122:             const parts = input.trim().split(/\s+/);
123:             const cmd = parts[0];
124:             if (cmd.startsWith('./') || cmd.startsWith('/')) {
125:                 const node = this.service.resolve(cmd, state.currentDirectory);
126:                 if (node) {
127:                     const inode = this.service.getInode(node.inodeId);
128:                     if (inode && typeof inode.content === 'string' && inode.content.includes('"type": "RISCV_EXECUTABLE"')) {
129:                         try {
130:                             const artifact = JSON.parse(inode.content);
131:                             const cpu = new CpuState();
132:                             const res = this.riscv.run(
133:                                 artifact.program,
134:                                 new Uint8Array(artifact.memory),
135:                                 cpu,
136:                                 new Map(Object.entries(artifact.labels))
137:                             );
138:                             return {
139:                                 output: res.stdout,
140:                                 exitCode: res.exitCode,
141:                                 newState: state,
142:                                 command: input
143:                             };
144:                         } catch (e: any) {
145:                             return { output: `Runtime Error: ${e.message}`, exitCode: 1, newState: state, command: input };
146:                         }
147:                     }
148:                 }
149:             }
150:             try {
151:                 const ast = this.parser.parse(input);
152:                 if (!ast) return { output: '', exitCode: 0, newState: state, command: input };
153:                 const activeInterpreter = this.resolveInterpreter(state);
154:                 let res = await activeInterpreter.visit(ast, state);
155:                 res.command = input;
156:                 // Handle EXIT Trap (Top Level)
157:                 if (res.controlFlow === 'EXIT') {
158:                     if (state.fsContext) {
159:                         return {
160:                             ...res,
161:                             output: res.output + '\nConnection to ' + state.fsContext + ' closed.',
162:                             newState: {
163:                                 ...(res.newState || state),
164:                                 fsContext: undefined,
165:                                 currentDirectory: '/home/operator',
166:                                 environment: {
167:                                     ...(res.newState?.environment || state.environment),
168:                                     USER: 'operator',
169:                                     HOSTNAME: 'terminalator'
170:                                 }
171:                             },
172:                             controlFlow: undefined
173:                         };
174:                     }
175:                     const effectiveState = mergeState(state, res.newState);
176:                     const trapCmd = effectiveState.traps?.get('EXIT');
177:                     if (trapCmd) {
178:                         try {
179:                             const trapAst = this.parser.parse(trapCmd);
180:                             if (trapAst) {
181:                                 const trapRes = await this.interpreter.visit(trapAst, effectiveState);
182:                                 res.output += (res.output ? '\n' : '') + trapRes.output;
183:                                 res.newState = mergeState(effectiveState, trapRes.newState);
184:                             }
185:                         } catch (e: any) {
186:                             res.output += `\nError running EXIT trap: ${e.message}`;
187:                         }
188:                     }
189:                 }
190:                 return { ...res, command: input };
191:             } catch (e: any) {
192:                 return { ...fail(state, `sh: syntax error: ${e.message}`, 2), command: input };
193:             }
194:         };
195:         if (this.telemetry) {
196:             return this.telemetry.trace('ExecuteCommand.execute', executeLogic);
197:         }
198:         return executeLogic();
199:     }
200: }
