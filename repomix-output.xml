<file path="src/domain/commands/core/JobsCommand.ts">
 1: import { ICommand, CommandResponse } from '../ICommand';
 2: import { ProcessContext } from '../../entities/ProcessContext';
 3: import { TerminalState } from '../../entities/TerminalState';
 4: import { Job, formatJob, formatJobLong } from '../../entities/Job';
 5: import { FileSystemService } from '../../services/FileSystemService';
 6: export class JobsCommand implements ICommand {
 7:     constructor(private fs: FileSystemService) { }
 8:     execute(
 9:         args: string[],
10:         context: ProcessContext,
11:         state: TerminalState
12:     ): CommandResponse {
13:         const jobControl = context.jobControl;
14:         let longFormat = false;
15:         let pidsOnly = false;
16:         const jobSpecs: string[] = [];
17:         for (const arg of args) {
18:             if (arg === '-l') {
19:                 longFormat = true;
20:             } else if (arg === '-p') {
21:                 pidsOnly = true;
22:             } else if (arg === '-lp' || arg === '-pl') {
23:                 pidsOnly = true;
24:             } else if (arg.startsWith('-') && arg !== '-' && !arg.startsWith('%')) {
25:                 return {
26:                     output: `jobs: ${arg}: invalid option`,
27:                     newState: state,
28:                     exitCode: 1
29:                 };
30:             } else {
31:                 jobSpecs.push(arg);
32:             }
33:         }
34:         if (!jobControl) {
35:             return {
36:                 output: '',
37:                 newState: state,
38:                 exitCode: 0
39:             };
40:         }
41:         // Get jobs to display
42:         let jobs: Job[];
43:         if (jobSpecs.length > 0) {
44:             // Filter to specified jobs
45:             jobs = [];
46:             for (const spec of jobSpecs) {
47:                 const job = jobControl.resolveJobSpec(spec);
48:                 if (!job) {
49:                     return {
50:                         output: `jobs: ${spec}: no such job`,
51:                         newState: state,
52:                         exitCode: 1
53:                     };
54:                 }
55:                 jobs.push(job);
56:             }
57:         } else {
58:             // All jobs
59:             jobs = [...jobControl.getAllJobs()];
60:         }
61:         // Format output based on options
62:         const output = this.formatOutput(jobs, pidsOnly, longFormat);
63:         // After reporting, completed jobs should be reaped
64:         // (but we leave that to the shell's command loop, not here)
65:         return {
66:             output,
67:             newState: state,
68:             exitCode: 0
69:         };
70:     }
71:     private formatOutput(jobs: Job[], pidsOnly: boolean, longFormat: boolean): string {
72:         if (jobs.length === 0) {
73:             return '';
74:         }
75:         if (pidsOnly) {
76:             // -p: Just PIDs, one per line
77:             return jobs.map(j => String(j.pgid)).join('\n');
78:         }
79:         if (longFormat) {
80:             return jobs.map(j => formatJobLong(j)).join('\n');
81:         }
82:         return jobs.map(j => formatJob(j)).join('\n');
83:     }
84: }
</file>

<file path="src/domain/commands/core/JoinCommand.ts">
  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { ICommand } from '../ICommand';
  3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  4: import { FileSystemService } from '../../../domain/services/FileSystemService';
  5: import { TerminalState } from '../../entities/TerminalState';
  6: import { CommandResponse } from '../../entities/Command';
  7: import { FileSystem } from '../../entities/FileSystem';
  8: interface JoinOptions {
  9:     field1: number;
 10:     field2: number;
 11:     separator: string;
 12:     outputFormat: string | null;
 13:     showUnpaired1: boolean;
 14:     showUnpaired2: boolean;
 15:     ignoreCase: boolean;
 16:     emptyReplace: string;
 17: }
 18: export class JoinCommand implements ICommand {
 19:     constructor(private fs: FileSystemService) { }
 20:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
 21:         const input = getStdinAsString(context);
 22:         const options: JoinOptions = {
 23:             field1: 1,
 24:             field2: 1,
 25:             separator: '',
 26:             outputFormat: null,
 27:             showUnpaired1: false,
 28:             showUnpaired2: false,
 29:             ignoreCase: false,
 30:             emptyReplace: ''
 31:         };
 32:         const files: string[] = [];
 33:         let skipNext = false;
 34:         for (let i = 0; i < args.length; i++) {
 35:             const arg = args[i];
 36:             if (arg === '-1') {
 37:                 options.field1 = parseInt(args[++i]);
 38:             } else if (arg === '-2') {
 39:                 options.field2 = parseInt(args[++i]);
 40:             } else if (arg === '-t') {
 41:                 options.separator = args[++i];
 42:             } else if (arg === '-o') {
 43:                 options.outputFormat = args[++i];
 44:             } else if (arg === '-a') {
 45:                 const filenum = args[++i];
 46:                 if (filenum === '1') options.showUnpaired1 = true;
 47:                 if (filenum === '2') options.showUnpaired2 = true;
 48:             } else if (arg === '-i') {
 49:                 options.ignoreCase = true;
 50:             } else if (arg === '-e') {
 51:                 options.emptyReplace = args[++i];
 52:             } else if (!arg.startsWith('-')) {
 53:                 files.push(arg);
 54:             }
 55:         }
 56:         if (files.length !== 2) {
 57:             return { output: 'join: missing operand', newState: state, exitCode: 1 };
 58:         }
 59:         try {
 60:             const content1 = this.readFile(files[0], state, input);
 61:             const content2 = this.readFile(files[1], state, input);
 62:             const lines1 = content1.split('\n').filter(l => l !== '');
 63:             const lines2 = content2.split('\n').filter(l => l !== '');
 64:             const splitLine = (line: string): string[] => {
 65:                 if (options.separator) {
 66:                     return line.split(options.separator);
 67:                 } else {
 68:                     return line.trim().split(/\s+/);
 69:                 }
 70:             };
 71:             const map2 = new Map<string, string[]>();
 72:             for (const line of lines2) {
 73:                 const fields = splitLine(line);
 74:                 if (fields.length >= options.field2) {
 75:                     const key = fields[options.field2 - 1];
 76:                     const k = options.ignoreCase ? key.toLowerCase() : key;
 77:                     if (!map2.has(k)) map2.set(k, []);
 78:                     map2.get(k)!.push(line);
 79:                 }
 80:             }
 81:             const output: string[] = [];
 82:             const matchedKeys2 = new Set<string>();
 83:             for (const line1 of lines1) {
 84:                 const fields1 = splitLine(line1);
 85:                 let key = '';
 86:                 if (fields1.length >= options.field1) {
 87:                     key = fields1[options.field1 - 1];
 88:                 }
 89:                 const lookupKey = options.ignoreCase ? key.toLowerCase() : key;
 90:                 if (map2.has(lookupKey)) {
 91:                     matchedKeys2.add(lookupKey);
 92:                     const matches = map2.get(lookupKey)!;
 93:                     for (const line2 of matches) {
 94:                         const fields2 = splitLine(line2);
 95:                         let outLine = '';
 96:                         const outSep = options.separator || ' ';
 97:                         if (options.outputFormat) {
 98:                             const rest1 = fields1.filter((_, idx) => idx !== options.field1 - 1).join(outSep);
 99:                             const rest2 = fields2.filter((_, idx) => idx !== options.field2 - 1).join(outSep);
100:                             outLine = key + outSep + rest1 + outSep + rest2;
101:                         } else {
102:                             const rest1 = fields1.filter((_, idx) => idx !== options.field1 - 1).join(outSep);
103:                             const rest2 = fields2.filter((_, idx) => idx !== options.field2 - 1).join(outSep);
104:                             outLine = key + outSep + rest1 + outSep + rest2;
105:                         }
106:                         output.push(outLine);
107:                     }
108:                 } else if (options.showUnpaired1) {
109:                     output.push(line1);
110:                 }
111:             }
112:             if (options.showUnpaired2) {
113:                 for (const line2 of lines2) {
114:                     const fields = splitLine(line2);
115:                     const key = fields[options.field2 - 1];
116:                     const k = options.ignoreCase ? key.toLowerCase() : key;
117:                     if (!matchedKeys2.has(k)) {
118:                         output.push(line2);
119:                     }
120:                 }
121:             }
122:             return {
123:                 output: output.join('\n'),
124:                 newState: state,
125:                 exitCode: 0
126:             };
127:         } catch (e: any) {
128:             if (e.message.includes('No such file')) {
129:                 return { output: `join: ${files.join(' ')}: No such file or directory`, newState: state, exitCode: 1 };
130:             }
131:             return { output: `join: error: ${e.message}`, newState: state, exitCode: 1 };
132:         }
133:     }
134:     private readFile(pathStr: string, state: TerminalState, input?: string): string {
135:         if (pathStr === '-') return input || '';
136:         const path = this.resolvePath(pathStr, state);
137:         return this.fs.readFile(path);
138:     }
139:     private resolvePath(path: string, state: TerminalState): string {
140:         if (path.startsWith('/')) return path;
141:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
142:     }
143: }
</file>

<file path="src/domain/commands/core/KillCommand.ts">
  1: import { ICommand, CommandResponse } from '../ICommand';
  2: import { ProcessContext } from '../../entities/ProcessContext';
  3: import { TerminalState } from '../../entities/TerminalState';
  4: import { FileSystemService } from '../../services/FileSystemService';
  5: import {
  6:     SIGNALS,
  7:     parseSignal,
  8:     getSignalName,
  9:     listSignals,
 10:     DEFAULT_SIGNAL
 11: } from '../../entities/Signal';
 12: export class KillCommand implements ICommand {
 13:     constructor(private fs: FileSystemService) { }
 14:     execute(
 15:         args: string[],
 16:         context: ProcessContext,
 17:         state: TerminalState
 18:     ): CommandResponse {
 19:         if (args.includes('-l')) {
 20:             return this.handleListSignals(args, state);
 21:         }
 22:         const { signal, targets, error } = this.parseArgs(args);
 23:         if (error) {
 24:             return {
 25:                 output: error,
 26:                 newState: state,
 27:                 exitCode: 1
 28:             };
 29:         }
 30:         if (targets.length === 0) {
 31:             return {
 32:                 output: 'kill: missing operand',
 33:                 newState: state,
 34:                 exitCode: 1
 35:             };
 36:         }
 37:         return this.sendSignals(targets, signal, context, state);
 38:     }
 39:     private handleListSignals(args: string[], state: TerminalState): CommandResponse {
 40:         const idx = args.indexOf('-l');
 41:         const exitStatus = args[idx + 1];
 42:         if (exitStatus !== undefined && exitStatus !== '') {
 43:             // Translate exit status to signal name
 44:             let signalNum = parseInt(exitStatus, 10);
 45:             if (isNaN(signalNum)) {
 46:                 return {
 47:                     output: `kill: ${exitStatus}: invalid signal specification`,
 48:                     newState: state,
 49:                     exitCode: 1
 50:                 };
 51:             }
 52:             // If > 128, extract signal number from exit code
 53:             if (signalNum > 128) {
 54:                 signalNum = signalNum - 128;
 55:             }
 56:             const name = getSignalName(signalNum);
 57:             if (name) {
 58:                 return {
 59:                     output: name,
 60:                     newState: state,
 61:                     exitCode: 0
 62:                 };
 63:             }
 64:             return {
 65:                 output: `kill: ${exitStatus}: invalid signal specification`,
 66:                 newState: state,
 67:                 exitCode: 1
 68:             };
 69:         }
 70:         // List all signals
 71:         // POSIX: signal names without SIG prefix, separated by space or newline
 72:         const signals = listSignals();
 73:         return {
 74:             output: signals.join(' '),
 75:             newState: state,
 76:             exitCode: 0
 77:         };
 78:     }
 79:     /**
 80:      * Parse command arguments to extract signal and targets.
 81:      *
 82:      * Handles:
 83:      * - -s signal_name
 84:      * - -SIGNAME or -signal_name (XSI)
 85:      * - -number (XSI)
 86:      *
 87:      * Pure function.
 88:      */
 89:     private parseArgs(args: string[]): {
 90:         signal: number;
 91:         targets: string[];
 92:         error?: string;
 93:     } {
 94:         let signal = DEFAULT_SIGNAL;
 95:         const targets: string[] = [];
 96:         let i = 0;
 97:         while (i < args.length) {
 98:             const arg = args[i];
 99:             if (arg === '-s' && i + 1 < args.length) {
100:                 const signalSpec = args[i + 1];
101:                 const parsed = parseSignal(signalSpec);
102:                 if (parsed === undefined) {
103:                     return { signal: 0, targets: [], error: `kill: ${signalSpec}: invalid signal specification` };
104:                 }
105:                 signal = parsed;
106:                 i += 2;
107:             } else if (arg === '--') {
108:                 targets.push(...args.slice(i + 1));
109:                 break;
110:             } else if (arg.startsWith('-') && arg.length > 1 && arg !== '-') {
111:                 const spec = arg.slice(1);
112:                 const parsed = parseSignal(spec);
113:                 if (parsed !== undefined) {
114:                     signal = parsed;
115:                     i++;
116:                 } else {
117:                     const num = parseInt(arg, 10);
118:                     if (!isNaN(num) && num < 0) {
119:                         const signalNum = -num;
120:                         if (getSignalName(signalNum) !== undefined) {
121:                             signal = signalNum;
122:                             i++;
123:                         } else {
124:                             return { signal: 0, targets: [], error: `kill: ${arg}: invalid signal specification` };
125:                         }
126:                     } else {
127:                         return { signal: 0, targets: [], error: `kill: ${arg}: invalid option` };
128:                     }
129:                 }
130:             } else {
131:                 targets.push(arg);
132:                 i++;
133:             }
134:         }
135:         return { signal, targets };
136:     }
137:     private sendSignals(
138:         targets: string[],
139:         signal: number,
140:         context: ProcessContext,
141:         state: TerminalState
142:     ): CommandResponse {
143:         const jobControl = context.jobControl;
144:         const errors: string[] = [];
145:         let anySuccess = false;
146:         for (const target of targets) {
147:             if (target.startsWith('%')) {
148:                 if (!jobControl) {
149:                     errors.push(`kill: ${target}: no job control in this shell`);
150:                     continue;
151:                 }
152:                 const result = jobControl.sendSignal(target, signal);
153:                 if (result.success) {
154:                     anySuccess = true;
155:                 } else {
156:                     errors.push(result.errorMessage ?? `kill: ${target}: no such job`);
157:                 }
158:             } else {
159:                 const pid = parseInt(target, 10);
160:                 if (isNaN(pid)) {
161:                     errors.push(`kill: ${target}: arguments must be process or job IDs`);
162:                     continue;
163:                 }
164:                 if (jobControl) {
165:                     const result = jobControl.sendSignal(target, signal);
166:                     if (result.success) {
167:                         anySuccess = true;
168:                         continue;
169:                     }
170:                 }
171:                 anySuccess = true;
172:             }
173:         }
174:         if (anySuccess) {
175:             return {
176:                 output: errors.join('\n'),
177:                 newState: state,
178:                 exitCode: errors.length > 0 ? 1 : 0
179:             };
180:         }
181:         return {
182:             output: errors.join('\n') || 'kill: no process found',
183:             newState: state,
184:             exitCode: 1
185:         };
186:     }
187: }
</file>

