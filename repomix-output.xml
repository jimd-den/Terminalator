<file path="src/domain/services/shell/executors/CommandExecutor.ts">
  1: import { NodeExecutor } from '../NodeExecutor';
  2: import { ASTNode, CommandNode, NodeType, FunctionDefNode } from '../../ShellParser';
  3: import { TerminalState } from '../../../entities/TerminalState';
  4: import { CommandResponse } from '../../../entities/Command';
  5: import { ShellExpansionService } from '../../ShellExpansionService';
  6: import { CommandRegistry } from '../../../commands/CommandRegistry';
  7: import { JobControlService } from '../../JobControlService';
  8: import { FileSystemService } from '../../FileSystemService';
  9: import { FileSystem } from '../../../entities/FileSystem';
 10: import { RedirectionService } from '../../RedirectionService';
 11: import { IBinaryRunner } from '../../../interfaces/IBinaryRunner';
 12: import { IShellExecutor } from '../../../interfaces/IShellExecutor';
 13: import { ProcessContext } from '../../../entities/ProcessContext';
 14: import { createStdinStream, createOutputStream } from '../../../entities/Stream';
 15: import { mergeState, fail } from '../../../utils/TerminalStateUtils';
 16: import { NetworkMap } from '../../NetworkMap';
 17: import { SimulationBus, GameEventType, CommandExecutedPayload } from '../../SimulationBus';
 18: export class CommandExecutor implements NodeExecutor {
 19:     constructor(
 20:         private expansionService: ShellExpansionService,
 21:         private registry: CommandRegistry,
 22:         private jobControl: JobControlService,
 23:         private fsService: FileSystemService,
 24:         private fs: FileSystem,
 25:         private redirectionService: RedirectionService,
 26:         private bus?: SimulationBus,
 27:         private binaryRunner?: IBinaryRunner,
 28:         private executorFactory?: () => IShellExecutor,
 29:         private networkMap?: NetworkMap
 30:     ) { }
 31:     async execute(
 32:         node: ASTNode,
 33:         state: TerminalState,
 34:         visitor: (node: ASTNode, state: TerminalState, stdin?: string) => Promise<CommandResponse>,
 35:         stdin?: string
 36:     ): Promise<CommandResponse> {
 37:         if (node.type !== NodeType.COMMAND) {
 38:             throw new Error('CommandExecutor can only handle COMMAND nodes');
 39:         }
 40:         const cmdNode = node as CommandNode;
 41:         const expandedArgs: string[] = [];
 42:         for (const arg of cmdNode.args) {
 43:             const tokens = this.expansionService.expandToken(arg, state.environment, state.currentDirectory);
 44:             expandedArgs.push(...tokens);
 45:         }
 46:         cmdNode.args = expandedArgs;
 47:         const commandName = cmdNode.command;
 48:         if (state.functions && state.functions.has(commandName)) {
 49:             const res = await this.executeFunction(commandName, expandedArgs, state, visitor, stdin, cmdNode);
 50:             this.emitCommandExecuted(commandName, expandedArgs, res, state.currentDirectory);
 51:             return res;
 52:         }
 53:         const command = this.registry.get(commandName);
 54:         if (command) {
 55:             try {
 56:                 const context: ProcessContext = {
 57:                     fs: this.fs,
 58:                     fileSystemService: this.fsService,
 59:                     env: state.environment,
 60:                     cwd: state.currentDirectory,
 61:                     user: state.user,
 62:                     stdin: createStdinStream(stdin),
 63:                     stdout: createOutputStream(),
 64:                     stderr: createOutputStream(),
 65:                     stdinLegacy: stdin,
 66:                     executor: this.executorFactory ? this.executorFactory() : {
 67:                         execute: async (i, s) => {
 68:                             throw new Error("Recursive execution not fully accessible in Interpreter context yet");
 69:                         },
 70:                         getRegistry: () => this.registry
 71:                     } as IShellExecutor,
 72:                     jobControl: this.jobControl,
 73:                     networkMap: this.networkMap
 74:                 };
 75:                 const res = await command.execute(expandedArgs, context, state);
 76:                 const finalRes = this.redirectionService.handleRedirections(res, cmdNode.redirects, state);
 77:                 this.emitCommandExecuted(commandName, expandedArgs, finalRes, state.currentDirectory);
 78:                 return finalRes;
 79:             } catch (error: any) {
 80:                 const res = fail(state, `sh: ${commandName}: ${error.message}`);
 81:                 this.emitCommandExecuted(commandName, expandedArgs, res, state.currentDirectory);
 82:                 return res;
 83:             }
 84:         }
 85:         if (commandName.startsWith('/') || commandName.startsWith('./') || commandName.startsWith('../')) {
 86:             const res = await this.executeFile(commandName, expandedArgs, state, stdin);
 87:             this.emitCommandExecuted(commandName, expandedArgs, res, state.currentDirectory);
 88:             return res;
 89:         }
 90:         const finalFail = fail(state, `sh: command not found: ${commandName}`, 127);
 91:         this.emitCommandExecuted(commandName, expandedArgs, finalFail, state.currentDirectory);
 92:         return finalFail;
 93:     }
 94:     private emitCommandExecuted(command: string, args: string[], response: CommandResponse, cwd: string) {
 95:         if (this.bus) {
 96:             const payload: CommandExecutedPayload = {
 97:                 command,
 98:                 args,
 99:                 exitCode: response.exitCode || 0,
100:                 output: response.output || '',
101:                 cwd
102:             };
103:             this.bus.emit(GameEventType.COMMAND_EXECUTED, payload);
104:         }
105:     }
106:     private async executeFunction(
107:         name: string,
108:         args: string[],
109:         state: TerminalState,
110:         visitor: (node: ASTNode, state: TerminalState, stdin?: string) => Promise<CommandResponse>,
111:         stdin: string | undefined,
112:         node: CommandNode
113:     ): Promise<CommandResponse> {
114:         const funcNode = state.functions?.get(name) as FunctionDefNode;
115:         const newEnv = { ...state.environment };
116:         // Positional Params
117:         args.forEach((arg, i) => newEnv[(i + 1).toString()] = arg);
118:         newEnv['#'] = args.length.toString();
119:         newEnv['@'] = args.join(' ');
120:         newEnv['*'] = args.join(' ');
121:         const funcState = mergeState(state, {
122:             environment: newEnv,
123:             callStackDepth: (state.callStackDepth || 0) + 1
124:         });
125:         const res = await visitor(funcNode.body, funcState, stdin);
126:         // Restore Environment
127:         const restoredEnv = { ...res.newState?.environment || state.environment };
128:         for (let i = 1; i <= 9; i++) {
129:             const key = i.toString();
130:             if (state.environment[key]) restoredEnv[key] = state.environment[key];
131:             else delete restoredEnv[key];
132:         }
133:         const finalState = mergeState(state, {
134:             ...res.newState,
135:             environment: restoredEnv
136:         });
137:         const flow = res.controlFlow === 'RETURN' ? undefined : res.controlFlow;
138:         let finalRes: CommandResponse = {
139:             ...res,
140:             newState: finalState,
141:             controlFlow: flow
142:         };
143:         if (funcNode.redirects) finalRes = this.redirectionService.handleRedirections(finalRes, funcNode.redirects, state);
144:         return this.redirectionService.handleRedirections(finalRes, node.redirects, state);
145:     }
146:     private async executeFile(path: string, args: string[], state: TerminalState, stdin?: string): Promise<CommandResponse> {
147:         const dentry = this.fsService.resolve(path, state.currentDirectory, true, state.user);
148:         if (dentry && !this.fsService.isDirectory(dentry)) {
149:             let content: Uint8Array;
150:             try {
151:                 content = this.fsService.readFileBuffer(this.fsService.getAbsolutePath(dentry));
152:             } catch (e) {
153:                 return fail(state, `sh: ${path}: cannot read file`, 126);
154:             }
155:             const isWasm = (content.length >= 4 && content[0] === 0x00 && content[1] === 0x61 && content[2] === 0x73 && content[3] === 0x6d);
156:             const isElf = (content.length >= 4 && content[0] === 0x7f && content[1] === 0x45 && content[2] === 0x4c && content[3] === 0x46);
157:             if (isWasm || isElf) {
158:                 if (this.binaryRunner) {
159:                     try {
160:                         const res = await this.binaryRunner.run(content, args, {
161:                             stdin: createStdinStream(stdin),
162:                             stdout: createOutputStream(),
163:                             stderr: createOutputStream(),
164:                             fs: this.fsService,
165:                             env: state.environment
166:                         });
167:                         return { ...res, newState: mergeState(state, res.newState) };
168:                     } catch (e: any) {
169:                         return fail(state, `sh: ${path}: cannot execute binary: ${e.message}`, 126);
170:                     }
171:                 }
172:                 return fail(state, `sh: ${path}: cannot execute binary file (No Runner)`, 126);
173:             } else {
174:                 return fail(state, `sh: ${path}: Shell Scripts not supported in Interpreter directly yet (Needs recursive parsing)`, 126);
175:             }
176:         }
177:         return fail(state, `sh: ${path}: No such file or directory`, 127);
178:     }
179: }
</file>

<file path="src/domain/services/shell/executors/ControlFlowExecutor.ts">
 1: import { NodeExecutor } from '../NodeExecutor';
 2: import { ASTNode, NodeType, IfNode, ForNode, WhileNode } from '../../ShellParser';
 3: import { TerminalState } from '../../../entities/TerminalState';
 4: import { CommandResponse } from '../../../entities/Command';
 5: import { ShellExpansionService } from '../../ShellExpansionService';
 6: import { mergeState } from '../../../utils/TerminalStateUtils';
 7: export class ControlFlowExecutor implements NodeExecutor {
 8:     constructor(private expansionService: ShellExpansionService) { }
 9:     async execute(
10:         node: ASTNode,
11:         state: TerminalState,
12:         visitor: (node: ASTNode, state: TerminalState, stdin?: string) => Promise<CommandResponse>,
13:         stdin?: string
14:     ): Promise<CommandResponse> {
15:         switch (node.type) {
16:             case NodeType.IF: return this.executeIf(node as IfNode, state, visitor, stdin);
17:             case NodeType.FOR: return this.executeFor(node as ForNode, state, visitor, stdin);
18:             case NodeType.WHILE: return this.executeWhile(node as WhileNode, state, visitor, stdin);
19:             default: throw new Error(`ControlFlowExecutor cannot handle ${node.type}`);
20:         }
21:     }
22:     private async executeIf(node: IfNode, state: TerminalState, visitor: any, stdin?: string): Promise<CommandResponse> {
23:         const condRes = await visitor(node.condition, state, stdin);
24:         if (condRes.exitCode === 0) {
25:             const thenState = mergeState(state, condRes.newState);
26:             const res = await visitor(node.thenBody, thenState, stdin);
27:             return { ...res, output: condRes.output + res.output };
28:         } else if (node.elseBody) {
29:             const elseState = mergeState(state, condRes.newState);
30:             const res = await visitor(node.elseBody, elseState, stdin);
31:             return { ...res, output: condRes.output + res.output };
32:         }
33:         return { output: condRes.output, newState: mergeState(state, condRes.newState), exitCode: 0 };
34:     }
35:     private async executeFor(node: ForNode, state: TerminalState, visitor: any, stdin?: string): Promise<CommandResponse> {
36:         const expandedItems: string[] = [];
37:         for (const item of node.items) {
38:             const tokens = this.expansionService.expandToken(item, state.environment, state.currentDirectory);
39:             expandedItems.push(...tokens);
40:         }
41:         let currentState = state;
42:         let output = '';
43:         let lastExitCode = 0;
44:         for (const val of expandedItems) {
45:             const newEnv = { ...currentState.environment, [node.variable]: val };
46:             currentState = mergeState(currentState, { environment: newEnv });
47:             const res = await visitor(node.body, currentState, stdin);
48:             currentState = mergeState(currentState, res.newState);
49:             output += res.output;
50:             lastExitCode = res.exitCode;
51:             if (res.controlFlow === 'BREAK') { currentState.lastExitCode = 0; break; }
52:             if (res.controlFlow === 'CONTINUE') continue;
53:             if (res.controlFlow === 'RETURN') return { ...res, newState: currentState, output };
54:         }
55:         return { output, newState: currentState, exitCode: lastExitCode };
56:     }
57:     private async executeWhile(node: WhileNode, state: TerminalState, visitor: any, stdin?: string): Promise<CommandResponse> {
58:         let currentState = state;
59:         let output = '';
60:         let lastExitCode = 0;
61:         let iterations = 0;
62:         const MAX = 1000; // Circuit breaker
63:         while (iterations < MAX) {
64:             const condRes = await visitor(node.condition, currentState, stdin);
65:             output += condRes.output;
66:             currentState = mergeState(currentState, condRes.newState);
67:             if (condRes.exitCode !== 0) break;
68:             const bodyRes = await visitor(node.body, currentState, stdin);
69:             currentState = mergeState(currentState, bodyRes.newState);
70:             output += bodyRes.output;
71:             lastExitCode = bodyRes.exitCode;
72:             if (bodyRes.controlFlow === 'BREAK') break;
73:             if (bodyRes.controlFlow === 'RETURN') return { ...bodyRes, newState: currentState, output };
74:             iterations++;
75:         }
76:         return { output, newState: currentState, exitCode: lastExitCode };
77:     }
78: }
</file>

