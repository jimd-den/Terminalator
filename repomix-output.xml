<file path="src/domain/commands/core/ShCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand, CommandResponse } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { Dentry } from '../../entities/FileSystem';
 7: export class ShCommand implements ICommand {
 8:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 9:         const _input = getStdinAsString(context);
10:         const input = getStdinAsString(context);
11:         let commandString = '';
12:         let scriptFile = '';
13:         let i = 0;
14:         // Parse args
15:         for (; i < args.length; i++) {
16:             const arg = args[i];
17:             if (arg === '-c') {
18:                 if (i + 1 < args.length) {
19:                     commandString = args[++i];
20:                     const params = args.slice(i + 1);
21:                     const newEnv = { ...state.environment };
22:                     if (params.length > 0) newEnv['0'] = params[0];
23:                     for (let k = 1; k < params.length; k++) {
24:                         newEnv[k.toString()] = params[k];
25:                     }
26:                     state = { ...state, environment: newEnv };
27:                     break;
28:                 } else {
29:                     return { output: 'sh: -c: option requires an argument', newState: state, exitCode: 2 };
30:                 }
31:             } else if (arg === '-s') {
32:             } else if (arg.startsWith('-') || arg.startsWith('+')) {
33:                 continue;
34:             } else {
35:                 scriptFile = arg;
36:                 break;
37:             }
38:         }
39:         if (scriptFile) {
40:             const fs = context.fileSystemService;
41:             let node: Dentry | null = fs.resolve(scriptFile, state.currentDirectory);
42:             if (!node && state.currentDirectory !== '/') {
43:                 node = fs.resolve(scriptFile, '/');
44:             }
45:             if (!node || fs.isDirectory(node)) {
46:                 return {
47:                     output: `sh: ${scriptFile}: No such file or directory`,
48:                     newState: state,
49:                     exitCode: 127
50:                 };
51:             }
52:             try {
53:                 const path = fs.getAbsolutePath(node);
54:                 commandString = fs.readFile(path);
55:             } catch (e) {
56:                 return { output: `sh: ${scriptFile}: Read error`, newState: state, exitCode: 126 };
57:             }
58:         } else if (!commandString && _input) {
59:             commandString = _input;
60:         }
61:         if (!commandString) {
62:             return { output: '', newState: state, exitCode: 0 };
63:         }
64:         // Execute logic
65:         const normalized = commandString.replace(/\n/g, '; ');
66:         if (context.executor) {
67:             const response = await context.executor.execute(normalized, state);
68:             return {
69:                 output: response.output,
70:                 newState: response.newState,
71:                 exitCode: response.exitCode
72:             };
73:         }
74:         return { output: 'sh: executor not available', newState: state, exitCode: 1 };
75:     }
76: }
</file>

