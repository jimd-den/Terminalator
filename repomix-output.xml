<file path="src/frameworks-drivers/ui/context/TutorMessagingProvider.tsx">
 1: import React, { createContext, useContext, useState, useEffect, useCallback, ReactNode } from 'react';
 2: import { TutorMessage } from '../../../domain/entities/tutor/TutorMessage';
 3: import { CoreEngine } from '../../../core/CoreEngine';
 4: interface TutorMessagingContextType {
 5:     activeTutorMessage: TutorMessage | null;
 6:     isTutorTyping: boolean;
 7:     sendTutorMessage: (text: string, type?: TutorMessage['type'], sender?: string) => Promise<void>;
 8:     tutorMessaging: any;
 9: }
10: const TutorMessagingContext = createContext<TutorMessagingContextType | undefined>(undefined);
11: export const TutorMessagingProvider: React.FC<{ children: ReactNode }> = ({ children }) => {
12:     const engine = CoreEngine.getInstance();
13:     const tutorMessaging = engine.getTutorMessaging();
14:     const [activeTutorMessage, setActiveTutorMessage] = useState<TutorMessage | null>(null);
15:     const [isTutorTyping, setIsTutorTyping] = useState(false);
16:     useEffect(() => {
17:         let isMounted = true;
18:         let isProcessing = false;
19:         const processQueue = async () => {
20:             if (isProcessing) return;
21:             isProcessing = true;
22:             let msg = await tutorMessaging.getNextMessage();
23:             while (msg && isMounted) {
24:                 setIsTutorTyping(true);
25:                 const delay = Math.min(2000, 500 + msg.text.length * 20);
26:                 await new Promise(resolve => setTimeout(resolve, delay));
27:                 if (!isMounted) break;
28:                 setIsTutorTyping(false);
29:                 setActiveTutorMessage(msg);
30:                 const next = await tutorMessaging.getAllMessages();
31:                 if (next.length > 0) {
32:                     await new Promise(resolve => setTimeout(resolve, 1500));
33:                 }
34:                 msg = await tutorMessaging.getNextMessage();
35:             }
36:             isProcessing = false;
37:         };
38:         const unsubscribe = tutorMessaging.subscribe(() => {
39:             processQueue();
40:         });
41:         processQueue();
42:         return () => {
43:             isMounted = false;
44:             unsubscribe();
45:         };
46:     }, [tutorMessaging]);
47:     const sendTutorMessage = useCallback(async (text: string, type: TutorMessage['type'] = 'info', sender: string = 'TUTOR') => {
48:         await tutorMessaging.sendMessage(text, type, sender);
49:     }, [tutorMessaging]);
50:     return (
51:         <TutorMessagingContext.Provider value={{
52:             activeTutorMessage,
53:             isTutorTyping,
54:             sendTutorMessage,
55:             tutorMessaging
56:         }}>
57:             {children}
58:         </TutorMessagingContext.Provider>
59:     );
60: };
61: export const useTutorMessaging = () => {
62:     const context = useContext(TutorMessagingContext);
63:     if (!context) {
64:         throw new Error('useTutorMessaging must be used within a TutorMessagingProvider');
65:     }
66:     return context;
67: };
</file>

