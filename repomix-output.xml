        output += `rootfs         ${TOTAL_BLOCKS.toString().padStart(10)} ${usedBlocks.toString().padStart(9)} ${availableBlocks.toString().padStart(9)} ${capacity.toString().padStart(7)}% /`;

        return {
            output: output,
            newState: state,
            exitCode: 0
        };
    }
