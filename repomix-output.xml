359:             if (line.type === 'output' && line.metadata?.renderType === 'fish-style') {
360:                 const items: { name: string, type: string }[] = line.metadata.data?.items || [];
361:                 const renderItems = (isStatic: boolean) => (
362:                     <View style={styles.cardContainer}>
