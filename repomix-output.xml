<file path="src/domain/commands/core/UncompressCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand, CommandResponse } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: export class UncompressCommand implements ICommand {
 7:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 8:         const input = getStdinAsString(context);
 9:         const fs = context.fileSystemService;
10:         const file = args[0];
11:         if (!file) {
12:             return { output: 'uncompress: missing file', newState: state, exitCode: 1 };
13:         }
14:         const node = fs.resolve(file, state.currentDirectory);
15:         if (!node || fs.isDirectory(node)) {
16:             return { output: `uncompress: ${file}: No such file or directory`, newState: state, exitCode: 1 };
17:         }
18:         const path = fs.getAbsolutePath(node);
19:         const raw = fs.readFile(path);
20:         const content = typeof raw === 'string' ? raw : new TextDecoder().decode(raw);
21:         let decompressed = content;
22:         if (content.startsWith(`\x1f\x9d`)) {
23:             decompressed = content.substring(2);
24:         }
25:         const newPath = path.replace('.Z', '');
26:         fs.writeFile(newPath, decompressed, 'w', 1000, 1000, state.currentDirectory);
27:         fs.deleteNode(path, state.currentDirectory);
28:         return { output: '', newState: state, exitCode: 0 };
29:     }
30: }
