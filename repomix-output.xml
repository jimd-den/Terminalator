36:                 return { output: 'cat: missing input', newState: state, exitCode: 1 };
37:             }
38:         } else {
39:             for (const filename of operands) {
40:                 if (filename === '-') {
41:                     output += input || '';
42:                     continue;
43:                 }
44:                 const path = PathResolver.resolveString(filename, state.currentDirectory, state.environment.HOME);
45:                 try {
46:                     const node = fsService.resolve(path);
47:                     const inode = node ? fsService.getInode(node.inodeId) : undefined;
48:                     if (node && inode && (inode.mode & 0o040000)) {
49:                         return { output: `cat: ${filename}: Is a directory`, newState: state, exitCode: 1 };
50:                     }
51:                     const content = fsService.readFile(path);
52:                     output += content;
53:                 } catch (error: any) {
54:                     return {
55:                         output: `cat: ${filename}: No such file or directory`,
56:                         newState: state,
57:                         exitCode: 1
58:                     };
59:                 }
60:             }
61:         }
62:         return {
63:             output: output,
64:             newState: state,
65:             exitCode: 0
66:         };
67:     }
68: }
