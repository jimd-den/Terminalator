  6:     IF = 'IF',
  7:     ELSE = 'ELSE',
  8:     WHILE = 'WHILE',
  9:     DO = 'DO',
 10:     FOR = 'FOR',
 11:     IN = 'IN',
 12:     BREAK = 'BREAK',
 13:     CONTINUE = 'CONTINUE',
 14:     NEXT = 'NEXT',
 15:     EXIT = 'EXIT',
 16:     FUNCTION = 'FUNCTION',
 17:     RETURN = 'RETURN',
 18:     IDENTIFIER = 'IDENTIFIER',
 19:     NUMBER = 'NUMBER',
 20:     STRING = 'STRING',
 21:     REGEX = 'REGEX',
 22:     FIELD_REF = 'FIELD_REF',
 23:     PLUS = 'PLUS',
 24:     MINUS = 'MINUS',
 25:     STAR = 'STAR',
 26:     SLASH = 'SLASH',
 27:     PERCENT = 'PERCENT',
 28:     CARET = 'CARET',
 29:     ASSIGN = 'ASSIGN',
 30:     PLUS_ASSIGN = 'PLUS_ASSIGN',
 31:     MINUS_ASSIGN = 'MINUS_ASSIGN',
 32:     STAR_ASSIGN = 'STAR_ASSIGN',
 33:     SLASH_ASSIGN = 'SLASH_ASSIGN',
 34:     PERCENT_ASSIGN = 'PERCENT_ASSIGN',
 35:     CARET_ASSIGN = 'CARET_ASSIGN',
 36:     INC = 'INC',
 37:     DEC = 'DEC',
 38:     EQ = 'EQ',
 39:     NEQ = 'NEQ',
 40:     LT = 'LT',
 41:     GT = 'GT',
 42:     LTE = 'LTE',
 43:     GTE = 'GTE',
 44:     MATCH = 'MATCH',
 45:     NOT_MATCH = 'NOT_MATCH',
 46:     AND = 'AND',
 47:     OR = 'OR',
 48:     NOT = 'NOT',
 49:     LPAREN = 'LPAREN',
 50:     RPAREN = 'RPAREN',
 51:     LBRACE = 'LBRACE',
 52:     RBRACE = 'RBRACE',
 53:     LBRACKET = 'LBRACKET',
 54:     RBRACKET = 'RBRACKET',
 55:     COMMA = 'COMMA',
 56:     SEMI = 'SEMI',
 57:     NEWLINE = 'NEWLINE',
 58:     EOF = 'EOF'
 59: }
 60: export interface AwkToken {
 61:     type: AwkTokenType;
 62:     value: string;
 63:     line: number;
 64:     col: number;
 65: }
 66: export class AwkLexer {
 67:     private pos = 0;
 68:     private line = 1;
 69:     private col = 1;
 70:     private source: string;
 71:     constructor(source: string) {
 72:         this.source = source;
 73:     }
 74:     tokenize(): AwkToken[] {
 75:         const tokens: AwkToken[] = [];
 76:         this.pos = 0;
 77:         this.line = 1;
 78:         this.col = 1;
 79:         while (this.pos < this.source.length) {
 80:             const char = this.peek();
 81:             if (/\s/.test(char)) {
 82:                 if (char === '\n') {
 83:                     tokens.push(this.token(AwkTokenType.NEWLINE, '\n'));
 84:                     this.advance();
 85:                     this.line++;
 86:                     this.col = 1;
 87:                 } else {
 88:                     this.advance();
 89:                 }
 90:                 continue;
 91:             }
 92:             if (char === '#') {
 93:                 while (this.pos < this.source.length && this.peek() !== '\n') {
 94:                     this.advance();
 95:                 }
 96:                 continue;
 97:             }
 98:             if (char === '"') {
 99:                 tokens.push(this.readString());
100:                 continue;
101:             }
102:             if (char === '/') {
103:                 const last = tokens.length > 0 ? tokens[tokens.length - 1] : null;
104:                 const isDiv = last && (
105:                     last.type === AwkTokenType.IDENTIFIER ||
106:                     last.type === AwkTokenType.NUMBER ||
107:                     last.type === AwkTokenType.STRING ||
108:                     last.type === AwkTokenType.RPAREN ||
109:                     last.type === AwkTokenType.RBRACKET ||
110:                     last.type === AwkTokenType.FIELD_REF
111:                 );
112:                 if (isDiv) {
113:                     if (this.peek(1) === '=') {
114:                         this.advance(); this.advance();
115:                         tokens.push(this.token(AwkTokenType.SLASH_ASSIGN, '/='));
116:                     } else {
117:                         this.advance();
118:                         tokens.push(this.token(AwkTokenType.SLASH, '/'));
119:                     }
120:                 } else {
121:                     tokens.push(this.readRegex());
122:                 }
123:                 continue;
124:             }
125:             if (/[0-9]/.test(char) || (char === '.' && /[0-9]/.test(this.peek(1)))) {
126:                 tokens.push(this.readNumber());
127:                 continue;
128:             }
129:             if (/[a-zA-Z_]/.test(char)) {
130:                 tokens.push(this.readIdentifier());
131:                 continue;
132:             }
133:             if (char === '$') {
134:                 this.advance();
135:                 tokens.push(this.token(AwkTokenType.FIELD_REF, '$'));
136:                 continue;
137:             }
138:             if (char === '+') {
139:                 if (this.peek(1) === '+') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.INC, '++')); continue; }
140:                 if (this.peek(1) === '=') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.PLUS_ASSIGN, '+=')); continue; }
141:                 this.advance(); tokens.push(this.token(AwkTokenType.PLUS, '+')); continue;
142:             }
143:             if (char === '-') {
144:                 if (this.peek(1) === '-') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.DEC, '--')); continue; }
145:                 if (this.peek(1) === '=') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.MINUS_ASSIGN, '-=')); continue; }
146:                 this.advance(); tokens.push(this.token(AwkTokenType.MINUS, '-')); continue;
147:             }
148:             if (char === '*') {
149:                 if (this.peek(1) === '=') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.STAR_ASSIGN, '*=')); continue; }
150:                 this.advance(); tokens.push(this.token(AwkTokenType.STAR, '*')); continue;
151:             }
152:             if (char === '%') {
153:                 if (this.peek(1) === '=') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.PERCENT_ASSIGN, '%=')); continue; }
154:                 this.advance(); tokens.push(this.token(AwkTokenType.PERCENT, '%')); continue;
155:             }
156:             if (char === '^') {
157:                 if (this.peek(1) === '=') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.CARET_ASSIGN, '^=')); continue; }
158:                 this.advance(); tokens.push(this.token(AwkTokenType.CARET, '^')); continue;
159:             }
160:             if (char === '=') {
161:                 if (this.peek(1) === '=') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.EQ, '==')); continue; }
162:                 this.advance(); tokens.push(this.token(AwkTokenType.ASSIGN, '=')); continue;
163:             }
164:             if (char === '!') {
165:                 if (this.peek(1) === '=') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.NEQ, '!=')); continue; }
166:                 if (this.peek(1) === '~') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.NOT_MATCH, '!~')); continue; }
167:                 this.advance(); tokens.push(this.token(AwkTokenType.NOT, '!')); continue;
168:             }
169:             if (char === '<') {
170:                 if (this.peek(1) === '=') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.LTE, '<=')); continue; }
171:                 this.advance(); tokens.push(this.token(AwkTokenType.LT, '<')); continue;
172:             }
173:             if (char === '>') {
174:                 if (this.peek(1) === '=') { this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.GTE, '>=')); continue; }
175:                 this.advance(); tokens.push(this.token(AwkTokenType.GT, '>')); continue;
176:             }
177:             if (char === '&' && this.peek(1) === '&') {
178:                 this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.AND, '&&')); continue;
179:             }
180:             if (char === '|' && this.peek(1) === '|') {
181:                 this.advance(); this.advance(); tokens.push(this.token(AwkTokenType.OR, '||')); continue;
182:             }
183:             if (char === '~') {
184:                 this.advance(); tokens.push(this.token(AwkTokenType.MATCH, '~')); continue;
185:             }
186:             switch (char) {
187:                 case '(': this.advance(); tokens.push(this.token(AwkTokenType.LPAREN, '(')); continue;
188:                 case ')': this.advance(); tokens.push(this.token(AwkTokenType.RPAREN, ')')); continue;
189:                 case '{': this.advance(); tokens.push(this.token(AwkTokenType.LBRACE, '{')); continue;
190:                 case '}': this.advance(); tokens.push(this.token(AwkTokenType.RBRACE, '}')); continue;
191:                 case '[': this.advance(); tokens.push(this.token(AwkTokenType.LBRACKET, '[')); continue;
192:                 case ']': this.advance(); tokens.push(this.token(AwkTokenType.RBRACKET, ']')); continue;
193:                 case ',': this.advance(); tokens.push(this.token(AwkTokenType.COMMA, ',')); continue;
194:                 case ';': this.advance(); tokens.push(this.token(AwkTokenType.SEMI, ';')); continue;
195:             }
196:             throw new Error(`AwkLexer: Unexpected character '${char}' at ${this.line}:${this.col}`);
197:         }
198:         tokens.push(this.token(AwkTokenType.EOF, ''));
199:         return tokens;
200:     }
201:     private peek(offset = 0): string {
202:         return this.source[this.pos + offset] || '';
203:     }
204:     private advance(): string {
205:         const c = this.source[this.pos++];
206:         this.col++;
207:         return c;
208:     }
209:     private token(type: AwkTokenType, value: string): AwkToken {
210:         return { type, value, line: this.line, col: this.col - value.length };
211:     }
212:     private readString(): AwkToken {
213:         this.advance(); // "
214:         let str = '';
215:         while (this.pos < this.source.length && this.peek() !== '"') {
216:             if (this.peek() === '\\') {
217:                 this.advance();
218:                 str += this.advance(); // Simple escape
219:             } else {
220:                 str += this.advance();
221:             }
222:         }
223:         if (this.peek() !== '"') throw new Error("Unterminated string");
224:         this.advance(); // "
225:         return this.token(AwkTokenType.STRING, str);
226:     }
227:     private readRegex(): AwkToken {
228:         this.advance(); // /
229:         let str = '';
230:         while (this.pos < this.source.length) {
231:             if (this.peek() === '/' && this.source[this.pos - 1] !== '\\') { // Crude unescaped / check
232:                 break;
233:             }
234:             str += this.advance();
235:         }
236:         if (this.peek() !== '/') throw new Error("Unterminated regex");
237:         this.advance();
238:         return this.token(AwkTokenType.REGEX, str);
239:     }
240:     private readNumber(): AwkToken {
241:         let num = '';
242:         while (this.pos < this.source.length && /[0-9.]/.test(this.peek())) {
243:             num += this.advance();
244:         }
245:         return this.token(AwkTokenType.NUMBER, num);
246:     }
247:     private readIdentifier(): AwkToken {
248:         let id = '';
249:         while (this.pos < this.source.length && /[a-zA-Z0-9_]/.test(this.peek())) {
250:             id += this.advance();
251:         }
252:         // Keywords
253:         switch (id) {
254:             case 'BEGIN': return this.token(AwkTokenType.BEGIN, id);
255:             case 'END': return this.token(AwkTokenType.END, id);
256:             case 'print': return this.token(AwkTokenType.PRINT, id);
257:             case 'if': return this.token(AwkTokenType.IF, id);
258:             case 'else': return this.token(AwkTokenType.ELSE, id);
259:             case 'length': return this.token(AwkTokenType.IDENTIFIER, id);
260:         }
261:         return this.token(AwkTokenType.IDENTIFIER, id);
262:     }
263: }
