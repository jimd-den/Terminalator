 35: export interface BinaryExpressionNode extends ASTNode {
 36:     type: 'Binary';
 37:     left: ExpressionNode;
 38:     op: string;
 39:     right: ExpressionNode;
 40: }
 41: export interface UnaryExpressionNode extends ASTNode {
 42:     type: 'Unary';
 43:     op: string;
 44:     operand: ExpressionNode;
 45: }
