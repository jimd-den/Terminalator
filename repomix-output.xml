<file path="src/domain/commands/core/TailCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { CommandBase } from '../CommandBase';
 3: import { CommandCapability } from '../IStructuredCommand';
 4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystemService } from '../../services/FileSystemService';
 8: export class TailCommand extends CommandBase {
 9:     public readonly capabilities = [CommandCapability.READ, CommandCapability.FILTER];
10:     public readonly utility = 'tail';
11:     constructor(private fs: FileSystemService) {
12:         super();
13:     }
14:     protected override parseArgs(args: string[]) {
15:         super.parseArgs(args, ['n', 'c']);
16:     }
17:     protected async executeInternal(
18:         rawArgs: string[],
19:         flags: Set<string>,
20:         operands: string[],
21:         context: ProcessContext,
22:         state: TerminalState
23:     ): Promise<CommandResponse> {
24:         const input = getStdinAsString(context);
25:         const fsService = context.fileSystemService || this.fs;
26:         let linesToPrint = 10;
27:         let bytesToPrint = -1;
28:         const nOption = this.options.get('n');
29:         if (nOption) linesToPrint = parseInt(nOption);
30:         const cOption = this.options.get('c');
31:         if (cOption) bytesToPrint = parseInt(cOption);
32:         const getTail = (content: string): string => {
33:             if (bytesToPrint !== -1) {
34:                 return content.slice(-bytesToPrint);
35:             }
36:             const lines = content.split('\n');
37:             let effectiveLines = lines;
38:             let hasTrailing = false;
39:             if (lines.length > 0 && lines[lines.length - 1] === '') {
40:                 effectiveLines = lines.slice(0, -1);
41:                 hasTrailing = true;
42:             }
43:             const snippet = effectiveLines.slice(-linesToPrint);
44:             let output = snippet.join('\n');
45:             if (hasTrailing && snippet.length > 0) {
46:                 output += '\n';
47:             }
48:             return output;
49:         };
50:         if (operands.length === 0 || (operands.length === 1 && operands[0] === '-')) {
51:             if (input !== undefined) {
52:                 return { output: getTail(input), newState: state, exitCode: 0 };
53:             } else {
54:                 return { output: '', newState: state, exitCode: 0 };
55:             }
56:         }
57:         let output = '';
58:         let exitCode = 0;
59:         for (let i = 0; i < operands.length; i++) {
60:             const filename = operands[i];
61:             if (operands.length > 1) {
62:                 if (i > 0) output += '\n';
63:                 output += `==> ${filename} <==\n`;
64:             }
65:             let path = filename;
66:             if (!path.startsWith('/')) {
67:                 path = state.currentDirectory === '/' ? `/${filename}` : `${state.currentDirectory}/${filename}`;
68:             }
69:             try {
70:                 const content = fsService.readFile(path);
71:                 output += getTail(content);
72:             } catch (error: any) {
73:                 output += `tail: cannot open '${filename}' for reading: No such file or directory`;
74:                 exitCode = 1;
75:             }
76:         }
77:         return {
78:             output: output,
79:             newState: state,
80:             exitCode: exitCode
81:         };
82:     }
83: }
</file>

