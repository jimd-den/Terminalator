<file path="src/domain/entities/filesystem/InodeTable.ts">
 1: import { Inode, S_IFDIR } from './FileSystemTypes';
 2: export class InodeTable {
 3:     private inodes: Map<number, Inode> = new Map();
 4:     private nextInodeId: number = 1;
 5:     allocate(mode: number, uid: number, gid: number): Inode {
 6:         const now = Date.now();
 7:         const inode: Inode = {
 8:             id: this.nextInodeId++,
 9:             mode: mode,
10:             uid: uid,
11:             gid: gid,
12:             size: 0,
13:             atime: now,
14:             mtime: now,
15:             ctime: now,
16:             links: 1,
17:             content: (mode & S_IFDIR) ? new Map() : ''
18:         };
19:         if (mode & S_IFDIR) {
20:             inode.size = 4096;
21:         }
22:         this.inodes.set(inode.id, inode);
23:         return inode;
24:     }
25:     get(id: number): Inode | undefined {
26:         return this.inodes.get(id);
27:     }
28:     free(id: number): boolean {
29:         return this.inodes.delete(id);
30:     }
31:     register(inode: Inode): void {
32:         this.inodes.set(inode.id, inode);
33:         if (inode.id >= this.nextInodeId) {
34:             this.nextInodeId = inode.id + 1;
35:         }
36:     }
37: }
</file>

