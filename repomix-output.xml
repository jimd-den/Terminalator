 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class StringsCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         let minLength = 4;
13:         const files: string[] = [];
14:         for (let i = 0; i < args.length; i++) {
15:             const arg = args[i];
16:             if (arg === '-n') {
17:                 minLength = parseInt(args[++i], 10) || 4;
18:             } else if (arg.startsWith('-') && !isNaN(parseInt(arg.slice(1)))) {
19:                 minLength = parseInt(arg.slice(1), 10);
20:             } else if (!arg.startsWith('-')) {
21:                 files.push(arg);
22:             }
23:         }
24:         let content = '';
25:         if (files.length > 0) {
26:             for (const file of files) {
27:                 try {
28:                     content += this.fs.readFile(this.resolvePath(file, state));
29:                 } catch (e) {
30:                     return { output: `strings: ${file}: No such file`, newState: state, exitCode: 1 };
31:                 }
32:             }
33:         } else if (input) {
34:             content = input;
35:         } else {
36:             // Wait for stdin, or exit
37:             return { output: '', newState: state, exitCode: 0 };
38:         }
39:         const strings: string[] = [];
40:         let currentString = '';
41:         for (let i = 0; i < content.length; i++) {
42:             const charCode = content.charCodeAt(i);
43:             // Printable ASCII: 32-126, plus tab (9). Newline (10)? Strings usually splits on newline.
44:             // POSIX: "graphic characters"
45:             const isPrintable = (charCode >= 32 && charCode <= 126) || charCode === 9;
46:             if (isPrintable) {
47:                 currentString += content[i];
48:             } else {
49:                 if (currentString.length >= minLength) {
50:                     strings.push(currentString);
51:                 }
52:                 currentString = '';
53:             }
54:         }
55:         if (currentString.length >= minLength) {
56:             strings.push(currentString);
57:         }
58:         return {
59:             output: strings.join('\n'),
60:             newState: state,
61:             exitCode: 0
62:         };
63:     }
64:     private resolvePath(path: string, state: TerminalState): string {
65:         if (path.startsWith('/')) return path;
66:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
67:     }
68: }
