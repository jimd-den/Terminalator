 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class ExprCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         if (args.length === 0) {
13:             return { output: 'expr: missing operand', newState: state, exitCode: 2 };
14:         }
15:         try {
16:             const res = this.evaluate(args);
17:             return {
18:                 output: res.toString(),
19:                 newState: state,
20:                 exitCode: res === 0 || res === '0' || res === '' ? 1 : 0
21:             };
22:         } catch (e: any) {
23:             return { output: `expr: syntax error: ${e.message}`, newState: state, exitCode: 2 };
24:         }
25:     }
26:     private evaluate(args: string[]): number | string {
27:         // Very simple parser handling 3 args: A op B
28:         // POSIX expr is complex.
29:         // Let's handle simple cases first.
30:         if (args.length === 1) {
31:             return args[0];
32:         }
33:         if (args.length === 3) {
34:             const a = args[0];
35:             const op = args[1];
36:             const b = args[2];
37:             const numA = parseInt(a);
38:             const numB = parseInt(b);
39:             const isNum = !isNaN(numA) && !isNaN(numB);
40:             switch (op) {
41:                 case '+': return numA + numB;
42:                 case '-': return numA - numB;
43:                 case '*': return numA * numB;
44:                 case '/': return Math.floor(numA / numB);
45:                 case '%': return numA % numB;
46:                 case '=': return (a === b) ? 1 : 0;
47:                 case '!=': return (a !== b) ? 1 : 0;
48:                 case '>': return (isNum ? numA > numB : a > b) ? 1 : 0;
49:                 case '>=': return (isNum ? numA >= numB : a >= b) ? 1 : 0;
50:                 case '<': return (isNum ? numA < numB : a < b) ? 1 : 0;
51:                 case '<=': return (isNum ? numA <= numB : a <= b) ? 1 : 0;
52:             }
53:         }
54:         return args.join(' ');
55:     }
56: }
</file>

