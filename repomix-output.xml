27:                     text: missionRepository.injectVariables(nextStepData?.command || 'ls -la', mission as any),
28:                     instructions: missionRepository.injectVariables(nextStepData?.instructions || '', mission as any),
29:                     isMission: true
30:                 };
31:             }
32:             break;
33:         case MissionStep.CONNECTED:
34:             const step = steps.find(s => s.type === 'LOCATE');
35:             if (isStepComplete) {
36:                 const nextStepData = steps.find(s => s.type === 'RECOVER');
37:                 return {
38:                     type: 'START_LESSON',
39:                     lessonId: `MISSION_SCP_${mission.id}`,
40:                     objectiveTarget: mission.objectiveTarget,
41:                     nextStep: MissionStep.LOCATED,
42:                     text: missionRepository.injectVariables(nextStepData?.command || '', mission as any),
43:                     instructions: missionRepository.injectVariables(nextStepData?.instructions || '', mission as any),
44:                     isMission: true
45:                 };
46:             } else {
47:                 const nav = StrategyUtils.handleNavigation(mission, state, step?.cwd);
48:                 if (nav) return nav;
49:             }
50:             break;
51:         case MissionStep.LOCATED:
52:             const recoverStep = steps.find(s => s.type === 'RECOVER');
53:             if (!isStepComplete) {
54:                 const nav = StrategyUtils.handleNavigation(mission, state, recoverStep?.cwd);
55:                 if (nav) return nav;
56:             }
57:             break;
58:     }
59:     return null;
60: };
</file>

