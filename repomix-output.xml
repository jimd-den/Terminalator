<file path="src/domain/usecases/SchemeVM.ts">
  1: import { SchemeValue, makeBoolean, schemeToString, makeProcedure, Procedure, listToArray } from '../entities/SchemeValue';
  2: import { Environment } from '../entities/Environment';
  3: export type Instruction =
  4:     | { op: 'CONST', value: SchemeValue }
  5:     | { op: 'LOOKUP', name: string }
  6:     | { op: 'DEFINE', name: string }
  7:     | { op: 'SET', name: string }
  8:     | { op: 'CLOSURE', params: string[], body: Instruction[] }
  9:     | { op: 'APPLY', argCount: number }
 10:     | { op: 'RETURN' }
 11:     | { op: 'JUMP', offset: number }
 12:     | { op: 'JUMP_IF_FALSE', offset: number }
 13:     | { op: 'CALL_CC' }
 14:     | { op: 'HALT' };
 15: export interface VMState {
 16:     stack: SchemeValue[];
 17:     env: Environment;
 18:     pc: number;
 19:     code: Instruction[];
 20:     callStack: { pc: number, code: Instruction[], env: Environment }[];
 21: }
 22: export class SchemeVM {
 23:     private stack: SchemeValue[] = [];
 24:     private env: Environment;
 25:     private pc: number = 0;
 26:     private code: Instruction[] = [];
 27:     private callStack: any[] = [];
 28:     private instructionCount: number = 0;
 29:     constructor(env: Environment) {
 30:         this.env = env;
 31:     }
 32:     public getInstructionCount(): number {
 33:         return this.instructionCount;
 34:     }
 35:     execute(code: Instruction[]): SchemeValue {
 36:         this.code = code;
 37:         this.pc = 0;
 38:         this.stack = [];
 39:         this.callStack = [];
 40:         this.instructionCount = 0;
 41:         while (this.pc < this.code.length) {
 42:             this.instructionCount++;
 43:             const instr = this.code[this.pc];
 44:             switch (instr.op) {
 45:                 case 'CONST':
 46:                     this.stack.push(instr.value);
 47:                     this.pc++;
 48:                     break;
 49:                 case 'LOOKUP':
 50:                     this.stack.push(this.env.lookup(instr.name));
 51:                     this.pc++;
 52:                     break;
 53:                 case 'DEFINE':
 54:                     this.env.define(instr.name, this.stack.pop()!);
 55:                     this.stack.push({ type: 'symbol', value: instr.name });
 56:                     this.pc++;
 57:                     break;
 58:                 case 'SET':
 59:                     this.env.assign(instr.name, this.stack.pop()!);
 60:                     this.pc++;
 61:                     break;
 62:                 case 'CLOSURE':
 63:                     const closure: Procedure = {
 64:                         isBuiltin: false,
 65:                         params: instr.params,
 66:                         body: { type: 'bytecode', code: instr.body } as any,
 67:                         env: this.env
 68:                     };
 69:                     this.stack.push(makeProcedure(closure));
 70:                     this.pc++;
 71:                     break;
 72:                 case 'APPLY': {
 73:                     const argCount = instr.argCount;
 74:                     const procVal = this.stack.pop()!;
 75:                     const args: SchemeValue[] = [];
 76:                     for (let i = 0; i < argCount; i++) args.unshift(this.stack.pop()!);
 77:                     this.doApply(procVal, args);
 78:                     break;
 79:                 }
 80:                 case 'RETURN':
 81:                     if (this.callStack.length === 0) {
 82:                         return this.stack[this.stack.length - 1];
 83:                     }
 84:                     const frame = this.callStack.pop();
 85:                     this.pc = frame.pc;
 86:                     this.code = frame.code;
 87:                     this.env = frame.env;
 88:                     break;
 89:                 case 'JUMP':
 90:                     this.pc += instr.offset;
 91:                     break;
 92:                 case 'JUMP_IF_FALSE':
 93:                     const test = this.stack.pop()!;
 94:                     if (test.type === 'boolean' && test.value === false) {
 95:                         this.pc += instr.offset;
 96:                     } else {
 97:                         this.pc++;
 98:                     }
 99:                     break;
100:                 case 'CALL_CC': {
101:                     const receiver = this.stack.pop()!;
102:                     const capturedStack = [...this.stack];
103:                     const capturedEnv = this.env;
104:                     const capturedPC = this.pc + 2;
105:                     const capturedCode = this.code;
106:                     const capturedCallStack = [...this.callStack];
107:                     const continuation: Procedure = {
108:                         isBuiltin: true,
109:                         name: 'continuation',
110:                         call: (args) => {
111:                             this.stack = [...capturedStack, args[0]];
112:                             this.env = capturedEnv;
113:                             this.pc = capturedPC;
114:                             this.code = capturedCode;
115:                             this.callStack = [...capturedCallStack];
116:                             return args[0];
117:                         }
118:                     };
119:                     this.stack.push(makeProcedure(continuation));
120:                     this.stack.push(receiver);
121:                     this.pc++;
122:                     break;
123:                 }
124:                 case 'HALT':
125:                     return this.stack[this.stack.length - 1];
126:             }
127:         }
128:         return this.stack[this.stack.length - 1] || { type: 'null', value: null };
129:     }
130:     private doApply(procVal: SchemeValue, args: SchemeValue[]) {
131:         if (procVal.type !== 'procedure') {
132:             throw new Error(`Not a procedure: ${schemeToString(procVal)}`);
133:         }
134:         const proc: Procedure = procVal.value;
135:         if (proc.name === 'apply' && proc.isBuiltin) {
136:             if (args.length < 2) throw new Error("apply: expects at least 2 arguments");
137:             const targetProc = args[0];
138:             const fixedArgs = args.slice(1, args.length - 1);
139:             const listArg = args[args.length - 1];
140:             const spreadArgs = listToArray(listArg);
141:             const finalArgs = [...fixedArgs, ...spreadArgs];
142:             this.doApply(targetProc, finalArgs);
143:             return;
144:         }
145:         if (proc.isBuiltin) {
146:             this.stack.push(proc.call!(args));
147:             this.pc++;
148:         } else {
149:             this.callStack.push({ pc: this.pc + 1, code: this.code, env: this.env });
150:             this.env = (proc.env as Environment).extend(proc.params!, args);
151:             this.code = (proc.body as any).code;
152:             this.pc = 0;
153:         }
154:     }
155: }
