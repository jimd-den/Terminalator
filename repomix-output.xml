 9:     ) {}
10:     public async execute(input: string, state: TerminalState): Promise<CommandResponse> {
11:         if (!input.trim()) {
12:             return { output: '', exitCode: 0, newState: state, command: input };
13:         }
14:         const parts = input.trim().split(/\s+/);
15:         const verb = parts[0];
