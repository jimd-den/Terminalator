<file path="src/domain/commands/core/ValCommand.ts">
  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { CommandBase } from '../CommandBase';
  3: import { CommandResponse } from '../ICommand';
  4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  5: import { TerminalState } from '../../entities/TerminalState';
  6: import { CommandCapability } from '../IStructuredCommand';
  7: const VAL_EXIT = {
  8:      MISSING_FILE_ARG: 0x80,
  9:      UNKNOWN_OPTION: 0x40,
 10:      CORRUPTED_SCCS: 0x20,
 11:      NOT_SCCS_FILE: 0x10,
 12:      SID_INVALID: 0x08,
 13:      SID_NOT_EXIST: 0x04,
 14:      TYPE_MISMATCH: 0x02,
 15:      NAME_MISMATCH: 0x01
 16: };
 17: interface ValOptions {
 18:      silent: boolean;
 19:      moduleName?: string;
 20:      sid?: string;
 21:      type?: string;
 22: }
 23: export class ValCommand extends CommandBase {
 24:      public readonly capabilities: CommandCapability[] = [CommandCapability.READ];
 25:      public readonly utility: string = 'val';
 26:      protected async executeInternal(
 27:           args: string[],
 28:           flags: Set<string>,
 29:           operands: string[],
 30:           context: ProcessContext,
 31:           state: TerminalState
 32:      ): Promise<CommandResponse> {
 33:           this.parseArgs(args, ['m', 'r', 'y']);
 34:           const input = getStdinAsString(context);
 35:           const opts: ValOptions = {
 36:                silent: this.hasFlag('s'),
 37:                moduleName: this.options.get('m'),
 38:                sid: this.options.get('r'),
 39:                type: this.options.get('y')
 40:           };
 41:           const files = this.operands;
 42:           if (files.length === 1 && files[0] === '-') {
 43:                return this.processStdin(input, opts, context, state);
 44:           }
 45:           if (files.length === 0) {
 46:                return {
 47:                     output: opts.silent ? '' : 'val: missing file operand',
 48:                     newState: state,
 49:                     exitCode: VAL_EXIT.MISSING_FILE_ARG
 50:                };
 51:           }
 52:           return this.processFiles(files, opts, context, state);
 53:      }
 54:      private parseArgsInner(args: string[]): { opts: ValOptions, files: string[] } {
 55:           const parser = new (class extends CommandBase {
 56:                public readonly capabilities: CommandCapability[] = [];
 57:                public readonly utility: string = 'val-parser';
 58:                public parse(a: string[]) { this.parseArgs(a, ['m', 'r', 'y']); }
 59:                public get() {
 60:                     return {
 61:                          opts: {
 62:                               silent: this.hasFlag('s'),
 63:                               moduleName: this.options.get('m'),
 64:                               sid: this.options.get('r'),
 65:                               type: this.options.get('y')
 66:                          },
 67:                          files: this.operands
 68:                     };
 69:                }
 70:                protected executeInternal(): any { return null; }
 71:           })();
 72:           parser.parse(args);
 73:           return parser.get();
 74:      }
 75:      private async processStdin(
 76:           input: string | undefined,
 77:           opts: ValOptions,
 78:           context: ProcessContext,
 79:           state: TerminalState
 80:      ): Promise<CommandResponse> {
 81:           if (!input || input.trim() === '') {
 82:                return { output: '', newState: state, exitCode: 0 };
 83:           }
 84:           const lines = input.trim().split('\n');
 85:           let aggregateExitCode = 0;
 86:           const outputs: string[] = [];
 87:           for (const line of lines) {
 88:                const lineArgs = line.trim().split(/\s+/).filter(s => s.length > 0);
 89:                if (lineArgs.length === 0) continue;
 90:                const { opts: lineOpts, files: lineFiles } = this.parseArgsInner(lineArgs);
 91:                const mergedOpts = { ...opts, ...lineOpts };
 92:                if (lineFiles.length === 0) {
 93:                     continue;
 94:                }
 95:                const result = await this.processFiles(lineFiles, mergedOpts, context, state, line);
 96:                if (result.output) {
 97:                     outputs.push(result.output);
 98:                }
 99:                aggregateExitCode |= result.exitCode;
100:           }
101:           return {
102:                output: outputs.join('\n'),
103:                newState: state,
104:                exitCode: aggregateExitCode
105:           };
106:      }
107:      private async processFiles(
108:           files: string[],
109:           opts: ValOptions,
110:           context: ProcessContext,
111:           state: TerminalState,
112:           inputLine?: string
113:      ): Promise<CommandResponse> {
114:           let aggregateExitCode = 0;
115:           const outputs: string[] = [];
116:           const fs = context.fileSystemService;
117:           for (const file of files) {
118:                let fileExitCode = 0;
119:                const messages: string[] = [];
120:                const node = fs.resolve(file, state.currentDirectory);
121:                if (!node) {
122:                     fileExitCode |= VAL_EXIT.NOT_SCCS_FILE;
123:                     messages.push(`${file}: cannot open file or file not SCCS`);
124:                } else if (fs.isDirectory(node)) {
125:                     fileExitCode |= VAL_EXIT.NOT_SCCS_FILE;
126:                     messages.push(`${file}: is a directory`);
127:                } else {
128:                     try {
129:                          const content = fs.readFile(fs.getAbsolutePath(node));
130:                          const validateResult = this.validateSccsFile(file, content, opts);
131:                          fileExitCode |= validateResult.exitCode;
132:                          messages.push(...validateResult.messages);
133:                     } catch (e) {
134:                          fileExitCode |= VAL_EXIT.NOT_SCCS_FILE;
135:                          messages.push(`${file}: cannot read file`);
136:                     }
137:                }
138:                if (messages.length > 0 && !opts.silent) {
139:                     if (inputLine) {
140:                          outputs.push(`${inputLine}\n\n    ${file}: ${messages.join(', ')}`);
141:                     } else {
142:                          outputs.push(`${file}: ${messages.join(', ')}`);
143:                     }
144:                }
145:                aggregateExitCode |= fileExitCode;
146:           }
147:           return {
148:                output: outputs.join('\n'),
149:                newState: state,
150:                exitCode: aggregateExitCode
151:           };
152:      }
153:      private validateSccsFile(
154:           filename: string,
155:           content: string,
156:           opts: ValOptions
157:      ): { exitCode: number, messages: string[] } {
158:           let exitCode = 0;
159:           const messages: string[] = [];
160:           const isSccsFile = filename.startsWith('s.') ||
161:                content.includes('@(#)') ||
162:                content.includes('%M%') ||
163:                content.includes('%Y%') ||
164:                content.includes('%I%');
165:           if (!isSccsFile && !content.includes('\x01h')) {
166:                if (content.includes('bad') || content.includes('corrupt')) {
167:                     exitCode |= VAL_EXIT.CORRUPTED_SCCS;
168:                     messages.push('corrupted SCCS file');
169:                } else {
170:                     if (!filename.startsWith('s.')) {
171:                          exitCode |= VAL_EXIT.NOT_SCCS_FILE;
172:                          messages.push('not an SCCS file');
173:                     }
174:                }
175:           }
176:           if (opts.sid) {
177:                const sidValid = this.validateSid(opts.sid);
178:                if (!sidValid.valid) {
179:                     exitCode |= VAL_EXIT.SID_INVALID;
180:                     messages.push(`SID ${opts.sid} is ${sidValid.reason}`);
181:                } else {
182:                     const sidExists = filename.startsWith('s.') || content.includes(opts.sid);
183:                     if (!sidExists) {
184:                          exitCode |= VAL_EXIT.SID_NOT_EXIST;
185:                          messages.push(`SID ${opts.sid} does not exist`);
186:                     }
187:                }
188:           }
189:           if (opts.type) {
190:                const typeMatch = content.match(/%Y%\s*=?\s*(\w+)/);
191:                const fileType = typeMatch ? typeMatch[1] : undefined;
192:                if (fileType && fileType !== opts.type) {
193:                     exitCode |= VAL_EXIT.TYPE_MISMATCH;
194:                     messages.push(`%Y%, -y mismatch`);
195:                }
196:           }
197:           if (opts.moduleName) {
198:                const nameMatch = content.match(/%M%\s*=?\s*(\w+)/);
199:                const fileModule = nameMatch ? nameMatch[1] : undefined;
200:                if (fileModule && fileModule !== opts.moduleName) {
201:                     exitCode |= VAL_EXIT.NAME_MISMATCH;
202:                     messages.push(`%M%, -m mismatch`);
203:                }
204:           }
205:           return { exitCode, messages };
206:      }
207:      private validateSid(sid: string): { valid: boolean, reason?: string } {
208:           const parts = sid.split('.');
209:           if (parts.length < 2 || parts.length > 4) {
210:                return { valid: false, reason: 'invalid format' };
211:           }
212:           for (const part of parts) {
213:                const num = parseInt(part, 10);
214:                if (isNaN(num) || num < 0 || part !== num.toString()) {
215:                     return { valid: false, reason: 'invalid format' };
216:                }
217:           }
218:           if (parts.length === 1) {
219:                return { valid: false, reason: 'ambiguous' };
220:           }
221:           if (parts.length >= 2 && parseInt(parts[1], 10) === 0) {
222:                return { valid: false, reason: 'invalid' };
223:           }
224:           if (parts.length === 4 && parseInt(parts[2], 10) === 0) {
225:                return { valid: false, reason: 'invalid' };
226:           }
227:           return { valid: true };
228:      }
229: }
</file>

