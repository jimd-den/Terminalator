 1: import { NodeExecutor } from '../NodeExecutor';
 2: import { ASTNode, PipelineNode, NodeType } from '../../ShellParser';
 3: import { TerminalState } from '../../../entities/TerminalState';
 4: import { CommandResponse } from '../../../entities/Command';
 5: import { mergeState } from '../../../utils/TerminalStateUtils';
 6: export class PipelineExecutor implements NodeExecutor {
 7:     async execute(
 8:         node: ASTNode,
 9:         state: TerminalState,
10:         visitor: (node: ASTNode, state: TerminalState, stdin?: string) => Promise<CommandResponse>,
11:         stdin?: string
12:     ): Promise<CommandResponse> {
13:         if (node.type !== NodeType.PIPELINE) {
14:             throw new Error('PipelineExecutor can only handle PIPELINE nodes');
15:         }
16:         const pipeNode = node as PipelineNode;
17:         let currentState = state;
18:         let currentInput = stdin;
19:         let lastExitCode = 0;
20:         let finalUiAction;
21:         let finalNavAction;
22:         let finalOutput = '';
23:         for (let i = 0; i < pipeNode.parts.length; i++) {
24:             const part = pipeNode.parts[i];
25:             const isLast = i === pipeNode.parts.length - 1;
26:             const res = await visitor(part, currentState, currentInput);
27:             currentInput = res.output;
28:             currentState = mergeState(currentState, res.newState);
29:             lastExitCode = res.exitCode;
30:             currentState.lastExitCode = res.exitCode;
31:             if (isLast) finalOutput = res.output;
32:             if (res.uiAction) finalUiAction = res.uiAction;
33:             if (res.navigationAction) finalNavAction = res.navigationAction;
34:             if (res.controlFlow === 'RETURN') return res;
35:         }
36:         return {
37:             output: finalOutput,
38:             newState: currentState,
39:             exitCode: lastExitCode,
40:             uiAction: finalUiAction,
41:             navigationAction: finalNavAction,
42:             controlFlow: undefined
43:         };
44:     }
45: }
