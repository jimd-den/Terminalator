 58:         if (!text) {
 59:             setDisplay('');
 60:             return;
 61:         }
 62:         let cursor = 0;
 63:         const batchSize = 4;
 64:         const interval = setInterval(() => {
 65:             cursor += batchSize;
 66:             setDisplay(text.substring(0, cursor));
 67:             if (cursor >= text.length) clearInterval(interval);
 68:         }, 16);
 69:         return () => clearInterval(interval);
 70:     }, [text]);
 71:     return <Text style={style}>{display}</Text>;
 72: };
