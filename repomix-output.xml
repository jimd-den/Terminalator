<file path="src/domain/entities/EditorBuffer.ts">
 1: import { IVimBuffer } from './vim/IVimBuffer';
 2: export interface EditorBufferState {
 3:     lines: string[];
 4:     filename: string;
 5:     language: string;
 6: }
 7: export class EditorBuffer implements IVimBuffer {
 8:     private state: EditorBufferState;
 9:     constructor(filename: string, content: string = '', language: string = 'plaintext') {
10:         this.state = {
11:             lines: content.split('\n'),
12:             filename,
13:             language
14:         };
15:         if (this.state.lines.length === 0) {
16:             this.state.lines = [''];
17:         }
18:     }
19:     /**
20:      * Returns the current state of the buffer.
21:      */
22:     getState(): EditorBufferState {
23:         return { ...this.state, lines: [...this.state.lines] };
24:     }
25:     /**
26:      * Updates a single line in the buffer.
27:      */
28:     updateLine(index: number, content: string): void {
29:         if (index >= 0 && index < this.state.lines.length) {
30:             this.state.lines[index] = content;
31:         }
32:     }
33:     /**
34:      * Inserts a new line at the specified index.
35:      */
36:     insertLine(index: number, content: string = ''): void {
37:         this.state.lines.splice(index, 0, content);
38:     }
39:     /**
40:      * Deletes the line at the specified index.
41:      */
42:     deleteLine(index: number): void {
43:         if (this.state.lines.length > 1) {
44:             this.state.lines.splice(index, 1);
45:         } else {
46:             this.state.lines = [''];
47:         }
48:     }
49:     /**
50:      * Joins a line with the one below it.
51:      */
52:     joinLines(index: number): void {
53:         if (index >= 0 && index < this.state.lines.length - 1) {
54:             this.state.lines[index] += this.state.lines[index + 1];
55:             this.state.lines.splice(index + 1, 1);
56:         }
57:     }
58:     /**
59:      * Splits a line at the specified column index.
60:      */
61:     splitLine(lineIndex: number, colIndex: number): void {
62:         if (lineIndex >= 0 && lineIndex < this.state.lines.length) {
63:             const line = this.state.lines[lineIndex];
64:             const head = line.slice(0, colIndex);
65:             const tail = line.slice(colIndex);
66:             this.state.lines[lineIndex] = head;
67:             this.state.lines.splice(lineIndex + 1, 0, tail);
68:         }
69:     }
70:     /**
71:      * Returns the full content of the buffer as a single string.
72:      */
73:     toString(): string {
74:         return this.state.lines.join('\n');
75:     }
76:     get length(): number {
77:         return this.state.lines.length;
78:     }
79:     getLine(index: number): string {
80:         return this.state.lines[index] || '';
81:     }
82: }
</file>

<file path="src/domain/entities/Environment.ts">
 1: import { SchemeValue } from './SchemeValue';
 2: export class Environment {
 3:     private bindings: Map<string, SchemeValue> = new Map();
 4:     private parent: Environment | null;
 5:     constructor(parent: Environment | null = null) {
 6:         this.parent = parent;
 7:     }
 8:     define(name: string, value: SchemeValue): void {
 9:         this.bindings.set(name.toLowerCase(), value);
10:     }
11:     assign(name: string, value: SchemeValue): void {
12:         const key = name.toLowerCase();
13:         if (this.bindings.has(key)) {
14:             this.bindings.set(key, value);
15:         } else if (this.parent) {
16:             this.parent.assign(name, value);
17:         } else {
18:             throw new Error(`Unbound variable: ${name}`);
19:         }
20:     }
21:     lookup(name: string): SchemeValue {
22:         const key = name.toLowerCase();
23:         if (this.bindings.has(key)) {
24:             return this.bindings.get(key)!;
25:         } else if (this.parent) {
26:             return this.parent.lookup(name);
27:         } else {
28:             throw new Error(`Unbound variable: ${name}`);
29:         }
30:     }
31:     extend(params: string[], args: SchemeValue[]): Environment {
32:         if (params.length !== args.length) {
33:             throw new Error(`Wrong number of arguments: expected ${params.length}, got ${args.length}`);
34:         }
35:         const child = new Environment(this);
36:         for (let i = 0; i < params.length; i++) {
37:             child.define(params[i], args[i]);
38:         }
39:         return child;
40:     }
41: }
</file>

