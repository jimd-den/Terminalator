<file path="src/infrastructure/services/HostBinaryRunner.ts">
 1: import { IBinaryRunner, ExecutionContext } from '../../domain/interfaces/IBinaryRunner';
 2: import { CommandResponse } from '../../domain/entities/Command';
 3: import { FileSystemService } from '../../domain/services/FileSystemService';
 4: import { TerminalState } from '../../domain/entities/TerminalState';
 5: import * as fs from 'fs';
 6: import * as path from 'path';
 7: import * as os from 'os';
 8: import { exec } from 'child_process';
 9: import { promisify } from 'util';
10: const execAsync = promisify(exec);
11: export class HostBinaryRunner implements IBinaryRunner {
12:     private tempDir: string;
13:     constructor() {
14:         this.tempDir = path.join(os.tmpdir(), 'terminalator_runner');
15:         if (!fs.existsSync(this.tempDir)) {
16:             fs.mkdirSync(this.tempDir);
17:         }
18:     }
19:     async run(binary: Uint8Array, args: string[], context: ExecutionContext): Promise<CommandResponse> {
20:         const binaryName = `bin_${Date.now()}`;
21:         const binaryPath = path.join(this.tempDir, binaryName);
22:         try {
23:             fs.writeFileSync(binaryPath, Buffer.from(binary));
24:             fs.chmodSync(binaryPath, 0o755);
25:             const cmd = `${binaryPath} ${args.join(' ')}`;
26:             const result = await execAsync(cmd);
27:             if (result.stdout) {
28:                 context.stdout.write(result.stdout);
29:             }
30:             if (result.stderr) {
31:                 context.stderr.write(result.stderr);
32:             }
33:             return {
34:                 output: (result.stdout + result.stderr).trim(),
35:                 exitCode: 0,
36:                 newState: null as any
37:             };
38:         } catch (error: any) {
39:             return {
40:                 output: error.stdout || error.stderr || error.message,
41:                 exitCode: error.code || 1,
42:                 newState: null as any
43:             };
44:         } finally {
45:             if (fs.existsSync(binaryPath)) fs.unlinkSync(binaryPath);
46:         }
47:     }
48: }
</file>

<file path="src/infrastructure/telemetry/ConsoleTelemetryAdapter.ts">
 1: import { TelemetryPort } from '../../domain/ports/TelemetryPort';
 2: enum LogLevel {
 3:     INFO = 'INFO',
 4:     WARN = 'WARN',
 5:     ERROR = 'ERROR',
 6:     DEBUG = 'DEBUG',
 7: }
 8: export class ConsoleTelemetryAdapter implements TelemetryPort {
 9:     private formatMessage(level: LogLevel, message: string, context?: any): string {
10:         const timestamp = new Date().toISOString();
11:         const contextString = context ? ` | Context: ${JSON.stringify(context)}` : '';
12:         return `[${timestamp}] [${level}] ${message}${contextString}`;
13:     }
14:     info(message: string, context?: any): void {
15:         console.log(this.formatMessage(LogLevel.INFO, message, context));
16:     }
17:     warn(message: string, context?: any): void {
18:         console.warn(this.formatMessage(LogLevel.WARN, message, context));
19:     }
20:     error(message: string, context?: any): void {
21:         console.error(this.formatMessage(LogLevel.ERROR, message, context));
22:     }
23:     debug(message: string, context?: any): void {
24:         const isDev = typeof (global as any).__DEV__ !== 'undefined' ? (global as any).__DEV__ : true;
25:         if (isDev) {
26:             console.debug(this.formatMessage(LogLevel.DEBUG, message, context));
27:         }
28:     }
29:     trace<T>(fnName: string, fn: (...args: any[]) => T, ...args: any[]): T {
30:         this.debug(`Executing ${fnName}`, { arguments: args });
31:         try {
32:             const result = fn(...args);
33:             if (result instanceof Promise) {
34:                 return result.then(res => {
35:                     this.debug(`Completed ${fnName}`, { result: res });
36:                     return res;
37:                 }).catch(err => {
38:                     this.error(`Failed ${fnName}`, { error: err, arguments: args });
39:                     throw err;
40:                 }) as any;
41:             }
42:             this.debug(`Completed ${fnName}`, { result });
43:             return result;
44:         } catch (error) {
45:             this.error(`Failed ${fnName}`, { error, arguments: args });
46:             throw error;
47:         }
48:     }
49: }
