 7: export const processEscapeSequences = (input: string): { result: string, suppressNewline: boolean, truncate: boolean } => {
 8:     let result = '';
 9:     let suppressNewline = false;
10:     let truncate = false;
11:     for (let i = 0; i < input.length; i++) {
12:         if (input[i] === '\\' && i + 1 < input.length) {
13:             const next = input[i + 1];
14:             switch (next) {
15:                 case 'a': result += '\x07'; i++; break;
16:                 case 'b': result += '\b'; i++; break;
17:                 case 'c':
18:                     suppressNewline = true;
19:                     truncate = true;
20:                     i++;
21:                     return { result, suppressNewline, truncate };
22:                 case 'f': result += '\f'; i++; break;
23:                 case 'n': result += '\n'; i++; break;
24:                 case 'r': result += '\r'; i++; break;
25:                 case 't': result += '\t'; i++; break;
26:                 case 'v': result += '\v'; i++; break;
27:                 case '\\': result += '\\'; i++; break;  // Backslash
28:                 case '0': {
29:                     let octalStr = '';
30:                     let j = i + 2;
31:                     while (j < input.length && j < i + 5 && /[0-7]/.test(input[j])) {
32:                         octalStr += input[j];
33:                         j++;
34:                     }
35:                     if (octalStr.length > 0) {
36:                         result += String.fromCharCode(parseInt(octalStr, 8));
37:                         i = j - 1;
38:                     } else {
39:                         // Just \0
40:                         result += '\0';
41:                         i++;
42:                     }
43:                     break;
44:                 }
45:                 default:
46:                     result += '\\';
47:                     break;
48:             }
49:         } else {
50:             result += input[i];
51:         }
52:     }
53:     return { result, suppressNewline, truncate };
54: };
55: export class EchoCommand implements ICommand {
56:     constructor(private fs: FileSystemService) { }
57:     /**
58:      * Executes the echo command.
59:      */
60:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
61:         const input = getStdinAsString(context);
62:         const timestamp = new Date().toISOString();
63:         this.log(`[${timestamp}] EchoCommand.execute(args=${JSON.stringify(args)})`);
64:         // POSIX: "The echo utility shall not recognize the '--' argument... or any options"
65:         // Everything passed in 'args' is treated as a string to be printed.
66:         let combinedOutput = '';
67:         let suppressNewline = false;
68:         for (let i = 0; i < args.length; i++) {
69:             const { result, suppressNewline: sn, truncate } = processEscapeSequences(args[i]);
70:             combinedOutput += result;
71:             if (truncate) {
72:                 suppressNewline = true;
73:                 break;
74:             }
75:             // Append space between arguments if not the last one and not truncated
76:             if (i < args.length - 1) {
77:                 combinedOutput += ' ';
78:             }
79:         }
80:         const finalOutput = suppressNewline ? combinedOutput : combinedOutput + '\n';
81:         this.log(`[${new Date().toISOString()}] EchoCommand.execute returns exitCode=0`);
82:         return {
83:             output: finalOutput,
84:             newState: state,
85:             exitCode: 0
86:         };
87:     }
88:     private log(message: string) {
89:     }
90: }
