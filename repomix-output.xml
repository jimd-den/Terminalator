<file path="src/domain/services/constraints/ComplexityEstimator.ts">
 1: export interface ExecutionStats {
 2:     iterations: number;
 3:     memoryUsed: number;
 4:     timeMs: number;
 5: }
 6: export class ComplexityEstimator {
 7:     public isEfficient(inputSize: number, stats: ExecutionStats, complexityLimit: 'O(1)' | 'O(log n)' | 'O(n)'): boolean {
 8:         switch (complexityLimit) {
 9:             case 'O(1)':
10:                 return stats.iterations < 10;
11:             case 'O(log n)':
12:                 const logLimit = Math.log2(inputSize) * 2;
13:                 return stats.iterations <= Math.max(5, logLimit);
14:             case 'O(n)':
15:                 return stats.iterations <= inputSize * 1.5;
16:             default:
17:                 return true;
18:         }
19:     }
20: }
</file>

<file path="src/domain/services/constraints/ConstraintValidator.ts">
 1: import { Mission } from '../../entities/Mission';
 2: import { ExecutionStats, ComplexityEstimator } from './ComplexityEstimator';
 3: export class ConstraintValidator {
 4:     constructor(private complexityEstimator: ComplexityEstimator) {}
 5:     public validate(mission: Mission, stats: ExecutionStats): { valid: boolean; reason?: string } {
 6:         if (!mission.constraints) return { valid: true };
 7:         const { constraints } = mission;
 8:         if (constraints.maxTimeMs && stats.timeMs > constraints.maxTimeMs) {
 9:             return { valid: false, reason: `TIMEOUT: Execution took ${stats.timeMs}ms, limit ${constraints.maxTimeMs}ms.` };
10:         }
11:         if (constraints.maxMemoryBytes && stats.memoryUsed > constraints.maxMemoryBytes) {
12:             return { valid: false, reason: `OOM: Memory usage ${stats.memoryUsed} bytes, limit ${constraints.maxMemoryBytes} bytes.` };
13:         }
14:         if (constraints.requiredComplexity && mission.problemSize) {
15:             const efficient = this.complexityEstimator.isEfficient(
16:                 mission.problemSize,
17:                 stats,
18:                 constraints.requiredComplexity
19:             );
20:             if (!efficient) {
21:                 return {
22:                     valid: false,
23:                     reason: `INEFFICIENT: Algorithm does not meet ${constraints.requiredComplexity} requirement for n=${mission.problemSize}.`
24:                 };
25:             }
26:         }
27:         return { valid: true };
28:     }
29: }
</file>

<file path="src/domain/services/filesystem/DirectoryService.ts">
 1: import { Inode, S_IFDIR, S_IWUSR, S_IXUSR } from '../../entities/filesystem/FileSystemTypes';
 2: import { InodeTable } from '../../entities/filesystem/InodeTable';
 3: import { IFileSystemNode } from '../../entities/filesystem/IFileSystemNode';
 4: import { DirectoryNode } from '../../entities/filesystem/DirectoryNode';
 5: import { PermissionService } from './PermissionService';
 6: import { PathResolver } from './PathResolver';
 7: type Dentry = IFileSystemNode;
 8: export class DirectoryService {
 9:     constructor(
10:         private inodeTable: InodeTable,
11:         private permissions: PermissionService,
12:         private pathResolver: PathResolver,
13:         private root: Dentry,
14:         private updateUsage: (delta: number) => void
15:     ) { }
16:     public mkdir(parent: DirectoryNode, name: string, mode: number, uid: number, gid: number): Dentry {
17:         if (parent.getChild(name)) throw new Error('File exists');
18:         const fullMode = S_IFDIR | mode;
19:         const inode = this.inodeTable.allocate(fullMode, uid, gid);
20:         this.updateUsage(4096);
21:         const newNode = new DirectoryNode(name, inode.id, parent);
22:         parent.addChild(newNode);
23:         const parentInode = this.inodeTable.get(parent.inodeId);
24:         if (parentInode) {
25:             parentInode.links++;
26:             parentInode.mtime = Date.now();
27:             parentInode.ctime = Date.now();
28:         }
29:         return newNode;
30:     }
31:     public mkdirp(path: string, mode: number, uid: number, gid: number, cwd: string = '/'): Dentry {
32:         const isAbsolute = path.startsWith('/');
33:         let targetPath = isAbsolute ? path : (cwd === '/' ? `/${path}` : `${cwd}/${path}`);
34:         targetPath = targetPath.replace(/\/\//g, '/');
35:         if (targetPath === '/') return this.root;
36:         const parts = targetPath.split('/').filter(p => p.length > 0);
37:         let currentPath = '';
38:         let lastDentry: Dentry = this.root;
39:         for (const part of parts) {
40:             currentPath += `/${part}`;
41:             // Try to find it
42:             const existing = this.pathResolver.resolve(this.root, currentPath, '/', true);
43:             if (existing) {
44:                 lastDentry = existing;
45:                 const inode = this.inodeTable.get(lastDentry.inodeId);
46:                 if (inode && !(inode.mode & S_IFDIR)) {
47:                     throw new Error(`mkdirp: cannot create directory '${currentPath}': Not a directory`);
48:                 }
49:             } else {
50:                 // Must create it inside the *previous* dentry (which must be a dir)
51:                 if (!lastDentry.isDirectory()) throw new Error('Not a directory');
52:                 lastDentry = this.mkdir(lastDentry as DirectoryNode, part, mode, uid, gid);
53:             }
54:         }
55:         return lastDentry;
56:     }
57:     public deleteNode(dentry: Dentry, actingUser?: { uid: number, gid: number, groups: number[] }): void {
58:         if (!dentry.parent) throw new Error('Cannot remove root');
59:         if (actingUser) {
60:             const parentInode = this.inodeTable.get(dentry.parent.inodeId);
61:             if (parentInode) {
62:                 if (!this.permissions.hasAccess(parentInode.id, actingUser, S_IWUSR) ||
63:                     !this.permissions.hasAccess(parentInode.id, actingUser, S_IXUSR)) {
64:                     throw new Error('Permission denied');
65:                 }
66:             }
67:         }
68:         const inode = this.inodeTable.get(dentry.inodeId);
69:         if (!inode) throw new Error('Corrupt filesystem');
70:         if (inode.mode & S_IFDIR) {
71:             if (dentry.isDirectory()) {
72:                 const dirNode = dentry as DirectoryNode;
73:                 if (dirNode.children.size > 0) {
74:                     throw new Error('Directory not empty');
75:                 }
76:             }
77:         }
78:         const parent = dentry.parent as DirectoryNode;
79:         parent.removeChild(dentry.name);
80:         inode.links--;
81:         const parentInode = this.inodeTable.get(parent.inodeId);
82:         if (parentInode) parentInode.mtime = Date.now();
83:         if (inode.links <= 0) {
84:             this.updateUsage(-inode.size);
85:             this.inodeTable.free(inode.id);
86:         }
87:     }
88: }
</file>

<file path="src/domain/services/filesystem/FileOperationService.ts">
 1: import { Inode, S_IFDIR, S_IFREG, S_IFIFO, S_IRUSR, S_IWUSR } from '../../entities/filesystem/FileSystemTypes';
 2: import { InodeTable } from '../../entities/filesystem/InodeTable';
 3: import { IFileSystemNode } from '../../entities/filesystem/IFileSystemNode';
 4: import { FileNode } from '../../entities/filesystem/FileNode';
 5: import { DirectoryNode } from '../../entities/filesystem/DirectoryNode';
 6: import { PermissionService } from './PermissionService';
 7: type Dentry = IFileSystemNode;
 8: export class FileOperationService {
 9:     constructor(
10:         private inodeTable: InodeTable,
11:         private permissions: PermissionService,
12:         private updateUsage: (delta: number) => void
13:     ) { }
14:     public readFile(dentry: Dentry, actingUser?: { uid: number, gid: number, groups: number[] }): string {
15:         const inode = this.validateAccess(dentry, actingUser, S_IRUSR);
16:         const content = inode.content;
17:         if (content instanceof Uint8Array) {
18:             return new TextDecoder().decode(content);
19:         }
20:         return content as string;
21:     }
22:     public readFileBuffer(dentry: Dentry, actingUser?: { uid: number, gid: number, groups: number[] }): Uint8Array {
23:         const inode = this.validateAccess(dentry, actingUser, S_IRUSR);
24:         const content = inode.content;
25:         if (content instanceof Uint8Array) {
26:             return content;
27:         }
28:         return new TextEncoder().encode(content as string);
29:     }
30:     public writeFile(dentry: Dentry, content: string | Uint8Array, modeStr: 'w' | 'a' = 'w', actingUser?: { uid: number, gid: number, groups: number[] }): void {
31:         const inode = this.validateAccess(dentry, actingUser, S_IWUSR);
32:         const oldSize = inode.size;
33:         if (modeStr === 'w') {
34:             inode.content = content;
35:         } else {
36:             const current = inode.content instanceof Uint8Array
37:                 ? inode.content
38:                 : new TextEncoder().encode(inode.content as string || '');
39:             const incoming = content instanceof Uint8Array
40:                 ? content
41:                 : new TextEncoder().encode(content);
42:             const combined = new Uint8Array(current.length + incoming.length);
43:             combined.set(current);
44:             combined.set(incoming, current.length);
45:             inode.content = combined;
46:         }
47:         // Update Metadata
48:         inode.size = (typeof inode.content === 'string') ? inode.content.length : (inode.content as Uint8Array).length;
49:         inode.mtime = Date.now();
50:         inode.ctime = Date.now();
51:         this.updateUsage(inode.size - oldSize);
52:     }
53:     public createFile(parent: DirectoryNode, name: string, mode: number, uid: number, gid: number): Dentry {
54:         return this.createDentry(parent, name, S_IFREG | mode, uid, gid);
55:     }
56:     public mkfifo(parent: DirectoryNode, name: string, mode: number, uid: number, gid: number): Dentry {
57:         return this.createDentry(parent, name, S_IFIFO | mode, uid, gid);
58:     }
59:     private createDentry(parent: DirectoryNode, name: string, fullMode: number, uid: number, gid: number): Dentry {
60:         if (parent.getChild(name)) throw new Error('File exists');
61:         const inode = this.inodeTable.allocate(fullMode, uid, gid);
62:         const newNode = new FileNode(name, inode.id, parent);
63:         parent.addChild(newNode);
64:         const parentInode = this.inodeTable.get(parent.inodeId);
65:         if (parentInode) {
66:             parentInode.mtime = Date.now();
67:             parentInode.ctime = Date.now();
68:         }
69:         return newNode;
70:     }
71:     private validateAccess(dentry: Dentry, actingUser: { uid: number, gid: number, groups: number[] } | undefined, requiredBit: number): Inode {
72:         const inode = this.inodeTable.get(dentry.inodeId);
73:         if (!inode) throw new Error('Corrupt filesystem');
74:         if (inode.mode & S_IFDIR) throw new Error('Is a directory');
75:         if (actingUser && !this.permissions.hasAccess(inode.id, actingUser, requiredBit)) {
76:             throw new Error('Permission denied');
77:         }
78:         return inode;
