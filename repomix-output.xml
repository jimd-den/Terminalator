 5: export class RedirectionService {
 6:     constructor(private fsService: FileSystemService) { }
 7:     public handleRedirections(result: CommandResponse, redirects: RedirectNode[], state: TerminalState): CommandResponse {
 8:         if (!redirects || redirects.length === 0) return result;
 9:         let finalResult = { ...result };
10:         for (const redir of redirects) {
11:             if (redir.op === '>' || redir.op === '>>') {
12:                 if (finalResult.output !== undefined && finalResult.output !== null) {
13:                     const content = finalResult.output;
14:                     const mode = redir.op === '>>' ? 'a' : 'w';
15:                     this.fsService.writeFile(
16:                         redir.file,
17:                         content,
18:                         mode,
19:                         state.user.uid,
20:                         state.user.gid,
21:                         state.currentDirectory,
22:                         state.user
23:                     );
24:                 }
25:                 finalResult.output = '';
26:             }
27:         }
28:         return finalResult;
29:     }
30: }
