<file path="src/domain/commands/core/UnexpandCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { CommandBase } from '../CommandBase';
 3: import { CommandCapability } from '../IStructuredCommand';
 4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystemService } from '../../services/FileSystemService';
 8: export class UnexpandCommand extends CommandBase {
 9:     public readonly capabilities = [CommandCapability.TRANSFORM];
10:     public readonly utility = 'unexpand';
11:     constructor(private fs: FileSystemService) {
12:         super();
13:     }
14:     protected async executeInternal(
15:         rawArgs: string[],
16:         flags: Set<string>,
17:         operands: string[],
18:         context: ProcessContext,
19:         state: TerminalState
20:     ): Promise<CommandResponse> {
21:         const input = getStdinAsString(context);
22:         const all = flags.has('a');
23:         const files = operands;
24:         let content = '';
25:         if (files.length > 0) {
26:             for (const file of files) {
27:                 try {
28:                     content += this.fs.readFile(this.resolvePath(file, state));
29:                 } catch (e) {
30:                     return { output: `unexpand: ${file}: No such file`, newState: state, exitCode: 1 };
31:                 }
32:             }
33:         } else if (input) {
34:             content = input;
35:         } else {
36:             return { output: '', newState: state, exitCode: 0 };
37:         }
38:         const lines = content.split('\n');
39:         const output: string[] = [];
40:         const tabStop = 8;
41:         for (const line of lines) {
42:             if (!all) {
43:                 let spaces = 0;
44:                 while (spaces < line.length && line[spaces] === ' ') {
45:                     spaces++;
46:                 }
47:                 if (spaces > 0) {
48:                     const tabs = Math.floor(spaces / tabStop);
49:                     const rem = spaces % tabStop;
50:                     output.push('\t'.repeat(tabs) + ' '.repeat(rem) + line.slice(spaces));
51:                 } else {
52:                     output.push(line);
53:                 }
54:             } else {
55:                 let res = '';
56:                 let col = 0;
57:                 let pendingSpaces = 0;
58:                 for (let i = 0; i < line.length; i++) {
59:                     const char = line[i];
60:                     if (char === ' ') {
61:                         pendingSpaces++;
62:                         col++;
63:                         if (col % tabStop === 0 && pendingSpaces > 1) {
64:                             res += '\t';
65:                             pendingSpaces = 0;
66:                         }
67:                     } else {
68:                         res += ' '.repeat(pendingSpaces);
69:                         pendingSpaces = 0;
70:                         res += char;
71:                         col++;
72:                         if (char === '\t') {
73:                             col = Math.ceil((col + 1) / tabStop) * tabStop;
74:                         } else if (char === '\b') {
75:                             col--;
76:                         }
77:                     }
78:                 }
79:                 res += ' '.repeat(pendingSpaces);
80:                 output.push(res);
81:             }
82:         }
83:         return {
84:             output: output.join('\n'),
85:             newState: state,
86:             exitCode: 0
87:         };
88:     }
89:     private resolvePath(path: string, state: TerminalState): string {
90:         if (path.startsWith('/')) return path;
91:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
92:     }
93: }
</file>

