 2: import { TokenType } from '../ShellLexer';
 3: import { IStatementParser } from './IStatementParser';
 4: import { IShellParserFacade } from './IShellParserFacade';
 5: export class FunctionDefParser implements IStatementParser {
 6:     canHandle(facade: IShellParserFacade): boolean {
 7:         const t1 = facade.peek(0);
 8:         const t2 = facade.peek(1);
 9:         const t3 = facade.peek(2);
10:         return t1.type === TokenType.WORD &&
11:             t2.type === TokenType.LPAREN &&
12:             t3.type === TokenType.RPAREN;
