16:     { name: '-', func: (args) => makeNumber(args.slice(1).reduce((acc, v) => acc - v.value, args[0].value)) },
17:     { name: '*', func: (args) => makeNumber(args.reduce((acc, v) => acc * v.value, 1)) },
18:     { name: '/', func: (args) => makeNumber(args.slice(1).reduce((acc, v) => acc / v.value, args[0].value)) },
19:     { name: '=', func: (args) => makeBoolean(args.every(v => v.value === args[0].value)) },
20:     { name: '<', func: (args) => makeBoolean(args[0].value < args[1].value) },
21:     { name: '>', func: (args) => makeBoolean(args[0].value > args[1].value) },
22:     { name: '<=', func: (args) => makeBoolean(args[0].value <= args[1].value) },
23:     { name: '>=', func: (args) => makeBoolean(args[0].value >= args[1].value) },
24:     { name: 'abs', func: (args) => makeNumber(Math.abs(args[0].value)) },
25:     { name: 'quotient', func: (args) => makeNumber(Math.trunc(args[0].value / args[1].value)) },
26:     { name: 'remainder', func: (args) => makeNumber(args[0].value % args[1].value) },
27:     {
28:         name: 'modulo', func: (args) => {
29:             const n = args[0].value;
30:             const d = args[1].value;
31:             return makeNumber(((n % d) + d) % d);
32:         }
33:     },
34:     { name: 'max', func: (args) => makeNumber(Math.max(...args.map(a => a.value))) },
35:     { name: 'min', func: (args) => makeNumber(Math.min(...args.map(a => a.value))) },
36:     { name: 'not', func: (args) => makeBoolean(args[0].type === 'boolean' && args[0].value === false) },
37:     { name: 'boolean?', func: (args) => makeBoolean(args[0].type === 'boolean') },
38:     { name: 'cons', func: (args) => makePair(args[0], args[1]) },
39:     {
40:         name: 'car', func: (args) => {
41:             if (args[0].type !== 'pair') throw new Error('car: expected pair');
42:             return args[0].value.car;
43:         }
44:     },
45:     {
46:         name: 'cdr', func: (args) => {
47:             if (args[0].type !== 'pair') throw new Error('cdr: expected pair');
48:             return args[0].value.cdr;
49:         }
50:     },
51:     { name: 'list', func: (args) => args.reduceRight((acc, v) => makePair(v, acc), NIL) },
52:     { name: 'null?', func: (args) => makeBoolean(args[0].type === 'null') },
53:     { name: 'pair?', func: (args) => makeBoolean(args[0].type === 'pair') },
