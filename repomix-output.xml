43:                 continue;
44:             }
45:             let path = target;
46:             if (!target.startsWith('/')) {
47:                 path = state.currentDirectory === '/'
48:                     ? `/${target}`
49:                     : `${state.currentDirectory}/${target}`;
50:             }
51:             if (path.length > 1 && path.endsWith('/')) {
52:                 path = path.slice(0, -1);
53:             }
54:             const existing = fsService.resolve(path);
55:             if (existing) {
56:                 const inode = fsService.getInode(existing.inodeId);
57:                 if (inode) {
58:                     const now = Date.now();
59:                     inode.mtime = now;
60:                     inode.atime = now;
61:                     inode.ctime = now;
62:                 }
63:             } else {
64:                 if (noCreate) {
65:                     continue;
66:                 }
67:                 const lastSlashIndex = path.lastIndexOf('/');
68:                 const parentPath = lastSlashIndex === 0 ? '/' : path.substring(0, lastSlashIndex);
69:                 const parent = fsService.resolve(parentPath);
70:                 if (!parent || !fsService.isDirectory(parent)) {
71:                     output += `touch: cannot touch '${target}': No such file or directory\n`;
72:                     exitCode = 1;
73:                     continue;
74:                 }
75:                 try {
76:                     fsService.writeFile(path, '', 'w');
77:                 } catch (e: any) {
78:                     output += `touch: cannot touch '${target}': ${e.message}\n`;
79:                     exitCode = 1;
80:                 }
81:             }
82:         }
