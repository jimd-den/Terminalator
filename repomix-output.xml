<file path="src/domain/services/scheme/MacroExpander.ts">
  1: import { SchemeValue, schemeToString, listToArray, makePair, NIL } from '../../entities/SchemeValue';
  2: type SyntaxRule = {
  3:     pattern: SchemeValue;
  4:     template: SchemeValue;
  5: };
  6: type MacroTransformer = {
  7:     keywords: string[];
  8:     rules: SyntaxRule[];
  9: };
 10: export class MacroExpander {
 11:     private macros: Map<string, MacroTransformer> = new Map();
 12:     expand(expr: SchemeValue): SchemeValue {
 13:         if (!expr) return expr;
 14:         if (expr.type === 'pair') {
 15:             const head = (expr.value as any).car;
 16:             if (head.type === 'symbol' && head.value === 'define-syntax') {
 17:                 this.registerMacro(expr);
 18:                 return { type: 'symbol', value: '#<void>' };
 19:             }
 20:         }
 21:         if (expr.type === 'pair') {
 22:             const head = (expr.value as any).car;
 23:             if (head.type === 'symbol' && this.macros.has(head.value)) {
 24:                 return this.expandMacroUse(head.value, expr);
 25:             }
 26:             const arr = listToArray(expr);
 27:             const expandedArr = arr.map(e => this.expand(e));
 28:             return expandedArr.reduceRight((acc, v) => makePair(v, acc), NIL);
 29:         }
 30:         return expr;
 31:     }
 32:     private registerMacro(expr: SchemeValue) {
 33:         const arr = listToArray(expr);
 34:         const name = (arr[1] as any).value;
 35:         const transformerSpec = arr[2];
 36:         const specArr = listToArray(transformerSpec);
 37:         if ((specArr[0] as any).value !== 'syntax-rules') {
 38:             throw new Error('Only syntax-rules macros are supported');
 39:         }
 40:         const keywords = listToArray(specArr[1]).map(k => (k as any).value);
 41:         const rules = specArr.slice(2).map(rule => {
 42:             const r = listToArray(rule);
 43:             return {
 44:                 pattern: r[0],
 45:                 template: r[1]
 46:             };
 47:         });
 48:         this.macros.set(name, { keywords, rules });
 49:     }
 50:     private expandMacroUse(name: string, expr: SchemeValue): SchemeValue {
 51:         const transformer = this.macros.get(name)!;
 52:         const use = listToArray(expr);
 53:         for (const rule of transformer.rules) {
 54:             const bindings = this.match(rule.pattern, use, transformer.keywords);
 55:             if (bindings) {
 56:                 const expansion = this.substitute(rule.template, bindings);
 57:                 return this.expand(expansion);
 58:             }
 59:         }
 60:         throw new Error(`No matching syntax-rules for macro '${name}'`);
 61:     }
 62:     private match(pattern: SchemeValue, input: SchemeValue[], keywords: string[]): Map<string, SchemeValue> | null {
 63:         const bindings = new Map<string, SchemeValue>();
 64:         return this.matchRecursive(pattern, { type: 'pair', value: null } , input, bindings, keywords) ? bindings : null;
 65:     }
 66:     private matchRecursive(pat: SchemeValue, input: any, inputArr: SchemeValue[], bindings: Map<string, SchemeValue>, keywords: string[]): boolean {
 67:         const patArr = listToArray(pat);
 68:         if (patArr.length !== inputArr.length) return false;
 69:         for (let i = 0; i < patArr.length; i++) {
 70:             const p = patArr[i];
 71:             const val = inputArr[i];
 72:             if (p.type === 'symbol') {
 73:                 const name = p.value;
 74:                 if (keywords.includes(name) || i === 0) {
 75:                     if (i === 0) continue;
 76:                     if (val.type !== 'symbol' || val.value !== name) return false;
 77:                 } else {
 78:                     bindings.set(name, val);
 79:                 }
 80:             } else if (p.type === 'pair') {
 81:                 if (val.type !== 'pair') return false;
 82:             } else {
 83:                 if (JSON.stringify(p) !== JSON.stringify(val)) return false;
 84:             }
 85:         }
 86:         return true;
 87:     }
 88:     private substitute(template: SchemeValue, bindings: Map<string, SchemeValue>): SchemeValue {
 89:         if (template.type === 'symbol') {
 90:             if (bindings.has(template.value)) {
 91:                 return bindings.get(template.value)!;
 92:             }
 93:             return template;
 94:         }
 95:         if (template.type === 'pair') {
 96:             const arr = listToArray(template);
 97:             const subArr = arr.map(x => this.substitute(x, bindings));
 98:             return subArr.reduceRight((acc, v) => makePair(v, acc), NIL);
 99:         }
100:         return template;
101:     }
102: }
</file>

