168:     const baseText = `COMMAND: ${cleanText}`;
169:     const dotsText = ' . . . . . .';
170:     React.useEffect(() => {
171:         if (isTyped) setStage('final');
172:     }, [isTyped]);
173:     if (!isActive && !isTyped) return null;
174:     return (
175:         <View style={styles.inputLineContainer}>
176:             <View style={{ flex: 1, flexDirection: 'row', alignItems: 'center' }}>
177:                 {stage === 'text' && isActive ? (
178:                     <GhostWriter
179:                         text={baseText}
180:                         speed={20}
181:                         style={styles.inputEchoText}
182:                         isActive={true}
183:                         onComplete={() => setStage('dots')}
184:                     />
185:                 ) : (
186:                     <TextRenderer type="secondary" style={styles.inputEchoText} content={baseText} />
187:                 )}
188:                 {stage === 'dots' && isActive ? (
189:                     <GhostWriter
190:                         text={dotsText}
191:                         speed={120} // Even crunchier, more deliberate dots for mainframe feel
192:                         style={styles.inputEchoText}
193:                         isActive={true}
194:                         onComplete={() => {
195:                             setStage('final');
196:                             onComplete();
197:                         }}
198:                     />
199:                 ) : (stage !== 'text') ? (
200:                     <TextRenderer type="secondary" style={styles.inputEchoText} content={dotsText} />
201:                 ) : null}
202:             </View>
203:             {stage === 'final' && (
204:                 <StatusIndicator
205:                     exitCode={line.exitCode}
206:                     pending={line.pending}
207:                     colors={colors}
208:                     settings={settings}
209:                     onSave={() => onSave(index)}
210:                     onMinimize={() => onMinimize(index)}
211:                     onDelete={() => onDelete(index)}
212:                     isMinimized={line.isMinimized}
213:                 />
214:             )}
