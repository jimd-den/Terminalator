<file path="src/domain/commands/core/NlCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class NlCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         let bodyType = 't';
13:         const files: string[] = [];
14:         for (let i = 0; i < args.length; i++) {
15:             const arg = args[i];
16:             if (arg === '-b') {
17:                 bodyType = args[++i] || 't';
18:             } else if (!arg.startsWith('-')) {
19:                 files.push(arg);
20:             }
21:         }
22:         let content = '';
23:         if (files.length > 0) {
24:             for (const file of files) {
25:                 try {
26:                     content += this.fs.readFile(this.resolvePath(file, state));
27:                 } catch (e) {
28:                     return { output: `nl: ${file}: No such file`, newState: state, exitCode: 1 };
29:                 }
30:             }
31:         } else if (input) {
32:             content = input;
33:         } else {
34:             return { output: '', newState: state, exitCode: 0 };
35:         }
36:         const lines = content.split('\n');
37:         const outputLines: string[] = [];
38:         let lineNum = 1;
39:         for (const line of lines) {
40:             let numberIt = false;
41:             if (bodyType === 'a') numberIt = true;
42:             else if (bodyType === 't' && line.trim() !== '') numberIt = true;
43:             else if (bodyType === 'n') numberIt = false;
44:             if (numberIt) {
45:                 const numStr = lineNum.toString().padStart(6, ' ');
46:                 outputLines.push(`${numStr}  ${line}`);
47:                 lineNum++;
48:             } else {
49:                 outputLines.push(line);
50:             }
51:         }
52:         return {
53:             output: outputLines.join('\n'),
54:             newState: state,
55:             exitCode: 0
56:         };
57:     }
58:     private resolvePath(path: string, state: TerminalState): string {
59:         if (path.startsWith('/')) return path;
60:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
61:     }
62: }
</file>

