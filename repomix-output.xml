 5: export class BlockParser implements IStatementParser {
 6:     canHandle(facade: IShellParserFacade): boolean {
 7:         const token = facade.peek();
 8:         return token.type === TokenType.WORD && token.value === '{';
 9:     }
10:     parse(facade: IShellParserFacade): ASTNode {
11:         facade.advance();
12:         while (facade.peek().type === TokenType.NEWLINE) facade.advance();
13:         const list = facade.parseList();
14:         if (!list) {
15:             throw new Error("Syntax Error: Block cannot be empty");
16:         }
17:         while (facade.peek().type === TokenType.NEWLINE || facade.peek().type === TokenType.SEMI) {
18:             facade.advance();
19:         }
20:         const token = facade.peek();
21:         if (token.type !== TokenType.WORD || token.value !== '}') {
22:             throw new Error(`Syntax Error: Missing closing '}' for block at position ${token.position}`);
23:         }
24:         facade.advance();
25:         return {
26:             type: NodeType.BLOCK,
27:             body: list
28:         } as BlockNode;
29:     }
30: }
