<file path="src/domain/services/shell/executors/ListExecutor.ts">
 1: import { NodeExecutor } from '../NodeExecutor';
 2: import { ASTNode, ListNode, NodeType } from '../../ShellParser';
 3: import { TerminalState } from '../../../entities/TerminalState';
 4: import { CommandResponse } from '../../../entities/Command';
 5: import { mergeState } from '../../../utils/TerminalStateUtils';
 6: export class ListExecutor implements NodeExecutor {
 7:     async execute(
 8:         node: ASTNode,
 9:         state: TerminalState,
10:         visitor: (node: ASTNode, state: TerminalState, stdin?: string) => Promise<CommandResponse>,
11:         stdin?: string
12:     ): Promise<CommandResponse> {
13:         if (node.type !== NodeType.LIST) {
14:             throw new Error('ListExecutor can only handle LIST nodes');
15:         }
16:         const listNode = node as ListNode;
17:         const leftRes = await visitor(listNode.left, state, stdin);
18:         if (leftRes.controlFlow) return leftRes;
19:         let runRight = false;
20:         if (listNode.operator === ';') runRight = true;
21:         else if (listNode.operator === '&&') runRight = (leftRes.exitCode === 0);
22:         else if (listNode.operator === '||') runRight = (leftRes.exitCode !== 0);
23:         if (runRight) {
24:             const effectiveLeftState = mergeState(state, leftRes.newState);
25:             if (leftRes.newState) {
26:                 effectiveLeftState.lastExitCode = leftRes.exitCode;
27:             } else {
28:                 effectiveLeftState.lastExitCode = leftRes.exitCode;
29:             }
30:             const rightRes = await visitor(listNode.right, effectiveLeftState, stdin);
31:             return {
32:                 output: [leftRes.output, rightRes.output].filter(s => s).join(''),
33:                 newState: mergeState(effectiveLeftState, rightRes.newState),
34:                 exitCode: rightRes.exitCode,
35:                 uiAction: rightRes.uiAction || leftRes.uiAction,
36:                 navigationAction: rightRes.navigationAction || leftRes.navigationAction,
37:                 controlFlow: rightRes.controlFlow,
38:                 command: rightRes.command
39:             };
40:         }
41:         return leftRes;
42:     }
