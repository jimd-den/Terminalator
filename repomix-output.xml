 2: export function mergeState(currentState: TerminalState, updates?: Partial<TerminalState>): TerminalState {
 3:     if (!updates) {
 4:         return currentState;
 5:     }
 6:     return { ...currentState, ...updates };
 7: }
 8: export function updateExitCode(state: TerminalState, code: number): TerminalState {
 9:     return { ...state, lastExitCode: code };
10: }
11: export function success(state: TerminalState, output: string = '') {
12:     return {
13:         output,
