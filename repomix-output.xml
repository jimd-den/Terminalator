  4: type CommandType = 'mkdir' | 'touch' | 'rm' | 'cp' | 'mv' | 'ls' | 'cd';
  5: export class CoreCommandGenerator {
  6:     public generate(type?: CommandType): Lesson {
  7:         const cmdType = type || this.getRandomType();
  8:         const id = `CORE_${cmdType.toUpperCase()}_${Date.now().toString(36).substr(-4)}`;
  9:         switch (cmdType) {
 10:             case 'mkdir': return this.genMkdir(id);
 11:             case 'touch': return this.genTouch(id);
 12:             case 'rm': return this.genRm(id);
 13:             case 'cp': return this.genCp(id);
 14:             case 'mv': return this.genMv(id);
 15:             case 'ls': return this.genLs(id);
 16:             case 'cd': return this.genCd(id);
 17:             default: return this.genLs(id);
 18:         }
 19:     }
 20:     private getRandomType(): CommandType {
 21:         const types: CommandType[] = ['mkdir', 'touch', 'rm', 'cp', 'mv', 'ls', 'cd'];
 22:         return types[Math.floor(Math.random() * types.length)];
 23:     }
 24:     private genMkdir(id: string): Lesson {
 25:         const target = `dir_${this.randId()}`;
 26:         return {
 27:             id,
 28:             type: 'SHELL',
 29:             text: `mkdir ${target}`,
 30:             instructions: 'CREATE DIRECTORY:',
 31:             setup: (fs: FileSystem) => {
 32:                 const service = new FileSystemService(fs);
 33:                 const existing = service.resolve(target);
 34:                 if (existing) service.deleteNode(target);
 35:             }
 36:         };
 37:     }
 38:     private genTouch(id: string): Lesson {
 39:         const target = `file_${this.randId()}.txt`;
 40:         return {
 41:             id,
 42:             type: 'SHELL',
 43:             text: `touch ${target}`,
 44:             instructions: 'CREATE EMPTY FILE:',
 45:             setup: (fs: FileSystem) => {
 46:                 const service = new FileSystemService(fs);
 47:                 const existing = service.resolve(target);
 48:                 if (existing) service.deleteNode(target);
 49:             }
 50:         };
 51:     }
 52:     private genRm(id: string): Lesson {
 53:         const target = `junk_${this.randId()}.tmp`;
 54:         return {
 55:             id,
 56:             type: 'SHELL',
 57:             text: `rm ${target}`,
 58:             instructions: 'REMOVE FILE:',
 59:             setup: (fs: FileSystem) => {
 60:                 const service = new FileSystemService(fs);
 61:                 service.writeFile(target, 'garbage content');
 62:             }
 63:         };
 64:     }
 65:     private genCp(id: string): Lesson {
 66:         const src = `data_${this.randId()}.dat`;
 67:         const dest = `backup_${this.randId()}.dat`;
 68:         return {
 69:             id,
 70:             type: 'SHELL',
 71:             text: `cp ${src} ${dest}`,
