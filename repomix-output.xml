220:             letterSpacing: 0.5,
221:             fontFamily: settings.fontFamily,
222:         }
223:     });
224:     const renderCard = (card: ResultCard, isCurrentlyActive: boolean) => {
225:         const isError = card.exitCode !== 0;
226:         const borderColor = isError ? colors.error : colors.primary;
227:         const cardStyle = isCurrentlyActive ? {
228:             transform: [{ translateY: moveAnim.y }, { scale: scaleAnim }],
229:             width: widthAnim,
230:             zIndex: 100,
231:             alignSelf: 'center' as const,
232:             position: 'absolute' as const,
233:             top: 20
234:         } : {
235:             width: '95%' as any,
236:             alignSelf: 'center' as const,
237:         };
238:         const isPreExec = isCurrentlyActive && !isSettling;
239:         return (
240:             <Animated.View key={card.id} style={[dynamicStyles.card, { borderColor }, cardStyle]}>
241:                 <View style={dynamicStyles.cardHeader}>
242:                     <Text style={[dynamicStyles.cardTitle, { color: colors.text.dim }]}>
243:                         {card.hostname}
244:                     </Text>
245:                     <Text style={[dynamicStyles.cardTitle, { color: borderColor }]}>
246:                         {card.exitCode === 0 ? '[ OK ]' : '[ ERR ]'}
247:                     </Text>
248:                 </View>
249:                 <View style={dynamicStyles.mainContent}>
250:                     <MorphingText
251:                         from={card.verb}
252:                         to={`$ ${card.command}`}
253:                         isMorphing={isCurrentlyActive && isSettling}
254:                         isSettled={card.isHistory}
255:                         style={[
256:                             dynamicStyles.contentStyle,
257:                             {
258:                                 color: isPreExec ? colors.primary : colors.secondary,
259:                                 fontSize: isPreExec ? 32 : 16,
260:                                 fontWeight: isPreExec ? '900' : 'bold',
261:                                 letterSpacing: isPreExec ? 8 : 1,
262:                                 textAlign: isPreExec ? 'center' : 'left',
263:                                 width: '100%'
264:                             }
265:                         ]}
266:                     />
267:                 </View>
268:                 {card.isHistory && card.output ? (
269:                     <View style={dynamicStyles.outputContainer}>
270:                         <TypewriterOutput
271:                             text={card.output}
272:                             style={[dynamicStyles.cardOutput, { color: colors.text.primary, fontFamily: settings.fontFamily }]}
273:                         />
274:                     </View>
275:                 ) : null}
276:             </Animated.View>
277:         );
278:     };
279:     return (
280:         <View
281:             style={dynamicStyles.container}
282:             pointerEvents="none"
283:             onLayout={(e) => setContainerHeight(e.nativeEvent.layout.height)}
284:         >
285:             <ScrollView
286:                 ref={scrollRef}
287:                 style={dynamicStyles.scroll}
288:                 contentContainerStyle={dynamicStyles.historyContent}
289:                 onContentSizeChange={() => scrollRef.current?.scrollToEnd({ animated: true })}
290:             >
291:                 {history.map(c => renderCard(c, false))}
292:             </ScrollView>
293:             {activeCard && renderCard(activeCard, true)}
294:         </View>
295:     );
296: };
</file>

