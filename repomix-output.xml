<file path="src/frameworks-drivers/ui/VisualCortex/PerformanceMonitor.ts">
 1: export class PerformanceMonitor {
 2:     private isRunning: boolean = false;
 3:     private lastTime: number = 0;
 4:     private rafId: number | null = null;
 5:     private listeners: (() => void)[] = [];
 6:     private readonly LAG_THRESHOLD_MS = 33.3;
 7:     private readonly DURATION_THRESHOLD_MS = 1000;
 8:     private lowFpsDuration: number = 0;
 9:     start() {
10:         if (this.isRunning) return;
11:         this.isRunning = true;
12:         this.lowFpsDuration = 0;
13:         this.lastTime = performance.now();
14:         this.loop();
15:     }
16:     stop() {
17:         this.isRunning = false;
18:         if (this.rafId !== null) {
19:             cancelAnimationFrame(this.rafId);
20:             this.rafId = null;
21:         }
22:     }
23:     onLagDetected(callback: () => void) {
24:         this.listeners.push(callback);
25:     }
26:     private loop = () => {
27:         if (!this.isRunning) return;
28:         const now = performance.now();
29:         const delta = now - this.lastTime;
30:         if (delta > 0) {
31:             if (delta > this.LAG_THRESHOLD_MS) {
32:                 this.lowFpsDuration += delta;
33:                 if (this.lowFpsDuration > this.DURATION_THRESHOLD_MS) {
34:                     this.notifyListeners();
35:                     this.lowFpsDuration = 0;
36:                 }
37:             } else {
38:                 this.lowFpsDuration = 0;
39:             }
40:         }
41:         this.lastTime = now;
42:         this.rafId = requestAnimationFrame(this.loop);
43:     }
44:     private notifyListeners() {
45:         this.listeners.forEach(cb => cb());
46:     }
47: }
</file>

