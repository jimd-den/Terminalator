19:     private evaluate(args: string[], state: TerminalState): boolean {
20:         // console.log("DEBUG: TestCommand evaluate args:", args);
21:         if (args.length === 0) return false;
22:         // Strip trailing ] if present (invoked as [ ... ])
23:         let evalArgs = args;
24:         if (evalArgs.length > 0 && evalArgs[evalArgs.length - 1] === ']') {
25:             evalArgs = evalArgs.slice(0, -1);
26:         }
27:         // Unary
28:         // Unary
29:         if (evalArgs.length === 2 && evalArgs[0].startsWith('-')) {
30:             const op = evalArgs[0];
31:             const file = evalArgs[1];
32:             try {
33:                 // Resolve path
34:                 const path = state.currentDirectory === '/' ? `/${file}` : `${state.currentDirectory}/${file}`; // Naive resolve
35:                 // TODO: use proper resolvePath helper if available or duplicate logic?
36:                 // I'll duplicate simplified logic for now.
37:                 const node = this.fs.resolve(path);
38:                 switch (op) {
39:                     case '-e': return !!node;
40:                     case '-d':
41:                         if (!node) return false;
42:                         const inode = this.fs.getInode(node.inodeId);
43:                         return !!(inode!.mode & 0o040000);
44:                     case '-f':
45:                         if (!node) return false;
46:                         const inodeF = this.fs.getInode(node.inodeId);
47:                         return !(inodeF!.mode & 0o040000);
48:                     case '-z': return file.length === 0;
49:                     case '-n': return file.length > 0;
50:                 }
51:             } catch (e) {
52:                 return false;
53:             }
54:         }
55:         if (evalArgs.length === 3) {
56:             const a = evalArgs[0];
57:             const op = evalArgs[1];
58:             const b = evalArgs[2];
59:             switch (op) {
60:                 case '=': return a === b;
61:                 case '!=': return a !== b;
62:                 case '-eq': return parseInt(a) === parseInt(b);
63:                 case '-ne': return parseInt(a) !== parseInt(b);
64:                 case '-gt': return parseInt(a) > parseInt(b);
65:                 case '-lt': return parseInt(a) < parseInt(b);
66:             }
67:         }
68:         if (evalArgs.length === 1) {
69:             return evalArgs[0].length > 0;
70:         }
71:         return false;
72:     }
73: }
