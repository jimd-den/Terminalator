  1: import { FileSystemService } from './FileSystemService';
  2: import { Dentry } from '../entities/FileSystem';
  3: import { DirectoryNode } from '../entities/filesystem/DirectoryNode';
  4: export class GlobService {
  5:     constructor(private fs: FileSystemService) { }
  6:     expand(pattern: string, cwd: string): string[] {
  7:         const isAbsolute = pattern.startsWith('/');
  8:         const parts = pattern.split('/').filter(p => p.length > 0);
  9:         const rootPath = isAbsolute ? '/' : cwd;
 10:         let matches: string[] = [];
 11:         if (isAbsolute) {
 12:             matches = this.matchRecursive('/', parts);
 13:         } else {
 14:             matches = this.matchRecursive(cwd, parts, '');
 15:         }
 16:         if (matches.length === 0) {
 17:             return [pattern];
 18:         }
 19:         // 3. Sort matches (POSIX requirement)
 20:         matches.sort((a, b) => a.localeCompare(b));
 21:         return matches;
 22:     }
 23:     private matchRecursive(currentPath: string, parts: string[], accumulatedPath: string = ''): string[] {
 24:         if (parts.length === 0) {
 25:             // End of pattern.
 26:             // If accumulatedPath is empty, it means we matched root? Or nothing?
 27:             // If absolute, accumulatedPath should be the full path.
 28:             // If relative, it should be the relative build up.
 29:             return [accumulatedPath || (currentPath === '/' ? '/' : currentPath)];
 30:         }
 31:         const [head, ...tail] = parts;
 32:         const results: string[] = [];
 33:         // Check if head contains wildcards
 34:         if (!this.hasWildcard(head)) {
 35:             // Literal match
 36:             // Resolve next node
 37:             const nextPath = currentPath === '/' ? `/${head}` : `${currentPath}/${head}`;
 38:             // If relative, accumulation:
 39:             const nextAcc = accumulatedPath ? `${accumulatedPath}/${head}` : (currentPath === '/' ? `/${head}` : head);
 40:             // Wait, logic for accumulation:
 41:             // If we started absolute, accumulatedPath is built as absolute.
 42:             // If we started relative, accumulatedPath starts empty.
 43:             // Adjust nextAcc logic:
 44:             let nextAccumulated = '';
 45:             if (accumulatedPath === '') {
 46:                 // Initial step
 47:                 nextAccumulated = currentPath === '/' ? `/${head}` : head;
 48:                 // Careful: if currentPath is CWD (e.g. /home), and head is 'foo', nextAcc for relative should be 'foo'.
 49:                 if (currentPath !== '/') {
 50:                     nextAccumulated = head;
 51:                 }
 52:             } else {
 53:                 nextAccumulated = `${accumulatedPath}/${head}`;
 54:             }
 55:             const node = this.fs.resolve(nextPath);
 56:             if (node) {
 57:                 if (tail.length === 0) {
 58:                     results.push(nextAccumulated);
 59:                 } else {
 60:                     if (this.fs.isDirectory(node)) {
 61:                         results.push(...this.matchRecursive(nextPath, tail, nextAccumulated));
 62:                     }
 63:                 }
 64:             }
 65:         } else {
 66:             const dirNode = this.fs.resolve(currentPath);
 67:             if (!dirNode || !this.fs.isDirectory(dirNode)) return [];
 68:             const children = Array.from((dirNode as DirectoryNode).children.values());
 69:             for (const child of children) {
 70:                 const name = child.name;
 71:                 if (name.startsWith('.') && !head.startsWith('.')) {
 72:                     continue;
 73:                 }
 74:                 if (this.matchesPattern(name, head)) {
 75:                     const nextPath = currentPath === '/' ? `/${name}` : `${currentPath}/${name}`;
 76:                     let nextAccumulated = '';
 77:                     if (accumulatedPath === '') {
 78:                         if (currentPath !== '/') nextAccumulated = name; // Relative start
 79:                         else nextAccumulated = `/${name}`; // Absolute start
 80:                     } else {
 81:                         nextAccumulated = `${accumulatedPath}/${name}`;
 82:                     }
 83:                     if (tail.length === 0) {
 84:                         results.push(nextAccumulated);
 85:                     } else {
 86:                         if (this.fs.isDirectory(child)) {
 87:                             results.push(...this.matchRecursive(nextPath, tail, nextAccumulated));
 88:                         }
 89:                     }
 90:                 }
 91:             }
 92:         }
 93:         return results;
 94:     }
 95:     private hasWildcard(str: string): boolean {
 96:         return str.includes('*') || str.includes('?') || str.includes('[');
 97:     }
 98:     private matchesPattern(str: string, pattern: string): boolean {
 99:         // Convert POSIX glob pattern to Regex
100:         // Escape regex characters except * ? [ ]
101:         // * -> .*
102:         // ? -> .
103:         // [abc] -> [abc]
104:         // [!abc] -> [^abc]
105:         let regexStr = '^';
106:         let i = 0;
107:         while (i < pattern.length) {
108:             const char = pattern[i];
109:             if (char === '*') {
110:                 regexStr += '.*';
111:                 i++;
112:             } else if (char === '?') {
113:                 regexStr += '.';
114:                 i++;
115:             } else if (char === '[') {
116:                 // Find closing ]
117:                 let j = i + 1;
118:                 // POSIX: "]" can be first char in class: []abc]
119:                 if (j < pattern.length && pattern[j] === ']') j++; // skip first ]
120:                 while (j < pattern.length && pattern[j] !== ']') j++;
121:                 if (j >= pattern.length) {
122:                     // No closing ], treat as literal [
123:                     regexStr += '\\[';
124:                     i++;
125:                 } else {
126:                     let cls = pattern.substring(i, j + 1); // [ ... ]
127:                     // Handle negation ! -> ^
128:                     if (cls.startsWith('[!')) {
129:                         cls = '[^' + cls.substring(2);
130:                     }
131:                     // Escape other regex chars inside class?
132:                     // Generally inside [] regex is similar, but things like \ need care.
133:                     // Simplified: pass direct.
134:                     regexStr += cls;
135:                     i = j + 1;
136:                 }
137:             } else {
138:                 // Escape regex chars
139:                 if (".+^${}()|\\".includes(char)) {
140:                     regexStr += '\\' + char;
141:                 } else {
142:                     regexStr += char;
143:                 }
144:                 i++;
145:             }
146:         }
147:         regexStr += '$';
148:         return new RegExp(regexStr).test(str);
149:     }
150: }
</file>

