 24:         const hub: Location = {
 25:             id: hubId,
 26:             name: this.getHubName(theme),
 27:             type: LocationType.STATION,
 28:             description: this.getHubDescription(theme),
 29:             controllingHost: (owner && owner.name) ? `${owner.name.toLowerCase().replace(' ', '-')}-core` : `core-${Math.floor(random() * 99)}`,
 30:             state: { lights: 'ON', alarm: 'OFF', owner: owner?.id }
 31:         };
