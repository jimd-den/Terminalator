<file path="src/domain/interpreters/LispInterpreter.ts">
 1: import { Interpreter } from './Interpreter';
 2: type LispValue = number | string | LispValue[];
 3: export class LispInterpreter implements Interpreter {
 4:     private globalEnv: Record<string, Function>;
 5:     constructor() {
 6:         this.globalEnv = {
 7:             '+': (args: number[]) => args.reduce((a, b) => a + b, 0),
 8:             '-': (args: number[]) => args.length === 1 ? -args[0] : args.reduce((a, b) => a - b),
 9:             '*': (args: number[]) => args.reduce((a, b) => a * b, 1),
10:             '/': (args: number[]) => args.reduce((a, b) => a / b),
11:             'print': (args: any[]) => args.join(' '),
12:             'concat': (args: string[]) => args.join(''),
13:             'first': (args: any[][]) => args[0][0],
14:             'rest': (args: any[][]) => args[0].slice(1),
15:         };
16:     }
17:     evaluate(code: string): string {
18:         try {
19:             const tokens = this.tokenize(code);
20:             const invalidParentheses = this.checkParentheses(tokens);
21:             if (invalidParentheses) return invalidParentheses;
22:             const ast = this.parse(tokens);
23:             const result = this.evalAst(ast, this.globalEnv);
24:             return result !== undefined && result !== null ? result.toString() : '';
25:         } catch (error: any) {
26:             return `LISP ERROR: ${error.message}`;
27:         }
28:     }
29:     private tokenize(code: string): string[] {
30:         return code
31:             .replace(/\(/g, ' ( ')
32:             .replace(/\)/g, ' ) ')
33:             .trim()
34:             .split(/\s+/)
35:             .filter(t => t.length > 0);
36:     }
37:     private checkParentheses(tokens: string[]): string | null {
38:         let balance = 0;
39:         for (const t of tokens) {
40:             if (t === '(') balance++;
41:             if (t === ')') balance--;
42:             if (balance < 0) return 'LISP ERROR: Unexpected closing parenthesis';
43:         }
44:         if (balance > 0) return 'LISP ERROR: Unclosed parenthesis';
45:         return null;
46:     }
47:     private parse(tokens: string[]): LispValue {
48:         if (tokens.length === 0) throw new Error('Unexpected EOF');
49:         const token = tokens.shift()!;
50:         if (token === '(') {
51:             const list: LispValue[] = [];
52:             while (tokens.length > 0 && tokens[0] !== ')') {
53:                 list.push(this.parse(tokens));
54:             }
55:             tokens.shift();
56:             return list;
57:         } else if (token === ')') {
58:             throw new Error('Unexpected )');
59:         } else {
60:             return this.atom(token);
61:         }
62:     }
63:     private atom(token: string): LispValue {
64:         const num = parseFloat(token);
65:         if (!isNaN(num)) return num;
66:         if (token.startsWith('"') && token.endsWith('"')) return token.slice(1, -1);
67:         return token;
68:     }
69:     private evalAst(ast: LispValue, env: Record<string, any>): any {
70:         if (typeof ast === 'string') {
71:             if (ast.startsWith('"')) return ast;
72:             if (env[ast]) return env[ast];
73:             return ast;
74:         } else if (typeof ast === 'number') {
75:             return ast;
76:         } else if (Array.isArray(ast)) {
77:             if (ast.length === 0) return null;
78:             const [symbol, ...args] = ast;
79:             const fn = this.evalAst(symbol, env);
80:             if (typeof fn === 'function') {
81:                 const evaluatedArgs = args.map(arg => this.evalAst(arg, env));
82:                 return fn(evaluatedArgs);
83:             } else {
84:                 throw new Error(`Function '${symbol}' not found`);
85:             }
86:         }
87:     }
88: }
</file>

<file path="src/domain/interpreters/MissionIntentInterpreter.ts">
 1: import { Mission } from '../entities/Mission';
 2: import { IMissionVisitor } from '../interfaces/IMissionVisitor';
 3: import { MissionMotive, MissionVerb, MissionNoun } from '../entities/mission/Grammar';
 4: export interface MissionIntent {
 5:     motive: string;
 6:     verb: string;
 7:     noun: string;
 8:     primaryUtility: string;
 9:     targetPath: string;
10: }
11: export class MissionIntentInterpreter implements IMissionVisitor<MissionIntent> {
12:     public visit(mission: Mission): MissionIntent {
13:         if (mission.grammar) {
14:             const lastStep = mission.grammar.steps[mission.grammar.steps.length - 1];
15:             return {
16:                 motive: mission.grammar.archetype,
17:                 verb: mission.metadata?.logic?.verb || 'PROCESS',
18:                 noun: mission.metadata?.logic?.noun || 'DATA',
19:                 primaryUtility: lastStep.commandMatcher.target || 'unknown',
20:                 targetPath: mission.objectiveTarget
21:             };
22:         }
23:         const metadata = mission.metadata;
24:         if (metadata && metadata.logic) {
25:             return {
26:                 motive: metadata.logic.motive,
27:                 verb: metadata.logic.verb,
28:                 noun: metadata.logic.noun,
29:                 primaryUtility: metadata.utility,
30:                 targetPath: mission.objectiveTarget
31:             };
32:         }
33:         return {
34:             motive: 'UNKNOWN',
35:             verb: 'ACCESS',
36:             noun: 'SYSTEM',
37:             primaryUtility: 'shell',
38:             targetPath: mission.objectiveTarget
39:         };
40:     }
41: }
</file>

