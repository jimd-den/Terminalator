<file path="src/core/presentation/SimulationMediator.ts">
 1: import { SimulationBus, GameEventType } from '../../domain/services/SimulationBus';
 2: import { PresentationDirector } from '../../domain/services/PresentationDirector';
 3: import { IShellExecutor } from '../../domain/interfaces/IShellExecutor';
 4: import { CommandResponse } from '../../domain/entities/Command';
 5: import { TerminalState } from '../../domain/entities/TerminalState';
 6: export class SimulationMediator {
 7:     constructor(
 8:         private bus: SimulationBus,
 9:         private director: PresentationDirector,
10:         private executor: IShellExecutor
11:     ) {}
12:     public async executeWithTheatre(input: string, state: TerminalState): Promise<CommandResponse> {
13:         if (!input.trim()) {
14:             return { output: '', exitCode: 0, newState: state, command: input };
15:         }
16:         const parts = input.trim().split(/\s+/);
17:         const cmdName = parts[0];
18:         const args = parts.slice(1);
19:         // Fetch Metadata from Command Registry if possible
20:         let verb = cmdName.toUpperCase();
21:         const registry = (this.executor as any).getRegistry?.();
22:         if (registry) {
23:             const cmd = registry.get(cmdName);
24:             if (cmd && cmd.getMetadata) {
25:                 const meta = cmd.getMetadata();
26:                 verb = meta.verb;
27:             }
28:         }
29:         console.log(`[SimulationMediator] Orchestrating execution for: ${cmdName} using verb: ${verb}`);
30:         // 1. Lock Input
31:         this.bus.emit(GameEventType.TUTOR_EVENT, { type: 'THEATRE_ACTIVE' as any, payload: { command: cmdName } });
32:         const preAnimPromise = this.waitForEvent('ANIMATION_COMPLETE');
33:         this.bus.emit(GameEventType.TUTOR_EVENT, {
34:             type: 'PRESENTATION_START' as any,
35:             payload: {
36:                 verb: verb.toUpperCase(),
37:                 command: input,
38:                 args,
39:                 stage: 'PRE'
40:             }
41:         });
42:         await preAnimPromise;
43:         const response = await this.executor.execute(input, state);
44:         this.bus.emit(GameEventType.TUTOR_EVENT, {
45:             type: 'RESULT_CARD' as any,
46:             payload: {
47:                 id: Math.random().toString(36).substring(2, 9),
48:                 command: input,
49:                 output: response.output,
50:                 exitCode: response.exitCode,
51:                 timestamp: Date.now(),
52:                 hostname: response.newState?.fsContext || state.fsContext || 'LOCAL'
53:             }
54:         });
55:         const postAnimPromise = this.waitForEvent('ANIMATION_COMPLETE');
56:         this.bus.emit(GameEventType.TUTOR_EVENT, {
57:             type: 'PRESENTATION_RESULT' as any,
58:             payload: {
59:                 verb,
60:                 command: verb,
61:                 exitCode: response.exitCode,
62:                 stage: 'POST'
63:             }
64:         });
65:         await postAnimPromise;
66:         this.bus.emit(GameEventType.TUTOR_EVENT, { type: 'THEATRE_COMPLETE' as any, payload: { command: cmdName } });
67:         return response;
68:     }
69:     private waitForEvent(targetType: string): Promise<void> {
70:         return new Promise((resolve) => {
71:             const unsub = this.bus.subscribe(GameEventType.TUTOR_EVENT, (event) => {
72:                 if (event.payload.type === targetType) {
73:                     unsub();
74:                     resolve();
75:                 }
76:             });
77:             setTimeout(() => {
78:                 unsub();
79:                 resolve();
80:             }, 5000);
81:         });
82:     }
83: }
</file>

