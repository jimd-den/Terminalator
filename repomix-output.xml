 90:         { key: '▼', label: 'DOWN', action: () => handleKeyPressWrapped('DOWN') },
 91:         { key: 'ENT', label: 'EXEC', action: () => handleKeyPressWrapped('ENTER') },
 92:     ], [handleAction, handleKeyPressWrapped]);
 93:     return {
