<file path="src/domain/commands/core/RmCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { CommandBase } from '../CommandBase';
 3: import { CommandCapability } from '../IStructuredCommand';
 4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse, CommandMetadata } from '../../entities/Command';
 7: import { TheatricalVerb } from '../../services/PresentationDirector';
 8: import { FileSystemService } from '../../services/FileSystemService';
 9: import { DirectoryNode } from '../../entities/filesystem/DirectoryNode';
10: export class RmCommand extends CommandBase {
11:     public readonly capabilities = [CommandCapability.MODIFY];
12:     public readonly utility = 'rm';
13:     constructor(private fsService: FileSystemService) { super(); }
14:     public getMetadata(): CommandMetadata {
15:         return {
16:             verb: TheatricalVerb.PURGE,
17:             style: 'NORMAL'
18:         };
19:     }
20:     executeInternal(args: string[], flags: Set<string>, targets: string[], context: ProcessContext, state: TerminalState): CommandResponse {
21:         const fsService = context.fileSystemService || this.fsService;
22:         const recursive = flags.has('r') || flags.has('R');
23:         const force = flags.has('f');
24:         if (targets.length === 0) {
25:             return {
26:                 output: 'rm: missing operand',
27:                 newState: state,
28:                 exitCode: 1
29:             };
30:         }
31:         for (const target of targets) {
32:             const path = fsService.resolveAbsolutePath(target, state.currentDirectory);
33:             const existing = fsService.resolve(path);
34:             if (!existing) {
35:                 if (force) continue;
36:                 return {
37:                     output: `rm: cannot remove '${target}': No such file or directory`,
38:                     newState: state,
39:                     exitCode: 1
40:                 };
41:             }
42:             if (fsService.isDirectory(existing)) {
43:                 if (!recursive) {
44:                     return {
45:                         output: `rm: cannot remove '${target}': Is a directory`,
46:                         newState: state,
47:                         exitCode: 1
48:                     };
49:                 }
50:                 try {
51:                     this.deleteRecursive(path, fsService);
52:                 } catch (e: any) {
53:                     return {
54:                         output: `rm: cannot remove '${target}': ${e.message}`,
55:                         newState: state,
56:                         exitCode: 1
57:                     };
58:                 }
59:             } else {
60:                 try {
61:                     fsService.deleteNode(path);
62:                 } catch (e: any) {
63:                     return {
64:                         output: `rm: cannot remove '${target}': ${e.message}`,
65:                         newState: state,
66:                         exitCode: 1
67:                     };
68:                 }
69:             }
70:         }
71:         return {
72:             output: '',
73:             newState: state,
74:             exitCode: 0
75:         };
76:     }
77:     private deleteRecursive(path: string, fsService: FileSystemService) {
78:         const node = fsService.resolve(path);
79:         if (!node) return;
80:         if (fsService.isDirectory(node)) {
81:             const children = Array.from((node as DirectoryNode).children.values());
82:             for (const child of children) {
83:                 const childPath = path === '/' ? `/${child.name}` : `${path}/${child.name}`;
84:                 this.deleteRecursive(childPath, fsService);
85:             }
86:         }
87:         fsService.deleteNode(path);
88:     }
89: }
</file>

