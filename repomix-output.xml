 9: export class DuCommand implements ICommand {
10:     constructor(private fs: FileSystemService) { }
11:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
12:         const input = getStdinAsString(context);
13:         const files = args.filter(arg => !arg.startsWith('-'));
14:         if (files.length === 0) {
15:             files.push('.');
16:         }
17:         const report: { size: number, path: string }[] = [];
18:         for (const filename of files) {
19:             let path = filename;
20:             if (path === '.') path = state.currentDirectory;
21:             if (!path.startsWith('/')) {
22:                 path = state.currentDirectory === '/'
23:                     ? `/${filename}`
24:                     : `${state.currentDirectory}/${filename}`;
25:             }
26:             const node = this.fs.resolve(path);
27:             if (!node) {
28:                 return {
29:                     output: `du: cannot access '${filename}': No such file or directory`,
30:                     newState: state,
31:                     exitCode: 1
32:                 };
33:             }
34:             this.traverse(node, path, report, true);
35:         }
36:         const output = report.map(r => `${r.size}\t${r.path}`).join('\n');
37:         return {
38:             output: output,
39:             newState: state,
40:             exitCode: 0
41:         };
42:     }
43:     private traverse(node: Dentry, path: string, report: { size: number, path: string }[], isOperand: boolean): number {
44:         const BLOCK_SIZE = 512;
45:         let sizeBytes = 0;
46:         if (this.fs.isDirectory(node)) {
47:             sizeBytes = 4096;
48:             for (const [name, child] of (node as DirectoryNode).children) {
49:                 const childPath = path === '/' ? `/${name}` : `${path}/${name}`;
50:                 const childSize = this.traverse(child, childPath, report, false);
51:                 sizeBytes += childSize * BLOCK_SIZE;
52:             }
53:         } else {
54:             try {
55:                 const content = this.fs.readFile(path);
56:                 sizeBytes = content.length;
57:             } catch (e) {
58:                 sizeBytes = 0;
59:             }
60:         }
61:         const blocks = Math.ceil(sizeBytes / BLOCK_SIZE);
62:         if (this.fs.isDirectory(node) || isOperand) {
63:             report.push({ size: blocks, path: path });
64:         }
65:         return blocks;
66:     }
67: }
