<file path="src/domain/commands/core/OdCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class OdCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         const files: string[] = [];
13:         for (const arg of args) {
14:             if (!arg.startsWith('-')) files.push(arg);
15:         }
16:         let content = '';
17:         if (files.length > 0) {
18:             try {
19:                 content = this.fs.readFile(this.resolvePath(files[0], state));
20:             } catch (e) {
21:                 return { output: `od: ${files[0]}: No such file`, newState: state, exitCode: 1 };
22:             }
23:         } else if (input) {
24:             content = input;
25:         } else {
26:             return { output: '', newState: state, exitCode: 0 };
27:         }
28:         // Default format: -t o2 (octal 2-byte units)
29:         // Simplified: output bytes in octal.
30:         // Address (octal)   Data (octal)
31:         // 0000000           061141 000143 ...
32:         let output = '';
33:         let offset = 0;
34:         const chunkSize = 16;
35:         for (let i = 0; i < content.length; i += chunkSize) {
36:             // Address
37:             output += offset.toString(8).padStart(7, '0') + ' ';
38:             const chunk = content.slice(i, i + chunkSize);
39:             for (let j = 0; j < chunk.length; j += 2) {
40:                 let val = 0;
41:                 const b1 = chunk.charCodeAt(j);
42:                 const b2 = j + 1 < chunk.length ? chunk.charCodeAt(j + 1) : 0;
43:                 val = (b2 << 8) | b1;
44:                 if (j + 1 >= chunk.length) val = b1;
45:                 output += val.toString(8).padStart(6, '0') + ' ';
46:             }
47:             output += '\n';
48:             offset += chunkSize;
49:         }
50:         output += offset.toString(8).padStart(7, '0');
51:         return {
52:             output: output,
53:             newState: state,
54:             exitCode: 0
55:         };
56:     }
57:     private resolvePath(path: string, state: TerminalState): string {
58:         if (path.startsWith('/')) return path;
59:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
60:     }
61: }
</file>

<file path="src/domain/commands/core/PasteCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { TerminalState } from '../../entities/TerminalState';
 5: import { CommandResponse } from '../../entities/Command';
 6: import { FileSystemService } from '../../services/FileSystemService';
 7: export class PasteCommand implements ICommand {
 8:     constructor(private fs: FileSystemService) { }
 9:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
10:         const input = getStdinAsString(context);
11:         let delimiter = '\t';
12:         let serial = false;
13:         const files: string[] = [];
14:         let skipNext = false;
15:         for (let i = 0; i < args.length; i++) {
16:             if (skipNext) {
17:                 skipNext = false;
18:                 continue;
19:             }
20:             const arg = args[i];
21:             if (arg === '-d') {
22:                 if (i + 1 < args.length) {
23:                     delimiter = args[i + 1];
24:                     delimiter = delimiter
25:                         .replace(/\\t/g, '\t')
26:                         .replace(/\\n/g, '\n')
27:                         .replace(/\\\\/g, '\\');
28:                     skipNext = true;
29:                 }
30:             } else if (arg === '-s') {
31:                 serial = true;
32:             } else if (!arg.startsWith('-')) {
33:                 files.push(arg);
34:             }
35:         }
36:         if (files.length === 0) {
37:             return { output: '', newState: state, exitCode: 0 };
38:         }
39:         const fileContents: string[][] = [];
40:         try {
41:             for (const file of files) {
42:                 if (file === '-') {
43:                     fileContents.push((input || '').split('\n'));
44:                 } else {
45:                     const path = this.resolvePath(file, state);
46:                     const content = this.fs.readFile(path);
47:                     const lines = content.split('\n');
48:                     if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();
49:                     fileContents.push(lines);
50:                 }
51:             }
52:         } catch (e) {
53:             return {
54:                 output: `paste: No such file or directory`,
55:                 newState: state,
56:                 exitCode: 1
57:             };
58:         }
59:         const output: string[] = [];
60:         const getDelim = (idx: number) => {
61:             if (delimiter.length === 0) return '';
62:             return delimiter[idx % delimiter.length];
63:         };
64:         if (serial) {
65:             for (const lines of fileContents) {
66:                 let lineStr = '';
67:                 for (let k = 0; k < lines.length; k++) {
68:                     if (k > 0) lineStr += getDelim(k - 1);
69:                     lineStr += lines[k];
70:                 }
71:                 output.push(lineStr);
72:             }
73:         } else {
74:             let maxLines = 0;
75:             for (const lines of fileContents) maxLines = Math.max(maxLines, lines.length);
76:             for (let i = 0; i < maxLines; i++) {
77:                 let rowStr = '';
78:                 for (let j = 0; j < fileContents.length; j++) {
79:                     const lines = fileContents[j];
80:                     if (j > 0) rowStr += getDelim(j - 1);
81:                     rowStr += (i < lines.length ? lines[i] : '');
82:                 }
83:                 output.push(rowStr);
84:             }
85:         }
86:         return {
87:             output: output.join('\n'),
88:             newState: state,
89:             exitCode: 0
90:         };
91:     }
92:     private resolvePath(path: string, state: TerminalState): string {
93:         if (path.startsWith('/')) return path;
94:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
95:     }
96: }
</file>

