 4: import { TerminalState } from '../../entities/TerminalState';
 5: import { FileSystemService } from '../../services/FileSystemService';
 6: export class FuserCommand implements ICommand {
 7:     constructor(private fs: FileSystemService) { }
 8:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 9:         const input = getStdinAsString(context);
10:         const files: string[] = [];
11:         let kill = false;
12:         let silent = false;
13:         let user = false;
14:         for (let i = 0; i < args.length; i++) {
15:             const arg = args[i];
16:             if (arg === '-k') {
17:                 kill = true;
18:             } else if (arg === '-u') {
19:                 user = true;
20:             } else if (arg === '-c') {
21:             } else if (arg === '-s') {
22:                 if (i + 1 < args.length && /^\d+$/.test(args[i + 1])) {
23:                     i++;
24:                 } else {
25:                     silent = true;
26:                 }
27:             } else if (!arg.startsWith('-')) {
28:                 files.push(arg);
29:             }
30:         }
31:         if (files.length === 0) {
32:             return { output: 'fuser: missing operand', newState: state, exitCode: 1 };
33:         }
34:         let output = '';
35:         const mockPid = '1234';
36:         for (const file of files) {
37:             const dentry = this.fs.resolve(file, state.currentDirectory);
38:             if (!dentry) return { output: `fuser: ${file}: No such file or directory`, newState: state, exitCode: 1 };
39:             if (!silent) {
40:                 if (user) {
41:                     output += `${file}:  ${mockPid}(operator)\n`;
42:                 } else {
43:                     output += `${file}:  ${mockPid}\n`;
44:                 }
45:             }
46:         }
47:         return { output: silent ? '' : output, newState: state, exitCode: 0 };
48:     }
49: }
</file>

