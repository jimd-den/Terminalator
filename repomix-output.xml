11:         const input = getStdinAsString(context);
12:         if (args.length === 0) {
13:             const lines: string[] = [];
14:             for (const [key, val] of Object.entries(state.aliases)) {
15:                 lines.push(`${key}=${val}`);
16:             }
17:             return {
18:                 output: lines.join('\n'),
19:                 newState: state,
20:                 exitCode: 0
21:             };
22:         }
23:         const newState = { ...state, aliases: { ...state.aliases } };
