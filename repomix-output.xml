<file path="src/interface-adapters/vim/highlighters/SchemeHighlighter.ts">
 1: import { SyntaxHighlighter, HighlightToken } from '../../../domain/ports/SyntaxHighlighter';
 2: export class SchemeHighlighter implements SyntaxHighlighter {
 3:     readonly language = 'scheme';
 4:     highlight(line: string): HighlightToken[] {
 5:         const tokens: HighlightToken[] = [];
 6:         let remaining = line;
 7:         const keywords = [
 8:             'define', 'lambda', 'if', 'quote', 'set!', 'begin', 'cond', 'else',
 9:             'let', 'let*', 'letrec', 'and', 'or', 'not', 'cons', 'car', 'cdr',
10:             'list', 'null?', 'pair?', 'display'
11:         ];
12:         while (remaining.length > 0) {
13:             const commentMatch = remaining.match(/^;.*/);
14:             if (commentMatch) {
15:                 tokens.push({ text: commentMatch[0], type: 'comment' });
16:                 break;
17:             }
18:             const stringMatch = remaining.match(/^".*?"/);
19:             if (stringMatch) {
20:                 tokens.push({ text: stringMatch[0], type: 'string' });
21:                 remaining = remaining.slice(stringMatch[0].length);
22:                 continue;
23:             }
24:             const numberMatch = remaining.match(/^-?\d+(\.\d+)?/);
25:             if (numberMatch && !remaining[numberMatch[0].length]?.match(/[a-zA-Z]/)) {
26:                 tokens.push({ text: numberMatch[0], type: 'number' });
27:                 remaining = remaining.slice(numberMatch[0].length);
28:                 continue;
29:             }
30:             const parenMatch = remaining.match(/^[()]/);
31:             if (parenMatch) {
32:                 tokens.push({ text: parenMatch[0], type: 'operator' });
33:                 remaining = remaining.slice(1);
34:                 continue;
35:             }
36:             const wordMatch = remaining.match(/^[a-zA-Z0-9+\-*/<=>?!]+/);
37:             if (wordMatch) {
38:                 const word = wordMatch[0];
39:                 if (keywords.includes(word)) {
40:                     tokens.push({ text: word, type: 'keyword' });
41:                 } else {
42:                     tokens.push({ text: word, type: 'plain' });
43:                 }
44:                 remaining = remaining.slice(word.length);
45:                 continue;
46:             }
47:             const wsMatch = remaining.match(/^\s+/);
48:             if (wsMatch) {
49:                 tokens.push({ text: wsMatch[0], type: 'plain' });
50:                 remaining = remaining.slice(wsMatch[0].length);
51:                 continue;
52:             }
53:             tokens.push({ text: remaining[0], type: 'plain' });
54:             remaining = remaining.slice(1);
55:         }
56:         return tokens;
57:     }
58: }
</file>

<file path="src/interface-adapters/vim/highlighters/TypescriptHighlighter.ts">
 1: import { SyntaxHighlighter, HighlightToken } from '../../../domain/ports/SyntaxHighlighter';
 2: export class TypescriptHighlighter implements SyntaxHighlighter {
 3:     readonly language = 'typescript';
 4:     private readonly keywords = new Set([
 5:         'import', 'from', 'export', 'class', 'interface', 'const', 'let', 'var',
 6:         'async', 'await', 'return', 'if', 'else', 'for', 'while', 'switch', 'case',
 7:         'default', 'try', 'catch', 'finally', 'new', 'this', 'private', 'protected',
 8:         'public', 'static', 'readonly', 'type', 'of', 'in', 'extends', 'implements'
 9:     ]);
10:     highlight(line: string): HighlightToken[] {
11:         if (!line) return [];
12:         const tokens: HighlightToken[] = [];
13:         let current = '';
14:         let i = 0;
15:         while (i < line.length) {
16:             const char = line[i];
17:             // String Literals
18:             if (char === '"' || char === "'" || char === '`') {
19:                 const quote = char;
20:                 let str = char;
21:                 i++;
22:                 while (i < line.length && line[i] !== quote) {
23:                     if (line[i] === '\\' && i + 1 < line.length) {
24:                         str += line[i] + line[i + 1];
25:                         i += 2;
26:                     } else {
27:                         str += line[i];
28:                         i++;
29:                     }
30:                 }
31:                 if (i < line.length) {
32:                     str += line[i];
33:                     i++;
34:                 }
35:                 tokens.push({ text: str, type: 'string' });
36:                 continue;
37:             }
38:             if (char === '/' && i + 1 < line.length && line[i + 1] === '/') {
39:                 tokens.push({ text: line.slice(i), type: 'comment' });
40:                 break;
41:             }
42:             if (/[a-zA-Z0-9_$]/.test(char)) {
43:                 let word = '';
44:                 while (i < line.length && /[a-zA-Z0-9_$]/.test(line[i])) {
45:                     word += line[i];
46:                     i++;
47:                 }
48:                 if (this.keywords.has(word)) {
49:                     tokens.push({ text: word, type: 'keyword' });
50:                 } else if (/^[0-9]+$/.test(word)) {
51:                     tokens.push({ text: word, type: 'number' });
52:                 } else {
53:                     tokens.push({ text: word, type: 'plain' });
54:                 }
55:                 continue;
56:             }
57:             tokens.push({ text: char, type: 'operator' });
58:             i++;
59:         }
60:         return tokens;
61:     }
62: }
</file>

