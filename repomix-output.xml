42:                 exitCode: 1
43:             };
44:         }
45:         const content = this.fs.readFile(absPath);
46:         if (context.executor) {
47:             let sourcedState = {
48:                 ...state,
49:                 callStackDepth: (state.callStackDepth || 0) + 1
50:             };
51:             if (args.length > 1) {
52:                 const newEnv = { ...state.environment };
53:                 for (let i = 1; i <= 9; i++) {
54:                     delete newEnv[i.toString()];
55:                 }
56:                 for (let i = 1; i < args.length; i++) {
57:                     newEnv[i.toString()] = args[i];
58:                 }
59:                 newEnv['#'] = (args.length - 1).toString();
60:                 const paramArgs = args.slice(1);
61:                 newEnv['@'] = paramArgs.join(' ');
62:                 newEnv['*'] = paramArgs.join(' ');
63:                 sourcedState = { ...sourcedState, environment: newEnv };
64:             }
65:             const response = await context.executor.execute(content, sourcedState);
66:             if (response.controlFlow === 'RETURN') {
67:                 return {
68:                     ...response,
69:                     controlFlow: undefined
70:                 };
71:             }
72:             return response;
73:         }
74:         return {
75:             output: '.: executor not available',
