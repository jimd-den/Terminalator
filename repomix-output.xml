 35:     const [containerHeight, setContainerHeight] = useState(0);
 36:     const [isInitialized, setIsInitialized] = useState(false);
 37:     const boxScale = useSharedValue(0);
 38:     const glyphOpacity = useSharedValue(1);
 39:     const feedbackVal = useSharedValue(0);
 40:     const multiplierScale = useSharedValue(0);
 41:     const cleanup = () => {
 42:         setIsActive(false);
 43:         setIsCountdown(false);
 44:         setSummary(null);
 45:         setStreak(0);
 46:         setDisplayZinc(0);
 47:         setBaseZinc(0);
 48:         setHashRate(0);
 49:         setLessonText('');
 50:         setProgressIndex(0);
 51:         setFeedback('NONE');
 52:         releaseFocus('rhythm-hud');
 53:     };
 54:     const boxStyle = useAnimatedStyle(() => {
 55:         const baseScale = boxScale.value;
 56:         const layoutScale = (containerHeight > 0 && containerHeight < 350) ? containerHeight / 400 : 1;
 57:         return {
 58:             transform: [{ scale: baseScale * layoutScale }],
 59:         };
