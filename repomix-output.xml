<file path="src/domain/utils/NameGenerator.ts">
 1: const CORPORATE_PREFIXES = ['OMNI', 'CYBER', 'NEXUS', 'GLOBAL', 'DATA', 'TECH', 'SYNERGY', 'VORTEX'];
 2: const CORPORATE_SUFFIXES = ['CORP', 'SYS', 'NET', 'DYNAMICS', 'LOGIC', 'WARE', 'SOFT', 'COM'];
 3: const MILITARY_PREFIXES = ['SEC', 'CMD', 'TAC', 'STRAT', 'DEF', 'OPS', 'NAV', 'BASE'];
 4: const MILITARY_SUFFIXES = ['HQ', 'OUTPOST', 'BUNKER', 'GRID', 'ALPHA', 'BRAVO', 'ZULU'];
 5: const FILE_TYPES = ['conf', 'log', 'dat', 'bin', 'enc', 'bak'];
 6: const FILE_NAMES = ['manifest', 'payload', 'access', 'security', 'users', 'passwords', 'protocol', 'schema'];
 7: export function generateHostname(faction: string = 'corporate'): string {
 8:     const prefixes = faction === 'military' ? MILITARY_PREFIXES : CORPORATE_PREFIXES;
 9:     const suffixes = faction === 'military' ? MILITARY_SUFFIXES : CORPORATE_SUFFIXES;
10:     const prefix = prefixes[Math.floor(Math.random() * prefixes.length)];
11:     const suffix = suffixes[Math.floor(Math.random() * suffixes.length)];
