364:                             <TextRenderer style={styles.cardHeaderText} content="[ DATA_NODES_STREAM ]" />
365:                         </View>
366:                         <View style={styles.cardBody}>
367:                             <View style={styles.fishLsContainer}>
368:                                 {items.map((item, i) => {
369:                                     const symbol = item.type === 'dir' ? '◆' : '◻';
370:                                     const label = `${symbol} ${item.name}`;
371:                                     if (isStatic) {
