10:         this.constructorLogic = new SentenceConstructor();
11:     }
12:     public generateAdvice(
13:         intent: TutorIntent,
14:         tone: TutorToneProfile,
15:         mission: Mission,
16:         lastCommand?: string
17:     ): TutorAction {
18:         const currentStep = mission.grammar?.steps.find(s => s.id === mission.currentStepId);
19:         const requiredToolName = currentStep?.lessonText?.split(' ')[0];
20:         const toolDef = requiredToolName ? this.kb.getCommand(requiredToolName) : undefined;
21:         let message = '';
22:         if (intent === TutorIntent.NUDGE_PROGRESSION && currentStep) {
23:             // Generative Nudge using SentenceConstructor
24:             if (toolDef) {
25:                 const capability = toolDef.capabilities[0].toLowerCase();
26:                 const action = `utilizing '${toolDef.name}'`;
27:                 const reason = `${capability} the data stream via '${toolDef.name}' to ${currentStep.description}`;
28:                 message = this.constructorLogic.constructImperative(action, reason, tone);
29:             } else {
30:                 message = this.constructorLogic.constructImperative("proceeding", currentStep.description, tone);
31:             }
32:         } else if (intent === TutorIntent.REPRIMAND_MISTAKE && lastCommand) {
33:             // Generative Critique
34:             message = this.constructorLogic.constructCritique(`The command '${lastCommand}' failed to advance the state`, tone);
35:         } else if (intent === TutorIntent.SYSTEM_BOOT) {
36:             // Generative Welcome
37:             message = this.constructorLogic.constructGreeting(tone);
38:         } else if (intent === TutorIntent.MISSION_BRIEFING) {
39:             // Generative Briefing
40:             const verb = mission.metadata?.logic?.verb || 'ACCESS';
41:             const noun = mission.metadata?.logic?.noun || 'DATA';
42:             message = this.constructorLogic.constructBriefing(verb, noun, mission.targetSystem, tone);
43:         } else if (intent === TutorIntent.IDLE_OBSERVATION) {
44:             message = this.constructorLogic.constructIdle(tone);
45:         } else if (intent === TutorIntent.RHYTHM_REPORT) {
46:             message = this.constructorLogic.constructRhythmFeedback(tone, 'FAST');
47:         } else if (intent === TutorIntent.ACCURACY_CRITIQUE) {
48:             message = this.constructorLogic.constructAccuracyFeedback(tone);
49:         } else if (intent === TutorIntent.INPUT_PROGRESS) {
50:             message = this.constructorLogic.constructInputProgress(tone);
51:         } else {
52:             message = this.styleMessage(tone, "Proceed with caution.");
53:         }
54:         return {
55:             missionId: mission.id,
56:             type: 'HINT',
57:             message,
58:             confidence: 1.0,
59:             severity: 'INFO'
