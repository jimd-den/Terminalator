  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { ICommand } from '../ICommand';
  3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  4: import { TerminalState } from '../../entities/TerminalState';
  5: import { CommandResponse } from '../../entities/Command';
  6: import { FileSystemService } from '../../services/FileSystemService';
  7: import { Dentry, S_IFDIR, S_IFREG, S_IFLNK } from '../../entities/FileSystem';
  8: import { DirectoryNode } from '../../entities/filesystem/DirectoryNode';
  9: interface Predicate {
 10:     evaluate(node: Dentry, path: string, fs: FileSystemService, context: ProcessContext, state: TerminalState, outputBuffer: string[]): Promise<boolean>;
 11:     isAction(): boolean;
 12:     type?: string;
 13:     value?: any;
 14: }
 15: export class FindCommand implements ICommand {
 16:     constructor(private fs: FileSystemService) { }
 17:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 18:         let paths: string[] = [];
 19:         let predicates: Predicate[] = [];
 20:         let expressionIndex = -1;
 21:         for (let i = 0; i < args.length; i++) {
 22:             if (args[i].startsWith('-')) {
 23:                 expressionIndex = i;
 24:                 break;
 25:             }
 26:             paths.push(args[i]);
 27:         }
 28:         if (expressionIndex === -1 && paths.length > 0) {
 29:         } else if (expressionIndex === 0) {
 30:             paths = ['.'];
 31:             expressionIndex = 0;
 32:         } else if (expressionIndex === -1 && paths.length === 0) {
 33:             paths = ['.'];
 34:         }
 35:         if (paths.length === 0) paths.push('.');
 36:         if (expressionIndex !== -1) {
 37:             for (let i = expressionIndex; i < args.length; i++) {
 38:                 const arg = args[i];
 39:                 if (arg === '-name') {
 40:                     if (i + 1 >= args.length) return this.error('missing argument to `-name`', state);
 41:                     const pattern = args[++i];
 42:                     predicates.push({
 43:                         evaluate: async (node) => {
 44:                             const regexStr = '^' + pattern.replace(/\./g, '\\.').replace(/\*/g, '.*').replace(/\?/g, '.') + '$';
 45:                             return new RegExp(regexStr).test(node.name);
 46:                         },
 47:                         isAction: () => false
 48:                     });
 49:                 } else if (arg === '-maxdepth') {
 50:                     if (i + 1 >= args.length) return this.error('missing argument to `-maxdepth`', state);
 51:                     const depth = parseInt(args[++i], 10);
 52:                     if (isNaN(depth)) return this.error('invalid argument to `-maxdepth`', state);
 53:                     predicates.push({
 54:                         evaluate: async () => true,
 55:                         isAction: () => false,
 56:                         type: 'maxdepth',
 57:                         value: depth
 58:                     });
 59:                 } else if (arg === '-type') {
 60:                     if (i + 1 >= args.length) return this.error('missing argument to `-type`', state);
 61:                     const type = args[++i];
 62:                     predicates.push({
 63:                         evaluate: async (node) => {
 64:                             const inode = this.fs.getInode(node.inodeId);
 65:                             if (!inode) return false;
 66:                             if (type === 'f') return (inode.mode & S_IFREG) !== 0;
 67:                             if (type === 'd') return (inode.mode & S_IFDIR) !== 0;
 68:                             if (type === 'l') return (inode.mode & S_IFLNK) !== 0;
 69:                             return false;
 70:                         },
 71:                         isAction: () => false
 72:                     });
 73:                 } else if (arg === '-print') {
 74:                     predicates.push({
 75:                         evaluate: async () => true,
 76:                         isAction: () => true,
 77:                         type: 'print'
 78:                     });
 79:                 } else if (arg === '-prune') {
 80:                     predicates.push({
 81:                         evaluate: async () => true,
 82:                         isAction: () => false,
 83:                         type: 'prune'
 84:                     });
 85:                 } else if (arg === '-exec') {
 86:                     const execArgs: string[] = [];
 87:                     i++;
 88:                     while (i < args.length) {
 89:                         if (args[i] === ';' || args[i] === '\\;') break;
 90:                         execArgs.push(args[i]);
 91:                         i++;
 92:                     }
 93:                     predicates.push({
 94:                         evaluate: async (node, path, fs, ctx, st, outBuf) => {
 95:                             const cmdArgs = execArgs.map(a => {
 96:                                 const val = a === '{}' ? path : a.replace(/{}/g, path);
 97:                                 return `'${val.replace(/'/g, "'\"'\"'")}'`;
 98:                             });
 99:                             const cmdLine = cmdArgs.join(' ');
100:                             if (!ctx.executor) return false;
101:                             const res = await ctx.executor.execute(cmdLine, st);
102:                             if (res.output) outBuf.push(res.output);
103:                             return res.exitCode === 0;
104:                         },
105:                         isAction: () => true,
106:                         type: 'exec'
107:                     });
108:                 } else {
109:                     return this.error(`unknown predicate \`${arg}\``, state);
110:                 }
111:             }
112:         }
113:         if (!predicates.some(p => p.isAction())) {
114:             predicates.push({
115:                 evaluate: async () => true,
116:                 isAction: () => true,
117:                 type: 'print'
118:             });
119:         }
120:         const results: string[] = [];
121:         let maxDepth = Infinity;
122:         const depthPred = predicates.find(p => p.type === 'maxdepth');
123:         if (depthPred && depthPred.value !== undefined) maxDepth = depthPred.value;
124:         for (const path of paths) {
125:             let startPath = path;
126:             if (!startPath.startsWith('/')) {
127:                 startPath = state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
128:             }
129:             const node = this.fs.resolve(startPath);
130:             if (!node) return this.error(`\`${path}\`: No such file or directory`, state);
131:             await this.traverse(node, path, predicates, results, context, state, 0, maxDepth);
132:         }
133:         return {
134:             output: results.join('\n'),
135:             newState: state,
136:             exitCode: 0
137:         };
138:     }
139:     private error(msg: string, state: TerminalState): CommandResponse {
140:         return { output: `find: ${msg}`, newState: state, exitCode: 1 };
141:     }
142:     private async traverse(
143:         node: Dentry,
144:         currentPath: string,
145:         predicates: Predicate[],
146:         output: string[],
147:         context: ProcessContext,
148:         state: TerminalState,
149:         currentDepth: number,
150:         maxDepth: number
151:     ) {
152:         if (currentDepth > maxDepth) return;
153:         let keepGoing = true;
154:         let pruned = false;
155:         for (const p of predicates) {
156:             if (!keepGoing) break;
157:             const res = await p.evaluate(node, currentPath, this.fs, context, state, output);
158:             if (p.type === 'prune' && res) pruned = true;
159:             if (p.type === 'print' && res) {
160:                 output.push(currentPath);
161:             }
162:             if (!res) keepGoing = false;
163:         }
164:         if (pruned) return;
165:         if (this.fs.isDirectory(node) && currentDepth < maxDepth) {
166:             const dirNode = node as DirectoryNode;
167:             const children = Array.from(dirNode.children.entries()).sort((a, b) => a[0].localeCompare(b[0]));
168:             for (const [name, child] of children) {
169:                 let childPath = currentPath.endsWith('/') ? `${currentPath}${name}` : `${currentPath}/${name}`;
170:                 if (currentPath === '/') childPath = `/${name}`;
171:                 await this.traverse(child, childPath, predicates, output, context, state, currentDepth + 1, maxDepth);
172:             }
173:         }
174:     }
175: }
</file>

