152:         const parentPath = absPath.substring(0, absPath.lastIndexOf('/')) || '/';
153:         const name = absPath.substring(absPath.lastIndexOf('/') + 1);
154:         const parent = this.resolve(parentPath, cwd, true);
155:         if (!parent || !parent.isDirectory()) throw new Error(`Cannot create symlink '${linkPath}': Parent not found`);
156:         const parentDir = parent as DirectoryNode;
157:         if (parentDir.getChild(name)) throw new Error('File exists');
158:         const inode = this.fs.inodeTable.allocate(S_IFLNK | 0o777, uid, gid);
159:         const newNode = new FileNode(name, inode.id, parentDir);
160:         parentDir.addChild(newNode);
