<file path="src/domain/usecases/asm/AsmChecker.ts">
 1: import { SyntaxChecker, SyntaxError } from '../../ports/SyntaxChecker';
 2: export class AsmChecker implements SyntaxChecker {
 3:     readonly language = 'asm';
 4:     private validMnemonics = new Set([
 5:         'add', 'sub', 'addi', 'lw', 'sw', 'beq', 'bne', 'jal', 'ecall',
 6:         'li', 'mv', 'nop', 'la'
 7:     ]);
 8:     private validDirectives = new Set([
 9:         '.string', '.word'
10:     ]);
11:     private registerRegex = /^(x\d+|zero|ra|sp|gp|tp|t[0-6]|s[0-1]1|s[0-9]|fp|a[0-7])$/i;
12:     check(source: string): SyntaxError[] {
13:         const errors: SyntaxError[] = [];
14:         const lines = source.split('\n');
15:         lines.forEach((line, index) => {
16:             const trimmedLine = line.split(';')[0].trim();
17:             if (!trimmedLine) return;
18:             let activeLine = trimmedLine;
19:             const labelMatch = activeLine.match(/^([a-zA-Z_][a-zA-Z0-9_]*):(.*)$/);
20:             if (labelMatch) {
21:                 activeLine = labelMatch[2].trim();
22:                 if (!activeLine) return;
23:             }
24:             if (activeLine.startsWith('.')) {
25:                 const parts = activeLine.split(/\s+/);
26:                 if (!this.validDirectives.has(parts[0].toLowerCase())) {
27:                     errors.push({
28:                         line: index + 1,
29:                         column: trimmedLine.indexOf(parts[0]) + 1,
30:                         message: `Unknown directive: ${parts[0]}`,
31:                         severity: 'error'
32:                     });
33:                 }
34:                 return;
35:             }
36:             const parts = activeLine.split(/[,\s]+/).filter(p => p.length > 0);
37:             const mnemonic = parts[0].toLowerCase();
38:             if (!this.validMnemonics.has(mnemonic)) {
39:                 errors.push({
40:                     line: index + 1,
41:                     column: trimmedLine.indexOf(parts[0]) + 1,
42:                     message: `Unknown mnemonic: ${parts[0]}`,
43:                     severity: 'error'
44:                 });
45:                 return;
46:             }
47:             if (['add', 'sub', 'addi', 'lw', 'sw', 'beq', 'bne', 'jal', 'li', 'mv', 'la'].includes(mnemonic)) {
48:                 for (let i = 1; i < parts.length; i++) {
49:                     const arg = parts[i];
50:                     let canBeLabel = false;
51:                     if (mnemonic === 'jal' && i === 2) canBeLabel = true;
52:                     if ((mnemonic === 'beq' || mnemonic === 'bne') && i === 3) canBeLabel = true;
53:                     if (mnemonic === 'la' && i === 2) canBeLabel = true;
54:                     if (/^-?\d+$/.test(arg)) continue;
55:                     if (arg.includes('(')) {
56:                         const regMatch = arg.match(/\((.*)\)/);
57:                         if (regMatch && !this.registerRegex.test(regMatch[1])) {
58:                             errors.push({
59:                                 line: index + 1,
60:                                 column: trimmedLine.indexOf(arg) + 1,
61:                                 message: `Invalid register in memory access: ${regMatch[1]}`,
62:                                 severity: 'error'
63:                             });
64:                         }
65:                         continue;
66:                     }
67:                     if (canBeLabel && this.isProbablyLabel(arg)) continue;
68:                     if (!this.registerRegex.test(arg)) {
69:                         errors.push({
70:                             line: index + 1,
71:                             column: trimmedLine.indexOf(arg) + 1,
72:                             message: `Invalid register or operand: ${arg}`,
73:                             severity: 'error'
74:                         });
75:                     }
76:                 }
77:             }
78:         });
79:         return errors;
80:     }
81:     private isProbablyLabel(arg: string): boolean {
82:         return /[a-zA-Z]/.test(arg) && !this.registerRegex.test(arg);
83:     }
84: }
</file>

<file path="src/domain/usecases/asm/Assembler.ts">
  1: import { Instruction, Opcode, makeInstruction, Funct3 } from '../../entities/asm/Instruction';
  2: export class Assembler {
  3:     private labels: Map<string, number> = new Map();
  4:     assemble(source: string): { program: Instruction[], memory: Uint8Array, labels: Map<string, number> } {
  5:         const rawLines = source.split('\n').map(l => l.split(';')[0].trim()).filter(l => l.length > 0);
  6:         this.labels.clear();
  7:         const memory = new Uint8Array(64 * 1024);
  8:         let currentAddr = 0;
  9:         const codeLines: { line: string, addr: number }[] = [];
 10:         const dataDirectives: { directive: string, addr: number }[] = [];
 11:         for (const line of rawLines) {
 12:             let activeLine = line;
 13:             const labelMatch = activeLine.match(/^([a-zA-Z_][a-zA-Z0-9_]*):(.*)$/);
 14:             if (labelMatch) {
 15:                 this.labels.set(labelMatch[1], currentAddr);
 16:                 activeLine = labelMatch[2].trim();
 17:             }
 18:             if (!activeLine) continue;
 19:             if (activeLine.startsWith('.')) {
 20:                 dataDirectives.push({ directive: activeLine, addr: currentAddr });
 21:                 if (activeLine.startsWith('.string')) {
 22:                     const str = activeLine.match(/"(.*)"/)?.[1] || '';
 23:                     currentAddr += str.length + 1;
 24:                 } else if (activeLine.startsWith('.word')) {
 25:                     currentAddr += 4;
 26:                 }
 27:             } else {
 28:                 codeLines.push({ line: activeLine, addr: currentAddr });
 29:                 currentAddr += 4;
 30:             }
 31:         }
 32:         const program: Instruction[] = [];
 33:         for (const { directive, addr } of dataDirectives) {
 34:             if (directive.startsWith('.string')) {
 35:                 const str = directive.match(/"(.*)"/)?.[1] || '';
 36:                 for (let i = 0; i < str.length; i++) {
 37:                     memory[addr + i] = str.charCodeAt(i);
 38:                 }
 39:                 memory[addr + str.length] = 0; // null terminator
 40:             } else if (directive.startsWith('.word')) {
 41:                 const val = parseInt(directive.split(/\s+/)[1]);
 42:                 memory[addr] = val & 0xFF;
 43:                 memory[addr + 1] = (val >> 8) & 0xFF;
 44:                 memory[addr + 2] = (val >> 16) & 0xFF;
 45:                 memory[addr + 3] = (val >> 24) & 0xFF;
 46:             }
 47:         }
 48:         for (const { line, addr } of codeLines) {
 49:             program.push(this.parseLine(line, addr));
 50:         }
 51:         return { program, memory, labels: this.labels };
 52:     }
 53:     private parseLine(line: string, address: number): Instruction {
 54:         const parts = line.split(/[,\s]+/).filter(p => p.length > 0);
 55:         const mnemonic = parts[0].toLowerCase();
 56:         switch (mnemonic) {
 57:             case 'li': {
 58:                 const rd = this.regToIndex(parts[1]);
 59:                 const imm = parseInt(parts[2]);
 60:                 return makeInstruction('addi', Opcode.OP_IMM, address, { rd, rs1: 0, imm, funct3: Funct3.ADD_SUB });
 61:             }
 62:             case 'mv': {
 63:                 const rd = this.regToIndex(parts[1]);
 64:                 const rs1 = this.regToIndex(parts[2]);
 65:                 return makeInstruction('addi', Opcode.OP_IMM, address, { rd, rs1, imm: 0, funct3: Funct3.ADD_SUB });
 66:             }
 67:             case 'nop': {
 68:                 return makeInstruction('addi', Opcode.OP_IMM, address, { rd: 0, rs1: 0, imm: 0, funct3: Funct3.ADD_SUB });
 69:             }
 70:             case 'add': {
 71:                 return this.makeROp(mnemonic, Opcode.OP, Funct3.ADD_SUB, 0x00, parts, address);
 72:             }
 73:             case 'sub': {
 74:                 return this.makeROp(mnemonic, Opcode.OP, Funct3.ADD_SUB, 0x20, parts, address);
 75:             }
 76:             case 'addi': {
 77:                 return this.makeIOp(mnemonic, Opcode.OP_IMM, Funct3.ADD_SUB, parts, address);
 78:             }
 79:             case 'lw': {
 80:                 const rd = this.regToIndex(parts[1]);
 81:                 const memMatch = parts[2].match(/(-?\d+)\((.*)\)/);
 82:                 if (!memMatch) throw new Error(`Invalid lw syntax: ${line}`);
 83:                 const imm = parseInt(memMatch[1]);
 84:                 const rs1 = this.regToIndex(memMatch[2]);
 85:                 return makeInstruction(mnemonic, Opcode.LOAD, address, { rd, rs1, imm, funct3: Funct3.W });
 86:             }
 87:             case 'sw': {
 88:                 const rs2 = this.regToIndex(parts[1]);
 89:                 const memMatch = parts[2].match(/(-?\d+)\((.*)\)/);
 90:                 if (!memMatch) throw new Error(`Invalid sw syntax: ${line}`);
 91:                 const imm = parseInt(memMatch[1]);
 92:                 const rs1 = this.regToIndex(memMatch[2]);
 93:                 return makeInstruction(mnemonic, Opcode.STORE, address, { rs1, rs2, imm, funct3: Funct3.W });
 94:             }
 95:             case 'beq': {
 96:                 return this.makeBOp(mnemonic, Opcode.BRANCH, Funct3.BEQ, parts, address);
 97:             }
 98:             case 'bne': {
 99:                 return this.makeBOp(mnemonic, Opcode.BRANCH, Funct3.BNE, parts, address);
100:             }
101:             case 'jal': {
102:                 const rd = this.regToIndex(parts[1]);
103:                 const label = parts[2];
104:                 return makeInstruction(mnemonic, Opcode.JAL, address, { rd, label });
105:             }
106:             case 'la': {
107:                 const rd = this.regToIndex(parts[1]);
108:                 const label = parts[2];
109:                 const addr = this.labels.get(label) || 0;
110:                 return makeInstruction('addi', Opcode.OP_IMM, address, { rd, rs1: 0, imm: addr, funct3: Funct3.ADD_SUB });
111:             }
112:             case 'ecall': {
113:                 return makeInstruction(mnemonic, Opcode.SYSTEM, address, {});
114:             }
115:             default:
116:                 return makeInstruction(mnemonic, Opcode.UNKNOWN, address, {});
117:         }
118:     }
119:     private regToIndex(name: string): number {
120:         const n = name.toLowerCase();
121:         if (n.startsWith('x')) return parseInt(n.slice(1));
122:         const regMap: Record<string, number> = {
123:             'zero': 0, 'ra': 1, 'sp': 2, 'gp': 3, 'tp': 4, 't0': 5, 't1': 6, 't2': 7,
124:             's0': 8, 'fp': 8, 's1': 9, 'a0': 10, 'a1': 11, 'a2': 12, 'a3': 13, 'a4': 14, 'a5': 15,
125:             'a6': 16, 'a7': 17, 's2': 18, 's3': 19, 's4': 20, 's5': 21, 's6': 22, 's7': 23,
126:             's8': 24, 's9': 25, 's10': 26, 's11': 27, 't3': 28, 't4': 29, 't5': 30, 't6': 31
127:         };
128:         if (regMap[n] !== undefined) return regMap[n];
129:         throw new Error(`Unknown register: ${name}`);
130:     }
131:     private makeROp(mnemonic: string, opcode: Opcode, f3: number, f7: number, parts: string[], address: number): Instruction {
132:         return makeInstruction(mnemonic, opcode, address, {
133:             rd: this.regToIndex(parts[1]),
134:             rs1: this.regToIndex(parts[2]),
135:             rs2: this.regToIndex(parts[3]),
136:             funct3: f3,
137:             funct7: f7
138:         });
139:     }
140:     private makeIOp(mnemonic: string, opcode: Opcode, f3: number, parts: string[], address: number): Instruction {
141:         return makeInstruction(mnemonic, opcode, address, {
142:             rd: this.regToIndex(parts[1]),
143:             rs1: this.regToIndex(parts[2]),
144:             imm: parseInt(parts[3]),
145:             funct3: f3
146:         });
147:     }
148:     private makeBOp(mnemonic: string, opcode: Opcode, f3: number, parts: string[], address: number): Instruction {
149:         return makeInstruction(mnemonic, opcode, address, {
150:             rs1: this.regToIndex(parts[1]),
151:             rs2: this.regToIndex(parts[2]),
152:             label: parts[3],
153:             funct3: f3
154:         });
155:     }
156: }
</file>

<file path="src/domain/usecases/asm/RISCVInterpreter.ts">
  1: import { CpuState } from '../../entities/asm/CpuState';
  2: import { Instruction, Opcode, Funct3 } from '../../entities/asm/Instruction';
  3: import { SimulationBus, GameEventType, RegisterModifiedPayload } from '../../services/SimulationBus';
  4: export interface InterpreterOutput {
  5:     stdout: string;
  6:     exitCode: number;
  7:     instructionCount: number;
  8: }
  9: export class RISCVInterpreter {
 10:     private stdout: string[] = [];
 11:     private instructionCount: number = 0;
 12:     constructor(private bus?: SimulationBus) {}
 13:     run(program: Instruction[], memory: Uint8Array, state: CpuState, labels: Map<string, number>): InterpreterOutput {
 14:         this.stdout = [];
 15:         this.instructionCount = 0;
 16:         state.reset();
 17:         state.loadMemory(memory);
 18:         if (labels.has('main')) {
 19:             state.pc = labels.get('main')!;
 20:         } else if (labels.has('start')) {
 21:             state.pc = labels.get('start')!;
 22:         }
 23:         return this.runWithMap(this.buildInstructionMap(program), memory, state, labels);
 24:     }
 25:     private buildInstructionMap(program: Instruction[]): Map<number, Instruction> {
 26:         const map = new Map<number, Instruction>();
 27:         for (const instr of program) {
 28:             map.set(instr.address, instr);
 29:         }
 30:         return map;
 31:     }
 32:     private runWithMap(instrMap: Map<number, Instruction>, memory: Uint8Array, state: CpuState, labels: Map<string, number>): InterpreterOutput {
 33:         while (!state.isHalted) {
 34:             this.instructionCount++;
 35:             const instruction = instrMap.get(state.pc);
 36:             if (!instruction) {
 37:                 if (state.pc >= 64 * 1024) break;
 38:                 state.pc += 4;
 39:                 continue;
 40:             }
 41:             this.execute(instruction, state, labels);
 42:         }
 43:         return {
 44:             stdout: this.stdout.join(''),
 45:             exitCode: state.exitCode,
 46:             instructionCount: this.instructionCount
 47:         };
 48:     }
 49:     private execute(instr: Instruction, state: CpuState, labels: Map<string, number>): void {
 50:         let nextPc = state.pc + 4;
 51:         const mnemonic = instr.mnemonic || 'unknown';
 52:         switch (instr.opcode) {
 53:             case Opcode.OP_IMM: {
 54:                 const rs1Val = state.getRegister(instr.rs1!);
 55:                 const imm = instr.imm!;
 56:                 if (instr.funct3 === Funct3.ADD_SUB) {
 57:                     this.setRegister(state, instr.rd!, rs1Val + imm, mnemonic);
 58:                 } else if (instr.funct3 === Funct3.AND) {
 59:                     this.setRegister(state, instr.rd!, rs1Val & imm, mnemonic);
 60:                 } else if (instr.funct3 === Funct3.OR) {
 61:                     this.setRegister(state, instr.rd!, rs1Val | imm, mnemonic);
 62:                 }
 63:                 break;
 64:             }
 65:             case Opcode.OP: {
 66:                 const rs1Val = state.getRegister(instr.rs1!);
 67:                 const rs2Val = state.getRegister(instr.rs2!);
 68:                 if (instr.funct3 === Funct3.ADD_SUB) {
 69:                     if (instr.funct7 === 0x00) {
 70:                         this.setRegister(state, instr.rd!, rs1Val + rs2Val, mnemonic);
 71:                     } else if (instr.funct7 === 0x20) {
 72:                         this.setRegister(state, instr.rd!, rs1Val - rs2Val, mnemonic);
 73:                     }
 74:                 }
 75:                 break;
 76:             }
 77:             case Opcode.BRANCH: {
 78:                 const rs1Val = state.getRegister(instr.rs1!);
 79:                 const rs2Val = state.getRegister(instr.rs2!);
 80:                 let takeBranch = false;
 81:                 if (instr.funct3 === Funct3.BEQ) takeBranch = rs1Val === rs2Val;
 82:                 else if (instr.funct3 === Funct3.BNE) takeBranch = rs1Val !== rs2Val;
 83:                 if (takeBranch && instr.label) {
 84:                     const target = labels.get(instr.label);
 85:                     if (target !== undefined) {
 86:                         nextPc = target;
 87:                     }
 88:                 }
 89:                 break;
 90:             }
 91:             case Opcode.JAL: {
 92:                 this.setRegister(state, instr.rd!, state.pc + 4, mnemonic);
 93:                 if (instr.label) {
 94:                     const target = labels.get(instr.label);
 95:                     if (target !== undefined) {
 96:                         nextPc = target;
 97:                     }
 98:                 }
 99:                 break;
100:             }
101:             case Opcode.LOAD: {
102:                 const base = state.getRegister(instr.rs1!);
103:                 const addr = base + instr.imm!;
104:                 if (instr.funct3 === Funct3.W) {
105:                     this.setRegister(state, instr.rd!, state.readWord(addr), mnemonic);
106:                 }
107:                 break;
108:             }
109:             case Opcode.STORE: {
110:                 const base = state.getRegister(instr.rs1!);
111:                 const rs2Val = state.getRegister(instr.rs2!);
112:                 const addr = base + instr.imm!;
113:                 if (instr.funct3 === Funct3.W) {
114:                     state.writeWord(addr, rs2Val);
115:                 }
116:                 break;
117:             }
118:             case Opcode.SYSTEM: {
119:                 this.handleSyscall(state);
120:                 break;
121:             }
122:             default:
123:                 break;
124:         }
125:         state.pc = nextPc;
126:     }
127:     private setRegister(state: CpuState, rd: number, value: number, instruction?: string): void {
128:         const oldValue = state.getRegister(rd);
129:         state.setRegister(rd, value);
130:         if (this.bus) {
131:             const payload: RegisterModifiedPayload = {
132:                 register: `x${rd}`,
133:                 oldValue,
134:                 newValue: value,
135:                 instruction
136:             };
137:             this.bus.emit(GameEventType.REGISTER_MODIFIED, payload);
138:         }
139:     }
140:     private handleSyscall(state: CpuState): void {
141:         const syscallId = state.getRegister(17);
142:         switch (syscallId) {
143:             case 1:
144:                 this.stdout.push(String(state.getRegister(10)));
145:                 break;
146:             case 4:
147:                 let addr = state.getRegister(10);
148:                 let str = "";
149:                 while (true) {
150:                     const char = state.readByte(addr++);
151:                     if (char === 0) break;
152:                     str += String.fromCharCode(char);
153:                 }
154:                 this.stdout.push(str);
155:                 break;
156:             case 10:
157:                 state.isHalted = true;
158:                 state.exitCode = state.getRegister(10);
159:                 break;
160:             case 11:
161:                 this.stdout.push(String.fromCharCode(state.getRegister(10)));
162:                 break;
163:             default:
164:                 this.stdout.push(`\n[VM] Unknown ecall: ${syscallId}\n`);
165:                 state.isHalted = true;
166:                 break;
167:         }
168:     }
169: }
</file>

<file path="src/domain/usecases/mission/ConstraintMissionFactory.ts">
  1: import { UnixKnowledgeBase } from '../../services/knowledge/UnixKnowledgeBase';
  2: import { ConstraintSolver, SolvedStep } from '../../services/knowledge/ConstraintSolver';
  3: import { CommandCapability } from '../../entities/knowledge/UnixCommandDefinition';
  4: import { Mission, MissionStep } from '../../entities/Mission';
  5: import { MissionGrammar, StepRule } from '../../entities/mission/MissionGrammar';
  6: import { GameEventType } from '../../services/SimulationBus';
  7: import { SystemPreparationSpec } from '../../entities/world/SystemPreparationSpec';
  8: import { WorldPatchService } from '../../services/world/WorldPatchService';
  9: export interface ProblemDefinition {
 10:     objective: string;
 11:     capabilities: CommandCapability[];
 12:     constraints: string[];
 13:     targetSystem: string;
 14: }
 15: export class ConstraintMissionFactory {
 16:     private solver: ConstraintSolver;
 17:     constructor(
 18:         private kb: UnixKnowledgeBase,
 19:         private worldPatchService: WorldPatchService
 20:     ) {
 21:         this.solver = new ConstraintSolver(kb);
 22:     }
 23:     public createMission(problem: ProblemDefinition): Mission {
 24:         const solution = this.solver.solveChain(problem.capabilities, problem.constraints);
 25:         if (solution.length === 0) {
 26:             throw new Error(`Unsolvable problem: ${problem.objective}`);
 27:         }
 28:         const id = `M-GEN-${Math.floor(Math.random() * 10000)}`;
 29:         const grammar = this.generateGrammarFromChain(id, solution, problem);
 30:         const prepSpec = this.generatePrepSpec(problem);
 31:         this.worldPatchService.patch(prepSpec);
 32:         const primaryTool = solution[solution.length - 1].tool;
 33:         return {
 34:             id,
 35:             type: 'generative',
 36:             targetSystem: problem.targetSystem,
 37:             targetUser: 'admin',
 38:             objectiveTarget: '/var/data/target',
 39:             description: `MISSION: ${problem.objective}. SOLUTION HINT: Use ${primaryTool}.`,
 40:             reward: '2500 Credits',
 41:             status: 'pending',
 42:             currentStep: MissionStep.PENDING,
 43:             currentStepId: grammar.initialStepId,
 44:             grammar,
 45:             assignedBy: 'system',
 46:             assignerName: 'THE GRID',
 47:             chatHistory: [],
 48:             metadata: {
 49:                 prepSpec
 50:             }
 51:         };
 52:     }
 53:     private generateGrammarFromChain(id: string, chain: SolvedStep[], problem: ProblemDefinition): MissionGrammar {
 54:         const steps: StepRule[] = [];
 55:         steps.push({
 56:             id: 'step1',
 57:             stepType: 'CONNECT',
 58:             description: `Connect to ${problem.targetSystem}`,
 59:             lessonText: `ssh admin@${problem.targetSystem}`,
 60:             commandMatcher: { type: GameEventType.COMMAND_EXECUTED, target: 'ssh', ruleKey: 'SUCCESS_EXIT' },
 61:             onComplete: { nextStepId: 'step2', tutorIntent: 'LINK_ESTABLISHED' }
 62:         });
 63:         steps.push({
 64:             id: 'step2',
 65:             stepType: 'LOCATE',
 66:             description: `Navigate to /var/data`,
 67:             lessonText: `cd /var/data`,
 68:             commandMatcher: { type: GameEventType.COMMAND_EXECUTED, target: 'cd', ruleKey: 'DIR_MATCH' },
 69:             onComplete: { nextStepId: 'step3', tutorIntent: 'FILE_LOCATED' }
 70:         });
 71:         const lastStep = chain[chain.length - 1];
 72:         const flagStr = lastStep.flags.join(' ');
 73:         const cmdString = `${lastStep.tool} ${flagStr} target`.trim();
 74:         steps.push({
 75:             id: 'step3',
 76:             stepType: 'MODIFY',
 77:             description: `Execute: ${cmdString}`,
 78:             lessonText: cmdString,
 79:             cwdPattern: '/var/data',
 80:             commandMatcher: {
 81:                 type: GameEventType.COMMAND_EXECUTED,
 82:                 target: lastStep.tool,
 83:                 ruleKey: 'SUCCESS_EXIT'
 84:             },
 85:             onComplete: { tutorIntent: 'MISSION_ACCOMPLISHED' }
 86:         });
 87:         return {
 88:             archetype: 'CONSTRAINT_SOLVER',
 89:             initialStepId: 'step1',
 90:             steps
 91:         };
 92:     }
 93:     private solveFlags(tool: any, constraints: string[]): string[] {
 94:         const flags: string[] = [];
 95:         constraints.forEach(c => {
 96:             const flag = tool.flags.find((f: any) => f.effect === c);
 97:             if (flag) flags.push(flag.name);
 98:         });
 99:         return flags;
100:     }
101:     private generatePrepSpec(problem: ProblemDefinition): SystemPreparationSpec {
102:         return {
103:             hostname: problem.targetSystem,
104:             requiredDirs: ['/home/admin', '/var/data'],
105:             files: [
106:                 {
107:                     path: '/var/data/target',
108:                     rawContent: `TARGET DATA FOR ${problem.objective}`,
109:                     mode: 0o644
110:                 }
111:             ],
112:             logs: []
113:         };
114:     }
115: }
