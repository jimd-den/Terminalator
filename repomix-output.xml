10: export class TopologyGenerator {
11:     public generateStar(rng: () => number, size: number): Topology {
12:         const rootId = 'node_hub';
13:         const nodes: TopologyNode[] = [{ id: rootId, type: 'HUB', connections: [] }];
14:         for (let i = 0; i < size; i++) {
15:             const nodeId = `node_${i}`;
16:             const node: TopologyNode = { id: nodeId, type: 'ROOM', connections: [rootId] };
17:             nodes.push(node);
18:             nodes[0].connections.push(nodeId);
19:         }
20:         return { nodes, rootId };
21:     }
22:     public generateLinear(rng: () => number, size: number): Topology {
23:         const rootId = 'node_0';
24:         const nodes: TopologyNode[] = [];
25:         for (let i = 0; i < size; i++) {
26:             const nodeId = `node_${i}`;
27:             const connections: string[] = [];
28:             if (i > 0) connections.push(`node_${i-1}`);
29:             if (i < size - 1) connections.push(`node_${i+1}`);
30:             nodes.push({ id: nodeId, type: 'ROOM', connections });
31:         }
32:         return { nodes, rootId };
33:     }
