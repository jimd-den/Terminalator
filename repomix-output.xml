 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { TerminalState } from '../../entities/TerminalState';
 5: import { CommandResponse } from '../../entities/Command';
 6: import { FileSystemService } from '../../services/FileSystemService';
 7: export class CksumCommand implements ICommand {
 8:     constructor(private fs: FileSystemService) { }
 9:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
10:         const input = getStdinAsString(context);
11:         const files = args.filter(a => !a.startsWith('-'));
12:         if (files.length === 0 && !input) {
13:             if (input) {
14:                 const crc = this.crc32(input);
15:                 const size = input.length;
16:                 return {
17:                     output: `${crc} ${size}`,
18:                     newState: state,
19:                     exitCode: 0
20:                 };
21:             }
22:             return { output: '', newState: state, exitCode: 0 };
23:         }
24:         const lines: string[] = [];
25:         for (const file of files) {
26:             try {
27:                 const content = this.fs.readFile(this.resolvePath(file, state));
28:                 const crc = this.crc32(content);
29:                 const size = content.length;
30:                 lines.push(`${crc} ${size} ${file}`);
31:             } catch (e) {
32:                 return { output: `cksum: ${file}: No such file or directory`, newState: state, exitCode: 1 };
33:             }
34:         }
35:         return {
36:             output: lines.join('\n'),
37:             newState: state,
38:             exitCode: 0
39:         };
40:     }
41:     private resolvePath(path: string, state: TerminalState): string {
42:         if (path.startsWith('/')) return path;
43:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
44:     }
45:     private crc32(str: string): number {
46:         const table = this.makeCRCTable();
47:         let crc = 0;
48:         crc = 0 ^ (-1);
49:         for (let i = 0; i < str.length; i++) {
50:             crc = (crc >>> 8) ^ table[(crc ^ str.charCodeAt(i)) & 0xFF];
51:         }
52:         return (crc ^ (-1)) >>> 0;
53:     }
54:     private makeCRCTable(): number[] {
55:         let c;
56:         const crcTable: number[] = [];
57:         for (let n = 0; n < 256; n++) {
58:             c = n;
59:             for (let k = 0; k < 8; k++) {
60:                 c = ((c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1));
61:             }
62:             crcTable[n] = c;
63:         }
64:         return crcTable;
65:     }
66: }
</file>

