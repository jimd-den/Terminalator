  6: import { CommandResponse } from '../../entities/Command';
  7: import { FileSystemService } from '../../services/FileSystemService';
  8: import { SedParser, SedVM, SedState } from '../../services/SedEngine';
  9: export class SedCommand extends CommandBase {
 10:     public readonly capabilities = [CommandCapability.FILTER, CommandCapability.TRANSFORM];
 11:     public readonly utility = 'sed';
 12:     constructor(private fs: FileSystemService) {
 13:         super();
 14:     }
 15:     protected override parseArgs(args: string[]) {
 16:         super.parseArgs(args, ['e', 'f']);
 17:     }
 18:     protected async executeInternal(
 19:         rawArgs: string[],
 20:         flags: Set<string>,
 21:         operands: string[],
 22:         context: ProcessContext,
 23:         state: TerminalState
 24:     ): Promise<CommandResponse> {
 25:         const input = getStdinAsString(context);
 26:         const scripts: string[] = [];
 27:         const files: string[] = [];
 28:         const suppressAutoPrint = flags.has('n');
 29:         const ereMode = flags.has('E');
 30:         const inPlace = flags.has('i');
 31:         const eOptions = this.options.get('e');
 32:         if (eOptions) scripts.push(eOptions);
 33:         const fOptions = this.options.get('f');
 34:         if (fOptions) {
 35:             try {
 36:                 scripts.push(this.fs.readFile(this.resolvePath(fOptions, state)));
 37:             } catch (e) {
 38:                 return { output: `sed: cannot read script file ${fOptions}`, newState: state, exitCode: 1 };
 39:             }
 40:         }
 41:         let opIndex = 0;
 42:         if (scripts.length === 0 && operands.length > 0) {
 43:             scripts.push(operands[opIndex++]);
 44:         }
 45:         while (opIndex < operands.length) {
 46:             files.push(operands[opIndex++]);
 47:         }
 48:         if (scripts.length === 0) {
 49:             return { output: 'sed: missing script', newState: state, exitCode: 1 };
 50:         }
 51:         let instructions;
 52:         try {
 53:             instructions = SedParser.parse(scripts.join('\n'), ereMode);
 54:         } catch (e: any) {
 55:             return { output: `sed: ${e.message}`, newState: state, exitCode: 1 };
 56:         }
 57:         const processContent = (content: string) => {
 58:             const lines = content.split('\n');
 59:             const hasTrailingNewline = content.endsWith('\n');
 60:             if (lines.length > 0 && lines[lines.length - 1] === '') lines.pop();
 61:             let sedState: SedState = {
 62:                 patternSpace: '',
 63:                 holdSpace: '',
 64:                 lineNumber: 0,
 65:                 isLastLine: false,
 66:                 deleted: false,
 67:                 printed: [],
 68:                 nextCycle: false,
 69:                 quit: false,
 70:                 substSuccess: false,
 71:                 rangeActive: [],
 72:                 rangeEnding: [],
 73:                 insertBuffer: [],
 74:                 appendBuffer: [],
 75:                 lines: lines,
 76:                 currentIndex: 0,
 77:                 suppressAutoPrint: suppressAutoPrint
 78:             };
 79:             const resultLines: string[] = [];
 80:             for (let j = 0; j < lines.length; j++) {
 81:                 sedState.currentIndex = j;
 82:                 sedState.patternSpace = lines[j];
 83:                 sedState.lineNumber = j + 1;
 84:                 sedState.isLastLine = (j === lines.length - 1);
 85:                 sedState.substSuccess = false;
 86:                 sedState.printed = [];
 87:                 sedState = SedVM.execute(instructions, sedState);
 88:                 for (const il of sedState.insertBuffer) resultLines.push(il);
 89:                 for (const pl of sedState.printed) resultLines.push(pl);
 90:                 if (!sedState.deleted) {
 91:                     if (!suppressAutoPrint) resultLines.push(sedState.patternSpace);
 92:                 }
 93:                 for (const al of sedState.appendBuffer) resultLines.push(al);
 94:                 j = sedState.currentIndex;
 95:                 if (sedState.quit) break;
 96:             }
 97:             let result = resultLines.join('\n');
 98:             if (result.length > 0 || hasTrailingNewline) result += '\n';
 99:             return result;
100:         };
101:         if (files.length === 0) {
102:             if (input !== undefined) {
103:                 return { output: processContent(input), newState: state, exitCode: 0 };
104:             }
105:             return { output: '', newState: state, exitCode: 0 };
106:         }
107:         let totalOutput = '';
108:         for (const filename of files) {
109:             const path = this.resolvePath(filename, state);
110:             try {
111:                 const content = this.fs.readFile(path);
112:                 const result = processContent(content);
113:                 if (inPlace) {
114:                     this.fs.writeFile(path, result, 'w');
115:                 } else {
116:                     totalOutput += result;
117:                 }
118:             } catch (e: any) {
119:                 return { output: `sed: ${filename}: ${e.message}`, newState: state, exitCode: 1 };
120:             }
121:         }
122:         return {
123:             output: totalOutput,
124:             newState: state,
125:             exitCode: 0
126:         };
127:     }
128:     private resolvePath(filename: string, state: TerminalState): string {
129:         if (filename.startsWith('/')) return filename;
130:         return state.currentDirectory === '/' ? `/${filename}` : `${state.currentDirectory}/${filename}`;
131:     }
132: }
</file>

