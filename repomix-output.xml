<file path="src/domain/usecases/vim/modes/InsertMode.ts">
 1: import { IVimMode } from '../IVimMode';
 2: import { IVimState } from '../../../entities/vim/IVimState';
 3: import { IVimBuffer } from '../../../entities/vim/IVimBuffer';
 4: import { VimCommandManager } from '../VimCommandManager';
 5: export class InsertMode implements IVimMode {
 6:     readonly name = 'INSERT';
 7:     handleKey(
 8:         key: string,
 9:         state: IVimState,
10:         buffer: IVimBuffer,
11:         commands: VimCommandManager
12:     ): string | null {
13:         if (key === 'ESC') {
14:             return 'NORMAL';
15:         }
16:         if (key === 'BACKSPACE') {
17:             this.handleBackspace(state, buffer, commands);
18:         } else if (key === 'ENTER' || key === '\n' || key === '\r') {
19:             this.handleEnter(state, buffer, commands);
20:         } else if (key.length === 1) {
21:             commands.insertChar(key, state.cursor.line, state.cursor.col);
22:             state.cursor.col++;
23:         }
24:         return null;
25:     }
26:     private handleBackspace(state: IVimState, buffer: IVimBuffer, commands: VimCommandManager): void {
27:         if (state.cursor.col > 0) {
28:             commands.deleteChar(state.cursor.line, state.cursor.col - 1);
29:             state.cursor.col--;
30:         } else if (state.cursor.line > 0) {
31:             const prevLineIdx = state.cursor.line - 1;
32:             const prevLineLen = buffer.getLine(prevLineIdx).length;
33:             buffer.joinLines(prevLineIdx);
34:             state.cursor.line = prevLineIdx;
35:             state.cursor.col = prevLineLen;
36:         }
37:     }
38:     private handleEnter(state: IVimState, buffer: IVimBuffer, commands: VimCommandManager): void {
39:         buffer.splitLine(state.cursor.line, state.cursor.col);
40:         state.cursor.line++;
41:         state.cursor.col = 0;
42:     }
43: }
</file>

<file path="src/domain/usecases/vim/modes/NormalMode.ts">
  1: import { IVimMode } from '../IVimMode';
  2: import { IVimState } from '../../../entities/vim/IVimState';
  3: import { IVimBuffer } from '../../../entities/vim/IVimBuffer';
  4: import { VimCommandManager } from '../VimCommandManager';
  5: import { MotionStrategy } from '../MotionStrategy';
  6: export class NormalMode implements IVimMode {
  7:     readonly name = 'NORMAL';
  8:     handleKey(
  9:         key: string,
 10:         state: IVimState,
 11:         buffer: IVimBuffer,
 12:         commands: VimCommandManager
 13:     ): string | null {
 14:         if (state.pendingAction === 'DELETE') {
 15:             return this.handleDeleteAction(key, state, buffer, commands);
 16:         }
 17:         if (state.pendingAction === 'G_PREFIX') {
 18:             if (key === 'g') {
 19:                 state.cursor.line = 0;
 20:                 state.cursor.col = 0;
 21:             }
 22:             state.pendingAction = null;
 23:             return null;
 24:         }
 25:         switch (key) {
 26:             case 'h': this.moveCursor(state, 0, -1); break;
 27:             case 'j': this.moveCursor(state, 1, 0); break;
 28:             case 'k': this.moveCursor(state, -1, 0); break;
 29:             case 'l': this.moveCursor(state, 0, 1); break;
 30:             case 'w':
 31:                 const nextPos = MotionStrategy.findNextWordStart(buffer, state.cursor.line, state.cursor.col);
 32:                 state.cursor.line = nextPos.line;
 33:                 state.cursor.col = nextPos.col;
 34:                 break;
 35:             case '$':
 36:                 const eolPos = MotionStrategy.findEndOfLine(buffer, state.cursor.line);
 37:                 state.cursor.col = eolPos.col;
 38:                 break;
 39:             case '0':
 40:             case '^':
 41:                 state.cursor.col = 0;
 42:                 break;
 43:             case 'G':
 44:                 state.cursor.line = Math.max(0, buffer.length - 1);
 45:                 state.cursor.col = 0;
 46:                 break;
 47:             case 'g':
 48:                 state.pendingAction = 'G_PREFIX';
 49:                 break;
 50:             case 'd':
 51:                 state.pendingAction = 'DELETE';
 52:                 break;
 53:             case 'D':
 54:                 const eol = MotionStrategy.findEndOfLine(buffer, state.cursor.line);
 55:                 commands.deleteRange(state.cursor.line, state.cursor.col, eol.col);
 56:                 break;
 57:             case 'i':
 58:                 return 'INSERT';
 59:             case 'a':
 60:                 this.moveCursor(state, 0, 1);
 61:                 return 'INSERT';
 62:             case ':':
 63:                 return 'COMMAND';
 64:             case 'x':
 65:                 commands.deleteChar(state.cursor.line, state.cursor.col);
 66:                 break;
 67:             case 'u':
 68:                 commands.undo();
 69:                 break;
 70:             case 'CTRL_R':
 71:                 commands.redo();
 72:                 break;
 73:         }
 74:         return null;
 75:     }
 76:     private handleDeleteAction(key: string, state: IVimState, buffer: IVimBuffer, commands: VimCommandManager): string | null {
 77:         state.pendingAction = null;
 78:         switch (key) {
 79:             case 'w':
 80:                 const nextPos = MotionStrategy.findNextWordStart(buffer, state.cursor.line, state.cursor.col);
 81:                 if (nextPos.col > state.cursor.col) {
 82:                     commands.deleteRange(state.cursor.line, state.cursor.col, nextPos.col - 1);
 83:                 } else {
 84:                     commands.deleteChar(state.cursor.line, state.cursor.col);
 85:                 }
 86:                 break;
 87:             case '$':
 88:                 const eolPos = MotionStrategy.findEndOfLine(buffer, state.cursor.line);
 89:                 commands.deleteRange(state.cursor.line, state.cursor.col, eolPos.col);
 90:                 break;
 91:             case 'd':
 92:                 const fullLine = MotionStrategy.findEndOfLine(buffer, state.cursor.line);
 93:                 commands.deleteRange(state.cursor.line, 0, fullLine.col);
 94:                 break;
 95:             case 'ESC':
 96:                 break;
 97:         }
 98:         return null;
 99:     }
100:     private moveCursor(state: IVimState, dLine: number, dCol: number): void {
101:         state.cursor.line += dLine;
102:         state.cursor.col += dCol;
103:     }
104: }
