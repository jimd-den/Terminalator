<file path="src/domain/commands/core/MakeCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { CommandBase } from '../CommandBase';
 3: import { CommandResponse } from '../ICommand';
 4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { Dentry } from '../../entities/FileSystem';
 7: import { MakefileParser } from '../../services/make/MakefileParser';
 8: import { MakeExecutor, MakeOptions } from '../../services/make/MakeExecutor';
 9: import { CommandCapability } from '../IStructuredCommand';
10: export class MakeCommand extends CommandBase {
11:     public readonly capabilities: CommandCapability[] = [CommandCapability.MODIFY];
12:     public readonly utility: string = 'make';
13:     protected async executeInternal(
14:         args: string[],
15:         flags: Set<string>,
16:         operands: string[],
17:         context: ProcessContext,
18:         state: TerminalState
19:     ): Promise<CommandResponse> {
20:         this.parseArgs(args, ['f']);
21:         const options: MakeOptions = {
22:             ignoreErrors: this.hasFlag('i'),
23:             dryRun: this.hasFlag('n'),
24:             keepGoing: this.hasFlag('k'),
25:             touch: this.hasFlag('t')
26:         };
27:         const makefileName = this.options.get('f') || 'Makefile';
28:         const cliMacros = new Map<string, string>();
29:         const targets: string[] = [];
30:         for (const op of this.operands) {
31:             if (op.includes('=')) {
32:                 const [key, ...rest] = op.split('=');
33:                 cliMacros.set(key.trim(), rest.join('=').trim());
34:             } else {
35:                 targets.push(op);
36:             }
37:         }
38:         const fs = context.fileSystemService;
39:         let makefileNode: Dentry | null = fs.resolve(makefileName, state.currentDirectory);
40:         if (!makefileNode && state.currentDirectory !== '/') {
41:             makefileNode = fs.resolve(makefileName, '/');
42:         }
43:         if ((!makefileNode || fs.isDirectory(makefileNode)) && makefileName === 'Makefile') {
44:             makefileNode = fs.resolve('makefile', state.currentDirectory) || fs.resolve('makefile', '/');
45:         }
46:         if (!makefileNode || fs.isDirectory(makefileNode)) {
47:             return {
48:                 output: `make: *** No targets specified and no makefile found. Stop.`,
49:                 newState: state,
50:                 exitCode: 2
51:             };
52:         }
53:         let content = '';
54:         try {
55:             content = fs.readFile(fs.getAbsolutePath(makefileNode));
56:         } catch (e) {
57:             return { output: `make: ${makefileName}: Cannot read file`, newState: state, exitCode: 2 };
58:         }
59:         const parser = new MakefileParser();
60:         const data = parser.parse(content, cliMacros);
61:         // 3. Determine Goals
62:         const goals = targets.length > 0 ? targets : (data.orderedTargets.length > 0 ? [data.orderedTargets[0]] : []);
63:         if (goals.length === 0) {
64:             return {
65:                 output: 'make: *** No targets. Stop.',
66:                 newState: state,
67:                 exitCode: 2
68:             };
69:         }
70:         const executor = new MakeExecutor(fs, state, data, options);
71:         const result = await executor.execute(goals);
72:         return {
73:             output: result.output,
74:             newState: state,
75:             exitCode: result.exitCode
76:         };
77:     }
78: }
</file>

