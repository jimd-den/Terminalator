 9: export class TutorSpy {
10:     private history: Keystroke[] = [];
11:     private startTime: number = 0;
12:     recordKeystroke(char: string, timestamp: number = Date.now()): void {
13:         if (this.history.length === 0) this.startTime = timestamp;
14:         this.history.push({ char, timestamp });
15:     }
16:     calculateWPM(now: number = Date.now()): number {
17:         if (this.history.length < 2) return 0;
18:         const start = this.history[0].timestamp;
19:         const durationMin = (now - start) / 60000;
20:         if (durationMin <= 0) return 0;
21:         const chars = this.history.length;
22:         const words = chars / 5;
23:         return Math.round(words / durationMin);
24:     }
25:     analyze(wpm: number): TutorReaction | null {
26:         if (wpm < 20) {
27:             return {
28:                 text: "My sensors detect a biological bottleneck. Type faster.",
29:                 type: 'warn'
30:             };
31:         }
32:         if (wpm > 100) {
33:             return {
34:                 text: "Impressive throughput. Are you enhanced?",
35:                 type: 'info'
36:             };
