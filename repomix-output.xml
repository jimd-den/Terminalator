        }

        const seconds = parseFloat(args[0]);
        if (isNaN(seconds)) {
            return { output: `sleep: invalid time interval '${args[0]}'`, newState: state, exitCode: 1 };
        }

        // Wait
        await new Promise(resolve => setTimeout(resolve, seconds * 1000));

        return {
            output: '',
            newState: state,
            exitCode: 0
        };
    }
}
