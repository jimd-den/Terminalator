<file path="src/domain/services/make/MakeExecutor.ts">
  1: import { FileSystemService } from '../../services/FileSystemService';
  2: import { TerminalState } from '../../entities/TerminalState';
  3: import { MakeRule, MakefileData } from './MakefileParser';
  4: export interface MakeOptions {
  5:     ignoreErrors: boolean;
  6:     dryRun: boolean;
  7:     keepGoing: boolean;
  8:     touch: boolean;
  9: }
 10: export class MakeExecutor {
 11:     private processed = new Set<string>();
 12:     private outputLines: string[] = [];
 13:     private globalExitCode = 0;
 14:     constructor(
 15:         private fs: FileSystemService,
 16:         private state: TerminalState,
 17:         private data: MakefileData,
 18:         private options: MakeOptions
 19:     ) { }
 20:     public async execute(goals: string[]): Promise<{ output: string, exitCode: number }> {
 21:         this.processed.clear();
 22:         this.outputLines = [];
 23:         this.globalExitCode = 0;
 24:         try {
 25:             for (const goal of goals) {
 26:                 await this.executeTarget(goal);
 27:             }
 28:         } catch (e: any) {
 29:             if (e.message !== 'Stop') {
 30:                 this.outputLines.push(`make: Internal error: ${e.message}`);
 31:                 this.globalExitCode = 2;
 32:             }
 33:         }
 34:         return {
 35:             output: this.outputLines.join('\n'),
 36:             exitCode: this.globalExitCode
 37:         };
 38:     }
 39:     private async executeTarget(targetName: string): Promise<boolean> {
 40:         if (this.processed.has(targetName)) return true;
 41:         this.processed.add(targetName);
 42:         const rule = this.data.rules.get(targetName);
 43:         const targetMtime = this.getMtime(targetName);
 44:         let rebuild = false;
 45:         if (!rule) {
 46:             if (targetMtime !== -1) return true;
 47:             this.outputLines.push(`make: *** No rule to make target '${targetName}'. Stop.`);
 48:             if (!this.options.keepGoing) throw new Error('Stop');
 49:             this.globalExitCode = 1;
 50:             return false;
 51:         }
 52:         for (const dep of rule.dependencies) {
 53:             const expandedDep = this.expand(dep);
 54:             if (!expandedDep) continue;
 55:             const depSuccess = await this.executeTarget(expandedDep);
 56:             if (!depSuccess) {
 57:                 if (!this.options.keepGoing) return false;
 58:                 this.outputLines.push(`make: *** Target '${targetName}' not remade because of errors.`);
 59:                 return false;
 60:             }
 61:             const depMtime = this.getMtime(expandedDep);
 62:             if (depMtime > targetMtime) rebuild = true;
 63:         }
 64:         if (targetMtime === -1) rebuild = true;
 65:         if (rule.dependencies.length === 0 && targetMtime === -1) rebuild = true;
 66:         if (!rebuild && targetMtime !== -1) {
 67:             return true;
 68:         }
 69:         if (this.options.touch) {
 70:             this.touchTarget(targetName);
 71:             return true;
 72:         }
 73:         for (const recipe of rule.recipes) {
 74:             const expandedRecipe = this.expand(recipe);
 75:             const silent = expandedRecipe.startsWith('@');
 76:             const ignore = this.options.ignoreErrors || expandedRecipe.startsWith('-');
 77:             let cmdStr = expandedRecipe;
 78:             if (cmdStr.startsWith('@')) cmdStr = cmdStr.substring(1);
 79:             if (cmdStr.startsWith('-')) cmdStr = cmdStr.substring(1);
 80:             if (!silent) this.outputLines.push(cmdStr);
 81:             if (this.options.dryRun) continue;
 82:             const cmdExit = this.simulationExecute(cmdStr);
 83:             if (cmdExit !== 0) {
 84:                 if (!ignore) {
 85:                     this.outputLines.push(`make: *** [${targetName}] Error ${cmdExit}`);
 86:                     if (!this.options.keepGoing) {
 87:                         this.globalExitCode = 2;
 88:                         throw new Error('Stop');
 89:                     }
 90:                     this.globalExitCode = 1;
 91:                     return false;
 92:                 } else {
 93:                     this.outputLines.push(`make: [${targetName}] Error ${cmdExit} (ignored)`);
 94:                 }
 95:             }
 96:         }
 97:         return true;
 98:     }
 99:     private expand(str: string): string {
100:         return str.replace(/\$\(([a-zA-Z0-9_]+)\)/g, (_, name) => {
101:             return this.data.macros.get(name) || this.state.environment[name] || '';
102:         });
103:     }
104:     private getMtime(path: string): number {
105:         const node = this.fs.resolve(path, this.state.currentDirectory);
106:         if (!node) return -1;
107:         const inode = this.fs.getInode(node.inodeId);
108:         return inode ? inode.mtime : -1;
109:     }
110:     private touchTarget(targetName: string) {
111:         if (this.options.dryRun) return;
112:         try {
113:             const path = targetName.startsWith('/') ? targetName : this.state.currentDirectory + '/' + targetName;
114:             this.fs.writeFile(path, '', 'a', undefined, undefined, this.state.currentDirectory);
115:             const node = this.fs.resolve(path, this.state.currentDirectory);
116:             if (node) {
117:                 const inode = this.fs.getInode(node.inodeId);
118:                 if (inode) {
119:                     inode.mtime = Date.now();
120:                     inode.ctime = Date.now();
121:                 }
122:             }
123:             this.outputLines.push(`touch ${targetName}`);
124:         } catch (e) { }
125:     }
126:     private simulationExecute(cmdStr: string): number {
127:         const parts = cmdStr.split(/\s+/);
128:         const prog = parts[0];
129:         const progArgs = parts.slice(1);
130:         try {
131:             if (prog === 'echo') {
132:                 let text = progArgs.join(' ');
133:                 this.outputLines.push(text.replace(/['"]/g, ''));
134:                 return 0;
135:             } else if (prog === 'touch') {
136:                 const file = progArgs[0];
137:                 this.touchTarget(file);
138:                 return 0;
139:             } else if (prog === 'false') {
140:                 return 1;
141:             } else if (prog === 'true') {
142:                 return 0;
143:             }
144:             return 0;
145:         } catch (e) {
146:             return 1;
147:         }
148:     }
149: }
</file>

<file path="src/domain/services/make/MakefileParser.ts">
 1: export interface MakeRule {
 2:     target: string;
 3:     dependencies: string[];
 4:     recipes: string[];
 5: }
 6: export interface MakefileData {
 7:     rules: Map<string, MakeRule>;
 8:     macros: Map<string, string>;
 9:     orderedTargets: string[];
10: }
11: export class MakefileParser {
12:     public parse(content: string, initialMacros: Map<string, string> = new Map()): MakefileData {
13:         const rules = new Map<string, MakeRule>();
14:         const macros = new Map<string, string>(initialMacros);
15:         const orderedTargets: string[] = [];
16:         let currentRule: MakeRule | null = null;
17:         const lines = content.split('\n');
18:         for (let line of lines) {
19:             const commentIdx = line.indexOf('#');
20:             if (commentIdx !== -1) line = line.substring(0, commentIdx);
21:             if (!line.trim() && !line.startsWith('\t')) {
22:                 currentRule = null;
23:                 continue;
24:             }
25:             if (line.startsWith('\t')) {
26:                 if (currentRule) {
27:                     currentRule.recipes.push(line.substring(1));
28:                 }
29:             } else if (line.includes(':') && !line.includes('=')) {
30:                 const parts = line.split(':');
31:                 const targetStr = parts[0].trim();
32:                 const depStr = parts.slice(1).join(':').trim();
33:                 let deps = depStr;
34:                 let inlineCmd = '';
35:                 if (depStr.includes(';')) {
36:                     const dParts = depStr.split(';');
37:                     deps = dParts[0].trim();
38:                     inlineCmd = dParts.slice(1).join(';').trim();
39:                 }
40:                 const targetsInLine = targetStr.split(/\s+/).filter(t => t.length > 0);
41:                 const dependencies = deps ? deps.split(/\s+/).filter(d => d.length > 0) : [];
42:                 for (const t of targetsInLine) {
43:                     if (!rules.has(t)) {
44:                         rules.set(t, { target: t, dependencies: [], recipes: [] });
45:                         orderedTargets.push(t);
46:                     }
47:                     const rule = rules.get(t)!;
48:                     rule.dependencies.push(...dependencies);
49:                     if (inlineCmd) rule.recipes.push(inlineCmd);
50:                     currentRule = rule; // Recipes will apply to the last target in the line
51:                 }
52:             } else if (line.includes('=')) {
53:                 // Macro definition
54:                 const parts = line.split('=');
55:                 const key = parts[0].trim();
56:                 const val = parts.slice(1).join('=').trim();
57:                 if (!macros.has(key)) {
58:                     macros.set(key, val);
59:                 }
60:             } else {
61:                 currentRule = null;
62:             }
63:         }
64:         return { rules, macros, orderedTargets };
65:     }
66: }
</file>

<file path="src/domain/services/mission/MissionInstantiationService.ts">
  1: import { MissionGrammar, StepRule, CommandMatcher, StepTransition } from '../../entities/mission/MissionGrammar';
  2: import { SystemPreparationSpec } from '../../entities/world/SystemPreparationSpec';
  3: import { MacroExpander } from '../scheme/MacroExpander';
  4: import { SchemeParser } from '../../usecases/SchemeParser';
  5: import { MISSION_MACROS } from '../scheme/MissionMacroDefinitions';
  6: import { SchemeValue, listToArray, schemeToString } from '../../entities/SchemeValue';
  7: import { SchemeVM } from '../../usecases/SchemeVM';
  8: import { Environment } from '../../entities/Environment';
  9: import { SchemeCompiler } from '../../usecases/SchemeCompiler';
 10: import { getPurePrimitives } from '../../usecases/SchemePrimitives';
 11: import { makeProcedure } from '../../entities/SchemeValue';
 12: import { WorldPatchService } from '../world/WorldPatchService';
 13: export interface InstantiatedMission {
 14:     grammar: MissionGrammar;
 15:     prepSpec: SystemPreparationSpec;
 16: }
 17: export class MissionInstantiationService {
 18:     private expander: MacroExpander;
 19:     private parser: SchemeParser;
 20:     private vm: SchemeVM;
 21:     private compiler: SchemeCompiler;
 22:     constructor(private worldPatchService: WorldPatchService) {
 23:         this.expander = new MacroExpander();
 24:         this.parser = new SchemeParser();
 25:         this.compiler = new SchemeCompiler();
 26:         const env = new Environment();
 27:         getPurePrimitives().forEach(p => {
 28:             env.define(p.name, makeProcedure({
 29:                 isBuiltin: true,
 30:                 name: p.name,
 31:                 call: p.func
 32:             }));
 33:         });
 34:         this.vm = new SchemeVM(env);
 35:         this.initializeMacros();
 36:     }
 37:     private initializeMacros() {
 38:         const macroExprs = this.parser.parse(MISSION_MACROS);
 39:         macroExprs.forEach(expr => this.expander.expand(expr));
 40:     }
 41:     public instantiate(script: string, hostname: string): InstantiatedMission {
 42:         const exprs = this.parser.parse(script);
 43:         if (exprs.length === 0) throw new Error("Empty mission script");
 44:         const expanded = this.expander.expand(exprs[0]);
 45:         const code = this.compiler.compile(expanded);
 46:         const result = this.vm.execute(code);
 47:         const rawData = this.schemeToJS(result);
 48:         const missionData = this.parseMissionData(rawData, hostname);
 49:         this.worldPatchService.patch(missionData.prepSpec);
 50:         return missionData;
 51:     }
 52:     private schemeToJS(v: SchemeValue): any {
 53:         switch (v.type) {
 54:             case 'number':
 55:             case 'string':
 56:             case 'boolean':
 57:                 return v.value;
 58:             case 'symbol':
 59:                 if (v.value === 'nil' || v.value === 'null') return null;
 60:                 return v.value;
 61:             case 'null':
 62:                 return [];
 63:             case 'pair': {
 64:                 const arr = listToArray(v);
 65:                 return arr.map(x => this.schemeToJS(x));
 66:             }
 67:             default:
 68:                 return null;
 69:         }
 70:     }
 71:     private parseMissionData(data: any, hostname: string): InstantiatedMission {
 72:         if (!Array.isArray(data) || data[0] !== 'mission') {
 73:             throw new Error(`Invalid mission data format: ${JSON.stringify(data)}`);
 74:         }
 75:         const archetype = data[1];
 76:         const initialStepId = data[2];
 77:         const rawSteps = data[3];
 78:         const steps: StepRule[] = rawSteps.map((s: any) => {
 79:             const lessonText = s[4] === 'nil' ? undefined : s[4];
 80:             const matcherData = s[5];
 81:             const transData = s[6];
 82:             const matcher: CommandMatcher = {
 83:                 type: matcherData[1],
 84:                 target: matcherData[2] === 'nil' ? undefined : matcherData[2],
 85:                 expectedValue: matcherData[3] === 'nil' ? undefined : matcherData[3],
 86:                 ruleKey: matcherData[4] === 'nil' ? undefined : matcherData[4]
 87:             };
 88:             const transition: StepTransition = {
 89:                 nextStepId: transData[1] === 'nil' ? undefined : transData[1],
 90:                 startLessonId: transData[2] === 'nil' ? undefined : transData[2],
 91:                 tutorIntent: transData[3] === 'nil' ? undefined : transData[3],
 92:                 tutorToneProfile: transData[4] === 'nil' ? undefined : transData[4]
 93:             };
 94:             return {
 95:                 id: s[1],
 96:                 stepType: s[2],
 97:                 description: s[3],
 98:                 lessonText,
 99:                 commandMatcher: matcher,
100:                 onComplete: transition
101:             };
102:         });
103:         const grammar: MissionGrammar = {
104:             archetype,
105:             initialStepId,
106:             steps
107:         };
108:         const prepSpec: SystemPreparationSpec = {
109:             hostname,
110:             requiredDirs: ['/home/admin', '/var/log'],
111:             files: [],
112:             logs: []
113:         };
114:         return { grammar, prepSpec };
115:     }
116: }
</file>

