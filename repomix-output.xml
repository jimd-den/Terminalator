  1: import { Mission, MissionStep } from '../entities/Mission';
  2: import { NPC } from '../entities/NPC';
  3: import { TerminalState } from '../entities/TerminalState';
  4: import { CommandResponse } from '../entities/Command';
  5: import { TutorService, TutorProgressionResult } from './TutorService';
  6: import { MissionRepository } from './MissionRepository';
  7: import { generateHostname, generateObjectiveFilename } from '../utils/NameGenerator';
  8: import { IWorldStateProvider } from '../interfaces/IWorldStateProvider';
  9: import { ProceduralMissionFactory } from '../factories/ProceduralMissionFactory';
 10: import { ConstraintValidator } from './constraints/ConstraintValidator';
 11: import { ComplexityEstimator } from './constraints/ComplexityEstimator';
 12: import { OrganizationGenerator } from './generation/OrganizationGenerator';
 13: import { KnuthianMissionFactory } from '../factories/KnuthianMissionFactory';
 14: import { Organization } from '../entities/world/Organization';
 15: import { MissionPopulator } from './MissionPopulator';
 16: import { TutorLedProgression } from '../usecases/tutor/TutorLedProgression';
 17: import { AdaptiveTutorEngine } from './tutor/AdaptiveTutorEngine';
 18: import { TutorIntent } from '../entities/tutor/TutorIntent';
 19: import { TutorToneProfile } from '../entities/tutor/TutorToneProfile';
 20: import { UnixKnowledgeBase } from './knowledge/UnixKnowledgeBase';
 21: export class MissionService {
 22:     private activeMissions: Mission[] = [];
 23:     private organizationGenerator = new OrganizationGenerator();
 24:     private adaptiveEngine: AdaptiveTutorEngine;
 25:     constructor(
 26:         private missionRepository: MissionRepository,
 27:         private tutorService: TutorService,
 28:         private worldState?: IWorldStateProvider,
 29:         private proceduralFactory?: ProceduralMissionFactory,
 30:         private constraintValidator?: ConstraintValidator,
 31:         private knuthianFactory?: KnuthianMissionFactory,
 32:         private missionPopulator?: MissionPopulator,
 33:         private tutorProgression?: TutorLedProgression
 34:     ) {
 35:         this.adaptiveEngine = new AdaptiveTutorEngine(new UnixKnowledgeBase());
 36:     }
 37:     public async createMission(npc: NPC): Promise<Mission> {
 38:         const targetSystem = generateHostname(npc.faction || 'corporate');
 39:         const mission = await this.tutorProgression!.generateNextMission(targetSystem);
 40:         mission.assignedBy = npc.id;
 41:         mission.assignerName = npc.name;
 42:         this.setupMissionChat(mission, npc);
 43:         this.activeMissions.push(mission);
 44:         return mission;
 45:     }
 46:     private setupMissionChat(mission: Mission, npc: NPC) {
 47:         const tone = npc.faction === 'resistance' ? TutorToneProfile.RESISTANCE_LEADER : TutorToneProfile.CORPORATE_DRONE;
 48:         const briefing = this.adaptiveEngine.generateAdvice(
 49:             TutorIntent.MISSION_BRIEFING,
 50:             tone,
 51:             mission
 52:         );
 53:         mission.chatHistory = [
 54:             { sender: 'SYSTEM', message: `CONNECTING TO SECURE CHANNEL ${mission.id}...`, timestamp: Date.now() },
 55:             { sender: npc.name, message: briefing.message, timestamp: Date.now() },
 56:             { sender: 'SYSTEM', message: `REWARD ESCROW: ${mission.reward}`, timestamp: Date.now() },
 57:         ];
 58:     }
 59:     public updateMissions(state: TerminalState, response: CommandResponse): { hints: { missionId: string, sender: string, message: string, type: string }[], progression: { result: TutorProgressionResult | null, missionId: string } | null } {
 60:         const hints: { missionId: string, sender: string, message: string, type: string }[] = [];
 61:         const progression = this.tutorService.checkMissionProgression(state, this.activeMissions, response);
 62:         for (const mission of this.activeMissions) {
 63:             const hint = this.tutorService.analyzeGameState(mission, state, response);
 64:             if (hint) {
 65:                 const alreadySent = mission.chatHistory.some(m => m.message === hint.message);
 66:                 if (!alreadySent) {
 67:                     const sender = hint.type === 'CONGRATS' ? 'SYSTEM' : 'TutorBot';
 68:                     mission.chatHistory.push({
 69:                         sender,
 70:                         message: hint.message,
 71:                         timestamp: Date.now()
 72:                     });
 73:                     if (hint.type === 'CONGRATS') {
 74:                         mission.status = 'completed';
 75:                         mission.currentStep = MissionStep.COMPLETED;
 76:                     }
 77:                     hints.push({ missionId: mission.id, sender, message: hint.message, type: hint.type });
 78:                 }
 79:             }
 80:         }
 81:         if (progression && progression.result && progression.result.nextStep) {
 82:             const mission = this.activeMissions.find(m => m.id === progression.missionId);
 83:             if (mission) {
 84:                 if (this.constraintValidator && response.executionStats && mission.constraints) {
 85:                     const validation = this.constraintValidator.validate(mission, response.executionStats);
 86:                     if (!validation.valid) {
 87:                         const rejectionMsg = `CONSTRAINT VIOLATION: ${validation.reason}`;
 88:                         mission.chatHistory.push({ sender: 'SYSTEM', message: rejectionMsg, timestamp: Date.now() });
 89:                         hints.push({ missionId: mission.id, sender: 'SYSTEM', message: rejectionMsg, type: 'WARNING' });
 90:                         return { hints, progression: null };
 91:                     }
 92:                 }
 93:                 mission.currentStep = progression.result.nextStep;
 94:             }
 95:         }
 96:         return { hints, progression };
 97:     }
 98:     public getActiveMissions(): Mission[] {
 99:         return [...this.activeMissions];
100:     }
101:     public getMissionById(id: string): Mission | undefined {
102:         return this.activeMissions.find(m => m.id === id);
103:     }
104:     public abandonMission(id: string): void {
105:         this.activeMissions = this.activeMissions.filter(m => m.id !== id);
106:     }
107: }
