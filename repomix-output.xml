 41:     const inputController = useInputController(
 42:         autocompleteService,
 43:         state.currentDirectory,
 44:         () => gameManager.tutorEngine.isActive()
 45:     );
 46:     const outputController = useOutputController();
 47:     const handleCommandRef = useRef<((cmd?: string) => Promise<void>) | null>(null);
 48:     const pendingCommandRef = useRef<string | null>(null);
 49:     useEffect(() => {
 50:         const unsub = gameManager.getSimulationBus().subscribe(GameEventType.TUTOR_EVENT, (event) => {
 51:             if (event.payload.type === 'SUMMARY_DISMISSED' && pendingCommandRef.current) {
 52:                 const cmd = pendingCommandRef.current;
 53:                 pendingCommandRef.current = null;
 54:                 if (handleCommandRef.current) {
 55:                     handleCommandRef.current(cmd);
 56:                 }
 57:             }
 58:         });
 59:         return unsub;
 60:     }, [gameManager]);
 61:     const tutorCallbacks: TutorControllerCallbacks = useMemo(() => ({
 62:         onStart: (lesson: Lesson, targetCwd: string) => {
 63:             const isMission = lesson.isMission || (lesson.id && lesson.id.startsWith('MISSION_'));
 64:             if (isMission) return;
 65:             setState(prev => ({ ...prev, currentDirectory: targetCwd }));
 66:             outputController.appendLine(
 67:                 ShellPresenter.presentSystemMessage(`RELOCATING TO TRAINING ENVIRONMENT: ${targetCwd}...`)
 68:             );
 69:         },
 70:         onStop: (originalCwd: string | null) => {
 71:             const current = stateRef.current;
 72:             const isMission = gameManager.tutorEngine.getCurrentLesson()?.isMission;
 73:             if (originalCwd && !current.fsContext && !isMission) {
 74:                 setState(prev => ({ ...prev, currentDirectory: originalCwd }));
 75:                 outputController.appendLine(
 76:                     ShellPresenter.presentSystemMessage(`TRAINING HALTED. RESTORING CONTEXT: ${originalCwd}`)
 77:                 );
 78:             }
 79:         },
 80:         onProgress: (input: string, ghostText: string) => {
 81:             inputController.setInput(input);
 82:             inputController.updateGhostText(ghostText);
 83:         },
 84:         onCorrection: (input: string, ghostText: string) => {
 85:             inputController.setInput(input);
 86:             inputController.updateGhostText(ghostText);
 87:         },
 88:         onMistake: (input: string, ghostText: string, _droppedCount: number) => {
 89:             inputController.setInput(input);
 90:             inputController.updateGhostText(ghostText);
 91:         },
 92:         onComplete: (payload: { lesson: Lesson, stats: any }, originalCwd: string | null) => {
 93:             const { lesson, stats } = payload;
 94:             inputController.setInput(lesson.text);
 95:             inputController.updateGhostText('');
 96:             // Queue command for execution AFTER summary dismissal
 97:             pendingCommandRef.current = lesson.text;
 98:             inputController.clearInput();
 99:             const isMission = lesson.isMission || (lesson.id && lesson.id.startsWith('MISSION_'));
100:             const hasSwitchedContext = !!stateRef.current.fsContext;
101:             if (originalCwd && !isMission && !hasSwitchedContext) {
102:                 setTimeout(() => {
103:                     if (!stateRef.current.fsContext) {
104:                         setState(prev => ({ ...prev, currentDirectory: originalCwd }));
105:                         outputController.appendLine(
106:                             ShellPresenter.presentSystemMessage(`CONTEXT RESTORED: ${originalCwd}`)
107:                         );
108:                     }
109:                 }, 1000);
110:             }
111:         }
112:     }), [inputController, outputController, gameManager]);
113:     const tutorController = useTutorController(
114:         gameManager.tutorEngine,
115:         tutorCallbacks,
116:         state.currentDirectory
117:     );
118:     const shellController = useMemo(() => new ShellController({
119:         commandExecutor,
120:         gameManager,
121:         gameEventObserver: gameObserver,
122:         outputController,
123:         setState,
124:         stateRef,
125:         inputController,
126:         navigation,
127:         setIsTransitioning,
128:         setActiveApp,
129:         setMissions,
130:         simulationMediator
131:     }), [commandExecutor, gameManager, gameObserver, outputController, inputController, navigation, simulationMediator]);
132:     const handleCommand = useCallback((manualCommand?: string) => {
133:         const cmd = manualCommand !== undefined ? manualCommand : inputController.input;
134:         return shellController.execute(cmd);
135:     }, [shellController, inputController.input]);
136:     useEffect(() => {
137:         handleCommandRef.current = handleCommand;
138:     }, [handleCommand]);
139:     const handleKeyPress = useCallback((key: string) => {
140:         const allowed = tutorShadow.intercept(key, 'SHELL');
141:         if (!allowed) return;
142:         if (gameManager.tutorEngine.isActive()) {
143:             const lesson = gameManager.tutorEngine.getCurrentLesson();
144:             if (lesson && lesson.type === 'SHELL' && key.length === 1) {
145:                 return;
146:             }
147:         }
148:         if (key === 'TAB') inputController.acceptAutocomplete();
149:         else if (key === 'ESC') inputController.clearInput();
150:         else if (key === 'BACKSPACE') inputController.deleteChar();
151:         else if (key === 'ENTER') handleCommand();
152:         else if (key.length === 1) inputController.appendChar(key);
153:     }, [inputController, handleCommand, tutorShadow, gameManager]);
154:     const handleVimExit = useCallback(() => {
155:         setIsTransitioning(true);
156:         setTimeout(() => {
157:             setActiveApp({ type: 'SHELL' });
158:             setTimeout(() => setIsTransitioning(false), 300);
159:         }, 100);
160:     }, []);
161:     return {
162:         state: TerminalStateMapper.toDTO(state),
