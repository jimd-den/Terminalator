<file path="src/domain/services/EconomyService.ts">
 1: import { FileSystemService } from './FileSystemService';
 2: import { MiningSession } from '../entities/economy/MiningSession';
 3: import { SimulationBus, GameEventType } from './SimulationBus';
 4: import { RhythmConductor } from './RhythmConductor';
 5: export class EconomyService {
 6:     private zincBalance: number = 0;
 7:     private readonly WALLET_PATH = '/home/operator/.wallet';
 8:     private session: MiningSession;
 9:     private tickInterval: any = null;
10:     constructor(
11:         private fsService: FileSystemService,
12:         private bus?: SimulationBus,
13:         private conductor?: RhythmConductor
14:     ) {
15:         this.session = new MiningSession();
16:         this.loadWallet();
17:         this.startTicker();
18:     }
19:     private startTicker() {
20:         if (this.tickInterval) {
21:             clearInterval(this.tickInterval);
22:         }
23:         console.log("[EconomyService] Starting ticker...");
24:         this.tickInterval = setInterval(() => {
25:             const passiveReward = this.session.decay();
26:             if (passiveReward > 0 || this.session.hashRate > 0) {
27:                 this.zincBalance += passiveReward;
28:                 this.emitUpdate();
29:             }
30:         }, 1000);
31:     }
32:     public getBalance(): number {
33:         return this.zincBalance;
34:     }
35:     public getSession(): MiningSession {
36:         return this.session;
37:     }
38:     public startSession() {
39:         this.session.startSession();
40:         this.emitUpdate();
41:     }
42:     public recordHit(nextBeatTime?: number) {
43:         const reward = this.session.processHit(Date.now(), nextBeatTime);
44:         if (reward > 0) {
45:             this.zincBalance += reward;
46:             this.saveWallet();
47:             this.emitUpdate();
48:         }
49:     }
50:     public recordMistake() {
51:         this.session.penalize();
52:         this.emitUpdate();
53:     }
54:     private emitUpdate() {
55:         if (this.bus) {
56:             this.bus.emit(GameEventType.ECONOMY_UPDATE, {
57:                 balance: this.zincBalance,
58:                 hashRate: this.session.hashRate,
59:                 streak: this.session.streak,
60:                 sessionReward: this.session.sessionZincMined
61:             });
62:         }
63:     }
64:     private loadWallet() {
65:         try {
66:             const node = this.fsService.resolve(this.WALLET_PATH);
67:             if (node) {
68:                 const content = this.fsService.readFile(this.WALLET_PATH);
69:                 const data = JSON.parse(content);
70:                 this.zincBalance = data.balance || 0;
71:             } else {
72:                 this.saveWallet();
73:             }
74:         } catch (e) {
75:             console.error("[EconomyService] Failed to load wallet:", e);
76:             this.zincBalance = 0;
77:         }
78:     }
79:     private saveWallet() {
80:         try {
81:             const data = {
82:                 balance: this.zincBalance,
83:                 lastSync: Date.now(),
84:                 currency: 'ZINC',
85:                 symbol: 'Ƶ'
86:             };
87:             this.fsService.writeFile(this.WALLET_PATH, JSON.stringify(data, null, 2));
88:         } catch (e) {
89:             console.error("[EconomyService] Failed to save wallet:", e);
90:         }
91:     }
92:     public syncWallet() {
93:         this.loadWallet();
94:     }
95: }
