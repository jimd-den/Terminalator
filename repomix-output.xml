<file path="src/domain/commands/core/ScpCommand.ts">
 1: import { ICommand, CommandResponse } from '../../entities/Command';
 2: import { ProcessContext } from '../../entities/ProcessContext';
 3: import { TerminalState } from '../../entities/TerminalState';
 4: import { FileSystemService } from '../../services/FileSystemService';
 5: export class ScpCommand implements ICommand {
 6:     public readonly name = 'scp';
 7:     public readonly description = 'Copy files between hosts on the network.';
 8:     public async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 9:         if (args.length < 2) {
10:             return {
11:                 output: "usage: scp [[user@]host1:]file1 ... [[user@]host2:]file2",
12:                 exitCode: 1
13:             };
14:         }
15:         const sourceArg = args[0];
16:         const destArg = args[1];
17:         try {
18:             const { host: sourceHost, path: sourcePath } = this.parsePath(sourceArg);
19:             const { host: destHost, path: destPath } = this.parsePath(destArg);
20:             const sourceFs = this.getFileSystem(context, sourceHost);
21:             const destFs = this.getFileSystem(context, destHost);
22:             if (!sourceFs) return { output: `scp: host ${sourceHost} not found`, exitCode: 1 };
23:             if (!destFs) return { output: `scp: host ${destHost} not found`, exitCode: 1 };
24:             const sourceService = new FileSystemService(sourceFs);
25:             const destService = new FileSystemService(destFs);
26:             const resolvedSource = sourceService.resolveAbsolutePath(sourcePath, sourceHost ? '/' : state.currentDirectory);
27:             const resolvedDest = destService.resolveAbsolutePath(destPath, destHost ? '/' : state.currentDirectory);
28:             const content = sourceService.readFile(resolvedSource);
29:             let finalDest = resolvedDest;
30:             const destNode = destService.resolve(resolvedDest);
31:             if (destNode && destService.isDirectory(destNode)) {
32:                 const fileName = resolvedSource.split('/').pop() || 'file';
33:                 finalDest = resolvedDest.endsWith('/') ? resolvedDest + fileName : resolvedDest + '/' + fileName;
34:             }
35:             destService.writeFile(finalDest, content, 'w');
36:             return {
37:                 output: `${sourceArg} -> ${destArg} (100%)`,
38:                 exitCode: 0
39:             };
40:         } catch (error: any) {
41:             return {
42:                 output: `scp: ${error.message}`,
43:                 exitCode: 1
44:             };
45:         }
46:     }
47:     private parsePath(arg: string): { host: string | null, path: string } {
48:         if (arg.includes(':')) {
49:             const parts = arg.split(':');
50:             let host = parts[0];
51:             const path = parts[1];
52:             if (host.includes('@')) {
53:                 host = host.split('@')[1];
54:             }
55:             return { host, path };
56:         }
57:         return { host: null, path: arg };
58:     }
59:     private getFileSystem(context: ProcessContext, host: string | null) {
60:         if (!host || host === 'localhost' || host === 'terminalator') {
61:             return context.fileSystemService.fileSystem;
62:         }
63:         return context.networkMap?.getSystem(host);
64:     }
65: }
</file>

