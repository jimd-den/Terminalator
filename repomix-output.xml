<file path="src/domain/commands/core/RmdirCommand.ts">
  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { CommandBase } from '../CommandBase';
  3: import { CommandCapability } from '../IStructuredCommand';
  4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  5: import { TerminalState } from '../../entities/TerminalState';
  6: import { CommandResponse } from '../../entities/Command';
  7: import { FileSystemService } from '../../services/FileSystemService';
  8: import { S_IFDIR } from '../../entities/FileSystem';
  9: import { DirectoryNode } from '../../entities/filesystem/DirectoryNode';
 10: export class RmdirCommand extends CommandBase {
 11:     public readonly capabilities = [CommandCapability.MODIFY];
 12:     public readonly utility = 'rmdir';
 13:     constructor(private fs: FileSystemService) {
 14:         super();
 15:     }
 16:     protected async executeInternal(
 17:         rawArgs: string[],
 18:         flags: Set<string>,
 19:         operands: string[],
 20:         context: ProcessContext,
 21:         state: TerminalState
 22:     ): Promise<CommandResponse> {
 23:         const parents = flags.has('p');
 24:         if (operands.length === 0) {
 25:             return {
 26:                 output: 'rmdir: missing operand\n',
 27:                 newState: state,
 28:                 exitCode: 1
 29:             };
 30:         }
 31:         let overallExitCode = 0;
 32:         let cumulativeOutput = '';
 33:         for (const target of operands) {
 34:             const result = this.handleOperand(target, parents, state.currentDirectory);
 35:             if (result.exitCode !== 0) {
 36:                 overallExitCode = 1;
 37:                 cumulativeOutput += result.output;
 38:             }
 39:         }
 40:         return {
 41:             output: cumulativeOutput,
 42:             newState: state,
 43:             exitCode: overallExitCode
 44:         };
 45:     }
 46:     private handleOperand(target: string, parents: boolean, cwd: string): { output: string, exitCode: number } {
 47:         const absolutePath = this.resolveAbsolutePath(target, cwd);
 48:         if (parents) {
 49:             const pathsToRemoval = this.getParentPaths(absolutePath);
 50:             for (const path of pathsToRemoval) {
 51:                 try {
 52:                     this.performRemoval(path);
 53:                 } catch (e: any) {
 54:                     if (path === absolutePath) {
 55:                         return { output: `rmdir: failed to remove '${target}': ${e.message}\n`, exitCode: 1 };
 56:                     }
 57:                     break;
 58:                 }
 59:             }
 60:         } else {
 61:             try {
 62:                 this.performRemoval(absolutePath);
 63:             } catch (e: any) {
 64:                 return { output: `rmdir: failed to remove '${target}': ${e.message}\n`, exitCode: 1 };
 65:             }
 66:         }
 67:         return { output: '', exitCode: 0 };
 68:     }
 69:     private performRemoval(path: string): void {
 70:         const node = this.fs.resolve(path);
 71:         if (!node) {
 72:             throw new Error('No such file or directory');
 73:         }
 74:         const inode = this.fs.getInode(node.inodeId);
 75:         if (!inode || !(inode.mode & S_IFDIR)) {
 76:             throw new Error('Not a directory');
 77:         }
 78:         const dirNode = node as DirectoryNode;
 79:         if (dirNode.children.size > 0) {
 80:             throw new Error('Directory not empty');
 81:         }
 82:         if (path === '/') {
 83:             throw new Error('Operation not permitted');
 84:         }
 85:         this.fs.deleteNode(path);
 86:     }
 87:     private resolveAbsolutePath(path: string, cwd: string): string {
 88:         if (path.startsWith('/')) return path;
 89:         const normalizedCwd = cwd.endsWith('/') ? cwd : `${cwd}/`;
 90:         return `${normalizedCwd}${path}`.replace(/\/+/g, '/');
 91:     }
 92:     private getParentPaths(path: string): string[] {
 93:         const parts = path.split('/').filter(p => p.length > 0);
 94:         const paths: string[] = [];
 95:         while (parts.length > 0) {
 96:             paths.push('/' + parts.join('/'));
 97:             parts.pop();
 98:         }
 99:         return paths;
100:     }
101: }
</file>

