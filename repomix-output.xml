  6: import { CommandResponse } from '../../entities/Command';
  7: import { FileSystemService } from '../../services/FileSystemService';
  8: interface CutOptions {
  9:     bytes?: string;
 10:     chars?: string;
 11:     fields?: string;
 12:     delimiter: string;
 13:     suppress: boolean;
 14:     files: string[];
 15: }
 16: export class CutCommand extends CommandBase {
 17:     public readonly capabilities = [CommandCapability.FILTER];
 18:     public readonly utility = 'cut';
 19:     constructor(private fs: FileSystemService) {
 20:         super();
 21:     }
 22:     protected override parseArgs(args: string[]) {
 23:         super.parseArgs(args, ['b', 'c', 'f', 'd']);
 24:     }
 25:     protected async executeInternal(
 26:         rawArgs: string[],
 27:         flags: Set<string>,
 28:         operands: string[],
 29:         context: ProcessContext,
 30:         state: TerminalState
 31:     ): Promise<CommandResponse> {
 32:         const input = getStdinAsString(context);
 33:         const options: CutOptions = {
 34:             bytes: this.options.get('b'),
 35:             chars: this.options.get('c'),
 36:             fields: this.options.get('f'),
 37:             delimiter: this.options.get('d') || '\t',
 38:             suppress: flags.has('s'),
 39:             files: operands
 40:         };
 41:         if (options.delimiter && options.delimiter.startsWith('"') && options.delimiter.endsWith('"')) {
 42:             options.delimiter = options.delimiter.slice(1, -1);
 43:         }
 44:         if (!options.bytes && !options.chars && !options.fields) {
 45:             return {
 46:                 output: 'cut: you must specify a list of bytes, characters, or fields',
 47:                 newState: state,
 48:                 exitCode: 1
 49:             };
 50:         }
 51:         if ((options.bytes && options.fields) || (options.chars && options.fields)) {
 52:             return {
 53:                 output: 'cut: only one type of list may be specified',
 54:                 newState: state,
 55:                 exitCode: 1
 56:             };
 57:         }
 58:         let inputContent = '';
 59:         if (options.files.length > 0) {
 60:             for (const file of options.files) {
 61:                 if (file === '-') {
 62:                     inputContent += (input || '') + '\n';
 63:                     continue;
 64:                 }
 65:                 try {
 66:                     const resolvedPath = this.resolvePath(file, state);
 67:                     inputContent += this.fs.readFile(resolvedPath) + '\n';
 68:                 } catch (e) {
 69:                     return {
 70:                         output: `cut: ${file}: No such file or directory`,
 71:                         newState: state,
 72:                         exitCode: 1
 73:                     };
 74:                 }
 75:             }
 76:             if (inputContent.endsWith('\n')) inputContent = inputContent.slice(0, -1);
 77:         } else if (input !== undefined) {
 78:             inputContent = input;
 79:         } else {
 80:             return { output: '', newState: state, exitCode: 0 };
 81:         }
 82:         const lines = inputContent.split('\n');
 83:         const results: string[] = [];
 84:         for (const line of lines) {
 85:             if (line === '') {
 86:                 results.push('');
 87:                 continue;
 88:             }
 89:             if (options.fields) {
 90:                 const res = this.processFields(line, options.fields, options.delimiter, options.suppress);
 91:                 if (res !== null) results.push(res);
 92:             } else {
 93:                 const list = options.bytes || options.chars;
 94:                 if (list) {
 95:                     results.push(this.processBytes(line, list));
 96:                 }
 97:             }
 98:         }
 99:         return {
100:             output: results.join('\n'),
101:             newState: state,
102:             exitCode: 0
103:         };
104:     }
105:     private resolvePath(path: string, state: TerminalState): string {
106:         if (path.startsWith('/')) return path;
107:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
108:     }
109:     private processBytes(line: string, listStr: string): string {
110:         const ranges = this.parseRanges(listStr);
111:         let result = '';
112:         for (let i = 1; i <= line.length; i++) {
113:             if (this.isInRanges(i, ranges)) {
114:                 result += line[i - 1];
115:             }
116:         }
117:         return result;
118:     }
119:     private processFields(line: string, listStr: string, delimiter: string, suppress: boolean): string | null {
120:         if (!line.includes(delimiter)) {
121:             return suppress ? null : line;
122:         }
123:         const fields = line.split(delimiter);
124:         const ranges = this.parseRanges(listStr);
125:         const selected: string[] = [];
126:         for (let i = 1; i <= fields.length; i++) {
127:             if (this.isInRanges(i, ranges)) {
128:                 selected.push(fields[i - 1]);
129:             }
130:         }
131:         return selected.join(delimiter);
132:     }
133:     private parseRanges(listStr: string): { start: number, end: number }[] {
134:         const parts = listStr.split(',');
135:         const ranges: { start: number, end: number }[] = [];
136:         for (const part of parts) {
137:             if (part.includes('-')) {
138:                 const [s, e] = part.split('-');
139:                 const start = s ? parseInt(s, 10) : 1;
140:                 const end = e ? parseInt(e, 10) : Infinity;
141:                 ranges.push({ start, end });
142:             } else {
143:                 const val = parseInt(part, 10);
144:                 ranges.push({ start: val, end: val });
145:             }
146:         }
147:         return ranges;
148:     }
149:     private isInRanges(index: number, ranges: { start: number, end: number }[]): boolean {
150:         for (const r of ranges) {
151:             if (index >= r.start && index <= r.end) return true;
152:         }
153:         return false;
154:     }
155: }
</file>

