<file path="src/domain/entities/tutor/PersonalityMatrix.ts">
 1: import { TutorToneProfile } from './TutorToneProfile';
 2: export interface BigFive {
 3:     openness: number;
 4:     conscientiousness: number;
 5:     extraversion: number;
 6:     agreeableness: number;
 7:     neuroticism: number;
 8: }
 9: export class PersonalityMatrix {
10:     constructor(public traits: BigFive) {}
11:     public getDominantTone(): TutorToneProfile {
12:         const { agreeableness, neuroticism, conscientiousness, extraversion, openness } = this.traits;
13:         if (neuroticism > 0.8 && agreeableness < 0.3) return TutorToneProfile.SNARKY_SYSADMIN;
14:         if (agreeableness > 0.7 && neuroticism < 0.4) return TutorToneProfile.GENTLE_GUIDE;
15:         if (conscientiousness > 0.8 && extraversion < 0.4) return TutorToneProfile.CORPORATE_DRONE;
16:         if (extraversion > 0.7 && openness > 0.7) return TutorToneProfile.RESISTANCE_LEADER;
17:         if (neuroticism < 0.2 && agreeableness < 0.2) return TutorToneProfile.AI_OVERLORD;
18:         return TutorToneProfile.GENTLE_GUIDE;
19:     }
20:     public mutate(delta: Partial<BigFive>): void {
21:         Object.entries(delta).forEach(([key, value]) => {
22:             const traitKey = key as keyof BigFive;
23:             this.traits[traitKey] = Math.max(0, Math.min(1, this.traits[traitKey] + (value || 0)));
24:         });
25:     }
26: }
</file>

<file path="src/domain/entities/tutor/TutorBrain.ts">
  1: import { ITutorPersona } from './ITutorPersona';
  2: import { IntensityCalculator } from '../../services/tutor/IntensityCalculator';
  3: import { MissionIntentInterpreter } from '../../interpreters/MissionIntentInterpreter';
  4: import { SimulationBus, GameEvent, GameEventType } from '../../services/SimulationBus';
  5: import { AdaptiveTutorEngine } from '../../services/tutor/AdaptiveTutorEngine';
  6: import { PsychAdapter } from '../../services/tutor/PsychAdapter';
  7: import { UnixKnowledgeBase } from '../../services/knowledge/UnixKnowledgeBase';
  8: import { TutorIntent } from './TutorIntent';
  9: import { Mission } from '../Mission';
 10: export interface IObservableGame {
 11:     subscribeToEvents(listener: (event: string, payload?: any) => void): () => void;
 12:     tutorEngine: IObservableTutor;
 13: }
 14: export interface IObservableTutor {
 15:     subscribe(listener: (event: any) => void): () => void;
 16: }
 17: export type BrainReactionListener = (text: string, type: string) => void;
 18: export class TutorBrain {
 19:     public activePersona: ITutorPersona;
 20:     private reactionListeners: BrainReactionListener[] = [];
 21:     private psychAdapter: PsychAdapter;
 22:     private adaptiveEngine: AdaptiveTutorEngine;
 23:     private idleTimer?: NodeJS.Timeout;
 24:     private lastEventTime: number = Date.now();
 25:     private activeMission: Mission | null = null;
 26:     constructor(
 27:         private intensityCalculator: IntensityCalculator,
 28:         private intentInterpreter: MissionIntentInterpreter,
 29:         private bus: SimulationBus
 30:     ) {
 31:         this.psychAdapter = new PsychAdapter();
 32:         const kb = new UnixKnowledgeBase();
 33:         this.adaptiveEngine = new AdaptiveTutorEngine(kb);
 34:         this.activePersona = {
 35:             id: 'default',
 36:             name: 'Default',
 37:             getReaction: () => '...'
 38:         };
 39:         this.initialize();
 40:         this.startIdleTimer();
 41:     }
 42:     public setActiveMission(mission: Mission | null) {
 43:         this.activeMission = mission;
 44:     }
 45:     private initialize() {
 46:         this.bus.subscribe('*', (event) => {
 47:             this.lastEventTime = Date.now();
 48:             this.handleEvent(event);
 49:         });
 50:     }
 51:     private startIdleTimer() {
 52:         if (this.idleTimer) clearInterval(this.idleTimer);
 53:         this.idleTimer = setInterval(() => {
 54:             const idleTime = Date.now() - this.lastEventTime;
 55:             if (idleTime > 20000) {
 56:                 this.triggerIdleObservation();
 57:                 this.lastEventTime = Date.now();
 58:             }
 59:         }, 5000);
 60:     }
 61:     private triggerIdleObservation() {
 62:         const action = this.adaptiveEngine.generateAdvice(
 63:             TutorIntent.IDLE_OBSERVATION,
 64:             this.psychAdapter.getActiveTone(),
 65:             { id: 'M-IDLE', currentStepId: 'idle', grammar: { steps: [] } } as any
 66:         );
 67:         if (action.message) {
 68:             this.emitReaction(action.message, 'info');
 69:         }
 70:     }
 71:     private handleEvent(event: GameEvent) {
 72:         if (event.type === GameEventType.COMMAND_EXECUTED) {
 73:             const success = event.payload.exitCode === 0;
 74:             this.psychAdapter.recordEvent(success ? 'SUCCESS' : 'ERROR');
 75:         } else if (event.type === GameEventType.TUTOR_EVENT && event.payload.type === 'MISTAKE') {
 76:             this.psychAdapter.recordEvent('ERROR');
 77:         }
 78:         const intent = this.determineIntent(event);
 79:         if (!intent) return;
 80:         const chance = this.activePersona.config?.commentChance ?? 0.5;
 81:         const isHighPriority = (event.type === GameEventType.COMMAND_EXECUTED && event.payload.exitCode !== 0) ||
 82:                                (event.type === GameEventType.TUTOR_EVENT && event.payload.type === 'SYSTEM_BOOT');
 83:         const effectiveChance = isHighPriority ? 1.0 : chance;
 84:         if (Math.random() > effectiveChance) return;
 85:         if (!this.activeMission) return;
 86:         const action = this.adaptiveEngine.generateAdvice(
 87:             intent,
 88:             this.psychAdapter.getActiveTone(),
 89:             this.activeMission,
 90:             event.payload?.command
 91:         );
 92:         if (action.message) {
 93:             this.emitReaction(action.message, action.severity?.toLowerCase() || 'info');
 94:         }
 95:     }
 96:     private determineIntent(event: GameEvent): TutorIntent | null {
 97:         switch (event.type) {
 98:             case GameEventType.COMMAND_EXECUTED:
 99:                 if (event.payload.exitCode !== 0) return TutorIntent.REPRIMAND_MISTAKE;
100:                 if (event.payload.command === 'ssh') return TutorIntent.NUDGE_PROGRESSION;
101:                 return null;
102:             case GameEventType.TUTOR_EVENT:
103:                 if (event.payload.type === 'START') return TutorIntent.NUDGE_PROGRESSION;
104:                 if (event.payload.type === 'COMPLETE') return TutorIntent.CELEBRATE_SUCCESS;
105:                 if (event.payload.type === 'MISTAKE') return TutorIntent.REPRIMAND_MISTAKE;
106:                 if (event.payload.type === 'SYSTEM_BOOT') return TutorIntent.SYSTEM_BOOT;
107:                 if (event.payload.type === 'CORRECTION') return TutorIntent.ACCURACY_CRITIQUE;
108:                 if (event.payload.type === 'SPEED_WARNING') return TutorIntent.RHYTHM_REPORT;
109:                 if (event.payload.type === 'PROGRESS' && event.payload.index % 10 === 0) return TutorIntent.INPUT_PROGRESS;
110:                 return null;
111:             case GameEventType.REGISTER_MODIFIED:
112:                 if (event.payload.newValue === 0xDEADBEEF) return TutorIntent.CELEBRATE_SUCCESS;
113:                 return TutorIntent.EXPLAIN_COMMAND;
114:             case GameEventType.MISSION_PROGRESS:
115:                 return TutorIntent.CELEBRATE_SUCCESS;
116:             default:
117:                 return null;
118:         }
119:     }
120:     setPersona(persona: ITutorPersona) {
121:         this.activePersona = persona;
122:     }
123:     public observe(game: IObservableGame) {
124:     }
125:     private emitReaction(text: string, type: string) {
126:         this.reactionListeners.forEach(l => l(text, type));
127:     }
128:     public subscribe(listener: BrainReactionListener): () => void {
129:         this.reactionListeners.push(listener);
130:         return () => {
131:             this.reactionListeners = this.reactionListeners.filter(l => l !== listener);
132:         };
133:     }
134:     public dispose() {
135:         if (this.idleTimer) {
136:             clearInterval(this.idleTimer);
137:             this.idleTimer = undefined;
138:         }
139:     }
140: }
</file>

