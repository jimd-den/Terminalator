 50: }
 51: export interface VariableNode extends ASTNode {
 52:     type: 'Variable';
 53:     name: string;
 54: }
 55: export interface FieldAccessNode extends ASTNode {
 56:     type: 'FieldAccess';
 57:     index: ExpressionNode;
 58: }
 59: export interface AssignExpressionNode extends ASTNode {
 60:     type: 'Assign';
 61:     left: VariableNode | FieldAccessNode;
 62:     op: string;
 63:     right: ExpressionNode;
 64: }
 65: export class AwkParser {
 66:     private tokens: AwkToken[];
 67:     private pos = 0;
 68:     constructor(tokens: AwkToken[]) {
 69:         this.tokens = tokens;
 70:     }
 71:     parse(): ProgramNode {
 72:         const program: ProgramNode = {
 73:             type: 'Program',
 74:             beginBlocks: [],
 75:             endBlocks: [],
 76:             patternActions: []
 77:         };
 78:         while (this.peek().type !== AwkTokenType.EOF) {
 79:             while (this.match(AwkTokenType.NEWLINE));
 80:             if (this.peek().type === AwkTokenType.EOF) break;
 81:             if (this.match(AwkTokenType.BEGIN)) {
 82:                 program.beginBlocks.push(this.parseBlock());
 83:             } else if (this.match(AwkTokenType.END)) {
 84:                 program.endBlocks.push(this.parseBlock());
 85:             } else if (this.peek().type === AwkTokenType.LBRACE) {
 86:                 program.patternActions.push({
 87:                     type: 'PatternAction',
 88:                     action: this.parseBlock()
 89:                 });
 90:             } else {
 91:                 const pattern = this.parseExpression();
 92:                 if (this.peek().type === AwkTokenType.LBRACE) {
 93:                     program.patternActions.push({
 94:                         type: 'PatternAction',
 95:                         pattern: pattern,
 96:                         action: this.parseBlock()
 97:                     });
 98:                 } else {
 99:                     program.patternActions.push({
100:                         type: 'PatternAction',
101:                         pattern: pattern,
102:                         action: { type: 'Block', statements: [{ type: 'Print', args: [] }] }
103:                     });
104:                 }
105:             }
106:         }
107:         return program;
108:     }
109:     private parseBlock(): BlockNode {
110:         this.consume(AwkTokenType.LBRACE, "Expected '{'");
111:         const stmts: StatementNode[] = [];
112:         while (this.peek().type !== AwkTokenType.RBRACE && this.peek().type !== AwkTokenType.EOF) {
113:             while (this.match(AwkTokenType.NEWLINE) || this.match(AwkTokenType.SEMI));
114:             if (this.peek().type === AwkTokenType.RBRACE) break;
115:             stmts.push(this.parseStatement());
116:             while (this.match(AwkTokenType.SEMI));
117:         }
118:         this.consume(AwkTokenType.RBRACE, "Expected '}'");
119:         return { type: 'Block', statements: stmts };
120:     }
121:     private parseStatement(): StatementNode {
122:         const token = this.peek();
123:         if (token.type === AwkTokenType.PRINT) {
124:             this.advance();
125:             const args: ExpressionNode[] = [];
126:             if (!this.isStmtEnd()) {
127:                 do {
128:                     args.push(this.parseExpression());
129:                 } while (this.match(AwkTokenType.COMMA));
130:             }
131:             return { type: 'Print', args };
132:         } else if (token.type === AwkTokenType.IF) {
133:             this.advance();
134:             this.consume(AwkTokenType.LPAREN, "Expected '(' after if");
135:             const cond = this.parseExpression();
136:             this.consume(AwkTokenType.RPAREN, "Expected ')'");
137:             const thenB = this.parseStatement();
138:             let elseB: StatementNode | undefined;
139:             if (this.match(AwkTokenType.ELSE)) {
140:                 elseB = this.parseStatement();
141:             }
142:             return { type: 'If', condition: cond, thenBranch: thenB, elseBranch: elseB };
143:         } else if (token.type === AwkTokenType.LBRACE) {
144:             return this.parseBlock();
145:         }
146:         return this.parseExprStatement();
147:     }
148:     private parseExprStatement(): ExprStatementNode {
149:         const expr = this.parseExpression();
150:         return { type: 'ExprStmt', expr };
151:     }
152:     private parseExpression(): ExpressionNode {
153:         return this.parseAssignment();
154:     }
155:     private parseAssignment(): ExpressionNode {
156:         let left = this.parseLogicalOr();
157:         if (this.match(AwkTokenType.ASSIGN)) {
158:             const right = this.parseAssignment();
159:             if (left.type !== 'Variable' && left.type !== 'FieldAccess') throw new Error("Invalid assignment target");
160:             return { type: 'Assign', left: left as VariableNode | FieldAccessNode, op: '=', right };
161:         }
162:         return left;
163:     }
164:     private parseLogicalOr(): ExpressionNode {
165:         let left = this.parseLogicalAnd();
166:         while (this.match(AwkTokenType.OR)) {
167:             const right = this.parseLogicalAnd();
168:             left = { type: 'Binary', left, op: '||', right };
169:         }
170:         return left;
171:     }
172:     private parseLogicalAnd(): ExpressionNode {
173:         let left = this.parseEquality();
174:         while (this.match(AwkTokenType.AND)) {
175:             const right = this.parseEquality();
176:             left = { type: 'Binary', left, op: '&&', right };
177:         }
178:         return left;
179:     }
180:     private parseEquality(): ExpressionNode {
181:         let left = this.parseComparison();
182:         while (true) {
183:             if (this.match(AwkTokenType.EQ)) left = { type: 'Binary', left, op: '==', right: this.parseComparison() };
184:             else if (this.match(AwkTokenType.NEQ)) left = { type: 'Binary', left, op: '!=', right: this.parseComparison() };
185:             else break;
186:         }
187:         return left;
188:     }
189:     private parseComparison(): ExpressionNode {
190:         let left = this.parseConcat();
191:         while (true) {
192:             if (this.match(AwkTokenType.LT)) left = { type: 'Binary', left, op: '<', right: this.parseConcat() };
193:             else if (this.match(AwkTokenType.GT)) left = { type: 'Binary', left, op: '>', right: this.parseConcat() };
194:             else if (this.match(AwkTokenType.MATCH)) left = { type: 'Binary', left, op: '~', right: this.parseConcat() };
195:             else break;
196:         }
197:         return left;
198:     }
199:     private parseConcat(): ExpressionNode {
200:         let left = this.parseAdditive();
201:         while (this.isStartOfExpression()) {
202:             const right = this.parseAdditive();
203:             left = { type: 'Binary', left, op: 'concat', right };
204:         }
205:         return left;
206:     }
207:     private parseAdditive(): ExpressionNode {
208:         let left = this.parseMultiplicative();
209:         while (true) {
210:             if (this.match(AwkTokenType.PLUS)) left = { type: 'Binary', left, op: '+', right: this.parseMultiplicative() };
211:             else if (this.match(AwkTokenType.MINUS)) left = { type: 'Binary', left, op: '-', right: this.parseMultiplicative() };
212:             else break;
213:         }
214:         return left;
215:     }
216:     private parseMultiplicative(): ExpressionNode {
217:         let left = this.parseUnary();
218:         while (true) {
219:             if (this.match(AwkTokenType.STAR)) left = { type: 'Binary', left, op: '*', right: this.parseUnary() };
220:             else if (this.match(AwkTokenType.SLASH)) left = { type: 'Binary', left, op: '/', right: this.parseUnary() };
221:             else break;
222:         }
223:         return left;
224:     }
225:     private parseUnary(): ExpressionNode {
226:         if (this.match(AwkTokenType.FIELD_REF)) {
227:             const expr = this.parseUnary();
228:             return { type: 'FieldAccess', index: expr };
229:         }
230:         if (this.match(AwkTokenType.NOT)) {
231:             return { type: 'Unary', op: '!', operand: this.parseUnary() };
232:         }
233:         if (this.match(AwkTokenType.MINUS)) {
234:             return { type: 'Unary', op: '-', operand: this.parseUnary() };
235:         }
236:         return this.parsePrimary();
237:     }
238:     private parsePrimary(): ExpressionNode {
239:         const token = this.peek();
240:         if (this.match(AwkTokenType.NUMBER)) return { type: 'Literal', value: parseFloat(token.value), valueType: 'number' };
241:         if (this.match(AwkTokenType.STRING)) return { type: 'Literal', value: token.value, valueType: 'string' };
242:         if (this.match(AwkTokenType.REGEX)) return { type: 'Literal', value: token.value, valueType: 'regex' };
243:         if (this.match(AwkTokenType.IDENTIFIER)) return { type: 'Variable', name: token.value };
244:         if (this.match(AwkTokenType.LPAREN)) {
245:             const expr = this.parseExpression();
246:             this.consume(AwkTokenType.RPAREN, "Expected ')'");
247:             return expr;
248:         }
249:         throw new Error(`Unexpected token: ${token.type} (${token.value})`);
250:     }
251:     private isStartOfExpression(): boolean {
252:         const t = this.peek().type;
253:         return t === AwkTokenType.IDENTIFIER || t === AwkTokenType.NUMBER || t === AwkTokenType.STRING || t === AwkTokenType.FIELD_REF || t === AwkTokenType.LPAREN || t === AwkTokenType.NOT || t === AwkTokenType.MINUS || t === AwkTokenType.REGEX;
254:     }
255:     private isStmtEnd(): boolean {
256:         const t = this.peek().type;
257:         return t === AwkTokenType.SEMI || t === AwkTokenType.NEWLINE || t === AwkTokenType.RBRACE || t === AwkTokenType.EOF;
258:     }
259:     private peek(offset = 0): AwkToken {
260:         return this.tokens[this.pos + offset] || { type: AwkTokenType.EOF, value: '' };
261:     }
262:     private advance(): AwkToken {
263:         return this.tokens[this.pos++] || { type: AwkTokenType.EOF, value: '' };
264:     }
265:     private match(type: AwkTokenType): boolean {
266:         if (this.peek().type === type) {
267:             this.advance();
268:             return true;
269:         }
270:         return false;
271:     }
272:     private consume(type: AwkTokenType, err: string) {
273:         if (!this.match(type)) throw new Error(err);
274:     }
275: }
</file>

<file path="src/domain/commands/core/awk/AwkRuntimeEnvironment.ts">
 1: export class AwkRuntimeEnvironment {
 2:     private vars: Map<string, any> = new Map();
 3:     private fields: string[] = [];
 4:     private record: string = '';
 5:     // Built-in Variables (Special Handling)
 6:     public NR: number = 0;
 7:     public NF: number = 0;
 8:     public FS: string = ' ';
 9:     public OFS: string = ' '; // Default output field separator
10:     constructor() {
11:         this.vars.set('NR', 0);
12:         this.vars.set('NF', 0);
13:         this.vars.set('FS', ' ');
14:         this.vars.set('OFS', ' ');
15:     }
16:     public updateFields(line: string) {
17:         this.record = line;
18:         this.NR++;
19:         this.vars.set('NR', this.NR);
20:         if (this.FS === ' ') {
21:             this.fields = line.trim().split(/\s+/);
22:             if (line.trim() === '') this.fields = [];
23:         } else {
24:             this.fields = line.split(this.FS);
25:         }
26:         this.NF = this.fields.length;
27:         this.vars.set('NF', this.NF);
28:     }
29:     public getField(index: number): any {
30:         if (index === 0) return this.record;
31:         if (index < 0) throw new Error("Field index cannot be negative");
32:         if (index > this.fields.length) return ""; // Awk returns empty for out of bounds
33:         return this.fields[index - 1];
34:     }
35:     public setField(index: number, value: any) {
36:         if (index === 0) {
37:             this.record = String(value);
38:             // Re-splitting needed? Or just update $0?
39:             // "If $0 is changed, fields are re-split."
40:             this.updateFields(this.record); // This increments NR! WRONG!
41:             // We should split without incrementing NR.
42:             this.reSplit();
43:             return;
44:         }
45:         // Updating $i rebuilds $0?
46:         // "If a field is changed, $0 is rebuilt using OFS."
47:         this.fields[index - 1] = String(value);
48:         this.NF = Math.max(this.NF, index);
49:         this.vars.set('NF', this.NF);
50:         // Rebuild $0
51:         this.record = this.fields.join(this.OFS);
52:     }
53:     private reSplit() {
54:         if (this.FS === ' ') {
55:             this.fields = this.record.trim().split(/\s+/);
56:             if (this.record.trim() === '') this.fields = [];
57:         } else {
58:             this.fields = this.record.split(this.FS);
59:         }
60:         this.NF = this.fields.length;
61:         this.vars.set('NF', this.NF);
62:     }
63:     public getVar(name: string): any {
64:         // Intercept Built-ins if needed, or rely on them being in map.
65:         // Optimizing for simple Map
66:         return this.vars.get(name) ?? ""; // Uninitialized is ""/0
67:     }
68:     public setVar(name: string, value: any) {
69:         this.vars.set(name, value);
70:         if (name === 'FS') this.FS = String(value);
71:         if (name === 'OFS') this.OFS = String(value);
72:         if (name === 'NR') this.NR = Number(value);
73:         if (name === 'NF') this.NF = Number(value);
74:     }
75: }
</file>

