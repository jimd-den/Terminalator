16:         return {
17:             verb: TheatricalVerb.SYNTHESIZE,
18:             style: 'NORMAL'
19:         };
20:     }
21:     protected async executeInternal(
22:         rawArgs: string[],
23:         flags: Set<string>,
24:         operands: string[],
25:         context: ProcessContext,
26:         state: TerminalState
27:     ): Promise<CommandResponse> {
28:         const fsService = context.fileSystemService || this.fs;
29:         const noCreate = flags.has('c');
30:         if (operands.length === 0) {
31:             return {
32:                 output: 'touch: missing operand',
33:                 newState: state,
34:                 exitCode: 1
35:             };
