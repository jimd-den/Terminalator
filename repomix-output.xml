<file path="src/domain/commands/core/PrintfCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class PrintfCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         if (args.length === 0) {
13:             return { output: 'printf: usage: printf format [arguments...]', newState: state, exitCode: 1 };
14:         }
15:         const format = args[0];
16:         const params = args.slice(1);
17:         let output = '';
18:         let paramIndex = 0;
19:         // Simple loop to handle format reuse if more params than specs
20:         // Loop at least once
21:         do {
22:             const startParamIndex = paramIndex;
23:             let i = 0;
24:             // Unescape the format string first?
25:             // POSIX: interpreted sequences like \n, \t
26:             let currentFormat = this.unescape(format);
27:             // Actually, we should parse % specifiers and consume params.
28:             // But we must also unescape.
29:             // Let's iterate through the unescaped string looking for %.
30:             let result = '';
31:             for (let j = 0; j < currentFormat.length; j++) {
32:                 if (currentFormat[j] === '%' && currentFormat[j + 1] !== '%') {
33:                     // Specifier found
34:                     const spec = currentFormat[j + 1]; // Simplified: assume 1 char spec like %s, %d. No width/precision yet.
35:                     // TODO: Improve specifier parsing for flags/width/precision.
36:                     let replacement = '';
37:                     if (paramIndex < params.length) {
38:                         const arg = params[paramIndex++];
39:                         if (spec === 's') {
40:                             replacement = arg;
41:                         } else if (spec === 'd' || spec === 'i') {
42:                             const val = parseInt(arg);
43:                             replacement = isNaN(val) ? '0' : val.toString();
44:                         } else {
45:                             replacement = `%${spec}`;
46:                             paramIndex--;
47:                         }
48:                     } else {
49:                         if (spec === 's') replacement = '';
50:                         else if (spec === 'd' || spec === 'i') replacement = '0';
51:                     }
52:                     result += replacement;
53:                     j++;
54:                 } else if (currentFormat[j] === '%' && currentFormat[j + 1] === '%') {
55:                     result += '%';
56:                     j++;
57:                 } else {
58:                     result += currentFormat[j];
59:                 }
60:             }
61:             if (paramIndex === 0 && params.length > 0 && result === currentFormat) {
62:                 break;
63:             }
64:             if (paramIndex === startParamIndex && paramIndex < params.length) {
65:                 break;
66:             }
67:             output += result;
68:         } while (paramIndex < params.length);
69:         return {
70:             output: output,
71:             newState: state,
72:             exitCode: 0
73:         };
74:     }
75:     private unescape(str: string): string {
76:         return str
77:             .replace(/\\n/g, '\n')
78:             .replace(/\\t/g, '\t')
79:             .replace(/\\\\/g, '\\')
80:             .replace(/\\'/g, '\'')
81:             .replace(/\\"/g, '"');
82:     }
83: }
