<file path="src/domain/commands/core/RealpathCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class RealpathCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         const files = args.filter(a => !a.startsWith('-'));
13:         if (files.length === 0) {
14:             return { output: 'realpath: missing operand', newState: state, exitCode: 1 };
15:         }
16:         const file = files[0];
17:         try {
18:             let absPath = this.resolvePath(file, state);
19:             absPath = this.normalize(absPath);
20:             const node = this.fs.resolve(absPath);
21:             if (!node) {
22:                 return { output: `realpath: ${file}: No such file or directory`, newState: state, exitCode: 1 };
23:             }
24:             return {
25:                 output: absPath,
26:                 newState: state,
27:                 exitCode: 0
28:             };
29:         } catch (e: any) {
30:             return { output: `realpath: ${file}: ${e.message}`, newState: state, exitCode: 1 };
31:         }
32:     }
33:     private resolvePath(path: string, state: TerminalState): string {
34:         if (path.startsWith('/')) return path;
35:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
36:     }
37:     private normalize(path: string): string {
38:         const parts = path.split('/');
39:         const stack: string[] = [];
40:         for (const part of parts) {
41:             if (part === '' || part === '.') continue;
42:             if (part === '..') {
43:                 if (stack.length > 0) stack.pop();
44:             } else {
45:                 stack.push(part);
46:             }
47:         }
48:         return '/' + stack.join('/');
49:     }
50: }
</file>

