<file path="src/domain/commands/core/WaitCommand.ts">
 1: import { ICommand, CommandResponse } from '../ICommand';
 2: import { ProcessContext } from '../../entities/ProcessContext';
 3: import { TerminalState } from '../../entities/TerminalState';
 4: import { FileSystemService } from '../../services/FileSystemService';
 5: export class WaitCommand implements ICommand {
 6:     constructor(private fs: FileSystemService) { }
 7:     execute(
 8:         args: string[],
 9:         context: ProcessContext,
10:         state: TerminalState
11:     ): CommandResponse {
12:         const jobControl = context.jobControl;
13:         const pids: string[] = [];
14:         for (const arg of args) {
15:             if (arg.startsWith('%') || !arg.startsWith('-')) {
16:                 pids.push(arg);
17:             } else if (arg === '--') {
18:                 continue;
19:             } else {
20:                 const num = parseInt(arg, 10);
21:                 if (!isNaN(num)) {
22:                     pids.push(arg);
23:                 }
24:             }
25:         }
26:         if (pids.length === 0) {
27:             if (jobControl) {
28:                 jobControl.waitFor('');
29:             }
30:             return {
31:                 output: '',
32:                 newState: state,
33:                 exitCode: 0
34:             };
35:         }
36:         // Wait for each specified PID/job
37:         let lastExitCode = 0;
38:         const errors: string[] = [];
39:         for (const pid of pids) {
40:             // Validate PID format
41:             if (!pid.startsWith('%')) {
42:                 const num = parseInt(pid, 10);
43:                 if (isNaN(num)) {
44:                     errors.push(`wait: ${pid}: not a valid pid or job spec`);
45:                     lastExitCode = 1;
46:                     continue;
47:                 }
48:             }
49:             // Wait for the process
50:             if (jobControl) {
51:                 // First try as job spec or known PID
52:                 const job = jobControl.resolveJobSpec(pid);
53:                 if (job) {
54:                     lastExitCode = jobControl.waitFor(pid);
55:                 } else if (pid.startsWith('%')) {
56:                     // Job spec for unknown job = 127
57:                     lastExitCode = 127;
58:                 } else {
59:                     // Unknown numeric PID - simulate completed process (exit 0)
60:                     // In a real system, we'd check if it's a child process
61:                     lastExitCode = 0;
62:                 }
63:             } else {
64:                 if (pid.startsWith('%')) {
65:                     lastExitCode = 127;
66:                 } else {
67:                     lastExitCode = 0;
68:                 }
69:             }
70:         }
71:         return {
72:             output: errors.length > 0 ? errors.join('\n') : '',
73:             newState: state,
74:             exitCode: lastExitCode
75:         };
76:     }
77: }
