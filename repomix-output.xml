 9: export class MvCommand extends CommandBase {
10:     public readonly capabilities = [CommandCapability.MODIFY];
11:     public readonly utility = 'mv';
12:     constructor(private fsService: FileSystemService) { super(); }
13:     public getMetadata(): CommandMetadata {
14:         return {
15:             verb: TheatricalVerb.UPLINK,
16:             style: 'NORMAL'
17:         };
18:     }
19:     executeInternal(args: string[], flags: Set<string>, operands: string[], context: ProcessContext, state: TerminalState): CommandResponse {
20:         const fsService = context.fileSystemService || this.fsService;
21:         if (operands.length < 2) {
22:             return {
23:                 output: 'mv: missing file operand',
24:                 newState: state,
25:                 exitCode: 1
26:             };
27:         }
28:         const sources = operands.slice(0, operands.length - 1);
29:         const destination = operands[operands.length - 1];
30:         const destPath = fsService.resolveAbsolutePath(destination, state.currentDirectory);
31:         const destNode = fsService.resolve(destPath);
32:         const destIsDir = destNode ? fsService.isDirectory(destNode) : destination.endsWith('/');
33:         if (sources.length > 1 && destNode && !destIsDir) {
34:             return {
35:                 output: `mv: target '${destination}' is not a directory`,
36:                 newState: state,
37:                 exitCode: 1
38:             };
39:         }
40:         for (const source of sources) {
41:             const srcPath = fsService.resolveAbsolutePath(source, state.currentDirectory);
42:             const srcNode = fsService.resolve(srcPath);
43:             if (!srcNode) {
44:                 return {
45:                     output: `mv: cannot stat '${source}': No such file or directory`,
46:                     newState: state,
47:                     exitCode: 1
48:                 };
49:             }
50:             if (fsService.isDirectory(srcNode) && destNode && !fsService.isDirectory(destNode)) {
51:                 return {
52:                     output: `mv: cannot overwrite non-directory '${destination}' with directory '${source}'`,
53:                     newState: state,
54:                     exitCode: 1
55:                 };
56:             }
57:             try {
58:                 let finalDest = destPath;
59:                 if (destIsDir) {
60:                     finalDest = destPath === '/' ? `/${srcNode.name}` : `${destPath}/${srcNode.name}`;
61:                 }
62:                 if (srcPath === finalDest) {
63:                     continue;
64:                 }
65:                 fsService.rename(srcPath, finalDest);
66:             } catch (e: any) {
67:                 return {
68:                     output: `mv: cannot move '${source}' to '${destination}': ${e.message}`,
69:                     newState: state,
70:                     exitCode: 1
71:                 };
72:             }
73:         }
74:         return {
75:             output: '',
76:             newState: state,
77:             exitCode: 0
78:         };
79:     }
80: }
