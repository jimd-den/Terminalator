<file path="src/domain/commands/core/SortCommand.ts">
  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { CommandBase } from '../CommandBase';
  3: import { CommandCapability } from '../IStructuredCommand';
  4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  5: import { TerminalState } from '../../entities/TerminalState';
  6: import { CommandResponse } from '../../entities/Command';
  7: import { FileSystemService } from '../../services/FileSystemService';
  8: interface SortOptions {
  9:     reverse: boolean;
 10:     numeric: boolean;
 11:     unique: boolean;
 12:     check: boolean;
 13:     key?: number;
 14:     outputFile?: string;
 15:     files: string[];
 16: }
 17: export class SortCommand extends CommandBase {
 18:     public readonly capabilities = [CommandCapability.TRANSFORM];
 19:     public readonly utility = 'sort';
 20:     constructor(private fs: FileSystemService) {
 21:         super();
 22:     }
 23:     protected override parseArgs(args: string[]) {
 24:         super.parseArgs(args, ['o', 'k']);
 25:     }
 26:     protected async executeInternal(
 27:         rawArgs: string[],
 28:         flags: Set<string>,
 29:         operands: string[],
 30:         context: ProcessContext,
 31:         state: TerminalState
 32:     ): Promise<CommandResponse> {
 33:         const input = getStdinAsString(context);
 34:         const options: SortOptions = {
 35:             reverse: flags.has('r'),
 36:             numeric: flags.has('n'),
 37:             unique: flags.has('u'),
 38:             check: flags.has('c'),
 39:             outputFile: this.options.get('o'),
 40:             key: this.options.get('k') ? parseInt(this.options.get('k')!) : undefined,
 41:             files: operands
 42:         };
 43:         let content = '';
 44:         if (options.files.length > 0) {
 45:             for (const file of options.files) {
 46:                 if (file === '-') {
 47:                     content += (input || '') + '\n';
 48:                     continue;
 49:                 }
 50:                 try {
 51:                     const resolvedPath = this.resolvePath(file, state);
 52:                     content += this.fs.readFile(resolvedPath) + '\n';
 53:                 } catch (e) {
 54:                     return {
 55:                         output: `sort: ${file}: No such file or directory`,
 56:                         newState: state,
 57:                         exitCode: 1
 58:                     };
 59:                 }
 60:             }
 61:             if (content.endsWith('\n')) content = content.slice(0, -1);
 62:         } else if (input !== undefined) {
 63:             content = input;
 64:         } else {
 65:             return { output: '', newState: state, exitCode: 0 };
 66:         }
 67:         let lines = content.split('\n');
 68:         if (content.endsWith('\n') && lines[lines.length - 1] === '') {
 69:             lines.pop();
 70:         }
 71:         if (options.unique) {
 72:             lines = Array.from(new Set(lines));
 73:         }
 74:         const compare = (a: string, b: string) => {
 75:             let valA = a;
 76:             let valB = b;
 77:             if (options.key) {
 78:                 const partsA = a.trim().split(/\s+/);
 79:                 const partsB = b.trim().split(/\s+/);
 80:                 valA = partsA[options.key - 1] || '';
 81:                 valB = partsB[options.key - 1] || '';
 82:             }
 83:             let res = 0;
 84:             if (options.numeric) {
 85:                 const numA = parseFloat(valA);
 86:                 const numB = parseFloat(valB);
 87:                 if (!isNaN(numA) && !isNaN(numB)) {
 88:                     res = numA - numB;
 89:                 } else {
 90:                     res = valA.localeCompare(valB);
 91:                 }
 92:             } else {
 93:                 res = valA.localeCompare(valB);
 94:             }
 95:             return options.reverse ? -res : res;
 96:         };
 97:         if (options.check) {
 98:             for (let i = 0; i < lines.length - 1; i++) {
 99:                 if (compare(lines[i], lines[i + 1]) > 0) {
100:                     return {
101:                         output: `sort: disorder: ${lines[i + 1]}`,
102:                         newState: state,
103:                         exitCode: 1
104:                     };
105:                 }
106:             }
107:             return { output: '', newState: state, exitCode: 0 };
108:         }
109:         lines.sort(compare);
110:         const result = lines.join('\n');
111:         if (options.outputFile) {
112:             try {
113:                 const resolvedOut = this.resolvePath(options.outputFile, state);
114:                 this.fs.writeFile(resolvedOut, result);
115:                 return { output: '', newState: state, exitCode: 0 };
116:             } catch (e) {
117:                 return { output: `sort: ${options.outputFile}: Cannot write`, newState: state, exitCode: 1 };
118:             }
119:         }
120:         return {
121:             output: result,
122:             newState: state,
123:             exitCode: 0
124:         };
125:     }
126:     private resolvePath(path: string, state: TerminalState): string {
127:         if (path.startsWith('/')) return path;
128:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
129:     }
130: }
</file>

<file path="src/domain/commands/core/SplitCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystem } from '../../entities/FileSystem';
 8: export class SplitCommand implements ICommand {
 9:     constructor(private fs: FileSystemService) { }
10:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse {
11:         const input = getStdinAsString(context);
12:         let lineCount = 1000;
13:         let suffixLength = 2;
14:         const operands: string[] = [];
15:         for (let i = 0; i < args.length; i++) {
16:             const arg = args[i];
17:             if (arg === '-l') {
18:                 lineCount = parseInt(args[++i], 10) || 1000;
19:             } else if (arg === '-a') {
20:                 suffixLength = parseInt(args[++i], 10) || 2;
21:             } else if (!arg.startsWith('-')) {
22:                 operands.push(arg);
23:             }
24:         }
25:         let content = '';
26:         let prefix = 'x';
27:         if (operands.length > 0) {
28:             const file = operands[0];
29:             if (file === '-') {
30:                 content = input || '';
31:             } else {
32:                 try {
33:                     content = this.fs.readFile(this.resolvePath(file, state));
34:                 } catch (e) {
35:                     return { output: `split: ${file}: No such file`, newState: state, exitCode: 1 };
36:                 }
37:             }
38:             if (operands.length > 1) {
39:                 prefix = operands[1];
40:             }
41:         } else {
42:             content = input || '';
43:         }
44:         const lines = content.split('\n');
45:         if (content.endsWith('\n') && lines[lines.length - 1] === '') lines.pop();
46:         let chunkIndex = 0;
47:         for (let i = 0; i < lines.length; i += lineCount) {
48:             const chunk = lines.slice(i, i + lineCount);
49:             // Reconstruct content
50:             // Be careful: if original had newlines, we add them back.
51:             // Split output files usually end with newline unless original didn't?
52:             const chunkContent = chunk.join('\n') + '\n';
53:             const suffix = this.generateSuffix(chunkIndex, suffixLength);
54:             const filename = prefix + suffix;
55:             const path = state.currentDirectory === '/' ? `/${filename}` : `${state.currentDirectory}/${filename}`;
56:             try {
57:                 this.fs.writeFile(path, chunkContent, 'w');
58:             } catch (e) {
59:                 return { output: `split: cannot write ${filename}`, newState: state, exitCode: 1 };
60:             }
61:             chunkIndex++;
62:         }
63:         return {
64:             output: '', // No output on success
65:             newState: state,
66:             exitCode: 0
67:         };
68:     }
69:     private resolvePath(path: string, state: TerminalState): string {
70:         if (path.startsWith('/')) return path;
71:         return state.currentDirectory === '/' ? `/${path}` : `${state.currentDirectory}/${path}`;
72:     }
73:     private generateSuffix(index: number, length: number): string {
74:         // Base 26: a-z
75:         let suffix = '';
76:         let temp = index;
77:         for (let i = 0; i < length; i++) {
78:             const charCode = 97 + (temp % 26); // 'a' is 97
79:             suffix = String.fromCharCode(charCode) + suffix;
80:             temp = Math.floor(temp / 26);
81:         }
82:         let res = '';
83:         for (let i = 0; i < length; i++) {
84:             const val = Math.floor(index / Math.pow(26, length - 1 - i)) % 26;
85:             res += String.fromCharCode(97 + val);
86:         }
87:         return res;
88:     }
89: }
</file>

<file path="src/domain/commands/core/StringsCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
