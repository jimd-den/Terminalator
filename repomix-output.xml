<file path="src/domain/services/ArithmeticEvaluator.ts">
 1: export class ArithmeticEvaluator {
 2:     evaluate(expression: string): number {
 3:         const expr = expression.replace(/\s+/g, '');
 4:         if (!expr) return 0;
 5:         try {
 6:             return this.parseExpression(expr);
 7:         } catch (e: any) {
 8:             throw new Error(`Arithmetic error: ${e.message}`);
 9:         }
10:     }
11:     // Recursive Descent Parser for Math
12:     // Expr -> Term {(+,-) Term}*
13:     // Term -> Factor {(*,/,%) Factor}*
14:     // Factor -> Number | (Expr)
15:     private pos = 0;
16:     private input = '';
17:     private parseExpression(str: string): number {
18:         this.input = str;
19:         this.pos = 0;
20:         return this.parseAddSub();
21:     }
22:     private peek(): string {
23:         return this.input[this.pos] || '';
24:     }
25:     private consume(): string {
26:         return this.input[this.pos++] || '';
27:     }
28:     private parseAddSub(): number {
29:         let left = this.parseTerm();
30:         while (this.peek() === '+' || this.peek() === '-') {
31:             const op = this.consume();
32:             const right = this.parseTerm();
33:             if (op === '+') left += right;
34:             else left -= right;
35:         }
36:         return left;
37:     }
38:     private parseTerm(): number {
39:         let left = this.parseFactor();
40:         while (this.peek() === '*' || this.peek() === '/' || this.peek() === '%') {
41:             const op = this.consume();
42:             const right = this.parseFactor();
43:             if (op === '*') left *= right;
44:             else if (op === '/') {
45:                 if (right === 0) throw new Error('Division by zero');
46:                 left = Math.floor(left / right);
47:             }
48:             else if (op === '%') {
49:                 if (right === 0) throw new Error('Modulo by zero');
50:                 left = left % right;
51:             }
52:         }
53:         return left;
54:     }
55:     private parseFactor(): number {
56:         const char = this.peek();
57:         if (char === '(') {
58:             this.consume();
59:             const val = this.parseAddSub();
60:             if (this.consume() !== ')') throw new Error('Mismatched parentheses');
61:             return val;
62:         }
63:         if (/[0-9]/.test(char)) {
64:             return this.parseNumber();
65:         }
66:         if (char === '-') {
67:             this.consume();
68:             return -this.parseFactor();
69:         }
70:         if (char === '') throw new Error('Unexpected end of expression');
71:         throw new Error(`Unexpected character: ${char}`);
72:     }
73:     private parseNumber(): number {
74:         let res = '';
75:         while (/[0-9]/.test(this.peek())) {
76:             res += this.consume();
77:         }
78:         return parseInt(res, 10);
79:     }
80: }
</file>

<file path="src/domain/services/AutocompleteService.ts">
 1: import { FileSystemService } from './FileSystemService';
 2: import { DirectoryNode } from '../entities/filesystem/DirectoryNode';
 3: export class AutocompleteService {
 4:     private readonly commands = [
 5:         'help', 'ls', 'cd', 'cat', 'whoami', 'mail',
 6:         'check-comms', 'clear', 'vim', 'man', 'grep',
 7:         'jobs', 'kill', 'ps', 'bg', 'fg'
 8:     ];
 9:     constructor(private fsService: FileSystemService) { }
10:     public getSuggestion(input: string, cwd: string): string {
11:         if (!input) return '';
12:         const parts = input.split(' ');
13:         const cmd = parts[0];
14:         // 1. Command Autocomplete
15:         if (parts.length === 1) {
16:             const match = this.commands.find(c => c.startsWith(input.toLowerCase()) && c !== input.toLowerCase());
17:             return match ? match.substring(input.length) : '';
18:         }
19:         // 2. File Autocomplete
20:         let lookingForFile = false;
21:         let partialName = '';
22:         // Commands that expect a file argument
23:         // TODO: Make this extensible or part of Command Definition
24:         if (['cd', 'cat', 'vim', 'ls', 'rm', 'touch', 'mkdir'].includes(cmd) && parts.length === 2) {
25:             lookingForFile = true;
26:             partialName = parts[1];
27:         } else if (cmd === 'grep' && parts.length === 3) {
28:             lookingForFile = true;
29:             partialName = parts[2];
30:         }
31:         if (lookingForFile) {
32:             try {
33:                 const node = this.fsService.resolve(cwd);
34:                 if (node && node.isDirectory()) {
35:                     const dirNode = node as DirectoryNode;
36:                     const files = Array.from(dirNode.children.keys());
37:                     const match = files.find(f => f.startsWith(partialName) && f !== partialName);
38:                     return match ? match.substring(partialName.length) : '';
39:                 }
40:             } catch (e) {
41:                 // Ignore FS errors during autocomplete
42:                 return '';
43:             }
44:         }
45:         return '';
46:     }
47: }
</file>

