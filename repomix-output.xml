143: /**
144:  * SequentialCommandEcho - Handles the 3-stage materialization of a command line.
145:  * Stage 1: COMMAND: [cmd] (Typed)
146:  * Stage 2: ...... (Dots Typed)
147:  * Stage 3: STATUS / CONTROLS (Revealed)
148:  */
149: const SequentialCommandEcho = ({
150:     line, index, styles, colors, settings, onSave, onMinimize, onDelete, onComplete, isActive, isTyped
151: }: {
152:     line: TerminalOutputLine,
153:     index: number,
154:     styles: any,
155:     colors: any,
