21:         if (event.type === GameEventType.COMMAND_EXECUTED) {
22:             const success = event.payload.exitCode === 0;
23:             this.psychAdapter.recordEvent(success ? 'SUCCESS' : 'ERROR');
24:         }
25:         const intent = this.determineIntent(event);
26:         if (!intent) return;
27:         const context = ContextBuilder.buildFromEvent(event);
28:         const action = CombinatorialUtteranceEngine.generate(
29:             intent,
30:             this.psychAdapter.getActiveTone(),
31:             context,
32:             INITIAL_TEMPLATE_CATALOG,
33:             'current-mission'
34:         );
35:         this.reactionListeners.forEach(l => l(action));
36:     }
37:     private determineIntent(event: GameEvent): TutorIntent | null {
38:         switch (event.type) {
39:             case GameEventType.COMMAND_EXECUTED:
40:                 if (event.payload.exitCode !== 0) return TutorIntent.REPRIMAND_MISTAKE;
41:                 if (event.payload.command === 'ssh') return TutorIntent.NUDGE_PROGRESSION;
42:                 return null;
43:             case GameEventType.REGISTER_MODIFIED:
44:                 if (event.payload.newValue === 0xDEADBEEF) return TutorIntent.CELEBRATE_SUCCESS;
45:                 return TutorIntent.EXPLAIN_COMMAND;
46:             case GameEventType.MISSION_PROGRESS:
47:                 return TutorIntent.CELEBRATE_SUCCESS;
48:             default:
49:                 return null;
50:         }
51:     }
