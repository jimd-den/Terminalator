168:         if (!dentry) throw new Error(`readlink: cannot access '${path}': No such file or directory`);
169:         const inode = this.getInode(dentry.inodeId)!;
170:         if (!(inode.mode & S_IFLNK)) throw new Error(`readlink: '${path}': Invalid argument`);
171:         return inode.target || '';
