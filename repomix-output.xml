 2: import { TokenType } from '../ShellLexer';
 3: import { IStatementParser } from './IStatementParser';
 4: import { IShellParserFacade } from './IShellParserFacade';
 5: export class IfParser implements IStatementParser {
 6:     canHandle(facade: IShellParserFacade): boolean {
 7:         const token = facade.peek();
 8:         return token.type === TokenType.WORD && token.value === 'if';
 9:     }
10:     parse(facade: IShellParserFacade): ASTNode {
11:         facade.advance();
12:         const condition = facade.parseList();
13:         while (facade.peek().type === TokenType.NEWLINE || facade.peek().type === TokenType.SEMI) {
14:             facade.advance();
15:         }
16:         if (facade.peek().value !== 'then') {
17:             throw new Error(`Syntax Error: Expected 'then' at position ${facade.peek().position}`);
18:         }
19:         facade.advance();
20:         const thenBody = facade.parseList();
21:         let elseBody: ASTNode | undefined;
22:         while (facade.peek().type === TokenType.NEWLINE || facade.peek().type === TokenType.SEMI) {
23:             facade.advance();
24:         }
25:         const nextWord = facade.peek().value;
26:         if (nextWord === 'else') {
27:             facade.advance();
28:             elseBody = facade.parseList() || undefined;
29:         } else if (nextWord === 'elif') {
30:             elseBody = this.parse(facade);
31:         }
32:         while (facade.peek().type === TokenType.NEWLINE || facade.peek().type === TokenType.SEMI) {
33:             facade.advance();
34:         }
35:         if (facade.peek().value !== 'fi') {
36:             throw new Error(`Syntax Error: Expected 'fi' at position ${facade.peek().position}`);
37:         }
38:         facade.advance();
39:         return {
40:             type: NodeType.IF,
41:             condition: condition!,
42:             thenBody: thenBody!,
43:             elseBody: elseBody
44:         } as IfNode;
45:     }
46: }
