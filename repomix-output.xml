<file path="src/interface-adapters/vim/highlighters/AsmHighlighter.ts">
 1: import { SyntaxHighlighter, HighlightToken } from '../../../domain/ports/SyntaxHighlighter';
 2: export class AsmHighlighter implements SyntaxHighlighter {
 3:     readonly language = 'asm';
 4:     highlight(line: string): HighlightToken[] {
 5:         const tokens: HighlightToken[] = [];
 6:         let remaining = line;
 7:         const keywords = [
 8:             'add', 'sub', 'addi', 'lw', 'sw', 'beq', 'bne', 'jal', 'jalr',
 9:             'li', 'mv', 'nop', 'ecall', 'la', 'lui', 'auipc'
10:         ];
11:         const registers = [
12:             'zero', 'ra', 'sp', 'gp', 'tp', 't0', 't1', 't2',
13:             's0', 'fp', 's1', 'a0', 'a1', 'a2', 'a3', 'a4', 'a5',
14:             'a6', 'a7', 's2', 's3', 's4', 's5', 's6', 's7',
15:             's8', 's9', 's10', 's11', 't3', 't4', 't5', 't6'
16:         ];
17:         while (remaining.length > 0) {
18:             const commentMatch = remaining.match(/^;.*/);
19:             if (commentMatch) {
20:                 tokens.push({ text: commentMatch[0], type: 'comment' });
21:                 break;
22:             }
23:             const labelMatch = remaining.match(/^[a-zA-Z_][a-zA-Z0-9_]*:/);
24:             if (labelMatch) {
25:                 tokens.push({ text: labelMatch[0], type: 'keyword' });
26:                 remaining = remaining.slice(labelMatch[0].length);
27:                 continue;
28:             }
29:             const stringMatch = remaining.match(/^".*?"/);
30:             if (stringMatch) {
31:                 tokens.push({ text: stringMatch[0], type: 'string' });
32:                 remaining = remaining.slice(stringMatch[0].length);
33:                 continue;
34:             }
35:             const wordMatch = remaining.match(/^[a-zA-Z0-9_]+/);
36:             if (wordMatch) {
37:                 const word = wordMatch[0];
38:                 if (keywords.includes(word.toLowerCase())) {
39:                     tokens.push({ text: word, type: 'keyword' });
40:                 } else if (registers.includes(word.toLowerCase())) {
41:                     tokens.push({ text: word, type: 'number' });
42:                 } else {
43:                     tokens.push({ text: word, type: 'plain' });
44:                 }
45:                 remaining = remaining.slice(word.length);
46:                 continue;
47:             }
48:             const numberMatch = remaining.match(/^-?\d+/);
49:             if (numberMatch) {
50:                 tokens.push({ text: numberMatch[0], type: 'number' });
51:                 remaining = remaining.slice(numberMatch[0].length);
52:                 continue;
53:             }
54:             const punctMatch = remaining.match(/^[,()]/);
55:             if (punctMatch) {
56:                 tokens.push({ text: punctMatch[0], type: 'operator' });
57:                 remaining = remaining.slice(1);
58:                 continue;
59:             }
60:             const wsMatch = remaining.match(/^\s+/);
61:             if (wsMatch) {
62:                 tokens.push({ text: wsMatch[0], type: 'plain' });
63:                 remaining = remaining.slice(wsMatch[0].length);
64:                 continue;
65:             }
66:             tokens.push({ text: remaining[0], type: 'plain' });
67:             remaining = remaining.slice(1);
68:         }
69:         return tokens;
