  1: import { useState, useEffect, useRef, useCallback } from 'react';
  2: import { TutorEngine, TutorEvent, TutorEmotion, Lesson } from '../../domain/entities/TutorEngine';
  3: import { TerminalState } from '../../domain/entities/TerminalState';
  4: export interface TutorControllerState {
  5:     emotion: TutorEmotion;
  6:     crashingIndices: number[];
  7:     isActive: boolean;
  8: }
  9: export interface TutorControllerCallbacks {
 10:     onStart: (lesson: Lesson, targetCwd: string) => void;
 11:     onStop: (originalCwd: string | null) => void;
 12:     onProgress: (input: string, ghostText: string) => void;
 13:     onCorrection: (input: string, ghostText: string) => void;
 14:     onMistake: (input: string, ghostText: string, droppedCount: number) => void;
 15:     onComplete: (payload: { lesson: Lesson, stats: any }, originalCwd: string | null) => void;
 16: }
 17: export const useTutorController = (
 18:     tutorEngine: TutorEngine,
 19:     callbacks: TutorControllerCallbacks,
 20:     currentCwd: string
 21: ): TutorControllerState => {
 22:     const [emotion, setEmotion] = useState<TutorEmotion>(TutorEmotion.NORMAL);
 23:     const [crashingIndices, setCrashingIndices] = useState<number[]>([]);
 24:     const [isActive, setIsActive] = useState(false);
 25:     const cwdRef = useRef(currentCwd);
 26:     const preTutorCwdRef = useRef<string | null>(null);
 27:     const callbacksRef = useRef(callbacks);
 28:     useEffect(() => {
 29:         cwdRef.current = currentCwd;
 30:     }, [currentCwd]);
 31:     useEffect(() => {
 32:         callbacksRef.current = callbacks;
 33:     }, [callbacks]);
 34:     useEffect(() => {
 35:         const unsubscribe = tutorEngine.subscribe((event: TutorEvent) => {
 36:             const engine = tutorEngine;
 37:             const cb = callbacksRef.current;
 38:             switch (event.type) {
 39:                 case 'START': {
 40:                     const lesson = event.payload as Lesson;
 41:                     preTutorCwdRef.current = cwdRef.current;
 42:                     const targetCwd = (lesson as any).cwd || '/home/operator';
 43:                     setIsActive(true);
 44:                     cb.onStart(lesson, targetCwd);
 45:                     break;
 46:                 }
 47:                 case 'STOP': {
 48:                     const original = preTutorCwdRef.current;
 49:                     preTutorCwdRef.current = null;
 50:                     setIsActive(false);
 51:                     cb.onStop(original);
 52:                     break;
 53:                 }
 54:                 case 'EMOTION_CHANGE': {
 55:                     setEmotion(event.payload as TutorEmotion);
 56:                     break;
 57:                 }
 58:                 case 'CORRECTION': {
 59:                     const completed = engine.getCompletedText();
 60:                     const badChar = event.payload.actual;
 61:                     const ghostText = engine.getGhostText();
 62:                     cb.onCorrection(completed + badChar, ghostText);
 63:                     setTimeout(() => {
 64:                         cb.onProgress(completed, ghostText);
 65:                     }, 200);
 66:                     break;
 67:                 }
 68:                 case 'PROGRESS': {
 69:                     cb.onProgress(engine.getCompletedText(), engine.getGhostText());
 70:                     break;
 71:                 }
 72:                 case 'MISTAKE': {
 73:                     const droppedCount = event.payload.dropped;
 74:                     const completed = engine.getCompletedText();
 75:                     const startIdx = completed.length;
 76:                     const endIdx = startIdx + droppedCount;
 77:                     const indices: number[] = [];
 78:                     for (let i = startIdx; i < endIdx; i++) {
 79:                         indices.push(i);
 80:                     }
 81:                     setCrashingIndices(indices);
 82:                     setTimeout(() => {
 83:                         cb.onMistake(completed, engine.getGhostText(), droppedCount);
 84:                         setCrashingIndices([]);
 85:                     }, 400);
 86:                     break;
 87:                 }
 88:                 case 'COMPLETE': {
 89:                     const payload = event.payload;
 90:                     const original = preTutorCwdRef.current;
 91:                     setIsActive(false);
 92:                     cb.onComplete(payload, original);
 93:                     if (original) {
 94:                         setTimeout(() => {
 95:                             preTutorCwdRef.current = null;
 96:                         }, 1000);
 97:                     }
 98:                     break;
 99:                 }
100:             }
101:         });
102:         return unsubscribe;
103:     }, [tutorEngine]);
104:     return {
105:         emotion,
106:         crashingIndices,
107:         isActive
108:     };
109: };
110: export const createTutorActiveChecker = (tutorEngine: TutorEngine) => {
111:     return () => tutorEngine.isActive();
112: };
