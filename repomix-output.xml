  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { CommandBase } from '../CommandBase';
  3: import { CommandCapability } from '../IStructuredCommand';
  4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  5: import { TerminalState } from '../../entities/TerminalState';
  6: import { CommandResponse } from '../../entities/Command';
  7: import { FileSystemService } from '../../services/FileSystemService';
  8: export class WcCommand extends CommandBase {
  9:     public readonly capabilities = [CommandCapability.READ, CommandCapability.FILTER];
 10:     public readonly utility = 'wc';
 11:     constructor(private fs: FileSystemService) {
 12:         super();
 13:     }
 14:     protected async executeInternal(
 15:         rawArgs: string[],
 16:         flags: Set<string>,
 17:         operands: string[],
 18:         context: ProcessContext,
 19:         state: TerminalState
 20:     ): Promise<CommandResponse> {
 21:         const input = getStdinAsString(context);
 22:         const fsService = context.fileSystemService || this.fs;
 23:         let countLines = flags.has('l');
 24:         let countWords = flags.has('w');
 25:         let countBytes = flags.has('c');
 26:         let countChars = flags.has('m');
 27:         if (!countLines && !countWords && !countBytes && !countChars) {
 28:             countLines = true;
 29:             countWords = true;
 30:             countBytes = true;
 31:         }
 32:         let output = '';
 33:         let totalLines = 0;
 34:         let totalWords = 0;
 35:         let totalBytes = 0;
 36:         let totalChars = 0;
 37:         const processContent = (content: string, name?: string) => {
 38:             const rawLines = content.split('\n');
 39:             let actualLines = rawLines.length;
 40:             if (content.length > 0 && content.endsWith('\n')) {
 41:                 actualLines--;
 42:             }
 43:             if (content.length === 0) actualLines = 0;
 44:             const words = content.trim().length === 0 ? 0 : content.trim().split(/\s+/).length;
 45:             const bytes = content.length;
 46:             const chars = content.length;
 47:             if (name) {
 48:                 totalLines += actualLines;
 49:                 totalWords += words;
 50:                 totalBytes += bytes;
 51:                 totalChars += chars;
 52:             }
 53:             let part = '';
 54:             if (countLines) part += ` ${actualLines}`;
 55:             if (countWords) part += ` ${words}`;
 56:             if (countBytes) part += ` ${bytes}`;
 57:             if (countChars) part += ` ${chars}`;
 58:             if (name) part += ` ${name}`;
 59:             return part.trimStart();
 60:         };
 61:         if (operands.length === 0) {
 62:             if (input !== undefined) {
 63:                 output = processContent(input);
 64:             } else {
 65:                 return { output: 'wc: missing input', newState: state, exitCode: 1 };
 66:             }
 67:         } else {
 68:             let exitCode = 0;
 69:             for (const filename of operands) {
 70:                 if (filename === '-') {
 71:                     output += processContent(input || '', '-') + '\n';
 72:                     continue;
 73:                 }
 74:                 let path = filename;
 75:                 if (!path.startsWith('/')) {
 76:                     path = state.currentDirectory === '/'
 77:                         ? `/${filename}`
 78:                         : `${state.currentDirectory}/${filename}`;
 79:                 }
 80:                 const node = fsService.resolve(path);
 81:                 if (!node) {
 82:                     output += `wc: ${filename}: No such file or directory\n`;
 83:                     exitCode = 1;
 84:                     continue;
 85:                 }
 86:                 if (fsService.isDirectory(node)) {
 87:                     output += `wc: ${filename}: Is a directory\n`;
 88:                     output += ` 0 0 0 ${filename}\n`;
 89:                     exitCode = 1;
 90:                     continue;
 91:                 }
 92:                 try {
 93:                     const content = fsService.readFile(path);
 94:                     output += processContent(content, filename) + '\n';
 95:                 } catch (e: any) {
 96:                     output += `wc: ${filename}: ${e.message}\n`;
 97:                     exitCode = 1;
 98:                 }
 99:             }
100:             if (operands.length > 1) {
101:                 let totalPart = '';
102:                 if (countLines) totalPart += ` ${totalLines}`;
103:                 if (countWords) totalPart += ` ${totalWords}`;
104:                 if (countBytes) totalPart += ` ${totalBytes}`;
105:                 if (countChars) totalPart += ` ${totalChars}`;
106:                 totalPart += ` total`;
107:                 output += totalPart.trimStart();
108:             } else {
109:                 if (output.endsWith('\n')) output = output.slice(0, -1);
110:             }
111:             return {
112:                 output: output,
113:                 newState: state,
114:                 exitCode: exitCode
115:             };
116:         }
117:         return {
118:             output: output,
119:             newState: state,
120:             exitCode: 0
121:         };
122:     }
123: }
</file>

