19:         const body = facade.parseCommand();
20:         if (!body) throw new Error(`Syntax Error: Missing body for function ${nameToken.value}`);
21:         const redirects: RedirectNode[] = [];
22:         while (facade.isRedirect(facade.peek())) {
23:             redirects.push(facade.parseRedirect());
24:         }
25:         return {
26:             type: NodeType.FUNCTION_DEF,
27:             name: nameToken.value,
28:             body: body,
29:             redirects: redirects
30:         } as FunctionDefNode;
