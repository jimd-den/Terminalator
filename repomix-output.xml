                    </>
                ) : (
                    <View style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={styles.emptyText}>SELECT_BUFFER_TO_VIEW</Text>
                    </View>
                )}
            </View>
        </View>
    );
