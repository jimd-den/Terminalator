<file path="src/interface-adapters/ui/VisualCortex/useVisualDirector.ts">
 1: import { create } from 'zustand';
 2: import { VisualPriority } from './VisualPriority';
 3: interface VisualDirectorState {
 4:   focusOwner: string | null;
 5:   currentPriority: VisualPriority;
 6:   reducedMotion: boolean;
 7:   requestFocus: (id: string, priority: VisualPriority) => boolean;
 8:   releaseFocus: (id: string) => void;
 9:   setReducedMotion: (enabled: boolean) => void;
10:   reportLag: () => void;
11: }
12: export const useVisualDirector = create<VisualDirectorState>((set, get) => ({
13:   focusOwner: null,
14:   currentPriority: VisualPriority.NONE,
15:   reducedMotion: false,
16:   requestFocus: (id: string, priority: VisualPriority) => {
17:     const { focusOwner, currentPriority, reducedMotion } = get();
18:     if (reducedMotion && priority === VisualPriority.AMBIENT) {
19:         return false;
20:     }
21:     if (focusOwner === null) {
22:       set({ focusOwner: id, currentPriority: priority });
23:       return true;
24:     }
25:     if (focusOwner === id) {
26:        if (priority > currentPriority) {
27:          set({ currentPriority: priority });
28:        }
29:        return true;
30:     }
31:     const isCoexistent = (
32:         (priority === VisualPriority.FOCUS && currentPriority === VisualPriority.CONTENT) ||
33:         (priority === VisualPriority.CONTENT && currentPriority === VisualPriority.FOCUS)
34:     );
35:     if (isCoexistent && !reducedMotion) {
36:         if (priority > currentPriority) {
37:             set({ currentPriority: priority, focusOwner: id });
38:         }
39:         return true;
40:     }
41:     if (priority > currentPriority) {
42:       set({ focusOwner: id, currentPriority: priority });
43:       return true;
44:     }
45:     return false;
46:   },
47:   releaseFocus: (id: string) => {
48:     const { focusOwner } = get();
49:     if (focusOwner === id) {
50:       set({ focusOwner: null, currentPriority: VisualPriority.NONE });
51:     }
52:   },
53:   setReducedMotion: (enabled: boolean) => set({ reducedMotion: enabled }),
54:   reportLag: () => {
55:       set({ reducedMotion: true });
56:       const { currentPriority } = get();
57:       if (currentPriority <= VisualPriority.AMBIENT) {
58:           set({ focusOwner: null, currentPriority: VisualPriority.NONE });
59:       }
60:   }
61: }));
</file>

