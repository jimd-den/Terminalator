 6: import { GameEventType } from '../../../../domain/services/SimulationBus';
 7: export const StandardCursor: React.FC<CursorProps> = ({
 8:     active,
 9:     color,
10:     type = 'block',
11:     metadata,
12:     theme,
13:     settings
14: }) => {
15:     const { bus } = useProcess();
16:     const emotion = metadata?.emotion || TutorEmotion.NORMAL;
17:     const opacityAnim = useRef(new Animated.Value(1)).current;
18:     const shakeAnim = useRef(new Animated.Value(0)).current;
19:     const scaleAnim = useRef(new Animated.Value(1)).current;
20:     useEffect(() => {
21:         const unsubscribe = bus.subscribe(GameEventType.KEYSTROKE_ACCEPTED, () => {
22:             Animated.sequence([
23:                 Animated.timing(scaleAnim, { toValue: 1.3, duration: 50, useNativeDriver: true }),
24:                 Animated.timing(scaleAnim, { toValue: 1.0, duration: 100, useNativeDriver: true }),
25:             ]).start();
26:         });
27:         return unsubscribe;
28:     }, [bus]);
29:     useEffect(() => {
30:         if (!active) {
31:             opacityAnim.setValue(1);
32:             return;
33:         }
34:         const blink = Animated.loop(
35:             Animated.sequence([
36:                 Animated.timing(opacityAnim, { toValue: 0, duration: 0, useNativeDriver: true }),
37:                 Animated.delay(500),
38:                 Animated.timing(opacityAnim, { toValue: 1, duration: 0, useNativeDriver: true }),
39:                 Animated.delay(500),
40:             ])
41:         );
42:         blink.start();
43:         return () => blink.stop();
44:     }, [active, opacityAnim]);
45:     useEffect(() => {
46:         shakeAnim.stopAnimation();
47:         shakeAnim.setValue(0);
48:         if (emotion === TutorEmotion.RESTLESS) {
49:             Animated.loop(
50:                 Animated.sequence([
51:                     Animated.timing(shakeAnim, { toValue: 2, duration: 50, useNativeDriver: true }),
52:                     Animated.timing(shakeAnim, { toValue: -2, duration: 50, useNativeDriver: true }),
53:                     Animated.timing(shakeAnim, { toValue: 0, duration: 50, useNativeDriver: true }),
54:                 ])
55:             ).start();
56:         }
57:     }, [emotion, shakeAnim]);
58:     const getCursorStyle = () => {
59:         switch (type) {
60:             case 'line':
61:                 return { width: 2, height: 20 };
62:             case 'underline':
63:                 return { width: 10, height: 2, marginTop: 18 };
64:             default:
65:                 return { width: 10, height: 20 };
66:         }
67:     };
68:     const finalColor = (emotion === TutorEmotion.MAD || emotion === TutorEmotion.CRASH_OUT) ? theme.colors.error : color;
69:     return (
70:         <Animated.View
71:             style={[
72:                 {
73:                     backgroundColor: finalColor,
74:                     opacity: opacityAnim,
75:                     transform: [{ translateX: shakeAnim }, { scale: scaleAnim }]
76:                 },
77:                 getCursorStyle(),
78:             ]}
79:         />
80:     );
81: };
</file>

