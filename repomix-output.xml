  9: import { S_IFDIR } from '../../entities/FileSystem';
 10: import { DirectoryNode } from '../../entities/filesystem/DirectoryNode';
 11: interface GrepOptions {
 12:     extended: boolean;
 13:     fixed: boolean;
 14:     countOnly: boolean;
 15:     listOnly: boolean;
 16:     quiet: boolean;
 17:     suppressErrors: boolean;
 18:     caseInsensitive: boolean;
 19:     lineNumbers: boolean;
 20:     invertMatch: boolean;
 21:     exactLine: boolean;
 22:     recursive: boolean;
 23: }
 24: interface MatchingStrategy {
 25:     match(line: string): boolean;
 26: }
 27: class BasicMatchingStrategy implements MatchingStrategy {
 28:     private regexes: RegExp[];
 29:     constructor(patterns: string[], options: GrepOptions) {
 30:         const flags = options.caseInsensitive ? 'i' : '';
 31:         this.regexes = patterns.map(p => {
 32:             let finalPattern = p;
 33:             if (options.exactLine) {
 34:                 finalPattern = `^${p}$`;
 35:             }
 36:             try {
 37:                 return new RegExp(finalPattern, flags);
 38:             } catch (e) {
 39:                 return /.^/;
 40:             }
 41:         });
 42:     }
 43:     match(line: string): boolean {
 44:         return this.regexes.some(re => re.test(line));
 45:     }
 46: }
 47: class FixedStringStrategy implements MatchingStrategy {
 48:     private patterns: string[];
 49:     private caseInsensitive: boolean;
 50:     private exactLine: boolean;
 51:     constructor(patterns: string[], options: GrepOptions) {
 52:         this.patterns = patterns;
 53:         this.caseInsensitive = options.caseInsensitive;
 54:         this.exactLine = options.exactLine;
 55:     }
 56:     match(line: string): boolean {
 57:         const target = this.caseInsensitive ? line.toLowerCase() : line;
 58:         return this.patterns.some(p => {
 59:             const pattern = this.caseInsensitive ? p.toLowerCase() : p;
 60:             if (this.exactLine) {
 61:                 return target === pattern;
 62:             }
 63:             return target.includes(pattern);
 64:         });
 65:     }
 66: }
 67: export class GrepCommand extends CommandBase {
 68:     public readonly capabilities = [CommandCapability.FILTER, CommandCapability.READ];
 69:     public readonly utility = 'grep';
 70:     constructor(private fs: FileSystemService) {
 71:         super();
 72:     }
 73:     public getMetadata(): CommandMetadata {
 74:         return {
 75:             verb: TheatricalVerb.EXTRACT,
 76:             style: 'NORMAL'
 77:         };
 78:     }
 79:     public override buildArgs(requirements: Record<string, any>): string[] {
 80:         const args: string[] = [];
 81:         if (requirements.caseInsensitive) args.push('-i');
 82:         if (requirements.recursive) args.push('-r');
 83:         if (requirements.pattern) {
 84:             args.push('-e', requirements.pattern);
 85:         }
 86:         if (requirements.path) args.push(requirements.path);
 87:         return args;
 88:     }
 89:     protected override parseArgs(args: string[]) {
 90:         super.parseArgs(args, ['e', 'f']);
 91:     }
 92:     protected async executeInternal(
 93:         rawArgs: string[],
 94:         flags: Set<string>,
 95:         operands: string[],
 96:         context: ProcessContext,
 97:         state: TerminalState
 98:     ): Promise<CommandResponse> {
 99:         const input = getStdinAsString(context);
100:         const fs = context.fileSystemService || this.fs;
101:         const options: GrepOptions = {
102:             extended: flags.has('E'),
103:             fixed: flags.has('F'),
104:             countOnly: flags.has('c'),
105:             listOnly: flags.has('l'),
106:             quiet: flags.has('q'),
107:             suppressErrors: flags.has('s'),
108:             caseInsensitive: flags.has('i'),
109:             lineNumbers: flags.has('n'),
110:             invertMatch: flags.has('v'),
111:             exactLine: flags.has('x'),
112:             recursive: flags.has('r') || flags.has('R')
113:         };
114:         const patterns: string[] = [];
115:         const targets: string[] = [];
116:         const eOptions = this.options.get('e');
117:         if (eOptions) patterns.push(eOptions);
118:         const fOptions = this.options.get('f');
119:         if (fOptions) {
120:             patterns.push(...this.readPatternsFromFile(fOptions, state, fs));
121:         }
122:         let opIndex = 0;
123:         if (patterns.length === 0 && operands.length > 0) {
124:             patterns.push(...operands[opIndex++].split('\n'));
125:         }
126:         while (opIndex < operands.length) {
127:             targets.push(operands[opIndex++]);
128:         }
129:         if (targets.length === 0 && input === undefined) {
130:             return { output: 'grep: missing input', newState: state, exitCode: 1 };
131:         }
132:         const strategy = options.fixed
133:             ? new FixedStringStrategy(patterns, options)
134:             : new BasicMatchingStrategy(patterns, options);
135:         const result = this.runGrep(targets, patterns, options, strategy, state, fs, input);
136:         return {
137:             output: result.output,
138:             newState: state,
139:             exitCode: result.exitCode
140:         };
141:     }
142:     private readPatternsFromFile(path: string, state: TerminalState, fs: FileSystemService): string[] {
143:         try {
144:             const content = fs.readFile(path, state.currentDirectory);
145:             return content.split('\n').filter(p => p.length > 0);
146:         } catch (e) {
147:             throw new Error(`could not read patterns from file ${path}`);
148:         }
149:     }
150:     private runGrep(targets: string[], patterns: string[], options: GrepOptions, strategy: MatchingStrategy, state: TerminalState, fs: FileSystemService, input?: string): { output: string, exitCode: number } {
151:         let output = '';
152:         let matchedOverall = false;
153:         let anyError = false;
154:         const showFilename = targets.length > 1 || options.recursive;
155:         const processRows = (content: string, filename: string): boolean => {
156:             const lines = content.split('\n');
157:             if (lines.length > 0 && lines[lines.length - 1] === '' && content.endsWith('\n')) {
158:                 lines.pop();
159:             }
160:             let matchCount = 0;
161:             let fileMatched = false;
162:             for (let idx = 0; idx < lines.length; idx++) {
163:                 const line = lines[idx];
164:                 const matches = strategy.match(line);
165:                 const selected = options.invertMatch ? !matches : matches;
166:                 if (selected) {
167:                     fileMatched = true;
168:                     matchedOverall = true;
169:                     matchCount++;
170:                     if (options.quiet) return true;
171:                     if (options.listOnly) {
172:                         output += `${filename}\n`;
173:                         return true;
174:                     }
175:                     if (!options.countOnly) {
176:                         let prefix = '';
177:                         if (showFilename) prefix += `${filename}:`;
178:                         if (options.lineNumbers) prefix += `${idx + 1}:`;
179:                         output += `${prefix}${line}\n`;
180:                     }
181:                 }
182:             }
183:             if (options.countOnly && !options.quiet) {
184:                 let prefix = '';
185:                 if (showFilename) prefix += `${filename}:`;
186:                 output += `${prefix}${matchCount}\n`;
187:             }
188:             return fileMatched;
189:         };
190:         if (targets.length === 0 && input !== undefined) {
191:             processRows(input, '(standard input)');
192:         } else {
193:             for (const target of targets) {
194:                 const processNode = (path: string) => {
195:                     try {
196:                         const node = fs.resolve(path, state.currentDirectory);
197:                         if (!node) {
198:                             if (!options.suppressErrors) {
199:                                 output += `grep: ${path}: No such file or directory\n`;
200:                             }
201:                             anyError = true;
202:                             return;
203:                         }
204:                         const inode = fs.getInode(node.inodeId);
205:                         if (!inode) return;
206:                         if (inode.mode & S_IFDIR) {
207:                             if (options.recursive) {
208:                                 for (const [name, child] of (node as DirectoryNode).children) {
209:                                     const childPath = path === '/' ? `/${name}` : `${path}/${name}`;
210:                                     processNode(childPath);
211:                                 }
212:                             } else {
213:                                 if (!options.suppressErrors) {
214:                                     output += `grep: ${path}: Is a directory\n`;
215:                                 }
216:                                 anyError = true;
217:                             }
218:                         } else {
219:                             const content = fs.readFile(path, state.currentDirectory);
220:                             processRows(content, path);
221:                         }
222:                     } catch (e: any) {
223:                         if (!options.suppressErrors) {
224:                             output += `grep: ${path}: ${e.message}\n`;
225:                         }
226:                         anyError = true;
227:                     }
228:                 };
229:                 processNode(target);
230:                 if (options.quiet && matchedOverall) break;
231:             }
232:         }
233:         let exitCode = matchedOverall ? 0 : 1;
234:         if (anyError && !matchedOverall) exitCode = 2;
235:         return { output: options.quiet ? '' : output, exitCode };
236:     }
237: }
</file>

<file path="src/domain/commands/core/LsCommand.ts">
  1: import { getStdinAsString } from '../../entities/ProcessContext';
  2: import { CommandBase } from '../CommandBase';
  3: import { CommandCapability } from '../IStructuredCommand';
  4: import { ProcessContext } from '../../../domain/entities/ProcessContext';
  5: import { TerminalState } from '../../entities/TerminalState';
  6: import { CommandResponse, CommandMetadata } from '../../entities/Command';
  7: import { TheatricalVerb } from '../../services/PresentationDirector';
  8: import { FileSystemService } from '../../services/FileSystemService';
  9: export class LsCommand extends CommandBase {
 10:     public readonly capabilities = [CommandCapability.LIST];
 11:     public readonly utility = 'ls';
 12:     constructor(private fsService: FileSystemService) { super(); }
 13:     public getMetadata(): CommandMetadata {
 14:         return {
 15:             verb: TheatricalVerb.SCAN,
 16:             style: 'NORMAL'
 17:         };
 18:     }
 19:     executeInternal(args: string[], flags: Set<string>, targets: string[], context: ProcessContext, state: TerminalState): CommandResponse {
 20:         const fsService = context.fileSystemService || this.fsService;
 21:         const showHidden = flags.has('a');
 22:         const classify = flags.has('F');
 23:         const recursive = flags.has('R');
 24:         const longFormat = flags.has('l');
 25:         const onePerLine = flags.has('1');
 26:         let exitCode = 0;
 27:         let outputParts: string[] = [];
 28:         let metadataItems: { name: string, type: 'file' | 'dir' }[] = [];
 29:         const pathsToProcess = targets.length > 0 ? targets : [''];
 30:         const listDirectory = (dirNode: any, dirPath: string, printHeader: boolean) => {
 31:             if (printHeader) {
 32:                 outputParts.push(`\n${dirPath}:`);
 33:             }
 34:             if (!dirNode || !dirNode.children) {
 35:                 return;
 36:             }
 37:             let files = Array.from(dirNode.children.values() as Iterable<any>);
 38:             if (!showHidden) {
 39:                 files = files.filter(f => !f.name.startsWith('.'));
 40:             }
 41:             files.sort((a: any, b: any) => a.name.localeCompare(b.name));
 42:             if (files.length === 0) {
 43:                 return;
 44:             }
 45:             const formattedNames = files.map(f => {
 46:                 metadataItems.push({
 47:                     name: f.name,
 48:                     type: fsService.isDirectory(f) ? 'dir' : 'file'
 49:                 });
 50:                 let name = f.name;
 51:                 if (classify && fsService.isDirectory(f)) {
 52:                     name += '/';
 53:                 }
 54:                 if (longFormat) {
 55:                     const isDir = fsService.isDirectory(f);
 56:                     const type = isDir ? 'd' : '-';
 57:                     const perm = 'rw-r--r--';
 58:                     const user = 'operator';
 59:                     const group = 'operator';
 60:                     const stats = fsService.getStat(f);
 61:                     const size = stats ? stats.size : 0;
 62:                     const date = 'Jan 1 00:00';
 63:                     return `${type}${perm} 1 ${user} ${group} ${size} ${date} ${name}`;
 64:                 }
 65:                 return name;
 66:             });
 67:             if (longFormat || onePerLine) {
 68:                 outputParts.push(formattedNames.join('\n'));
 69:             } else {
 70:                 outputParts.push(formattedNames.join('  '));
 71:             }
 72:             if (recursive) {
 73:                 for (const f of files) {
 74:                     if (fsService.isDirectory(f)) {
 75:                         if (f.name === '.' || f.name === '..') continue;
 76:                         let childPath;
 77:                         if (dirPath === '/') {
 78:                             childPath = `/${f.name}`;
 79:                         } else {
 80:                             childPath = `${dirPath}/${f.name}`;
 81:                         }
 82:                         listDirectory(f, childPath, true);
 83:                     }
 84:                 }
 85:             }
 86:         };
 87:         for (const targetPath of pathsToProcess) {
 88:             const pathToList = targetPath || state.currentDirectory;
 89:             const absPath = targetPath
 90:                 ? fsService.resolveAbsolutePath(targetPath, state.currentDirectory)
 91:                 : state.currentDirectory;
 92:             const node = fsService.resolve(absPath);
 93:             if (!node) {
 94:                 outputParts.push(`ls: cannot access '${targetPath}': No such file or directory`);
 95:                 exitCode = 1;
 96:                 continue;
 97:             }
 98:             if (!fsService.isDirectory(node)) {
 99:                 if (longFormat) {
100:                     const type = '-';
101:                     const perm = 'rw-r--r--';
102:                     const user = 'operator';
103:                     const group = 'operator';
104:                     const stats = fsService.getStat(node);
105:                     const size = stats ? stats.size : 0;
106:                     const date = 'Jan 1 00:00';
107:                     const name = targetPath || node.name;
108:                     outputParts.push(`${type}${perm} 1 ${user} ${group} ${size} ${date} ${name}`);
109:                 } else {
110:                     outputParts.push(targetPath || node.name);
111:                 }
112:                 continue;
113:             }
114:             let printInitialHeader = pathsToProcess.length > 1;
115:             let displayPath = targetPath;
116:             if (!displayPath) {
117:                 if (recursive) {
118:                     displayPath = '.';
119:                     printInitialHeader = true;
120:                 }
121:             }
122:             listDirectory(node, displayPath || pathToList, printInitialHeader);
123:         }
124:         let finalOutput = outputParts.join('\n').trim();
125:         return {
126:             output: finalOutput,
127:             newState: state,
128:             exitCode: exitCode,
129:             metadata: {
130:                 renderType: (longFormat || recursive) ? undefined : 'fish-style',
131:                 data: {
132:                     items: metadataItems
133:                 }
134:             }
135:         };
136:     }
137: }
</file>

