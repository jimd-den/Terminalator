 67:     private static parseAddresses(src: string): { addresses: SedAddress[], negated: boolean } {
 68:         let s = src.trim();
 69:         let negated = false;
 70:         if (s.endsWith('!')) { negated = true; s = s.slice(0, -1).trim(); }
 71:         const addresses: SedAddress[] = [];
 72:         const parts = s.split(',').map(p => p.trim()).filter(p => p.length > 0);
 73:         for (const p of parts) {
 74:             if (p === '$') addresses.push({ type: 'last', value: null });
 75:             else if (p.startsWith('/')) {
 76:                 const end = p.lastIndexOf('/');
 77:                 addresses.push({ type: 'regex', value: new RegExp(p.slice(1, end)) });
