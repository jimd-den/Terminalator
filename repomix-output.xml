<file path="src/domain/commands/core/CommandCommand.ts">
 1: import { getStdinAsString } from '../../entities/ProcessContext';
 2: import { ICommand, CommandResponse } from '../ICommand';
 3: import { ProcessContext } from '../../../domain/entities/ProcessContext';
 4: import { FileSystemService } from '../../../domain/services/FileSystemService';
 5: import { TerminalState } from '../../entities/TerminalState';
 6: export class CommandCommand implements ICommand {
 7:     constructor(private registryProvider: (name: string) => ICommand | undefined) { }
 8:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
 9:         const input = getStdinAsString(context);
10:         if (args.length === 0) return { output: '', newState: state, exitCode: 0 };
11:         let cmdName = args[0];
12:         let cmdArgs = args.slice(1);
13:         if (cmdName === '-v' || cmdName === '-V') {
14:             if (cmdArgs.length > 0) {
15:                 const name = cmdArgs[0];
16:                 const cmd = this.registryProvider(name);
17:                 if (cmd) {
18:                     return { output: name, newState: state, exitCode: 0 };
19:                 } else {
20:                     return { output: '', newState: state, exitCode: 1 };
21:                 }
22:             }
23:             return { output: '', newState: state, exitCode: 0 };
24:         }
25:         const cmd = this.registryProvider(cmdName);
26:         if (!cmd) {
27:             return { output: `command: ${cmdName}: not found`, newState: state, exitCode: 127 };
28:         }
29:         return cmd.execute(cmdArgs, context, state);
30:     }
31: }
