export enum AwkTokenType {
    BEGIN = 'BEGIN',
    END = 'END',
    PRINT = 'PRINT',
    IF = 'IF',
    ELSE = 'ELSE',
    WHILE = 'WHILE',
    DO = 'DO',
    FOR = 'FOR',
    IN = 'IN',
    BREAK = 'BREAK',
    CONTINUE = 'CONTINUE',
    NEXT = 'NEXT',
    EXIT = 'EXIT',
    FUNCTION = 'FUNCTION',
    RETURN = 'RETURN',

