  9: import { ModeParser } from '../../services/ModeParser';
 10: export class MkdirCommand extends CommandBase {
 11:     public readonly capabilities = [CommandCapability.MODIFY];
 12:     public readonly utility = 'mkdir';
 13:     constructor(private fs: FileSystemService) {
 14:         super();
 15:     }
 16:     public getMetadata(): CommandMetadata {
 17:         return {
 18:             verb: TheatricalVerb.SYNTHESIZE,
 19:             style: 'NORMAL'
 20:         };
 21:     }
 22:     protected async executeInternal(
 23:         rawArgs: string[],
 24:         flags: Set<string>,
 25:         operands: string[],
 26:         context: ProcessContext,
 27:         state: TerminalState
 28:     ): Promise<CommandResponse> {
 29:         const fsService = context.fileSystemService || this.fs;
 30:         const parents = flags.has('p');
 31:         const modeStr = this.options.get('m');
 32:         if (operands.length === 0) {
 33:             return {
 34:                 output: 'mkdir: missing operand',
 35:                 newState: state,
 36:                 exitCode: 1
 37:             };
 38:         }
 39:         let exitCode = 0;
 40:         let outputString = '';
 41:         for (const target of operands) {
 42:             const result = this.createPath(target, parents, modeStr, state, fsService);
 43:             if (result.error) {
 44:                 outputString += `mkdir: ${result.error}\n`;
 45:                 exitCode = 1;
 46:             }
 47:         }
 48:         if (outputString.endsWith('\n')) outputString = outputString.slice(0, -1);
 49:         return {
 50:             output: outputString,
 51:             newState: state,
 52:             exitCode: exitCode
 53:         };
 54:     }
 55:     protected override parseArgs(args: string[]) {
 56:         super.parseArgs(args, ['m']);
 57:     }
 58:     private createPath(target: string, parents: boolean, modeStr: string | undefined, state: TerminalState, fsService: FileSystemService): { error?: string } {
 59:         const fullPath = this.resolvePath(target, state);
 60:         const components = this.getPathComponents(fullPath);
 61:         let current = '/';
 62:         for (let i = 0; i < components.length; i++) {
 63:             const node = fsService.resolve(current);
 64:             if (node && !this.hasSearchPermission(node, state.user, fsService)) {
 65:                 return { error: `cannot create directory '${target}': Permission denied` };
 66:             }
 67:             if (i === components.length - 1) break;
 68:             current += (current === '/' ? '' : '/') + components[i];
 69:             const existingNode = fsService.resolve(current);
 70:             if (existingNode && !fsService.isDirectory(existingNode)) {
 71:                 return { error: `cannot create directory '${target}': File exists` };
 72:             }
 73:         }
 74:         if (parents) {
 75:             return this.createPathWithParents(components, modeStr, state.user, fsService);
 76:         } else {
 77:             return this.createSinglePath(fullPath, modeStr, state.user, fsService);
 78:         }
 79:     }
 80:     private createSinglePath(path: string, modeStr: string | undefined, user: { uid: number, gid: number, groups: number[] } | string, fsService: FileSystemService): { error?: string } {
 81:         const node = fsService.resolve(path);
 82:         if (node) {
 83:             return { error: `cannot create directory '${path}': File exists` };
 84:         }
 85:         const parentPath = this.getParentPath(path);
 86:         const parent = fsService.resolve(parentPath);
 87:         if (!parent || !fsService.isDirectory(parent)) {
 88:             return { error: `cannot create directory '${path}': No such file or directory` };
 89:         }
 90:         try {
 91:             const mode = modeStr ? ModeParser.parse(modeStr, 0o777) : 0o755;
 92:             fsService.mkdir(path, mode);
 93:             return {};
 94:         } catch (e: any) {
 95:             return { error: `cannot create directory '${path}': ${e.message}` };
 96:         }
 97:     }
 98:     private createPathWithParents(components: string[], modeStr: string | undefined, user: { uid: number, gid: number, groups: number[] } | string, fsService: FileSystemService): { error?: string } {
 99:         let currentPath = '';
100:         const len = components.length;
101:         for (let i = 0; i < len; i++) {
102:             currentPath += `/${components[i]}`;
103:             const node = fsService.resolve(currentPath);
104:             if (!node) {
105:                 try {
106:                     const isLast = (i === len - 1);
107:                     const mode = isLast
108:                         ? (modeStr ? ModeParser.parse(modeStr, 0o777) : 0o755)
109:                         : 0o755;
110:                     fsService.mkdir(currentPath, mode);
111:                 } catch (e: any) {
112:                     return { error: `cannot create directory '${currentPath}': ${e.message}` };
113:                 }
114:             } else if (!fsService.isDirectory(node)) {
115:                 return { error: `cannot create directory '${currentPath}': File exists` };
116:             }
117:         }
118:         return {};
119:     }
120:     private hasSearchPermission(dentry: any, user: { uid: number, gid: number, groups: number[] } | string, fsService: FileSystemService): boolean {
121:         if (user === 'root') return true;
122:         const inode = fsService.getInode(dentry.inodeId);
123:         if (!inode) return false;
124:         const mode = inode.mode;
125:         return (mode & 0o001) !== 0 || (typeof user === 'string' && user === 'operator' && (mode & 0o100) !== 0);
126:     }
127:     private resolvePath(path: string, state: TerminalState): string {
128:         if (path.startsWith('/')) return this.normalizePath(path);
129:         const base = state.currentDirectory === '/' ? '' : state.currentDirectory;
130:         return this.normalizePath(`${base}/${path}`);
131:     }
132:     private normalizePath(path: string): string {
133:         const parts = path.split('/').filter(p => p.length > 0 && p !== '.');
134:         const stack: string[] = [];
135:         for (const part of parts) {
136:             if (part === '..') {
137:                 if (stack.length > 0) stack.pop();
138:             } else {
139:                 stack.push(part);
140:             }
141:         }
142:         return '/' + stack.join('/');
143:     }
144:     private getPathComponents(path: string): string[] {
145:         return path.split('/').filter(p => p.length > 0);
146:     }
147:     private getParentPath(path: string): string {
148:         const parts = path.split('/').filter(p => p.length > 0);
149:         if (parts.length <= 1) return '/';
150:         return '/' + parts.slice(0, -1).join('/');
151:     }
152: }
</file>

