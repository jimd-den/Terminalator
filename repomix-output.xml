<file path="src/domain/services/ArchiveService.ts">
 1: import { TerminalOutputLine } from '../../interface-adapters/controllers/OutputController';
 2: export interface CapturedBuffer {
 3:     id: string;
 4:     timestamp: number;
 5:     command: string;
 6:     output: string[];
 7:     tags: string[];
 8:     exitCode?: number;
 9:     hostname: string;
10: }
11: export class ArchiveService {
12:     private archive: CapturedBuffer[] = [];
13:     public record(
14:         command: string,
15:         outputLines: TerminalOutputLine[],
16:         hostname: string,
17:         exitCode?: number
18:     ): CapturedBuffer {
19:         const id = `buf_${Date.now()}_${Math.floor(Math.random() * 1000)}`;
20:         const plainTextOutput = outputLines
21:             .filter(l => l.type === 'output' || l.type === 'system')
22:             .map(l => l.text);
23:         const buffer: CapturedBuffer = {
24:             id,
25:             timestamp: Date.now(),
26:             command,
27:             output: plainTextOutput,
28:             tags: this.autoTag(command, plainTextOutput),
29:             exitCode,
30:             hostname
31:         };
32:         this.archive.unshift(buffer);
33:         return buffer;
34:     }
35:     public recordFromOutput(
36:         index: number,
37:         lines: TerminalOutputLine[],
38:         hostname: string
39:     ): void {
40:         const cmdLine = lines[index];
41:         if (!cmdLine || cmdLine.type !== 'input') return;
42:         const command = cmdLine.text.replace(/^>\s*/, '');
43:         const blockOutput: TerminalOutputLine[] = [];
44:         // Collect lines until next input or end
45:         for (let i = index + 1; i < lines.length; i++) {
46:             if (lines[i].type === 'input') break;
47:             blockOutput.push(lines[i]);
48:         }
49:         this.record(command, blockOutput, hostname, cmdLine.exitCode);
50:     }
51:     public getAll(): CapturedBuffer[] {
52:         return this.archive;
53:     }
54:     public getByTag(tag: string): CapturedBuffer[] {
55:         return this.archive.filter(b => b.tags.includes(tag.toLowerCase()));
56:     }
57:     public delete(id: string): void {
58:         this.archive = this.archive.filter(b => b.id !== id);
59:     }
60:     private autoTag(command: string, content: string[]): string[] {
61:         const tags: string[] = [];
62:         const baseCmd = command.split(' ')[0].toLowerCase();
63:         if (['ls', 'find', 'locate'].includes(baseCmd)) tags.push('navigation');
64:         if (['cat', 'grep', 'awk', 'sed', 'val'].includes(baseCmd)) tags.push('data-processing');
65:         if (['vim', 'nano', 'touch'].includes(baseCmd)) tags.push('editing');
66:         if (['ssh', 'scp', 'ftp'].includes(baseCmd)) tags.push('network');
67:         if (['make', 'gcc', 'sh'].includes(baseCmd)) tags.push('system');
68:         const text = content.join('\n').toLowerCase();
69:         if (text.includes('error') || text.includes('failed')) tags.push('errors');
70:         if (text.includes('password') || text.includes('key')) tags.push('security');
71:         if (text.includes('total') || text.includes('summary')) tags.push('reports');
72:         return tags;
73:     }
74: }
