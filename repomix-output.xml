 1: import { Organization, OrganizationType } from '../../entities/world/Organization';
 2: export class OrganizationGenerator {
 3:     private prefixes = ['Omni', 'Cyber', 'Nano', 'Terra', 'Solar', 'Lunar', 'Void'];
 4:     private suffixes = ['Corp', 'Systems', 'Dynamics', 'Heavy Industries', 'Logistics', 'Gov'];
 5:     public generateFaction(seed: string): Organization {
 6:         const rng = this.createRNG(seed);
 7:         const type = rng() > 0.5 ? OrganizationType.CORPORATION : OrganizationType.GOVERNMENT;
 8:         return {
 9:             id: `org_${seed}`,
10:             name: this.generateName(rng),
11:             type: type,
12:             techLevel: Math.floor(rng() * 10) + 1,
13:             wealth: Math.floor(rng() * 1000000),
14:             assets: [],
15:             relationships: {}
16:         };
17:     }
18:     private generateName(rng: () => number): string {
19:         const p = this.prefixes[Math.floor(rng() * this.prefixes.length)];
20:         const s = this.suffixes[Math.floor(rng() * this.suffixes.length)];
21:         return `${p}${s}`;
22:     }
23:     private createRNG(seed: string): () => number {
24:         let h = 0xdeadbeef;
25:         for (let i = 0; i < seed.length; i++) h = Math.imul(h ^ seed.charCodeAt(i), 2654435761);
26:         return function () {
27:             h = Math.imul(h ^ (h >>> 16), 2246822507);
28:             return ((h ^= h >>> 16) >>> 0) / 4294967296;
29:         };
30:     }
31: }
