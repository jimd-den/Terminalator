 1: import { ICommand, CommandResponse } from '../ICommand';
 2: import { ProcessContext } from '../../entities/ProcessContext';
 3: import { TerminalState } from '../../entities/TerminalState';
 4: import { formatJobForBg } from '../../entities/Job';
 5: export class BgCommand implements ICommand {
 6:     async execute(
 7:         args: string[],
 8:         context: ProcessContext,
 9:         state: TerminalState
10:     ): Promise<CommandResponse> {
11:         const jobControl = context.jobControl;
12:         if (!jobControl) {
13:             return {
14:                 output: 'bg: no job control in this shell',
15:                 newState: state,
16:                 exitCode: 1
17:             };
18:         }
19:         const jobSpecs = args.filter(arg => !arg.startsWith('-'));
20:         if (args.includes('--help')) {
21:             return {
22:                 output: this.getHelp(),
23:                 newState: state,
24:                 exitCode: 0
25:             };
26:         }
27:         const invalidOption = args.find(arg => arg.startsWith('-') && arg !== '--help');
28:         if (invalidOption) {
29:             return {
30:                 output: `bg: ${invalidOption}: invalid option`,
31:                 newState: state,
32:                 exitCode: 1
33:             };
34:         }
35:         if (jobSpecs.length === 0) {
36:             return this.resumeSingleJob(jobControl, undefined, state);
37:         }
38:         const outputs: string[] = [];
39:         let exitCode = 0;
40:         for (const spec of jobSpecs) {
41:             const result = jobControl.resumeBackground(spec);
42:             if (!result.success) {
43:                 outputs.push(result.errorMessage ?? `bg: ${spec}: no such job`);
44:                 exitCode = 1;
45:             } else if (result.job) {
46:                 outputs.push(formatJobForBg(result.job));
47:             }
48:         }
49:         return {
50:             output: outputs.join('\n'),
51:             newState: state,
52:             exitCode
53:         };
54:     }
55:     private resumeSingleJob(
56:         jobControl: NonNullable<ProcessContext['jobControl']>,
57:         spec: string | undefined,
58:         state: TerminalState
59:     ): CommandResponse {
60:         const result = jobControl.resumeBackground(spec);
61:         if (!result.success) {
62:             return {
63:                 output: result.errorMessage ?? 'bg: no current job',
64:                 newState: state,
65:                 exitCode: 1
66:             };
67:         }
68:         if (result.job) {
69:             return {
70:                 output: formatJobForBg(result.job),
71:                 newState: state,
72:                 exitCode: 0
73:             };
74:         }
75:         return {
76:             output: '',
77:             newState: state,
78:             exitCode: 0
79:         };
80:     }
81:     private getHelp(): string {
82:         return `bg - run jobs in the background
83: Usage: bg [job_id...]
84: Resume suspended jobs by running them in the background.
85: If no job_id is given, the current job is used.
86: Job ID formats:
87:   %n      - Job number n
88:   %% or %+ - Current job
89:   %-      - Previous job
90:   %str    - Job starting with str`;
91:     }
92: }
