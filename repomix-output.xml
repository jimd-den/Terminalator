41:         setGhostText(getAutocompleteSuggestion(text));
42:     }, [getAutocompleteSuggestion]);
43:     /**
44:      * Appends a character to input.
45:      */
46:     const appendChar = useCallback((char: string) => {
47:         setInputState(prev => {
48:             const next = prev + char;
49:             setGhostText(getAutocompleteSuggestion(next));
50:             return next;
51:         });
52:     }, [getAutocompleteSuggestion]);
53:     /**
54:      * Deletes the last character from input.
55:      */
56:     const deleteChar = useCallback(() => {
57:         setInputState(prev => {
58:             const next = prev.slice(0, -1);
59:             setGhostText(getAutocompleteSuggestion(next));
60:             return next;
61:         });
62:     }, [getAutocompleteSuggestion]);
63:     /**
64:      * Clears input and ghost text.
65:      */
66:     const clearInput = useCallback(() => {
67:         setInputState('');
68:         setGhostText('');
69:     }, []);
70:     /**
71:      * Accepts autocomplete suggestion (TAB completion).
72:      */
73:     const acceptAutocomplete = useCallback(() => {
74:         if (ghostText) {
75:             setInputState(prev => prev + ghostText);
76:             setGhostText('');
77:         }
78:     }, [ghostText]);
79:     const updateGhostText = useCallback((text: string) => {
80:         setGhostText(text);
81:     }, []);
82:     return {
83:         input,
84:         ghostText,
85:         setInput,
86:         appendChar,
87:         deleteChar,
88:         clearInput,
89:         acceptAutocomplete,
90:         updateGhostText
91:     };
92: };
