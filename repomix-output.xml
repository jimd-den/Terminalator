 6: export class DateCommand implements ICommand {
 7:     name = 'date';
 8:     description = 'Display the current time';
 9:     execute(args: string[], context: ProcessContext, state: TerminalState): CommandResponse | Promise<CommandResponse> {
10:         let date = new Date();
11:         let format = '';
12:         let utc = false;
13:         let setDateAttempt = false;
14:         // Robust argument parsing
15:         for (const arg of args) {
16:             if (arg === '-u') {
17:                 utc = true;
18:             } else if (arg.startsWith('+')) {
19:                 format = arg.substring(1);
20:             } else if (arg.startsWith('-')) {
21:                 return {
22:                     output: `date: invalid option -- '${arg}'`,
23:                     exitCode: 1,
24:                     newState: state
25:                 };
26:             } else {
27:                 setDateAttempt = true;
28:             }
29:         }
30:         if (setDateAttempt) {
31:             return {
32:                 output: 'date: cannot set date (permission denied or not implemented)',
33:                 exitCode: 1,
34:                 newState: state
35:             };
36:         }
37:         const p = (n: number) => n.toString().padStart(2, '0');
38:         if (!format) {
39:             return {
40:                 output: utc ? date.toUTCString() : date.toString(),
41:                 exitCode: 0,
42:                 newState: state
43:             };
44:         }
45:         let output = format;
46:         const year = utc ? date.getUTCFullYear() : date.getFullYear();
47:         const month = utc ? date.getUTCMonth() + 1 : date.getMonth() + 1;
48:         const day = utc ? date.getUTCDate() : date.getDate();
49:         const hours = utc ? date.getUTCHours() : date.getHours();
50:         const minutes = utc ? date.getUTCMinutes() : date.getMinutes();
51:         const seconds = utc ? date.getUTCSeconds() : date.getSeconds();
52:         output = output.replace(/%Y/g, year.toString());
53:         output = output.replace(/%y/g, year.toString().slice(-2));
54:         output = output.replace(/%m/g, p(month));
55:         output = output.replace(/%d/g, p(day));
56:         output = output.replace(/%H/g, p(hours));
57:         output = output.replace(/%M/g, p(minutes));
58:         output = output.replace(/%S/g, p(seconds));
59:         output = output.replace(/%%/g, '%');
60:         return {
61:             output: output,
62:             exitCode: 0,
63:             newState: state
64:         };
65:     }
66: }
