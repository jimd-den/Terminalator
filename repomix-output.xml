100:         handleAction,
101:         handleKeyPress: handleKeyPressWrapped,
102:         handleVimExit: shellVM.handleVimExit,
103:         toggleCommsView,
104:         toggleBufferView,
105:         ircMissionId: missionVM.ircMissionId,
