 6: export class ConnectCommand implements ICommand {
 7:     name = 'ssh';
 8:     description = 'Open SSH client to connect to a remote system';
 9:     constructor(private networkMap: NetworkMap) { }
10:     async execute(args: string[], context: ProcessContext, state: TerminalState): Promise<CommandResponse> {
11:         const input = context.stdin;
12:         if (args.length === 0) {
13:             return { output: 'usage: ssh [user@]hostname', exitCode: 1 };
14:         }
15:         const target = args[0];
16:         let user = 'guest';
17:         let hostname = target;
18:         if (target.includes('@')) {
19:             const parts = target.split('@');
20:             user = parts[0];
21:             hostname = parts[1];
22:         }
23:         const system = this.networkMap.getSystem(hostname);
24:         await new Promise(resolve => setTimeout(resolve, 800));
25:         if (hostname === 'localhost' || hostname === '127.0.0.1') {
26:             return {
27:                 output: `Connection to ${hostname} established.`,
28:                 exitCode: 0,
29:                 newState: {
30:                     user: state.user,
31:                     currentDirectory: '/home/operator',
32:                     fsContext: undefined,
33:                     environment: { ...state.environment, HOSTNAME: 'localhost', USER: 'operator', HOME: '/home/operator' }
34:                 }
35:             };
36:         }
37:         if (system) {
38:             const service = new FileSystemService(system);
39:             let targetUid = 1000;
40:             let targetGid = 1000;
41:             try {
42:                 const passwd = service.readFile('/etc/passwd');
43:                 const userLine = passwd.split('\n').find(line => line.startsWith(`${user}:`));
44:                 if (!userLine) {
45:                     return { output: `Permission denied (publickey,password).\nssh: connect to host ${hostname}: User unknown`, exitCode: 1 };
46:                 }
47:                 const parts = userLine.split(':');
48:                 targetUid = parseInt(parts[2]);
49:                 targetGid = parseInt(parts[3]);
50:             } catch (e) {
51:                 return { output: `ssh: Connection failed: Unable to verify user context.`, exitCode: 1 };
52:             }
53:             return {
54:                 output: `\nConnecting to ${hostname}...\nWelcome to ${hostname.toUpperCase()} SystemOS v4.2\nLast login: ${new Date().toUTCString()}`,
55:                 exitCode: 0,
56:                 newState: {
57:                     user: { uid: targetUid, gid: targetGid, groups: [targetGid] },
58:                     currentDirectory: `/home/${user}`,
59:                     fsContext: hostname,
60:                     environment: { ...state.environment, HOSTNAME: hostname, USER: user, HOME: `/home/${user}` }
61:                 }
62:             };
63:         }
64:         return { output: `ssh: Could not resolve hostname ${hostname}: Name or service not known`, exitCode: 1 };
65:     }
66: }
</file>

