 6: import { CommandResponse } from '../../entities/Command';
 7: import { FileSystemService } from '../../services/FileSystemService';
 8: export class LnCommand extends CommandBase {
 9:     public readonly capabilities = [CommandCapability.MODIFY];
10:     public readonly utility = 'ln';
11:     constructor(private fs: FileSystemService) {
12:         super();
13:     }
14:     protected async executeInternal(
15:         rawArgs: string[],
16:         flags: Set<string>,
17:         operands: string[],
18:         context: ProcessContext,
19:         state: TerminalState
20:     ): Promise<CommandResponse> {
21:         const symbolic = flags.has('s');
22:         const force = flags.has('f');
23:         if (operands.length < 2) {
24:             return {
25:                 output: 'ln: missing file operand',
26:                 newState: state,
27:                 exitCode: 1
28:             };
29:         }
30:         const target = operands[0];
31:         const linkName = operands[1];
32:         let finalLinkPath = linkName;
33:         let linkNode = this.fs.resolve(linkName.startsWith('/') ? linkName : (state.currentDirectory === '/' ? `/${linkName}` : `${state.currentDirectory}/${linkName}`));
34:         if (linkNode && this.fs.isDirectory(linkNode)) {
35:             const targetBase = target.substring(target.lastIndexOf('/') + 1);
36:             finalLinkPath = linkName.endsWith('/') ? `${linkName}${targetBase}` : `${linkName}/${targetBase}`;
37:         }
38:         let absLinkPath = finalLinkPath;
39:         if (!finalLinkPath.startsWith('/')) {
40:             absLinkPath = state.currentDirectory === '/'
41:                 ? `/${finalLinkPath}`
42:                 : `${state.currentDirectory}/${finalLinkPath}`;
43:         }
44:         try {
45:             if (symbolic) {
46:                 this.fs.symlink(target, absLinkPath, 1000, 1000, '/');
47:             } else {
48:                 let absTarget = target;
49:                 if (!target.startsWith('/')) {
50:                     absTarget = state.currentDirectory === '/'
51:                         ? `/${target}`
52:                         : `${state.currentDirectory}/${target}`;
53:                 }
54:                 this.fs.link(absTarget, absLinkPath, '/');
55:             }
56:         } catch (e: any) {
57:             return {
58:                 output: `ln: ${e.message}`,
59:                 newState: state,
60:                 exitCode: 1
61:             };
62:         }
63:         return {
64:             output: '',
65:             newState: state,
66:             exitCode: 0
67:         };
68:     }
69: }
