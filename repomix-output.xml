 17: const GLYPHS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;':,./<>?";
 18: const MorphingText: React.FC<{
 19:     from: string,
 20:     to: string,
 21:     isMorphing: boolean,
 22:     isSettled: boolean,
 23:     style: any
 24: }> = ({ from, to, isMorphing, isSettled, style }) => {
 25:     const [display, setDisplay] = useState(isSettled ? to : from);
 26:     useEffect(() => {
 27:         if (isSettled) {
 28:             setDisplay(to);
 29:             return;
 30:         }
 31:         if (!isMorphing) {
 32:             setDisplay(from);
 33:             return;
 34:         }
 35:         let step = 0;
 36:         const totalSteps = 25;
 37:         const interval = setInterval(() => {
 38:             step++;
 39:             const progress = step / totalSteps;
 40:             const currentLen = Math.floor(from.length + (to.length - from.length) * progress);
 41:             const scrambled = Array.from({ length: currentLen }).map((_, i) => {
 42:                 if (progress > 0.6 && i < to.length) return to[i];
 43:                 return GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
 44:             }).join('');
 45:             setDisplay(scrambled);
 46:             if (step >= totalSteps) {
 47:                 clearInterval(interval);
 48:                 setDisplay(to);
 49:             }
 50:         }, 30);
 51:         return () => clearInterval(interval);
 52:     }, [from, to, isMorphing, isSettled]);
 53:     return <Text style={style}>{display}</Text>;
 54: };
