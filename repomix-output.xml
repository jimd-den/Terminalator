 1: import { Inode, S_IFMT } from '../../entities/filesystem/FileSystemTypes';
 2: import { InodeTable } from '../../entities/filesystem/InodeTable';
 3: import { IFileSystemNode } from '../../entities/filesystem/IFileSystemNode';
 4: type Dentry = IFileSystemNode;
 5: export class OwnershipService {
 6:     constructor(private inodeTable: InodeTable) { }
 7:     public chmod(dentry: Dentry, mode: number, actingUser?: { uid: number, gid: number, groups: number[] }): void {
 8:         const inode = this.inodeTable.get(dentry.inodeId);
 9:         if (!inode) throw new Error('Corrupt filesystem: Inode not found');
10:         if (actingUser && actingUser.uid !== 0 && actingUser.uid !== inode.uid) {
11:             throw new Error('Operation not permitted');
12:         }
13:         const typeMask = S_IFMT;
14:         const permMask = ~S_IFMT;
15:         inode.mode = (inode.mode & typeMask) | (mode & permMask);
16:         inode.ctime = Date.now();
17:     }
18:     public chown(dentry: Dentry, uid: number, gid: number, actingUser?: { uid: number, gid: number, groups: number[] }): void {
19:         const inode = this.inodeTable.get(dentry.inodeId);
20:         if (!inode) throw new Error('Corrupt filesystem: Inode not found');
21:         if (actingUser && actingUser.uid !== 0) {
22:             if (actingUser.uid !== inode.uid) {
23:                 throw new Error('Operation not permitted');
24:             }
25:             if (uid !== -1 && uid !== inode.uid) {
26:                 throw new Error('Operation not permitted');
27:             }
28:             if (gid !== -1 && gid !== inode.gid) {
29:                 if (actingUser.gid !== gid && !actingUser.groups.includes(gid)) {
30:                     throw new Error('Operation not permitted');
31:                 }
32:             }
33:         }
34:         if (uid !== -1) inode.uid = uid;
35:         if (gid !== -1) inode.gid = gid;
36:         inode.ctime = Date.now();
37:     }
38: }
